#!/bin/sh
set -eu

die() {
  printf 't: %s\n' "$1" >&2
  exit 1
}

usage() {
  printf '%s\n' 'usage: t [--editor | --with-editor]' >&2
}

normalize_directory() {
  CDPATH='' cd -P "$1" 2>/dev/null || return 1
  printf '%s.' "$PWD"
}

attach_session() {
  exec "$project_helper" open "=$1" "$2" "$project_view"
}

attach_session_id() {
  exec "$project_helper" open "$1" "$2" "$project_view"
}

session_root() {
  tmux display-message -p -t "$1:" '#{session_path}.' 2>/dev/null
}

session_name() {
  tmux display-message -p -t "$1:" '#{session_name}.' 2>/dev/null
}

attach_current_directory_session() {
  exact_directory=$1

  if ! exact_session_ids=$(tmux list-sessions -F '#{session_id}' 2>/dev/null); then
    return 0
  fi

  exact_match_count=0
  exact_match_id=
  exact_match_ids=

  while IFS= read -r exact_candidate_id; do
    [ -n "$exact_candidate_id" ] || continue
    exact_root_with_sentinel=$(session_root "$exact_candidate_id") || continue
    exact_root=${exact_root_with_sentinel%.}
    exact_normalized_root_with_sentinel=$(normalize_directory "$exact_root") || continue
    exact_normalized_root=${exact_normalized_root_with_sentinel%.}
    [ "$exact_normalized_root" = "$exact_directory" ] || continue

    # The editor shares this directory, but t attaches the shell half of the pair.
    # Its deterministic name survives restoration even when tmux options do not.
    exact_name_with_sentinel=$(session_name "$exact_candidate_id") || continue
    [ "${exact_name_with_sentinel%.}" != "$paired_editor_name" ] || continue

    exact_match_count=$((exact_match_count + 1))
    exact_match_id=$exact_candidate_id
    if [ -z "$exact_match_ids" ]; then
      exact_match_ids=$exact_candidate_id
    else
      exact_match_ids="$exact_match_ids
$exact_candidate_id"
    fi
  done <<EOF
$exact_session_ids
EOF

  case $exact_match_count in
    0)
      return 0
      ;;
    1)
      attach_session_id "$exact_match_id" "$exact_directory"
      ;;
    *)
      exact_match_list=
      while IFS= read -r exact_duplicate_id; do
        [ -n "$exact_duplicate_id" ] || continue
        if exact_duplicate_name_with_sentinel=$(session_name "$exact_duplicate_id"); then
          exact_duplicate_name=${exact_duplicate_name_with_sentinel%.}
        else
          exact_duplicate_name=$exact_duplicate_id
        fi
        if [ -z "$exact_match_list" ]; then
          exact_match_list="'$exact_duplicate_name'"
        else
          exact_match_list="$exact_match_list, '$exact_duplicate_name'"
        fi
      done <<EOF
$exact_match_ids
EOF
      die "multiple sessions use directory '$exact_directory': $exact_match_list"
      ;;
  esac
}

claim_or_attach() {
  candidate=$1

  if tmux has-session -t "=$candidate" 2>/dev/null; then
    existing_root_with_sentinel=$(session_root "=$candidate") || die "could not inspect session '$candidate'"
    existing_root=${existing_root_with_sentinel%.}
    if [ "$existing_root" = "$project_root" ]; then
      attach_session "$candidate" "$project_root"
    fi
    return 1
  fi

  if tmux new-session -d -s "$candidate" -c "$project_root" 2>/dev/null; then
    attach_session "$candidate" "$project_root"
  fi

  if tmux has-session -t "=$candidate" 2>/dev/null; then
    existing_root_with_sentinel=$(session_root "=$candidate") || die "could not inspect session '$candidate' after a create race"
    existing_root=${existing_root_with_sentinel%.}
    if [ "$existing_root" = "$project_root" ]; then
      attach_session "$candidate" "$project_root"
    fi
    return 1
  fi

  die "could not create session '$candidate'"
}

if [ -n "${TMUX-}" ]; then
  die "already inside tmux"
fi

project_view=shell
if [ "$#" -eq 1 ] && [ "$1" = --editor ]; then
  project_view=nvim
elif [ "$#" -eq 1 ] && [ "$1" = --with-editor ]; then
  project_view=pair
elif [ "$#" -ne 0 ]; then
  usage
  exit 2
fi

if ! command -v tmux >/dev/null 2>&1; then
  printf '%s\n' 't: tmux is not installed or not in PATH' >&2
  exit 127
fi

workspace_helper=$HOME/.config/tmux/scripts/workspace
[ -x "$workspace_helper" ] \
  || die "workspace helper is missing or not executable: $workspace_helper"
"$workspace_helper" ensure \
  || die "workspace restoration did not become ready"

if ! current_directory_with_sentinel=$(normalize_directory .); then
  die "could not normalize current directory"
fi
current_directory=${current_directory_with_sentinel%.}
project_helper=$HOME/.config/tmux/scripts/project-session
[ -x "$project_helper" ] \
  || die "project helper is missing or not executable: $project_helper"
paired_editor_name=$("$project_helper" editor-name "$current_directory") \
  || die "could not identify the project's editor session"
attach_current_directory_session "$current_directory"

if ! command -v git >/dev/null 2>&1; then
  printf '%s\n' 't: git is not installed or not in PATH' >&2
  exit 127
fi

if ! git_root_with_sentinel=$(git rev-parse --show-toplevel 2>/dev/null && printf '.'); then
  [ "$project_view" = shell ] || die 'no project session or Git worktree found'
  exec tmux
fi
# Remove the sentinel and exactly Git's output newline, preserving path newlines.
git_root=${git_root_with_sentinel%.}
git_root=${git_root%?}

if ! project_root_with_sentinel=$(normalize_directory "$git_root"); then
  die "could not normalize Git root '$git_root'"
fi
project_root=${project_root_with_sentinel%.}

project_name=${project_root##*/}
session_base=$(printf '%s' "$project_name" | LC_ALL=C sed 's/[^A-Za-z0-9_-][^A-Za-z0-9_-]*/_/g')
if [ -z "$session_base" ]; then
  session_base=project
fi

if claim_or_attach "$session_base"; then
  exit 0
fi

full_hash=$(printf '%s' "$project_root" | git hash-object --stdin 2>/dev/null) || die "could not hash Git root '$project_root'"
short_hash=$(printf '%.8s' "$full_hash")
collision_name=$session_base-$short_hash

if claim_or_attach "$collision_name"; then
  exit 0
fi

die "session '$collision_name' belongs to another project"
