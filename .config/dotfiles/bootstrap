#!/bin/sh

set -u

LC_ALL=C
export LC_ALL
umask 077

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_CEILING_DIRECTORIES \
  GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_PREFIX GIT_NAMESPACE GIT_SHALLOW_FILE \
  GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT

program=${0##*/}
case "$program" in
  sh|dash|bash|zsh) program=bootstrap ;;
esac

usage() {
  destination=${1:-1}
  if [ "$destination" -eq 1 ]; then
    output=/dev/stdout
  else
    output=/dev/stderr
  fi

  printf '%s\n' \
    'usage: bootstrap [--apply] --window-manager (hypr|i3|aerospace|none)' \
    '                 [--allow-community-packages] [--repo URL] [--ref REF]' \
    '                 [--expected-commit OID]' \
    '       bootstrap [--apply] --managed-tool taplo' \
    '       bootstrap --rollback (latest|RUN_ID)' \
    '       bootstrap --help' \
    '' \
    'Without --apply, bootstrap prints a dry-run and makes no persistent changes.' \
    'Use --apply to install packages and deploy the selected dotfiles.' \
    'Use --expected-commit to verify the reviewed source before installing packages (requires Git).' \
    'Use --window-manager to make the platform-specific manager choice explicit.' \
    'Use --allow-community-packages to permit the documented Ghostty Ubuntu/Debian installer.' \
    >"$output"
}

die() {
  printf 'bootstrap: %s\n' "$1" >&2
  exit "${2:-1}"
}

mode=dry-run
allow_community_packages=false
repo_url=https://github.com/Ruohao1/dotfiles.git
repo_ref=main
# Exact managed releases; external providers keep their own minimum versions.
node_fallback_version=24.19.0
luals_fallback_version=3.19.1
taplo_fallback_version=0.10.0
npm_language_servers_lock_sha256=f01618d246ff8f53ad57e8d6a1cfe4d278f06a68d80eddbb254d910218aba4b8
rollback_id=
window_manager=
managed_tool=
managed_tool_was_set=false
window_manager_was_set=false
repo_was_set=false
ref_was_set=false
expected_commit=
expected_commit_was_set=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply)
      [ "$mode" = dry-run ] || die '--apply cannot be combined with --rollback' 2
      mode=apply
      ;;
    --allow-community-packages)
      allow_community_packages=true
      ;;
    --window-manager)
      [ "$#" -ge 2 ] || die '--window-manager requires a profile' 2
      window_manager_was_set=true
      window_manager=$2
      shift
      ;;
    --repo)
      [ "$#" -ge 2 ] || die '--repo requires a URL' 2
      repo_was_set=true
      repo_url=$2
      shift
      ;;
    --ref)
      [ "$#" -ge 2 ] || die '--ref requires a Git reference' 2
      ref_was_set=true
      repo_ref=$2
      shift
      ;;
    --expected-commit)
      [ "$#" -ge 2 ] || die '--expected-commit requires a full commit ID' 2
      expected_commit=$2
      expected_commit_was_set=true
      shift
      ;;
    --managed-tool)
      [ "$#" -ge 2 ] || die '--managed-tool requires a tool name' 2
      [ "$managed_tool_was_set" = false ] \
        || die '--managed-tool may be specified only once' 2
      managed_tool_was_set=true
      managed_tool=$2
      shift
      ;;
    --rollback)
      [ "$#" -ge 2 ] || die '--rollback requires latest or a run ID' 2
      [ "$mode" = dry-run ] || die '--rollback cannot be combined with --apply' 2
      mode=rollback
      rollback_id=$2
      shift
      ;;
    --help|-h)
      usage 1
      exit 0
      ;;
    --)
      shift
      [ "$#" -eq 0 ] || die 'positional arguments are not supported' 2
      break
      ;;
    *)
      usage 2
      die "unknown option: $1" 2
      ;;
  esac
  shift
done

if [ "$expected_commit_was_set" = true ]; then
  case "$expected_commit" in
    ''|*[!0-9a-f]*) die 'expected commit must be a full hexadecimal commit ID' 2 ;;
  esac
  case "${#expected_commit}" in
    40|64) ;;
    *) die 'expected commit must be a full hexadecimal commit ID' 2 ;;
  esac
  [ "$mode" != rollback ] && [ "$managed_tool_was_set" = false ] \
    || die '--expected-commit requires full preview or apply mode' 2
fi

if [ "$managed_tool_was_set" = true ]; then
  [ "$managed_tool" = taplo ] \
    || die "unsupported managed tool: $managed_tool" 2
  [ "$window_manager_was_set" = false ] \
    || die '--managed-tool cannot be combined with --window-manager' 2
  [ "$allow_community_packages" = false ] \
    || die '--managed-tool cannot be combined with --allow-community-packages' 2
  [ "$repo_was_set" = false ] \
    || die '--managed-tool cannot be combined with --repo' 2
  [ "$ref_was_set" = false ] \
    || die '--managed-tool cannot be combined with --ref' 2
  [ "$mode" != rollback ] \
    || die '--managed-tool cannot be combined with --rollback' 2
fi

case "$repo_url" in
  ''|-*) die 'repository URL must not be empty or begin with a dash' 2 ;;
  *"
"*|*""*|*"	"*) die 'repository URL must not contain control characters' 2 ;;
esac
# Reject credential-bearing HTTP(S) inputs before commands, output, or journals.
case "$repo_url" in
  [hH][tT][tT][pP]::*|[hH][tT][tT][pP][sS]::*)
    die 'HTTP(S) repository URL must use standard URL syntax, not an explicit remote-helper prefix' 2
    ;;
  [hH][tT][tT][pP]:/*|[hH][tT][tT][pP][sS]:/*)
    repo_address=${repo_url#*:}
    case "$repo_address" in
      //[!/]*) ;;
      *) die 'HTTP(S) repository URL requires two slashes and a host' 2 ;;
    esac
    repo_authority=${repo_address#//}
    repo_authority=${repo_authority%%/*}
    case "$repo_authority" in
      *@*) die 'HTTP(S) repository URL must not include userinfo; use Git credential helpers or SSH' 2 ;;
    esac
    case "$repo_url" in
      *'?'*|*'#'*) die 'HTTP(S) repository URL must not include a query or fragment; use Git credential helpers or SSH' 2 ;;
    esac
    ;;
esac
case "$repo_ref" in
  ''|-*|*[!A-Za-z0-9._/-]*|*..*|*/)
    die 'Git reference contains unsupported characters or structure' 2
    ;;
esac
case "$rollback_id" in
  *[!A-Za-z0-9._-]*) die 'rollback ID contains unsupported characters' 2 ;;
esac

# BEGIN embedded ownership guard
# shellcheck shell=sh
# Portable fixed-home coordination; embedded verbatim in standalone bootstrap.
# mkdir is the atomic lock primitive on Linux and Darwin, also used by Python.
ownership_lock_path=
ownership_lock_identity=

ownership_error() {
  printf 'dotfiles ownership: %s\n' "$1" >&2
  return 1
}

ownership_safe_directory() {
  [ ! -L "$1" ] && [ -d "$1" ] || {
    ownership_error "unsafe directory: $1"; return 1;
  }
  ownership_listing=$(LC_ALL=C ls -ldn -- "$1") || return 1
  # Filename fields may contain spaces. Only the fixed mode/UID fields matter.
  read -r ownership_permissions _ownership_link_count ownership_directory_uid _ownership_rest <<EOF
$ownership_listing
EOF
  [ "$ownership_directory_uid" = "$ownership_uid" ] || {
    ownership_error 'coordination directories must belong to the current user'; return 1;
  }
  case "$ownership_permissions" in
    ?????w*|????????w*) ownership_error 'coordination directories must not be group/world writable'; return 1 ;;
  esac
}

ownership_check_paths() {
  case "${HOME:-}" in
    /*) ;;
    *) ownership_error 'HOME must be an absolute directory'; return 1 ;;
  esac
  case "$HOME" in
    */../*|*/./*|*/..|*/.|*//*) ownership_error 'HOME must not contain traversal or empty components'; return 1 ;;
  esac
  [ "$HOME" != / ] || { ownership_error 'HOME must not be root'; return 1; }
  # Reject symlinks in the complete lexical home path, including its parents.
  ownership_ancestor=$HOME
  while [ "$ownership_ancestor" != / ]; do
    [ ! -L "$ownership_ancestor" ] || {
      ownership_error "symlinked home parent: $ownership_ancestor"; return 1;
    }
    ownership_ancestor=${ownership_ancestor%/*}
    [ -n "$ownership_ancestor" ] || ownership_ancestor=/
  done
  ownership_uid=$(id -u) || return 1
  ownership_safe_directory "$HOME" || return 1
  ownership_home=$(CDPATH='' cd -- "$HOME" && pwd -P) || return 1
  ownership_root=$ownership_home/.local/state/dotfiles-ownership
  for ownership_directory in "$ownership_home/.local" "$ownership_home/.local/state" "$ownership_root"; do
    if [ -e "$ownership_directory" ] || [ -L "$ownership_directory" ]; then
      ownership_safe_directory "$ownership_directory" || return 1
    fi
  done
  if [ -e "$ownership_root/owner.json" ] || [ -L "$ownership_root/owner.json" ]; then
    ownership_error 'Home Manager ownership metadata exists; legacy deployment is blocked'
    return 1
  fi
}

ownership_acquire() {
  ownership_check_paths || return 1
  # Create one component at a time; recheck before and after publication.
  for ownership_directory in "$ownership_home/.local" "$ownership_home/.local/state" "$ownership_root"; do
    if [ ! -e "$ownership_directory" ]; then
      (umask 077; mkdir -- "$ownership_directory") 2>/dev/null || {
        ownership_safe_directory "$ownership_directory" || return 1;
      }
    fi
    ownership_safe_directory "$ownership_directory" || return 1
  done
  ownership_candidate=$ownership_root/lock
  (umask 077; mkdir -- "$ownership_candidate") 2>/dev/null || {
    ownership_error 'another deployer holds the per-home lock'; return 1;
  }
  ownership_lock_path=$ownership_candidate
  # Keep the inode alive so a removed lock cannot be replaced with the same inode.
  exec 9< "$ownership_lock_path" || return 1
  ownership_lock_identity=$(ls -di -- "$ownership_lock_path") || return 1
  read -r ownership_lock_identity _ownership_rest <<EOF
$ownership_lock_identity
EOF
  ownership_recheck || { ownership_release; return 1; }
}

ownership_recheck() {
  ownership_check_paths || return 1
  [ -n "$ownership_lock_path" ] && [ "$ownership_lock_path" = "$ownership_root/lock" ] || {
    ownership_error 'deployment requires its held per-home lock'; return 1;
  }
  ownership_safe_directory "$ownership_lock_path" || return 1
  ownership_current_identity=$(ls -di -- "$ownership_lock_path") || return 1
  read -r ownership_current_identity _ownership_rest <<EOF
$ownership_current_identity
EOF
  [ "$ownership_current_identity" = "$ownership_lock_identity" ] || {
    ownership_error 'held lock was replaced'; return 1;
  }
}

ownership_release() {
  if [ -n "$ownership_lock_path" ] && [ ! -L "$ownership_lock_path" ] && [ -d "$ownership_lock_path" ]; then
    ownership_current_identity=$(ls -di -- "$ownership_lock_path") || return 1
    read -r ownership_current_identity _ownership_rest <<EOF
$ownership_current_identity
EOF
    if [ "$ownership_current_identity" = "$ownership_lock_identity" ]; then
      rmdir -- "$ownership_lock_path" || return 1
    fi
  fi
  exec 9<&-
  ownership_lock_path=
  ownership_lock_identity=
}
# END embedded ownership guard

script_dir=
case "$0" in
  */*)
    candidate_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || candidate_dir=
    if [ -n "$candidate_dir" ] && [ -d "$candidate_dir/manifests" ]; then
      script_dir=$candidate_dir
    fi
    ;;
esac

detect_platform() {
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ -n "${DOTFILES_BOOTSTRAP_TEST_PLATFORM:-}" ]; then
    printf '%s\n' "$DOTFILES_BOOTSTRAP_TEST_PLATFORM"
    return
  fi

  case "$(uname -s)" in
    Darwin) printf '%s\n' macos ;;
    Linux) printf '%s\n' linux ;;
    *) die "unsupported operating system: $(uname -s)" ;;
  esac
}

detect_manager() {
  selected_platform=$1

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ -n "${DOTFILES_BOOTSTRAP_TEST_MANAGER:-}" ]; then
    printf '%s\n' "$DOTFILES_BOOTSTRAP_TEST_MANAGER"
    return
  fi

  if [ "$selected_platform" = macos ]; then
    printf '%s\n' homebrew
    return
  fi

  os_release=${DOTFILES_BOOTSTRAP_OS_RELEASE:-/etc/os-release}
  distribution=
  if [ -r "$os_release" ]; then
    distribution=$(sed -n 's/^ID=//p' "$os_release" | sed 's/^"//;s/"$//' | head -n 1)
  fi

  case "$distribution" in
    arch|endeavouros|manjaro) printf '%s\n' pacman ;;
    debian|ubuntu|linuxmint|pop) printf '%s\n' apt ;;
    *)
      if command -v pacman >/dev/null 2>&1; then
        printf '%s\n' pacman
      elif command -v apt-get >/dev/null 2>&1; then
        printf '%s\n' apt
      else
        die "unsupported Linux distribution: ${distribution:-unknown}"
      fi
      ;;
  esac
}

select_window_manager() {
  selected_platform=$1
  selected_manager=$2
  selected_window_manager=$3

  if [ -z "$selected_window_manager" ] \
    && [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_WINDOW_MANAGER+set}" = set ]; then
    selected_window_manager=$DOTFILES_BOOTSTRAP_TEST_WINDOW_MANAGER
  fi

  [ -n "$selected_window_manager" ] \
    || die '--window-manager is required: choose hypr, i3, aerospace, or none' 2
  case "$selected_window_manager" in
    hypr|i3|aerospace|none) ;;
    *) die "unsupported window-manager profile: $selected_window_manager" 2 ;;
  esac

  case "$selected_platform:$selected_manager:$selected_window_manager" in
    linux:pacman:hypr|linux:pacman:i3|linux:pacman:none|\
    linux:apt:i3|linux:apt:none|\
    macos:homebrew:aerospace|macos:homebrew:none)
      ;;
    linux:apt:hypr)
      die 'Hyprland is unsupported through apt; choose i3 or none on apt systems' 2
      ;;
    *)
      die "window-manager $selected_window_manager is invalid for $selected_platform/$selected_manager" 2
      ;;
  esac

  window_manager=$selected_window_manager
}

validate_manifest_path() {
  manifest_path=$1
  case "$manifest_path" in
    ''|'#'*) return 1 ;;
    /*|.|..|../*|*/../*|*/..|./*|*/./*|*/.|*/|*//*|*[?*\[]*)
      die "unsafe manifest path: $manifest_path"
      ;;
  esac
  case "$manifest_path" in
    *"
"*|*""*|*"	"*) die 'manifest paths must not contain control characters' ;;
    *[!A-Za-z0-9._/@+\ -]*) die "manifest path contains unsupported characters: $manifest_path" ;;
  esac
  return 0
}

emit_manifest() {
  manifest_file=$1
  [ -r "$manifest_file" ] || die "missing manifest: $manifest_file"

  while IFS= read -r manifest_path || [ -n "$manifest_path" ]; do
    if validate_manifest_path "$manifest_path"; then
      printf '%s\n' "$manifest_path"
    fi
  done <"$manifest_file"
}

emit_selected_paths() {
  selected_platform=$1
  selected_window_manager=$2
  manifest_root=$3

  emit_manifest "$manifest_root/config-common.paths"
  emit_manifest "$manifest_root/config-$selected_platform.paths"
  window_manager_manifest=$(window_manager_config_manifest \
    "$selected_window_manager" "$manifest_root")
  if [ -n "$window_manager_manifest" ]; then
    emit_manifest "$window_manager_manifest"
  fi
}

emit_platform_preference_plan() {
  selected_platform=$1
  selected_window_manager=$2
  printf '%s\n' 'System preferences:'
  case "$selected_platform" in
    macos)
      printf '%s\n' \
        '  backup and set Spotlight shortcut Command+Shift+semicolon'
      if [ "$selected_window_manager" = aerospace ]; then
        printf '%s\n' \
          '  backup and enable NSWindowShouldDragOnGesture for Control+Command drag'
      fi
      ;;
    linux) printf '%s\n' '  none' ;;
    *) die "unsupported preference platform: $selected_platform" ;;
  esac
}

emit_post_apply_manual_steps() {
  selected_platform=$1
  selected_window_manager=$2
  printf '%s\n' 'Post-apply manual steps:'
  case "$selected_platform:$selected_window_manager" in
    macos:aerospace)
      printf '%s\n' \
        '  open Karabiner-Elements and complete its required macOS setup'
      ;;
    *) printf '%s\n' '  none' ;;
  esac
}

emit_service_plan() {
  selected_platform=$1
  printf '%s\n' 'Login service:'
  case "$selected_platform" in
    linux)
      printf '%s\n' \
        '  systemctl --user daemon-reload' \
        '  systemctl --user enable tmux-workspace.service (unless already enabled)' \
        '  systemctl --user start tmux-workspace.service (unless already active)'
      if [ "$2" = hypr ]; then
        printf '%s\n' \
          '  systemctl --user enable cliphist.service (unless already enabled)' \
          '  systemctl --user start cliphist.service (only in an active Wayland graphical session)'
      fi
      ;;
    macos)
      service_domain=gui/$(id -u)
      printf '%s\n' \
        "  launchctl bootstrap $service_domain $HOME/Library/LaunchAgents/dev.ruohao.tmux-workspace.plist" \
        "  launchctl kickstart -k $service_domain/dev.ruohao.tmux-workspace"
      ;;
    *) die "unsupported service platform: $selected_platform" ;;
  esac
}

window_manager_config_manifest() {
  selected_window_manager=$1
  manifest_root=$2

  case "$selected_window_manager" in
    hypr) printf '%s\n' "$manifest_root/config-linux-hypr.paths" ;;
    i3) printf '%s\n' "$manifest_root/config-linux-i3.paths" ;;
    aerospace) printf '%s\n' "$manifest_root/config-macos-aerospace.paths" ;;
    none) ;;
    *) die "unsupported window-manager config profile: $selected_window_manager" ;;
  esac
}

window_manager_package_manifest() {
  selected_manager=$1
  selected_window_manager=$2
  manifest_root=$3

  case "$selected_manager:$selected_window_manager" in
    pacman:hypr) printf '%s\n' "$manifest_root/packages-pacman-hypr.list" ;;
    pacman:i3) printf '%s\n' "$manifest_root/packages-pacman-i3.list" ;;
    apt:i3) printf '%s\n' "$manifest_root/packages-apt-i3.list" ;;
    homebrew:aerospace)
      printf '%s\n' "$manifest_root/packages-homebrew-aerospace-casks.list"
      ;;
    pacman:none|apt:none|homebrew:none) ;;
    *)
      die "unsupported window-manager package profile: $selected_manager/$selected_window_manager"
      ;;
  esac
}

validate_package_name() {
  package_name=$1
  case "$package_name" in
    ''|'#'*) return 1 ;;
    -*|/*|*/|*..*|*//*|*/./*|*/.|*"
"*|*""*|*"	"*) die "unsafe package name: $package_name" ;;
    *[!A-Za-z0-9@+._/-]*) die "unsafe package name: $package_name" ;;
  esac
  return 0
}

emit_package_list() {
  package_kind=$1
  package_file=$2
  [ -r "$package_file" ] || die "missing package manifest: $package_file"

  while IFS= read -r package_name || [ -n "$package_name" ]; do
    if validate_package_name "$package_name"; then
      printf '  install %s %s\n' "$package_kind" "$package_name"
    fi
  done <"$package_file"
}

package_arguments() {
  package_line=
  for package_file do
    [ -n "$package_file" ] || continue
    [ -r "$package_file" ] || die "missing package manifest: $package_file"
    while IFS= read -r package_name || [ -n "$package_name" ]; do
      if validate_package_name "$package_name"; then
        if [ -n "$package_line" ]; then
          package_line="$package_line $package_name"
        else
          package_line=$package_name
        fi
      fi
    done <"$package_file"
  done
  printf '%s\n' "$package_line"
}

emit_package_plan() {
  selected_manager=$1
  selected_window_manager=$2
  manifest_root=$3
  window_manager_packages=$(window_manager_package_manifest \
    "$selected_manager" "$selected_window_manager" "$manifest_root")

  case "$selected_manager" in
    homebrew)
      emit_package_list homebrew-formula "$manifest_root/packages-homebrew-formulae.list"
      emit_package_list homebrew-cask "$manifest_root/packages-homebrew-casks.list"
      if [ -n "$window_manager_packages" ]; then
        emit_package_list homebrew-cask "$window_manager_packages"
      fi
      ;;
    apt)
      emit_package_list apt "$manifest_root/packages-apt.list"
      if [ -n "$window_manager_packages" ]; then
        emit_package_list apt "$window_manager_packages"
      fi
      printf '%s\n' \
        '  install upstream neovim >=0.12.0' \
        '  install upstream stylua' \
        '  install upstream tree-sitter-cli >=0.26.1' \
        '  install upstream herdr' \
        '  install upstream font-space-mono-nerd' \
        '  ensure upstream uv >=0.11.6 (fallback uv 0.12.5)' \
        "  ensure upstream node >=22.0.0 with npm >=10.0.0 (fallback node $node_fallback_version)" \
        '  ensure upstream lua-language-server >=3.19.1' \
        "  ensure upstream taplo >=0.10.0 (fallback taplo $taplo_fallback_version)" \
        '  ensure npm bash-language-server@5.6.0' \
        '  ensure npm vscode-langservers-extracted@4.10.0' \
        '  ensure npm pyright@1.1.411' \
        '  ensure npm yaml-language-server@1.24.0'
      if apt_offers_ghostty; then
        printf '%s\n' '  install apt ghostty'
      elif [ "$allow_community_packages" = true ]; then
        printf '%s\n' '  install community ghostty'
      else
        printf '%s\n' '  blocked community ghostty (requires --allow-community-packages when no official apt package exists)'
      fi
      ;;
    pacman)
      emit_package_list pacman "$manifest_root/packages-pacman.list"
      if [ -n "$window_manager_packages" ]; then
        emit_package_list pacman "$window_manager_packages"
      fi
      printf '  manual sudo pacman -Syu --needed %s\n' \
        "$(package_arguments \
          "$manifest_root/packages-pacman.list" "$window_manager_packages")"
      printf '%s\n' '  install upstream herdr'
      if [ "$selected_window_manager" = hypr ]; then
        printf '%s\n' \
          '  install upstream rishot 28c273b1b573725e03ef12989451f48009dabc83'
      fi
      ;;
    *) die "unsupported package manager: $selected_manager" ;;
  esac
  printf '%s\n' \
    '  ensure uv-tool visidata==3.4 with pyarrow==25.0.0 and duckdb==1.5.5'
}

record_test_command() {
  command_log=${DOTFILES_BOOTSTRAP_TEST_COMMAND_LOG:-}
  [ -n "$command_log" ] || return 0
  first_argument=true
  for argument do
    if [ "$first_argument" = true ]; then
      first_argument=false
    else
      printf ' ' >>"$command_log"
    fi
    printf '%s' "$argument" >>"$command_log"
  done
  printf '\n' >>"$command_log"
}

start_package_tracking() {
  package_actions_tmp=$(temporary_directory) \
    || die 'could not create temporary package action journal'
  package_actions_file=$package_actions_tmp/actions
  : >"$package_actions_file" \
    || die 'could not initialize temporary package action journal'
  managed_created_paths_file=$package_actions_tmp/managed-created.paths
  : >"$managed_created_paths_file" \
    || die 'could not initialize managed-created path journal'
}

record_package_action() {
  package_action_kind=$1
  package_action_name=$2
  [ -n "$package_actions_file" ] || return 0
  case "$package_action_kind" in
    apt|direct|homebrew-cask|homebrew-formula|installer|community|npm|uv-tool) ;;
    *) die "unsupported package action kind: $package_action_kind" ;;
  esac
  validate_package_name "$package_action_name" \
    || die 'empty package action name is not allowed'
  printf '%s %s\n' "$package_action_kind" "$package_action_name" \
    >>"$package_actions_file" \
    || die 'could not record a package action'
}

run_command() {
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    record_test_command "$@"
    return 0
  fi
  "$@"
}

record_service_action() {
  [ -n "${transaction_run:-}" ] || return 0
  [ -d "$transaction_run" ] || return 0
  action_log=$transaction_run/service-actions.log
  first_argument=true
  for argument do
    if [ "$first_argument" = true ]; then
      first_argument=false
    else
      printf ' ' >>"$action_log"
    fi
    printf '%s' "$argument" >>"$action_log"
  done
  printf '\n' >>"$action_log"
}

run_service_command() {
  record_service_action "$@"
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    record_test_command "$@"
    failure_token=${DOTFILES_BOOTSTRAP_TEST_SERVICE_FAIL:-}
    if [ -n "$failure_token" ]; then
      failure_unit=${DOTFILES_BOOTSTRAP_TEST_SERVICE_FAIL_UNIT:-}
      if [ -n "$failure_unit" ]; then
        failure_unit_selected=false
        for service_argument do
          [ "$service_argument" != "$failure_unit" ] || failure_unit_selected=true
        done
        [ "$failure_unit_selected" = true ] || return 0
      fi
      for service_argument do
        [ "$service_argument" != "$failure_token" ] || return 1
      done
    fi
    return 0
  fi
  "$@"
}

run_privileged_command() {
  if [ "$(id -u)" -eq 0 ]; then
    run_command "$@"
    return
  fi
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" != 1 ]; then
    command -v sudo >/dev/null 2>&1 \
      || die "sudo is required to run: $1"
  fi
  run_command sudo "$@"
}

package_is_installed() {
  selected_manager=$1
  package_name=$2

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_ALL_PACKAGES_MISSING:-0}" = 1 ]; then
    return 1
  fi

  case "$selected_manager" in
    homebrew-formula) brew list --formula "$package_name" >/dev/null 2>&1 ;;
    homebrew-cask) brew list --cask "$package_name" >/dev/null 2>&1 ;;
    apt)
      dpkg-query -W -f='${Status}\n' "$package_name" 2>/dev/null \
        | grep -qx 'install ok installed'
      ;;
    pacman) pacman -Q "$package_name" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

version_at_least() {
  actual_version=$1
  required_version=$2

  awk -v actual="$actual_version" -v required="$required_version" 'BEGIN {
    actual_count = split(actual, actual_part, ".")
    required_count = split(required, required_part, ".")
    count = actual_count > required_count ? actual_count : required_count
    for (part_index = 1; part_index <= count; part_index++) {
      actual_value = actual_part[part_index] + 0
      required_value = required_part[part_index] + 0
      if (actual_value > required_value) exit 0
      if (actual_value < required_value) exit 1
    }
    exit 0
  }'
}

command_version() {
  command_name=$1
  case "$command_name" in
    nvim) nvim --version 2>/dev/null | sed -n '1s/[^0-9]*\([0-9][0-9.]*\).*/\1/p' ;;
    tree-sitter) tree-sitter --version 2>/dev/null | sed -n '1s/[^0-9]*\([0-9][0-9.]*\).*/\1/p' ;;
    *) "$command_name" --version 2>/dev/null | sed -n '1s/[^0-9]*\([0-9][0-9.]*\).*/\1/p' ;;
  esac
}

rishot_installation_is_satisfied() {
  rishot_required_revision=$1
  rishot_root=$HOME/.local/share/rishot
  rishot_launcher=$HOME/.local/bin/rishot
  rishot_marker=$rishot_root/.dotfiles-revision
  rishot_expected_origin=https://github.com/Gakuseei/rishot.git

  [ -d "$rishot_root" ] && [ ! -L "$rishot_root" ] || return 1
  [ -f "$rishot_root/bin/rishot" ] \
    && [ ! -L "$rishot_root/bin/rishot" ] \
    && [ -x "$rishot_root/bin/rishot" ] || return 1
  [ -f "$rishot_root/src/shell.qml" ] \
    && [ ! -L "$rishot_root/src/shell.qml" ] || return 1
  [ -L "$rishot_launcher" ] || return 1
  [ "$(readlink "$rishot_launcher" 2>/dev/null || true)" \
    = "$rishot_root/bin/rishot" ] || return 1

  if [ -d "$rishot_root/.git" ] && [ ! -L "$rishot_root/.git" ]; then
    command -v git >/dev/null 2>&1 || return 1
    [ "$(git -C "$rishot_root" rev-parse HEAD 2>/dev/null || true)" \
      = "$rishot_required_revision" ] || return 1
    [ "$(git -C "$rishot_root" remote get-url origin 2>/dev/null || true)" \
      = "$rishot_expected_origin" ] || return 1
    rishot_git_status=$(git -C "$rishot_root" status --porcelain=v1 \
      --untracked-files=no 2>/dev/null) || return 1
    [ -z "$rishot_git_status" ] || return 1
    return 0
  fi

  [ -f "$rishot_marker" ] && [ ! -L "$rishot_marker" ] \
    && [ "$(cat "$rishot_marker")" = "$rishot_required_revision" ]
}

tool_is_satisfied() {
  tool_name=$1
  required_version=$2

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_SATISFIED_TOOLS+x}" = x ] \
    && { [ "$tool_name" != rishot ] \
      || [ "${DOTFILES_BOOTSTRAP_TEST_REAL_RISHOT_INSTALL:-0}" != 1 ]; }; then
    case ",${DOTFILES_BOOTSTRAP_TEST_SATISFIED_TOOLS}," in
      *,"$tool_name",*) return 0 ;;
      *) return 1 ;;
    esac
  fi

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_ALL_PACKAGES_MISSING:-0}" = 1 ]; then
    return 1
  fi

  case "$tool_name" in
    font-space-mono-nerd)
      command -v fc-list >/dev/null 2>&1 \
        && fc-list 2>/dev/null | grep -Fq 'SpaceMono Nerd Font Mono'
      return
      ;;
    rishot)
      rishot_installation_is_satisfied "$required_version"
      return
      ;;
  esac

  command -v "$tool_name" >/dev/null 2>&1 || return 1
  [ -n "$required_version" ] || return 0
  installed_version=$(command_version "$tool_name")
  [ -n "$installed_version" ] || return 1
  version_at_least "$installed_version" "$required_version"
}

debian_probe_runtime_is_ready() {
  case ${debian_probe_setsid_command:-} in
    /*) [ -x "$debian_probe_setsid_command" ] || return 1 ;;
    *) return 1 ;;
  esac
  case ${debian_probe_env_command:-} in
    /*) [ -x "$debian_probe_env_command" ] || return 1 ;;
    *) return 1 ;;
  esac
}

require_debian_probe_runtime() {
  debian_probe_runtime_is_ready && return 0
  debian_probe_setsid_command=
  debian_probe_env_command=

  debian_probe_setsid_candidate=$(command -v setsid 2>/dev/null || true)
  case $debian_probe_setsid_candidate in
    /*) [ -x "$debian_probe_setsid_candidate" ] ;;
    *) false ;;
  esac || {
    printf '%s\n' \
      'bootstrap: util-linux setsid -f -w is required for Debian language-server probes' >&2
    return 1
  }

  debian_probe_env_candidate=$(command -v env 2>/dev/null || true)
  case $debian_probe_env_candidate in
    /*) [ -x "$debian_probe_env_candidate" ] ;;
    *) false ;;
  esac || {
    printf '%s\n' \
      'bootstrap: GNU env --default-signal=HUP,INT,TERM is required for Debian language-server probes' >&2
    return 1
  }

  if ! "$debian_probe_setsid_candidate" -f -w /bin/sh -c 'exit 0'; then
    printf '%s\n' \
      'bootstrap: util-linux setsid -f -w is required for Debian language-server probes' >&2
    return 1
  fi
  if ! "$debian_probe_env_candidate" \
    --default-signal=HUP,INT,TERM /bin/sh -c 'exit 0'; then
    printf '%s\n' \
      'bootstrap: GNU env --default-signal=HUP,INT,TERM is required for Debian language-server probes' >&2
    return 1
  fi

  debian_probe_setsid_command=$debian_probe_setsid_candidate
  debian_probe_env_command=$debian_probe_env_candidate
}

probe_decimal_id_is_safe() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$1" -gt 1 ]
}

probe_record_is_safe() {
  case "$1" in
    ''|*"
"*|*""*|*"	"*) return 1 ;;
    *) return 0 ;;
  esac
}

read_probe_pair_record() {
  probe_pair_path=$1
  [ -r "$probe_pair_path" ] || return 1
  probe_pair_record=$(cat "$probe_pair_path") || return 1
  probe_record_is_safe "$probe_pair_record" || return 1
  case "$probe_pair_record" in
    *'|'*) ;;
    *) return 1 ;;
  esac
  probe_record_first=${probe_pair_record%%|*}
  probe_record_second=${probe_pair_record#*|}
  case "$probe_record_second" in
    *'|'*) return 1 ;;
  esac
  case "$probe_record_first:$probe_record_second" in
    *[!0-9:]*|:*) return 1 ;;
  esac
  return 0
}

probe_process_identity() {
  probe_identity_pid=$1
  probe_identity=$(ps -o pid= -o ppid= -o pgid= -o sid= \
    -p "$probe_identity_pid" 2>/dev/null \
    | awk '
      NF == 4 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ \
        && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ {
        print $1, $2, $3, $4
        valid += 1
      }
      END { if (valid != 1) exit 1 }
    ') || return 1
  probe_identity_pid_value=
  probe_identity_parent_value=
  probe_identity_group_value=
  probe_identity_session_value=
  probe_identity_extra=
  IFS=' ' read -r \
    probe_identity_pid_value \
    probe_identity_parent_value \
    probe_identity_group_value \
    probe_identity_session_value \
    probe_identity_extra <<PROBE_IDENTITY
$probe_identity
PROBE_IDENTITY
  [ -z "$probe_identity_extra" ]
}

probe_anchor_identity_is_valid() {
  probe_anchor_check_pid=$1
  probe_anchor_check_parent=$2
  probe_decimal_id_is_safe "$probe_anchor_check_pid" || return 1
  probe_decimal_id_is_safe "$probe_anchor_check_parent" || return 1
  probe_process_identity "$probe_anchor_check_pid" || return 1
  [ "$probe_identity_pid_value" = "$probe_anchor_check_pid" ] \
    && [ "$probe_identity_parent_value" = "$probe_anchor_check_parent" ] \
    && [ "$probe_identity_group_value" = "$probe_anchor_check_pid" ] \
    && [ "$probe_identity_session_value" = "$probe_anchor_check_pid" ]
}

probe_target_identity_is_valid() {
  probe_target_check_pid=$1
  probe_target_check_parent=$2
  probe_target_check_group=$3
  probe_decimal_id_is_safe "$probe_target_check_pid" || return 1
  probe_process_identity "$probe_target_check_pid" || return 1
  [ "$probe_identity_pid_value" = "$probe_target_check_pid" ] \
    && [ "$probe_identity_parent_value" = "$probe_target_check_parent" ] \
    && [ "$probe_identity_group_value" = "$probe_target_check_group" ] \
    && [ "$probe_identity_session_value" = "$probe_target_check_group" ]
}

probe_atomic_record() {
  probe_record_target=$1
  probe_record_content=$2
  probe_record_tmp=$probe_record_target.tmp.$$
  (umask 077 && printf '%s\n' "$probe_record_content" >"$probe_record_tmp") \
    || return 1
  mv -f "$probe_record_tmp" "$probe_record_target"
}

record_probe_test_audit() {
  [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] || return 0
  probe_audit_path=${DOTFILES_BOOTSTRAP_TEST_PROBE_AUDIT_FILE:-}
  [ -n "$probe_audit_path" ] || return 0
  case "$probe_audit_path" in
    /*) ;;
    *) return 1 ;;
  esac
  probe_record_is_safe "$probe_audit_path" || return 1
  printf '%s\n' "$1" >>"$probe_audit_path"
}

probe_wait_for_record() {
  probe_wait_path=$1
  probe_wait_attempt=0
  while [ "$probe_wait_attempt" -lt 40 ]; do
    [ -e "$probe_wait_path" ] && return 0
    sleep 0.05
    probe_wait_attempt=$((probe_wait_attempt + 1))
  done
  return 1
}

write_probe_helper_scripts() {
  probe_helper_root=$1
  active_probe_supervisor=$probe_helper_root/supervisor
  active_probe_target_wrapper=$probe_helper_root/target-wrapper

  cat >"$active_probe_target_wrapper" <<'PROBE_TARGET_WRAPPER'
#!/bin/sh
set -u
probe_root=$1
probe_anchor_pid=$2
probe_stdin=$3
probe_stdout=$4
probe_stderr=$5
shift 5
trap - HUP INT TERM

atomic_record() {
  record_target=$1
  record_content=$2
  record_tmp=$record_target.tmp.$$
  (umask 077 && printf '%s\n' "$record_content" >"$record_tmp") || exit 121
  mv -f "$record_tmp" "$record_target" || exit 121
}

case ${DOTFILES_BOOTSTRAP_TEST_PROBE_HANDSHAKE:-} in
  malformed-target) atomic_record "$probe_root/target.ready" 'malformed-target' ;;
  *) atomic_record "$probe_root/target.ready" "$$|$PPID" ;;
esac

target_ack_expected=$$\|$probe_anchor_pid
target_ack_attempt=0
while [ "$target_ack_attempt" -lt 120 ]; do
  [ ! -e "$probe_root/cancel.ready" ] || exit 122
  if [ -e "$probe_root/target.ack" ]; then
    target_ack=$(cat "$probe_root/target.ack") || exit 123
    [ "$target_ack" = "$target_ack_expected" ] || exit 124
    exec "$@" <"$probe_stdin" >"$probe_stdout" 2>"$probe_stderr"
    exit 125
  fi
  sleep 0.05
  target_ack_attempt=$((target_ack_attempt + 1))
done
exit 126
PROBE_TARGET_WRAPPER

  cat >"$active_probe_supervisor" <<'PROBE_SUPERVISOR'
#!/bin/sh
set -u
probe_root=$1
target_wrapper=$2
probe_env=$3
probe_release_fifo=$4
probe_stdin=$5
probe_stdout=$6
probe_stderr=$7
shift 7
trap '' HUP INT TERM

atomic_record() {
  record_target=$1
  record_content=$2
  record_tmp=$record_target.tmp.$$
  (umask 077 && printf '%s\n' "$record_content" >"$record_tmp") || exit 111
  mv -f "$record_tmp" "$record_target" || exit 111
}

wait_for_release() {
  exec 5<"$probe_release_fifo" || exit 117
  exec 4>&-
  atomic_record "$probe_root/release.ready" release
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_STOP_AFTER_RELEASE_READY:-0}" = 1 ]; then
    kill -STOP "$$"
  fi
  probe_release_token=
  IFS= read -r probe_release_token <&5 || exit 118
  exec 5<&-
  [ "$probe_release_token" = release ] || exit 119
}

case ${DOTFILES_BOOTSTRAP_TEST_PROBE_HANDSHAKE:-} in
  missing-anchor) ;;
  malformed-anchor) atomic_record "$probe_root/anchor.ready" 'malformed-anchor' ;;
  *) atomic_record "$probe_root/anchor.ready" "$$|$PPID" ;;
esac

anchor_ack_expected=$$\|$PPID
anchor_ack_attempt=0
anchor_acknowledged=false
while [ "$anchor_ack_attempt" -lt 120 ]; do
  [ ! -e "$probe_root/cancel.ready" ] || exit 112
  if [ -e "$probe_root/anchor.ack" ]; then
    anchor_ack=$(cat "$probe_root/anchor.ack") || exit 113
    [ "$anchor_ack" = "$anchor_ack_expected" ] || exit 114
    anchor_acknowledged=true
    break
  fi
  sleep 0.05
  anchor_ack_attempt=$((anchor_ack_attempt + 1))
done
[ "$anchor_acknowledged" = true ] || exit 115

if [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_HANDSHAKE:-}" = missing-target ]; then
  wait_for_release
  exit 116
fi

"$probe_env" --default-signal=HUP,INT,TERM \
  "$target_wrapper" "$probe_root" "$$" \
  "$probe_stdin" "$probe_stdout" "$probe_stderr" "$@" &
probe_target_pid=$!
probe_target_status=0
wait "$probe_target_pid" || probe_target_status=$?
case ${DOTFILES_BOOTSTRAP_TEST_PROBE_HANDSHAKE:-} in
  missing-status) ;;
  malformed-status) atomic_record "$probe_root/status.ready" 'malformed-status' ;;
  *) atomic_record "$probe_root/status.ready" "$probe_target_pid|$probe_target_status" ;;
esac
wait_for_release
exit 0
PROBE_SUPERVISOR

  chmod 0755 "$active_probe_supervisor" "$active_probe_target_wrapper"
}

clear_active_probe_state() {
  active_probe_tmp=
  active_probe_waiter_pid=
  active_probe_anchor_pid=
  active_probe_anchor_parent=
  active_probe_group_id=
  active_probe_target_pid=
  active_probe_acknowledged=false
  active_probe_target_acknowledged=false
  active_probe_fifo=
  active_probe_release_fifo=
  active_probe_release_fd_open=false
  active_probe_supervisor=
  active_probe_target_wrapper=
  active_probe_wait_in_progress=false
  active_probe_wait_interrupted=false
  last_probe_waiter_status_available=false
  last_probe_waiter_status=
}

close_active_probe_release_fd() {
  if [ "$active_probe_release_fd_open" = true ]; then
    exec 4>&-
    active_probe_release_fd_open=false
  fi
}

send_active_probe_release_token() {
  probe_release_send_status=0
  if [ "$active_probe_release_fd_open" = true ]; then
    printf '%s\n' release >&4 || probe_release_send_status=1
    close_active_probe_release_fd
  fi
  return "$probe_release_send_status"
}

wait_for_owned_probe_waiter() {
  probe_owned_waiter_pid=$1
  probe_wait_candidate=
  probe_wait_candidate_available=false
  probe_wait_audit_status=0
  last_probe_waiter_status_available=false
  last_probe_waiter_status=

  while :; do
    active_probe_wait_interrupted=false
    active_probe_wait_in_progress=true
    record_probe_test_audit "wait-attempt|$probe_owned_waiter_pid" \
      || probe_wait_audit_status=1
    probe_wait_status=0
    wait "$probe_owned_waiter_pid" || probe_wait_status=$?
    active_probe_wait_in_progress=false

    if [ "$active_probe_wait_interrupted" = true ]; then
      record_probe_test_audit "wait-interrupted|$probe_owned_waiter_pid" \
        || probe_wait_audit_status=1
      if [ "$probe_wait_status" -ne 127 ]; then
        probe_wait_candidate=$probe_wait_status
        probe_wait_candidate_available=true
      fi
      if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
        && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_STOP_BETWEEN_WAITS:-0}" = 1 ]; then
        kill -STOP "$$"
      fi
      continue
    fi

    if [ "$probe_wait_status" -eq 127 ] \
      && [ "$probe_wait_candidate_available" = true ]; then
      probe_wait_status=$probe_wait_candidate
    fi
    last_probe_waiter_status_available=true
    last_probe_waiter_status=$probe_wait_status
    record_probe_test_audit \
      "waiter-status|$probe_owned_waiter_pid|$last_probe_waiter_status" \
      || probe_wait_audit_status=1
    return "$probe_wait_audit_status"
  done
}

cancel_unacknowledged_probe() {
  if [ -n "$active_probe_tmp" ] && [ -d "$active_probe_tmp" ]; then
    probe_atomic_record "$active_probe_tmp/cancel.ready" cancel >/dev/null 2>&1 \
      || true
  fi
  send_active_probe_release_token || true
  if [ -n "$active_probe_waiter_pid" ]; then
    wait_for_owned_probe_waiter "$active_probe_waiter_pid" || true
  fi
  if [ -n "$active_probe_tmp" ] && [ -d "$active_probe_tmp" ]; then
    remove_temporary_directory "$active_probe_tmp"
  fi
  clear_active_probe_state
}

probe_group_has_non_anchor_member() {
  probe_group_check_id=$1
  probe_group_check_anchor=$2
  probe_group_processes=$(ps -e -o pid= -o pgid= 2>/dev/null) || return 0
  printf '%s\n' "$probe_group_processes" | awk \
    -v group_id="$probe_group_check_id" \
    -v anchor_pid="$probe_group_check_anchor" '
      $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ \
        && $2 == group_id && $1 != anchor_pid { found = 1 }
      END { exit !found }
    '
}

snapshot_probe_status_before_term() {
  last_probe_status_available=false
  last_probe_status=
  [ -n "$active_probe_tmp" ] || return 1
  [ "$active_probe_target_acknowledged" = true ] || return 0
  [ -e "$active_probe_tmp/status.ready" ] || return 0
  if ! read_probe_pair_record "$active_probe_tmp/status.ready" \
    || [ "$probe_record_first" != "$active_probe_target_pid" ] \
    || [ "$probe_record_second" -gt 255 ]; then
    printf '%s\n' 'bootstrap: malformed probe target status record' >&2
    return 1
  fi
  last_probe_status_available=true
  last_probe_status=$probe_record_second
  record_probe_test_audit \
    "status-before-term|$active_probe_target_pid|$last_probe_status" \
    || return 1
  return 0
}

stop_owned_probe() {
  if [ "$probe_cleanup_active" = true ]; then
    printf '%s\n' 'bootstrap: refusing recursive probe cleanup' >&2
    return 1
  fi
  probe_cleanup_active=true
  probe_cleanup_status=0
  probe_cleanup_owns_deferral=false
  probe_cleanup_graceful_release=false
  if [ "$cleanup_registration_critical" = false ]; then
    cleanup_registration_critical=true
    probe_cleanup_owns_deferral=true
  fi

  exec 3>&-
  snapshot_probe_status_before_term || probe_cleanup_status=1

  if [ "$active_probe_acknowledged" = true ] \
    && [ -n "$active_probe_anchor_pid" ]; then
    if probe_anchor_identity_is_valid \
      "$active_probe_anchor_pid" "$active_probe_anchor_parent"; then
      if probe_group_has_non_anchor_member \
        "$active_probe_group_id" "$active_probe_anchor_pid"; then
        record_probe_test_audit "group-term|$active_probe_group_id" \
          || probe_cleanup_status=1
        kill -TERM "-$active_probe_group_id" >/dev/null 2>&1 \
          || probe_cleanup_status=1
      fi
      if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
        && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_SIGNAL_AT:-}" = teardown ]; then
        record_probe_test_audit 'teardown-signal|TERM' \
          || probe_cleanup_status=1
        kill -TERM "$$"
      fi

      probe_group_grace_attempt=0
      while [ "$probe_group_grace_attempt" -lt 20 ] \
        && probe_group_has_non_anchor_member \
          "$active_probe_group_id" "$active_probe_anchor_pid"
      do
        sleep 0.05
        probe_group_grace_attempt=$((probe_group_grace_attempt + 1))
      done

      if probe_group_has_non_anchor_member \
        "$active_probe_group_id" "$active_probe_anchor_pid"; then
        if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
          && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_LOSE_ANCHOR_BEFORE_KILL:-0}" = 1 ]; then
          probe_loss_release=${DOTFILES_BOOTSTRAP_TEST_PROBE_LOSS_RELEASE_FILE:-}
          case "$probe_loss_release" in
            /*) : >"$probe_loss_release" ;;
          esac
          kill -KILL "$active_probe_anchor_pid" >/dev/null 2>&1 || true
          sleep 0.05
        fi
        if probe_anchor_identity_is_valid \
          "$active_probe_anchor_pid" "$active_probe_anchor_parent"; then
          record_probe_test_audit "group-kill|$active_probe_group_id" \
            || probe_cleanup_status=1
          kill -KILL "-$active_probe_group_id" >/dev/null 2>&1 \
            || probe_cleanup_status=1
        else
          printf '%s\n' \
            'bootstrap: probe anchor disappeared before forced group cleanup' >&2
          probe_cleanup_status=1
        fi
      else
        if ! probe_wait_for_record "$active_probe_tmp/release.ready"; then
          printf '%s\n' \
            'bootstrap: probe supervisor did not become ready for release' >&2
          probe_cleanup_status=1
          if probe_anchor_identity_is_valid \
            "$active_probe_anchor_pid" "$active_probe_anchor_parent"; then
            record_probe_test_audit "group-kill|$active_probe_group_id" \
              || probe_cleanup_status=1
            kill -KILL "-$active_probe_group_id" >/dev/null 2>&1 \
              || probe_cleanup_status=1
          fi
        elif probe_anchor_identity_is_valid \
          "$active_probe_anchor_pid" "$active_probe_anchor_parent"; then
          if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
            && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_LOSE_ANCHOR_BEFORE_RELEASE_TOKEN:-0}" = 1 ]; then
            record_probe_test_audit \
              "anchor-loss-before-release|$active_probe_anchor_pid" \
              || probe_cleanup_status=1
            kill -KILL "$active_probe_anchor_pid" >/dev/null 2>&1 || true
            sleep 0.05
          fi
          send_active_probe_release_token || probe_cleanup_status=1
          probe_cleanup_graceful_release=true
        else
          printf '%s\n' \
            'bootstrap: probe anchor disappeared before release' >&2
          probe_cleanup_status=1
        fi
      fi
    else
      printf '%s\n' \
        'bootstrap: probe anchor identity changed before group cleanup' >&2
      probe_cleanup_status=1
    fi
    if [ "$probe_cleanup_graceful_release" != true ]; then
      close_active_probe_release_fd
    fi
    if [ -n "$active_probe_waiter_pid" ]; then
      wait_for_owned_probe_waiter "$active_probe_waiter_pid" \
        || probe_cleanup_status=1
      if [ "$probe_cleanup_graceful_release" = true ] \
        && { [ "$last_probe_waiter_status_available" != true ] \
          || [ "$last_probe_waiter_status" -ne 0 ]; }; then
        probe_cleanup_status=1
      fi
    fi
  else
    cancel_unacknowledged_probe
  fi

  probe_cleanup_tmp=$active_probe_tmp
  clear_active_probe_state
  if [ -n "$probe_cleanup_tmp" ] && [ -d "$probe_cleanup_tmp" ]; then
    remove_temporary_directory "$probe_cleanup_tmp"
  fi
  probe_cleanup_active=false
  if [ "$probe_cleanup_owns_deferral" = true ]; then
    cleanup_registration_critical=false
    replay_pending_transaction_signal
  fi
  return "$probe_cleanup_status"
}

start_owned_probe() {
  probe_start_mode=$1
  shift
  if ! debian_probe_runtime_is_ready; then
    require_debian_probe_runtime || return 1
  fi
  begin_cleanup_registration_critical
  active_probe_tmp=$(temporary_directory) || {
    finish_cleanup_registration_critical
    return 1
  }
  if [ -n "$pending_transaction_signal_name" ]; then
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi
  active_probe_waiter_pid=
  active_probe_anchor_pid=
  active_probe_anchor_parent=
  active_probe_group_id=
  active_probe_target_pid=
  active_probe_acknowledged=false
  active_probe_target_acknowledged=false
  active_probe_fifo=
  active_probe_release_fifo=
  active_probe_release_fd_open=false
  if ! write_probe_helper_scripts "$active_probe_tmp"; then
    printf '%s\n' 'bootstrap: could not create private probe helpers' >&2
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi

  active_probe_release_fifo=$active_probe_tmp/release
  mkfifo "$active_probe_release_fifo" || {
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  }
  if ! exec 4<>"$active_probe_release_fifo"; then
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi
  active_probe_release_fd_open=true
  if [ -n "$pending_transaction_signal_name" ]; then
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi

  probe_start_stdin=/dev/null
  probe_start_stdout=/dev/null
  probe_start_stderr=/dev/null
  if [ "$probe_start_mode" = stdio ]; then
    active_probe_fifo=$active_probe_tmp/stdin
    mkfifo "$active_probe_fifo" || {
      cancel_unacknowledged_probe
      finish_cleanup_registration_critical
      return 1
    }
    probe_start_stdin=$active_probe_fifo
    probe_start_stdout=$active_probe_tmp/stdout
    probe_start_stderr=$active_probe_tmp/stderr
  elif [ "$probe_start_mode" = capture ]; then
    probe_start_stdout=$active_probe_tmp/stdout
  fi

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    DOTFILES_BOOTSTRAP_TEST_PROBE_OWNER_PID=$$
    export DOTFILES_BOOTSTRAP_TEST_PROBE_OWNER_PID
  fi

  "$debian_probe_setsid_command" -f -w "$active_probe_supervisor" \
    "$active_probe_tmp" "$active_probe_target_wrapper" \
    "$debian_probe_env_command" "$active_probe_release_fifo" \
    "$probe_start_stdin" "$probe_start_stdout" "$probe_start_stderr" \
    "$@" &
  active_probe_waiter_pid=$!
  if [ -n "$pending_transaction_signal_name" ]; then
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi

  if ! probe_wait_for_record "$active_probe_tmp/anchor.ready" \
    || ! read_probe_pair_record "$active_probe_tmp/anchor.ready" \
    || ! probe_anchor_identity_is_valid \
      "$probe_record_first" "$probe_record_second" \
    || [ "$probe_record_second" != "$active_probe_waiter_pid" ]; then
    printf '%s\n' 'bootstrap: probe anchor handshake failed closed' >&2
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi
  active_probe_anchor_pid=$probe_record_first
  active_probe_anchor_parent=$probe_record_second
  active_probe_group_id=$probe_record_first

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_SIGNAL_AT:-}" = before-anchor-ack ]; then
    kill -TERM "$$"
  fi
  if [ -n "$pending_transaction_signal_name" ]; then
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  fi

  probe_anchor_ack=$active_probe_anchor_pid\|$active_probe_waiter_pid
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_PROBE_HANDSHAKE:-}" = malformed-anchor-ack ]; then
    probe_anchor_ack=malformed-anchor-ack
  fi
  probe_atomic_record "$active_probe_tmp/anchor.ack" "$probe_anchor_ack" || {
    cancel_unacknowledged_probe
    finish_cleanup_registration_critical
    return 1
  }
  if [ "$probe_anchor_ack" \
    = "$active_probe_anchor_pid|$active_probe_waiter_pid" ]; then
    active_probe_acknowledged=true
  fi

  if ! probe_wait_for_record "$active_probe_tmp/target.ready" \
    || ! read_probe_pair_record "$active_probe_tmp/target.ready" \
    || [ "$probe_record_second" != "$active_probe_anchor_pid" ] \
    || ! probe_target_identity_is_valid \
      "$probe_record_first" "$active_probe_anchor_pid" \
      "$active_probe_group_id"; then
    printf '%s\n' 'bootstrap: probe target handshake failed closed' >&2
    stop_owned_probe || true
    finish_cleanup_registration_critical
    return 1
  fi
  active_probe_target_pid=$probe_record_first
  probe_target_ack=$active_probe_target_pid\|$active_probe_anchor_pid
  probe_atomic_record "$active_probe_tmp/target.ack" "$probe_target_ack" || {
    stop_owned_probe || true
    finish_cleanup_registration_critical
    return 1
  }
  active_probe_target_acknowledged=true
  finish_cleanup_registration_critical

  if [ "$probe_start_mode" = stdio ]; then
    exec 3>"$active_probe_fifo" || {
      stop_owned_probe || true
      return 1
    }
  fi
  return 0
}

bounded_command_succeeds() {
  start_owned_probe bounded "$@" || return 1
  sleep 1
  bounded_probe_cleanup_status=0
  stop_owned_probe || bounded_probe_cleanup_status=$?
  [ "$bounded_probe_cleanup_status" -eq 0 ] \
    && [ "$last_probe_status_available" = true ] \
    && [ "$last_probe_status" -eq 0 ]
}

bounded_command_output() {
  bounded_probe_output=
  start_owned_probe capture "$@" || return 1
  sleep 1
  bounded_probe_cleanup_status=0
  bounded_probe_output=$(cat "$active_probe_tmp/stdout") \
    || bounded_probe_cleanup_status=1
  stop_owned_probe || bounded_probe_cleanup_status=1
  [ "$bounded_probe_cleanup_status" -eq 0 ] \
    && [ "$last_probe_status_available" = true ] \
    && [ "$last_probe_status" -eq 0 ]
}

replay_pending_transaction_signal() {
  [ -n "$pending_transaction_signal_name" ] || return 0
  replayed_signal_name=$pending_transaction_signal_name
  replayed_signal_code=$pending_transaction_signal_code
  trap '' HUP INT TERM
  pending_transaction_signal_name=
  pending_transaction_signal_code=
  exit_for_transaction_signal "$replayed_signal_name" "$replayed_signal_code"
}

begin_cleanup_registration_critical() {
  [ "$cleanup_registration_critical" = false ] \
    || die 'cleanup registration critical section is already active'
  cleanup_registration_critical=true
}

finish_cleanup_registration_critical() {
  [ "$cleanup_registration_critical" = true ] \
    || die 'cleanup registration critical section is not active'
  cleanup_registration_critical=false
  replay_pending_transaction_signal
}

stdio_server_is_satisfied() {
  stdio_command=$1
  shift

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_SATISFIED_TOOLS+x}" = x ]; then
    case ",${DOTFILES_BOOTSTRAP_TEST_SATISFIED_TOOLS}," in
      *,"$stdio_command",*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_ALL_PACKAGES_MISSING:-0}" = 1 ]; then
    return 1
  fi

  command -v "$stdio_command" >/dev/null 2>&1 || return 1
  start_owned_probe stdio "$stdio_command" "$@" || return 1
  sleep 1
  if [ ! -e "$active_probe_tmp/status.ready" ] \
    && probe_target_identity_is_valid \
      "$active_probe_target_pid" "$active_probe_anchor_pid" \
      "$active_probe_group_id"; then
    stdio_probe_result=0
  else
    stdio_probe_result=1
  fi
  stdio_probe_cleanup_status=0
  stop_owned_probe || stdio_probe_cleanup_status=$?
  [ "$stdio_probe_result" -eq 0 ] \
    && [ "$stdio_probe_cleanup_status" -eq 0 ]
}

stable_taplo_version() {
  taplo_version_command=$1
  "$taplo_version_command" --version 2>/dev/null | awk '
    NR == 1 {
      if (NF == 2 && $1 == "taplo" \
        && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/) {
        version = $2
      } else {
        invalid = 1
      }
      next
    }
    { invalid = 1 }
    END {
      if (!invalid && NR == 1) print version
    }
  '
}

language_server_is_satisfied() {
  language_server_command=$1
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_SATISFIED_TOOLS+x}" = x ]; then
    case ",${DOTFILES_BOOTSTRAP_TEST_SATISFIED_TOOLS}," in
      *,"$language_server_command",*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  case "$language_server_command" in
    bash-language-server)
      tool_is_satisfied bash-language-server 5.6.0
      ;;
    vscode-json-language-server)
      stdio_server_is_satisfied vscode-json-language-server --stdio
      ;;
    lua-language-server)
      tool_is_satisfied lua-language-server 3.19.1
      ;;
    pyright-langserver)
      stdio_server_is_satisfied pyright-langserver --stdio || return 1
      if command -v pyright >/dev/null 2>&1; then
        pyright_version=$(command_version pyright)
        if [ -n "$pyright_version" ] \
          && ! version_at_least "$pyright_version" 1.1.411; then
          return 1
        fi
      fi
      ;;
    taplo)
      taplo_command=$(command -v taplo) || return 1
      taplo_version=$(stable_taplo_version "$taplo_command")
      [ -n "$taplo_version" ] || return 1
      version_at_least "$taplo_version" 0.10.0 || return 1
      bounded_command_succeeds "$taplo_command" lsp stdio --help
      ;;
    yaml-language-server)
      tool_is_satisfied yaml-language-server 1.24.0
      ;;
    *) return 1 ;;
  esac
}

normalized_architecture() {
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ -n "${DOTFILES_BOOTSTRAP_TEST_ARCH:-}" ]; then
    machine=$DOTFILES_BOOTSTRAP_TEST_ARCH
  else
    machine=$(uname -m)
  fi
  case "$machine" in
    x86_64|amd64) printf '%s\n' x86_64 ;;
    arm64|aarch64) printf '%s\n' arm64 ;;
    *) die "unsupported architecture: $machine" ;;
  esac
}

temporary_directory() {
  temporary_base=${TMPDIR:-/tmp}
  case "$temporary_base" in
    /) die 'refusing to create bootstrap temporary data in the filesystem root' ;;
    /*) ;;
    *) die 'TMPDIR must be an absolute path when set' ;;
  esac
  temporary_base=${temporary_base%/}
  mktemp -d "$temporary_base/dotfiles-bootstrap.XXXXXX" \
    || die 'could not create a private temporary directory'
}

remove_temporary_directory() {
  temporary_path=$1
  cleanup_temporary_base=${TMPDIR:-/tmp}
  cleanup_temporary_base=${cleanup_temporary_base%/}
  case "$temporary_path" in
    "$cleanup_temporary_base"/dotfiles-bootstrap.*) rm -rf "$temporary_path" ;;
    *) die "refusing to remove unexpected temporary path: $temporary_path" ;;
  esac
}

file_sha256() {
  checksum_path=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$checksum_path" | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$checksum_path" | awk '{ print $1 }'
  else
    die 'sha256sum or shasum is required to verify downloads'
  fi
}

download_verified() {
  download_url=$1
  expected_sha256=$2
  destination=$3

  case "$expected_sha256" in
    *[!0-9a-f]*|'') die "invalid SHA-256 for $download_url" ;;
  esac
  [ "${#expected_sha256}" -eq 64 ] || die "invalid SHA-256 length for $download_url"

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ -n "${DOTFILES_BOOTSTRAP_TEST_DOWNLOAD_ROOT:-}" ]; then
    case "$DOTFILES_BOOTSTRAP_TEST_DOWNLOAD_ROOT" in
      /*) ;;
      *) die 'DOTFILES_BOOTSTRAP_TEST_DOWNLOAD_ROOT must be absolute' ;;
    esac
    download_name=${download_url##*/}
    case "$download_name" in
      ''|.|..|*/*) die "unsafe test download basename: $download_name" ;;
    esac
    test_download_source=$DOTFILES_BOOTSTRAP_TEST_DOWNLOAD_ROOT/$download_name
    [ -f "$test_download_source" ] \
      || die "missing test download source: $test_download_source"
    cp "$test_download_source" "$destination" \
      || die "could not copy test download source: $download_name"
    record_test_command download "$download_url"
  else
    curl --fail --location --show-error --silent --output "$destination" -- "$download_url" \
      || die "download failed: $download_url"
  fi
  actual_sha256=$(file_sha256 "$destination")
  [ "$actual_sha256" = "$expected_sha256" ] \
    || die "checksum mismatch for $download_url"
}

archive_member_list_is_safe() {
  member_list=$1
  allowed_root=$2
  awk -v root="$allowed_root" '
    function reject() { invalid = 1 }
    /^\// { reject(); next }
    {
      path = $0
      sub(/\/$/, "", path)
      count = split(path, component, "/")
      for (part_index = 1; part_index <= count; part_index++) {
        if (component[part_index] == "..") reject()
      }
      if (root != "" && path != root && index(path, root "/") != 1) reject()
    }
    END { exit invalid }
  ' "$member_list"
}

maybe_fail_rishot_publication() {
  rishot_failure_token=$1
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_RISHOT_FAIL_AFTER:-}" \
      = "$rishot_failure_token" ]; then
    die "forced Rishot publication failure after $rishot_failure_token"
  fi
}

ensure_rishot_parent_directory() {
  rishot_parent_path=$1
  rishot_parent_label=$2
  if [ -e "$rishot_parent_path" ] || [ -L "$rishot_parent_path" ]; then
    [ -d "$rishot_parent_path" ] && [ ! -L "$rishot_parent_path" ] \
      || die "$rishot_parent_label must be a real directory"
    return 0
  fi
  mkdir "$rishot_parent_path" \
    || die "could not create $rishot_parent_label"
}

require_rishot_parent_directory_or_absent() {
  rishot_parent_path=$1
  rishot_parent_label=$2
  if [ -e "$rishot_parent_path" ] || [ -L "$rishot_parent_path" ]; then
    [ -d "$rishot_parent_path" ] && [ ! -L "$rishot_parent_path" ] \
      || die "$rishot_parent_label must be a real directory"
  fi
}

prepare_rishot_paths() {
  require_rishot_parent_directory_or_absent "$HOME/.local" \
    'the Rishot local-data parent'
  require_rishot_parent_directory_or_absent "$HOME/.local/bin" \
    'the Rishot launcher parent'
  require_rishot_parent_directory_or_absent "$HOME/.local/share" \
    'the Rishot installation parent'
  require_rishot_targets_free
  ensure_rishot_parent_directory "$HOME/.local" \
    'the Rishot local-data parent'
  ensure_rishot_parent_directory "$HOME/.local/bin" \
    'the Rishot launcher parent'
  ensure_rishot_parent_directory "$HOME/.local/share" \
    'the Rishot installation parent'
  require_rishot_targets_free
}

require_rishot_targets_free() {
  rishot_required_target=$HOME/.local/share/rishot
  rishot_required_link=$HOME/.local/bin/rishot
  [ ! -e "$rishot_required_target" ] && [ ! -L "$rishot_required_target" ] \
    || die "refusing to replace existing direct-tool target: $rishot_required_target"
  [ ! -e "$rishot_required_link" ] && [ ! -L "$rishot_required_link" ] \
    || die "refusing to replace existing direct-tool target: $rishot_required_link"
}

cleanup_active_rishot_publication() {
  rishot_cleanup_status=0

  if [ -n "$active_rishot_link" ]; then
    if [ "$active_rishot_link" != "$HOME/.local/bin/rishot" ] \
      || [ ! -L "$active_rishot_link" ] \
      || [ "$(stat -c '%d:%i:%u:%a' "$active_rishot_link" \
        2>/dev/null || true)" != "$active_rishot_link_identity" ] \
      || [ "$(readlink "$active_rishot_link" 2>/dev/null || true)" \
        != "$HOME/.local/share/rishot/bin/rishot" ]; then
      printf 'bootstrap: refusing Rishot launcher cleanup: %s\n' \
        "$active_rishot_link" >&2
      rishot_cleanup_status=1
    else
      rm -f -- "$active_rishot_link" || rishot_cleanup_status=1
    fi
  fi

  if [ -n "$active_rishot_directory" ]; then
    case "$active_rishot_directory" in
      "$HOME/.local/share/rishot") ;;
      "$HOME/.local/share/.rishot-stage."*)
        rishot_stage_suffix=${active_rishot_directory##*.rishot-stage.}
        case "$rishot_stage_suffix" in
          ''|*[!A-Za-z0-9]*) rishot_cleanup_status=1 ;;
        esac
        ;;
      *) rishot_cleanup_status=1 ;;
    esac
    if [ "$rishot_cleanup_status" -eq 0 ]; then
      if [ ! -d "$active_rishot_directory" ] \
        || [ -L "$active_rishot_directory" ] \
        || [ "$(stat -c '%d:%i:%u:%a' "$active_rishot_directory" \
          2>/dev/null || true)" != "$active_rishot_directory_identity" ]; then
        printf 'bootstrap: refusing Rishot directory cleanup: %s\n' \
          "$active_rishot_directory" >&2
        rishot_cleanup_status=1
      else
        rm -rf -- "$active_rishot_directory" \
          || rishot_cleanup_status=1
      fi
    else
      printf 'bootstrap: refusing Rishot directory cleanup: %s\n' \
        "$active_rishot_directory" >&2
    fi
  fi

  return "$rishot_cleanup_status"
}

publish_rishot_tree() {
  rishot_publish_source=$1
  rishot_publish_target=$2
  rishot_publish_link=$3
  rishot_publish_parent=$(dirname "$rishot_publish_target")
  rishot_stage_record=$active_package_tmp/rishot-stage.path
  : >"$rishot_stage_record" \
    || die 'could not initialize the Rishot staging record'

  begin_cleanup_registration_critical
  if ! mktemp -d "$rishot_publish_parent/.rishot-stage.XXXXXX" \
    >"$rishot_stage_record"; then
    finish_cleanup_registration_critical
    die 'could not create same-filesystem Rishot staging directory'
  fi
  IFS= read -r rishot_publish_stage <"$rishot_stage_record" || {
    finish_cleanup_registration_critical
    die 'could not read the Rishot staging directory'
  }
  case "$rishot_publish_stage" in
    "$rishot_publish_parent/.rishot-stage."*) ;;
    *)
      finish_cleanup_registration_critical
      die 'Rishot staging directory has an unexpected path'
      ;;
  esac
  active_rishot_directory=$rishot_publish_stage
  active_rishot_directory_identity=$(stat -c '%d:%i:%u:%a' \
    "$active_rishot_directory") || {
    finish_cleanup_registration_critical
    die 'could not identify the Rishot staging directory'
  }
  finish_cleanup_registration_critical
  maybe_fail_rishot_publication stage

  cp -R "$rishot_publish_source/." "$rishot_publish_stage/" \
    || die 'could not populate the Rishot staging directory'
  [ -x "$rishot_publish_stage/bin/rishot" ] \
    && [ -f "$rishot_publish_stage/src/shell.qml" ] \
    && [ ! -L "$rishot_publish_stage/src/shell.qml" ] \
    || die 'staged Rishot tree failed publication validation'

  begin_cleanup_registration_critical
  if ! mv --no-clobber --no-target-directory \
    "$rishot_publish_stage" "$rishot_publish_target"; then
    finish_cleanup_registration_critical
    die 'could not publish the verified Rishot directory'
  fi
  if [ -e "$rishot_publish_stage" ] || [ -L "$rishot_publish_stage" ]; then
    finish_cleanup_registration_critical
    die 'Rishot installation target appeared during publication'
  fi
  [ "$(stat -c '%d:%i:%u:%a' "$rishot_publish_target" \
      2>/dev/null || true)" = "$active_rishot_directory_identity" ] || {
    finish_cleanup_registration_critical
    die 'published Rishot directory identity changed unexpectedly'
  }
  active_rishot_directory=$rishot_publish_target
  finish_cleanup_registration_critical
  maybe_fail_rishot_publication directory

  begin_cleanup_registration_critical
  if ! ln -s "$rishot_publish_target/bin/rishot" "$rishot_publish_link"; then
    finish_cleanup_registration_critical
    die 'could not publish the verified Rishot launcher'
  fi
  active_rishot_link=$rishot_publish_link
  active_rishot_link_identity=$(stat -c '%d:%i:%u:%a' \
    "$active_rishot_link") || {
    finish_cleanup_registration_critical
    die 'could not identify the published Rishot launcher'
  }
  finish_cleanup_registration_critical
  maybe_fail_rishot_publication launcher

  active_rishot_link=
  active_rishot_link_identity=
  active_rishot_directory=
  active_rishot_directory_identity=
}

lua_archive_roots_are_exact() {
  member_list=$1
  awk '
    {
      path = $0
      sub(/\/$/, "", path)
      split(path, component, "/")
      top = component[1]
      if (top == "LICENSE" || top == "bin" || top == "changelog.md" \
        || top == "debugger.lua" || top == "locale" || top == "main.lua" \
        || top == "meta" || top == "script") {
        seen[top] = 1
      } else {
        invalid = 1
      }
    }
    END {
      required[1] = "LICENSE"
      required[2] = "bin"
      required[3] = "changelog.md"
      required[4] = "debugger.lua"
      required[5] = "locale"
      required[6] = "main.lua"
      required[7] = "meta"
      required[8] = "script"
      for (root_index = 1; root_index <= 8; root_index++) {
        if (!seen[required[root_index]]) invalid = 1
      }
      exit invalid
    }
  ' "$member_list"
}

installer_record() {
  installer_name=$1
  manifest_file=$2
  awk -F '\t' -v name="$installer_name" '
    $0 !~ /^#/ && $1 == name { print $2 "\t" $3 "\t" $4; found = 1 }
    END { if (!found) exit 1 }
  ' "$manifest_file" || die "missing installer manifest entry: $installer_name"
}

run_pinned_installer() {
  installer_name=$1
  manifest_file=$2
  installer_data=$(installer_record "$installer_name" "$manifest_file")
  old_ifs=$IFS
  tab_character=$(printf '\t')
  IFS=$tab_character
  set -f
  # shellcheck disable=SC2086 # Intentional split on the verified manifest tab delimiter.
  set -- $installer_data
  set +f
  IFS=$old_ifs
  [ "$#" -eq 3 ] || die "malformed installer manifest entry: $installer_name"
  installer_revision=$1
  installer_url=$2
  installer_sha256=$3
  case "$installer_revision" in
    *[!0-9a-f]*|'') die "invalid installer revision: $installer_name" ;;
  esac
  [ "${#installer_revision}" -eq 40 ] \
    || die "installer revision must be a full commit: $installer_name"
  case "$installer_url" in
    https://*) ;;
    *) die "installer URL must use HTTPS: $installer_name" ;;
  esac

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    record_test_command pinned-installer "$installer_name" "$installer_revision"
    return 0
  fi

  installer_tmp=$(temporary_directory) \
    || die 'could not create temporary installer storage'
  active_package_tmp=$installer_tmp
  installer_path=$installer_tmp/install.sh
  download_verified "$installer_url" "$installer_sha256" "$installer_path"
  if [ "$installer_name" = homebrew ]; then
    NONINTERACTIVE=1 /bin/bash "$installer_path"
  else
    /bin/bash "$installer_path"
  fi || {
    installer_status=$?
    remove_temporary_directory "$installer_tmp"
    active_package_tmp=
    return "$installer_status"
  }
  remove_temporary_directory "$installer_tmp"
  active_package_tmp=
}

direct_asset_record() {
  tool_name=$1
  selected_platform=$2
  selected_arch=$3
  manifest_file=$4

  awk -F '\t' -v tool="$tool_name" -v platform="$selected_platform" -v architecture="$selected_arch" '
    $0 !~ /^#/ && $1 == tool && $2 == platform && ($3 == architecture || $3 == "any") {
      print $4 "\t" $5 "\t" $6 "\t" $7
      found = 1
    }
    END { if (!found) exit 1 }
  ' "$manifest_file" || die "missing direct asset for $tool_name/$selected_platform/$selected_arch"
}

stage_node_runtime() {
  node_manifest_root=$1
  node_stage_root=$2
  node_asset_data=$(direct_asset_record \
    node linux "$managed_architecture" "$node_manifest_root/packages-direct.tsv")
  old_ifs=$IFS
  tab_character=$(printf '\t')
  IFS=$tab_character
  set -f
  # shellcheck disable=SC2086 # Intentional split on the verified manifest tab delimiter.
  set -- $node_asset_data
  set +f
  IFS=$old_ifs
  [ "$#" -eq 4 ] || die 'malformed direct asset entry: node'
  node_asset_version=$1
  node_asset_format=$2
  node_asset_url=$3
  node_asset_sha256=$4
  [ "$node_asset_version" = "$node_fallback_version" ] \
    || die 'unexpected managed Node version'
  [ "$node_asset_format" = tar.xz ] \
    || die 'unexpected managed Node archive format'
  case "$node_asset_url" in
    https://*) ;;
    *) die 'direct asset URL must use HTTPS: node' ;;
  esac
  case "$managed_architecture" in
    x86_64) node_archive_root=node-v$node_fallback_version-linux-x64 ;;
    arm64) node_archive_root=node-v$node_fallback_version-linux-arm64 ;;
    *) die "unsupported managed Node architecture: $managed_architecture" ;;
  esac

  node_asset_path=$node_stage_root/node.asset
  node_member_list=$node_stage_root/node.members
  download_verified "$node_asset_url" "$node_asset_sha256" "$node_asset_path"
  tar -tJf "$node_asset_path" >"$node_member_list" \
    || die 'could not list the verified Node archive'
  archive_member_list_is_safe "$node_member_list" "$node_archive_root" \
    || die 'verified Node archive contains an unsafe member'
  mkdir "$node_stage_root/node.extract" \
    || die 'could not create managed Node extraction directory'
  tar -xJf "$node_asset_path" -C "$node_stage_root/node.extract" \
    || die 'could not extract the verified Node archive'
  node_extracted_root=$node_stage_root/node.extract/$node_archive_root
  [ -x "$node_extracted_root/bin/node" ] \
    || die 'verified Node archive is missing executable bin/node'
  [ -x "$node_extracted_root/bin/npm" ] \
    || die 'verified Node archive is missing executable bin/npm'
  [ -f "$node_extracted_root/lib/node_modules/npm/bin/npm-cli.js" ] \
    || die 'verified Node archive is missing npm-cli.js'
  mv "$node_extracted_root" "$node_stage_root/node.ready" \
    || die 'could not stage the verified Node runtime'
  selected_node=$node_stage_root/node.ready/bin/node
  selected_npm=$node_stage_root/node.ready/bin/npm
  selected_node_version=$(command_version "$selected_node")
  [ "$selected_node_version" = "$node_fallback_version" ] \
    || die "staged Node version does not match $node_fallback_version"
  selected_npm_version=$(
    PATH="$node_stage_root/node.ready/bin:$PATH" \
      "$selected_npm" --version 2>/dev/null \
      | sed -n '1s/[^0-9]*\([0-9][0-9.]*\).*/\1/p'
  )
  [ "$selected_npm_version" = 11.17.0 ] \
    || die 'staged npm version does not match 11.17.0'
}

stage_lua_language_server() {
  lua_manifest_root=$1
  lua_stage_root=$2
  lua_asset_data=$(direct_asset_record \
    lua-language-server linux "$managed_architecture" \
    "$lua_manifest_root/packages-direct.tsv")
  old_ifs=$IFS
  tab_character=$(printf '\t')
  IFS=$tab_character
  set -f
  # shellcheck disable=SC2086 # Intentional split on the verified manifest tab delimiter.
  set -- $lua_asset_data
  set +f
  IFS=$old_ifs
  [ "$#" -eq 4 ] || die 'malformed direct asset entry: lua-language-server'
  lua_asset_version=$1
  lua_asset_format=$2
  lua_asset_url=$3
  lua_asset_sha256=$4
  [ "$lua_asset_version" = "$luals_fallback_version" ] \
    || die 'unexpected managed LuaLS version'
  [ "$lua_asset_format" = tar.gz ] \
    || die 'unexpected managed LuaLS archive format'
  case "$lua_asset_url" in
    https://*) ;;
    *) die 'direct asset URL must use HTTPS: lua-language-server' ;;
  esac

  lua_asset_path=$lua_stage_root/lua.asset
  lua_member_list=$lua_stage_root/lua.members
  download_verified "$lua_asset_url" "$lua_asset_sha256" "$lua_asset_path"
  tar -tzf "$lua_asset_path" >"$lua_member_list" \
    || die 'could not list the verified LuaLS archive'
  archive_member_list_is_safe "$lua_member_list" '' \
    || die 'verified LuaLS archive contains an unsafe member'
  lua_archive_roots_are_exact "$lua_member_list" \
    || die 'verified LuaLS archive has unexpected top-level content'
  mkdir "$lua_stage_root/lua.ready" \
    || die 'could not create managed LuaLS extraction directory'
  tar -xzf "$lua_asset_path" -C "$lua_stage_root/lua.ready" \
    || die 'could not extract the verified LuaLS archive'
  [ -x "$lua_stage_root/lua.ready/bin/lua-language-server" ] \
    || die 'verified LuaLS archive is missing executable bin/lua-language-server'
  [ -f "$lua_stage_root/lua.ready/bin/main.lua" ] \
    || die 'verified LuaLS archive is missing bin/main.lua'
  [ -f "$lua_stage_root/lua.ready/main.lua" ] \
    || die 'verified LuaLS archive is missing main.lua'
  [ -f "$lua_stage_root/lua.ready/debugger.lua" ] \
    || die 'verified LuaLS archive is missing debugger.lua'
  for lua_required_directory in locale meta script; do
    [ -d "$lua_stage_root/lua.ready/$lua_required_directory" ] \
      || die "verified LuaLS archive is missing $lua_required_directory"
  done
}

load_managed_taplo_record() {
  managed_taplo_manifest_root=$1
  managed_taplo_asset_data=$(direct_asset_record \
    taplo linux "$managed_architecture" \
    "$managed_taplo_manifest_root/packages-direct.tsv") || exit $?
  managed_taplo_old_ifs=$IFS
  managed_taplo_tab=$(printf '	')
  IFS=$managed_taplo_tab
  set -f
  # shellcheck disable=SC2086
  set -- $managed_taplo_asset_data
  set +f
  IFS=$managed_taplo_old_ifs
  [ "$#" -eq 4 ] || die 'malformed direct asset entry: taplo'
  managed_taplo_asset_version=$1
  managed_taplo_asset_format=$2
  managed_taplo_asset_url=$3
  managed_taplo_asset_sha256=$4
  [ "$managed_taplo_asset_version" = "$taplo_fallback_version" ] \
    || die 'unexpected managed Taplo version'
  [ "$managed_taplo_asset_format" = gzip ] \
    || die 'unexpected managed Taplo archive format'
  case $managed_taplo_asset_url in
    https://*) ;;
    *) die 'direct asset URL must use HTTPS: taplo' ;;
  esac
  case $managed_taplo_asset_sha256 in
    ''|*[!0-9a-f]*) die 'invalid SHA-256 for managed Taplo' ;;
  esac
  [ "${#managed_taplo_asset_sha256}" -eq 64 ] \
    || die 'invalid SHA-256 length for managed Taplo'
}

stage_taplo() {
  taplo_manifest_root=$1
  taplo_stage_root=$2
  load_managed_taplo_record "$taplo_manifest_root"
  taplo_asset_path=$taplo_stage_root/taplo.asset
  taplo_ready_root=$taplo_stage_root/taplo.ready
  download_verified "$managed_taplo_asset_url" "$managed_taplo_asset_sha256" \
    "$taplo_asset_path"
  gzip -t "$taplo_asset_path" \
    || die 'verified Taplo asset is not valid gzip'
  mkdir "$taplo_ready_root" \
    || die 'could not create managed Taplo staging directory'
  gzip -dc "$taplo_asset_path" >"$taplo_ready_root/taplo" \
    || die 'could not decompress the verified Taplo asset'
  [ -s "$taplo_ready_root/taplo" ] \
    && [ -f "$taplo_ready_root/taplo" ] \
    && [ ! -L "$taplo_ready_root/taplo" ] \
    || die 'verified Taplo asset did not produce one regular executable'
  chmod 0755 "$taplo_ready_root/taplo" \
    || die 'could not make the staged Taplo executable'
  read_managed_taplo_version "$taplo_ready_root/taplo" \
    && [ "$managed_taplo_version" = "$taplo_fallback_version" ] \
    || die "staged Taplo version does not match taplo $taplo_fallback_version"
  bounded_command_succeeds \
    "$taplo_ready_root/taplo" lsp stdio --help \
    || die 'staged Taplo does not expose lsp stdio'
}

stage_npm_language_servers() {
  npm_manifest_root=$1
  npm_stage_root=$2
  npm_ready=$npm_stage_root/npm.ready
  mkdir "$npm_ready" || die 'could not create managed npm staging directory'
  cp "$npm_manifest_root/packages-npm-language-servers.json" \
    "$npm_ready/package.json" \
    || die 'could not stage the npm language-server manifest'
  cp "$npm_manifest_root/packages-npm-language-servers-lock.json" \
    "$npm_ready/package-lock.json" \
    || die 'could not stage the npm language-server lockfile'

  "$selected_node" -e '
const fs = require("fs");
const root = process.argv[1];
const manifest = JSON.parse(fs.readFileSync(root + "/package.json", "utf8"));
const lock = JSON.parse(fs.readFileSync(root + "/package-lock.json", "utf8"));
const expected = {"bash-language-server":"5.6.0","pyright":"1.1.411","vscode-langservers-extracted":"4.10.0","yaml-language-server":"1.24.0"};
if (manifest.private !== true || JSON.stringify(manifest.dependencies) !== JSON.stringify(expected)) process.exit(1);
if (lock.lockfileVersion !== 3 || lock.requires !== true) process.exit(1);
if (!lock.packages || JSON.stringify(lock.packages[""].dependencies) !== JSON.stringify(expected)) process.exit(1);
for (const [path, record] of Object.entries(lock.packages)) {
  if (path === "") continue;
  if (!path.startsWith("node_modules/")) process.exit(1);
  if (typeof record.resolved !== "string" || !record.resolved.startsWith("https://registry.npmjs.org/")) process.exit(1);
  if (typeof record.integrity !== "string" || !/^sha512-[A-Za-z0-9+/]+={0,2}$/.test(record.integrity)) process.exit(1);
}
' "$npm_ready" || die 'npm language-server manifests failed validation'

  (
    cd "$npm_ready" || exit 1
    npm_config_cache="$npm_stage_root/npm-cache" \
      PATH="$(dirname "$selected_node"):$PATH" \
      "$selected_npm" ci --ignore-scripts --omit=dev --no-audit --no-fund
  ) || die 'npm language-server installation failed'

  for npm_command in \
    bash-language-server \
    vscode-json-language-server \
    pyright-langserver \
    yaml-language-server
  do
    [ -x "$npm_ready/node_modules/.bin/$npm_command" ] \
      || die "npm language-server bundle is missing executable: $npm_command"
  done
}

scoped_managed_path_identity() {
  scoped_identity_path=$1
  scoped_identity_kind=$2
  scoped_identity_stat=$(stat -c '%d:%i:%f:%w' "$scoped_identity_path") || return 1
  case $scoped_identity_kind in
    directory)
      [ "$(find "$scoped_identity_path" -mindepth 1 -maxdepth 1 -printf '%f\n')" = taplo ] \
        && [ -f "$scoped_identity_path/taplo" ] \
        && [ ! -L "$scoped_identity_path/taplo" ] || return 1
      scoped_identity_file=$(stat -c '%d:%i:%f:%w' "$scoped_identity_path/taplo") || return 1
      scoped_identity_hash=$(file_sha256 "$scoped_identity_path/taplo") || return 1
      [ -n "$scoped_identity_hash" ] || return 1
      printf '%s|%s|%s\n' "$scoped_identity_stat" "$scoped_identity_file" "$scoped_identity_hash"
      ;;
    link)
      scoped_identity_source=$(readlink -- "$scoped_identity_path") || return 1
      printf '%s|%s\n' "$scoped_identity_stat" "$scoped_identity_source"
      ;;
    parent) printf '%s\n' "$scoped_identity_stat" ;;
    *) return 1 ;;
  esac
}

scoped_recorded_path_identity() {
  scoped_lookup_path=$1
  while IFS="$(printf '\t')" read -r scoped_record_path scoped_record_identity; do
    if [ "$scoped_record_path" = "$scoped_lookup_path" ]; then
      printf '%s\n' "$scoped_record_identity"
      return 0
    fi
  done <"$managed_created_identities_file"
  return 1
}

record_managed_created_path() {
  created_path=$1
  [ -n "$managed_created_paths_file" ] \
    || die 'managed-created path journal is unavailable'
  case "$created_path" in
    ''|*"
"*|*""*|*"	"*) die 'managed-created path contains control characters' ;;
    /*) ;;
    *) die "managed-created path must be absolute: $created_path" ;;
  esac
  if [ "$managed_tool" = taplo ]; then
    [ -n "$managed_unjournaled_identity" ] \
      || die 'managed Taplo publication identity is unavailable'
    printf '%s\t%s\n' "$created_path" "$managed_unjournaled_identity" \
      >>"$managed_created_identities_file" \
      || die 'could not record managed Taplo publication identity'
  fi
  printf '%s\n' "$created_path" >>"$managed_created_paths_file" \
    || die 'could not record a managed-created path'
}

classify_managed_created_path() {
  candidate_managed_path=$1
  managed_created_path_kind=
  case "$candidate_managed_path" in
    "$HOME/.local"|"$HOME/.local/bin"|"$HOME/.local/opt")
      managed_created_path_kind=parent
      return 0
      ;;
    "$HOME/.local/bin/lua-language-server")
      managed_created_path_kind=regular
      return 0
      ;;
    "$HOME/.local/bin/node"|"$HOME/.local/bin/npm"|\
    "$HOME/.local/bin/bash-language-server"|\
    "$HOME/.local/bin/vscode-json-language-server"|\
    "$HOME/.local/bin/pyright-langserver"|\
    "$HOME/.local/bin/taplo"|\
    "$HOME/.local/bin/yaml-language-server")
      managed_created_path_kind='link'
      return 0
      ;;
  esac
  [ -n "$managed_node_target" ] \
    && [ "$candidate_managed_path" = "$managed_node_target" ] && {
      managed_created_path_kind=directory
      return 0
    }
  [ -n "$managed_lua_target" ] \
    && [ "$candidate_managed_path" = "$managed_lua_target" ] && {
      managed_created_path_kind=directory
      return 0
    }
  [ -n "$managed_taplo_target" ] \
    && [ "$candidate_managed_path" = "$managed_taplo_target" ] && {
      managed_created_path_kind=directory
      return 0
    }
  [ -n "$managed_npm_target" ] \
    && [ "$candidate_managed_path" = "$managed_npm_target" ] && {
      managed_created_path_kind=directory
      return 0
    }
  return 1
}

managed_path_matches_kind() {
  managed_match_path=$1
  managed_match_kind=$2
  case "$managed_match_kind" in
    parent|directory)
      [ -d "$managed_match_path" ] && [ ! -L "$managed_match_path" ]
      ;;
    regular)
      [ -f "$managed_match_path" ] && [ ! -L "$managed_match_path" ]
      ;;
    link)
      [ -L "$managed_match_path" ]
      ;;
    *) return 1 ;;
  esac
}

begin_managed_publication_critical() {
  [ "$managed_publication_critical" = false ] \
    || die 'managed publication critical section is already active'
  managed_publication_critical=true
  managed_unjournaled_path=
  managed_unjournaled_kind=
  managed_unjournaled_identity=
}

track_managed_unjournaled_path() {
  [ "$managed_publication_critical" = true ] \
    || die 'managed publication path was created outside its critical section'
  [ -z "$managed_unjournaled_path" ] \
    || die 'managed publication already has an unjournaled path'
  managed_unjournaled_path=$1
  managed_unjournaled_kind=$2
  case "$managed_unjournaled_kind" in
    parent|directory|regular|link) ;;
    *) die "unsupported managed publication path kind: $managed_unjournaled_kind" ;;
  esac
  classify_managed_created_path "$managed_unjournaled_path" \
    || die "unexpected managed publication path: $managed_unjournaled_path"
  [ "$managed_created_path_kind" = "$managed_unjournaled_kind" ] \
    || die "managed publication path kind mismatch: $managed_unjournaled_path"
  if [ "$managed_tool" = taplo ]; then
    managed_unjournaled_identity=
    [ "$#" -lt 3 ] || managed_unjournaled_identity=$3
    if [ -z "$managed_unjournaled_identity" ]; then
      managed_unjournaled_identity=$(scoped_managed_path_identity \
        "$managed_unjournaled_path" "$managed_unjournaled_kind") \
        || die 'could not identify managed Taplo publication'
    fi
  fi
}

clear_managed_unjournaled_path() {
  managed_unjournaled_path=
  managed_unjournaled_kind=
  managed_unjournaled_identity=
}

finish_managed_publication_critical() {
  [ "$managed_publication_critical" = true ] \
    || die 'managed publication critical section is not active'
  managed_publication_critical=false
  replay_pending_transaction_signal
}

complete_managed_publication_critical() {
  [ -n "$managed_unjournaled_path" ] \
    || die 'managed publication has no path to journal'
  record_managed_created_path "$managed_unjournaled_path"
  clear_managed_unjournaled_path
  finish_managed_publication_critical
}

fail_managed_publication_critical() {
  managed_publication_error=$1
  finish_managed_publication_critical
  die "$managed_publication_error"
}

remove_managed_unjournaled_path() {
  [ -n "$managed_unjournaled_path" ] || return 0
  cleanup_unjournaled_path=$managed_unjournaled_path
  cleanup_unjournaled_kind=$managed_unjournaled_kind
  if ! classify_managed_created_path "$cleanup_unjournaled_path"; then
    printf 'bootstrap: refusing unjournaled managed cleanup for unexpected path: %s\n' \
      "$cleanup_unjournaled_path" >&2
    return 1
  fi
  if [ "$managed_created_path_kind" != "$cleanup_unjournaled_kind" ]; then
    printf 'bootstrap: refusing unjournaled managed cleanup for mismatched path kind: %s\n' \
      "$cleanup_unjournaled_path" >&2
    return 1
  fi

  unjournaled_cleanup_status=0
  if ! path_exists "$cleanup_unjournaled_path"; then
    clear_managed_unjournaled_path
    return 0
  fi
  if ! managed_path_matches_kind \
    "$cleanup_unjournaled_path" "$cleanup_unjournaled_kind"; then
    printf 'bootstrap: refusing unjournaled managed %s cleanup for changed path: %s\n' \
      "$cleanup_unjournaled_kind" "$cleanup_unjournaled_path" >&2
    return 1
  fi
  if [ "$managed_tool" = taplo ] \
    && { [ -z "$managed_unjournaled_identity" ] \
      || [ "$(scoped_managed_path_identity "$cleanup_unjournaled_path" "$cleanup_unjournaled_kind")" \
        != "$managed_unjournaled_identity" ]; }; then
    printf 'bootstrap: refusing managed Taplo cleanup for replaced or changed path: %s\n' \
      "$cleanup_unjournaled_path" >&2
    return 1
  fi
  case "$cleanup_unjournaled_kind" in
    parent)
      rmdir "$cleanup_unjournaled_path" >/dev/null 2>&1 \
        || unjournaled_cleanup_status=1
      ;;
    directory)
      rm -rf -- "$cleanup_unjournaled_path" \
        || unjournaled_cleanup_status=1
      ;;
    regular|link)
      rm -f -- "$cleanup_unjournaled_path" \
        || unjournaled_cleanup_status=1
      ;;
    *)
      printf 'bootstrap: refusing unjournaled managed cleanup for unsupported path kind: %s\n' \
        "$cleanup_unjournaled_kind" >&2
      unjournaled_cleanup_status=1
      ;;
  esac
  if [ "$unjournaled_cleanup_status" -eq 0 ]; then
    clear_managed_unjournaled_path
  fi
  return "$unjournaled_cleanup_status"
}

remove_managed_created_paths() {
  [ -n "$managed_created_paths_file" ] || return 0
  [ -r "$managed_created_paths_file" ] || return 0
  managed_reverse_file=$managed_created_paths_file.reverse
  awk '{ path[NR] = $0 } END { for (path_index = NR; path_index >= 1; path_index--) print path[path_index] }' \
    "$managed_created_paths_file" >"$managed_reverse_file" \
    || return 1
  managed_cleanup_status=0
  while IFS= read -r cleanup_managed_path || [ -n "$cleanup_managed_path" ]; do
    case "$cleanup_managed_path" in
      ''|*"
"*|*""*|*"	"*)
        printf '%s\n' 'bootstrap: refusing managed cleanup for a control-character path' >&2
        managed_cleanup_status=1
        continue
        ;;
    esac
    if ! classify_managed_created_path "$cleanup_managed_path"; then
      printf 'bootstrap: refusing managed cleanup for unexpected path: %s\n' \
        "$cleanup_managed_path" >&2
      managed_cleanup_status=1
      continue
    fi
    cleanup_managed_kind=$managed_created_path_kind
    path_exists "$cleanup_managed_path" || continue
    if ! managed_path_matches_kind \
      "$cleanup_managed_path" "$cleanup_managed_kind"; then
      printf 'bootstrap: refusing managed %s cleanup for changed path: %s\n' \
        "$cleanup_managed_kind" "$cleanup_managed_path" >&2
      managed_cleanup_status=1
      continue
    fi
    if [ "$managed_tool" = taplo ]; then
      cleanup_managed_identity=$(scoped_recorded_path_identity "$cleanup_managed_path") \
        || cleanup_managed_identity=
      if [ -z "$cleanup_managed_identity" ] \
        || [ "$(scoped_managed_path_identity "$cleanup_managed_path" "$cleanup_managed_kind")" \
          != "$cleanup_managed_identity" ]; then
        printf 'bootstrap: refusing managed Taplo cleanup for replaced or changed path: %s\n' \
          "$cleanup_managed_path" >&2
        managed_cleanup_status=1
        continue
      fi
    fi
    case "$cleanup_managed_kind" in
      parent)
        rmdir "$cleanup_managed_path" >/dev/null 2>&1 \
          || managed_cleanup_status=1
        ;;
      directory)
        rm -rf -- "$cleanup_managed_path" \
          || managed_cleanup_status=1
        ;;
      regular|link)
        rm -f -- "$cleanup_managed_path" \
          || managed_cleanup_status=1
        ;;
      *)
        printf 'bootstrap: refusing managed cleanup for unsupported path kind: %s\n' \
          "$cleanup_managed_kind" >&2
        managed_cleanup_status=1
        ;;
    esac
  done <"$managed_reverse_file"
  return "$managed_cleanup_status"
}

maybe_fail_managed_publication() {
  publication_token=$1
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_PUBLISH_FAIL_AFTER:-}" = "$publication_token" ]; then
    die "forced managed publication failure after $publication_token"
  fi
}

create_managed_parent_directory() {
  parent_path=$1
  require_managed_parent_directory "$parent_path"
  if ! path_exists "$parent_path"; then
    begin_managed_publication_critical
    if ! mkdir "$parent_path"; then
      fail_managed_publication_critical \
        "could not create managed language-tool parent: $parent_path"
    fi
    track_managed_unjournaled_path "$parent_path" parent
    complete_managed_publication_critical
  fi
}

publish_managed_directory() {
  publish_source=$1
  publish_target=$2
  publication_token=$3
  require_managed_target_free "$publish_target"
  begin_managed_publication_critical
  if [ "$managed_tool" = taplo ]; then
    scoped_publish_identity=$(scoped_managed_path_identity "$publish_source" directory) \
      || fail_managed_publication_critical 'could not identify staged Taplo directory'
  fi
  if ! mv --no-clobber --no-target-directory \
    "$publish_source" "$publish_target"; then
    fail_managed_publication_critical \
      "could not publish managed language-tool directory: $publish_target"
  fi
  if [ "$managed_tool" = taplo ]; then
    if path_exists "$publish_source" \
      || [ "$(scoped_managed_path_identity "$publish_target" directory)" != "$scoped_publish_identity" ]; then
      fail_managed_publication_critical \
        "managed Taplo directory ownership did not transfer: $publish_target"
    fi
    track_managed_unjournaled_path "$publish_target" directory "$scoped_publish_identity"
  else
    track_managed_unjournaled_path "$publish_target" directory
  fi
  if [ -e "$publish_source" ] || [ -L "$publish_source" ]; then
    fail_managed_publication_critical \
      "managed language-tool directory was not published: $publish_target"
  fi
  if [ ! -d "$publish_target" ] || [ -L "$publish_target" ]; then
    fail_managed_publication_critical \
      "managed language-tool directory has an unexpected type: $publish_target"
  fi
  complete_managed_publication_critical
  maybe_fail_managed_publication "$publication_token"
}

mutate_managed_link_for_test() {
  managed_link_mutation_phase=$1
  managed_link_mutation_path=$2
  [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] || return 0
  [ "${DOTFILES_BOOTSTRAP_TEST_LINK_MUTATION_PHASE:-}" \
    = "$managed_link_mutation_phase" ] || return 0
  [ "${DOTFILES_BOOTSTRAP_TEST_LINK_MUTATION_TARGET:-}" \
    = "$managed_link_mutation_path" ] || return 0
  [ -L "$managed_link_mutation_path" ] \
    || die 'managed link mutation hook requires the exact published link'
  rm -f -- "$managed_link_mutation_path" \
    || die 'managed link mutation hook could not remove the published link'
  case "${DOTFILES_BOOTSTRAP_TEST_LINK_MUTATION_KIND:-}" in
    regular)
      printf '%s\n' 'mutated Taplo link bytes' \
        >"$managed_link_mutation_path" \
        || die 'managed link mutation hook could not create a regular file'
      ;;
    directory)
      mkdir "$managed_link_mutation_path" \
        || die 'managed link mutation hook could not create a directory'
      printf '%s\n' 'mutated Taplo link directory' \
        >"$managed_link_mutation_path/sentinel" \
        || die 'managed link mutation hook could not create a directory sentinel'
      ;;
    *) die 'managed link mutation hook has an unsupported replacement kind' ;;
  esac
}

publish_managed_link() {
  link_source=$1
  link_target=$2
  case "$link_source" in
    ''|*"
"*|*""*|*"	"*)
      die 'managed language-tool link source contains control characters'
      ;;
  esac
  case "$link_target" in
    ''|*"
"*|*""*|*"	"*)
      die 'managed language-tool link target contains control characters'
      ;;
  esac
  require_managed_target_free "$link_target"
  begin_managed_publication_critical
  if [ "$managed_tool" = taplo ]; then
    scoped_staged_link=$managed_taplo_link_root/taplo.link
    ln -sT "$link_source" "$scoped_staged_link" \
      || fail_managed_publication_critical 'could not stage managed Taplo link'
    scoped_publish_identity=$(scoped_managed_path_identity "$scoped_staged_link" link) \
      || fail_managed_publication_critical 'could not identify staged Taplo link'
    if ! mv --no-clobber --no-target-directory "$scoped_staged_link" "$link_target" \
      || path_exists "$scoped_staged_link" \
      || [ "$(scoped_managed_path_identity "$link_target" link)" != "$scoped_publish_identity" ]; then
      fail_managed_publication_critical \
        "managed Taplo link ownership did not transfer: $link_target"
    fi
    track_managed_unjournaled_path "$link_target" link "$scoped_publish_identity"
  else
    if ! ln -s "$link_source" "$link_target"; then
      fail_managed_publication_critical \
        "could not publish managed language-tool link: $link_target"
    fi
    track_managed_unjournaled_path "$link_target" link
  fi
  mutate_managed_link_for_test before-journal "$link_target"
  if [ ! -L "$link_target" ]; then
    fail_managed_publication_critical \
      "managed language-tool link was not published: $link_target"
  fi
  if ! published_link_source=$(readlink -- "$link_target"); then
    fail_managed_publication_critical \
      "could not inspect managed language-tool link: $link_target"
  fi
  if [ "$published_link_source" != "$link_source" ]; then
    fail_managed_publication_critical \
      "managed language-tool link has an unexpected target: $link_target"
  fi
  complete_managed_publication_critical
  mutate_managed_link_for_test after-journal "$link_target"
}

record_managed_language_server_actions() {
  if [ "$managed_node_required" = true ]; then
    record_package_action direct node
  fi
  if [ "$managed_lua_required" = true ]; then
    record_package_action direct lua-language-server
  fi
  if [ "$managed_taplo_required" = true ]; then
    record_package_action direct taplo
  fi
  if [ "$managed_npm_required" = true ]; then
    record_package_action npm bash-language-server@5.6.0
    record_package_action npm vscode-langservers-extracted@4.10.0
    record_package_action npm pyright@1.1.411
    record_package_action npm yaml-language-server@1.24.0
  fi
}

publish_debian_language_servers() {
  publish_stage_root=$1
  managed_publish_active=true

  create_managed_parent_directory "$HOME/.local"
  create_managed_parent_directory "$HOME/.local/bin"
  create_managed_parent_directory "$HOME/.local/opt"

  if [ "$managed_node_required" = true ]; then
    publish_managed_directory \
      "$publish_stage_root/node.ready" "$managed_node_target" node-directory
  fi
  if [ "$managed_lua_required" = true ]; then
    lua_relative_target=../opt/lua-language-server-$luals_fallback_version-$managed_architecture/bin/lua-language-server
    # shellcheck disable=SC2016 # The generated wrapper expands these values at runtime.
    printf '%s\n' \
      '#!/bin/sh' \
      'wrapper_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd) || exit 1' \
      "exec \"\$wrapper_dir/$lua_relative_target\" \"\$@\"" \
      >"$publish_stage_root/lua-language-server.wrapper" \
      || die 'could not stage the LuaLS wrapper'
    chmod 0755 "$publish_stage_root/lua-language-server.wrapper" \
      || die 'could not make the LuaLS wrapper executable'
    publish_managed_directory \
      "$publish_stage_root/lua.ready" "$managed_lua_target" lua-directory
  fi
  if [ "$managed_taplo_required" = true ]; then
    publish_managed_directory \
      "$publish_stage_root/taplo.ready" \
      "$managed_taplo_target" taplo-directory
  fi
  if [ "$managed_npm_required" = true ]; then
    publish_managed_directory \
      "$publish_stage_root/npm.ready" "$managed_npm_target" npm-directory
  fi

  if [ "$managed_node_required" = true ]; then
    publish_managed_link "$managed_node_target/bin/node" "$HOME/.local/bin/node"
    publish_managed_link "$managed_node_target/bin/npm" "$HOME/.local/bin/npm"
  fi
  if [ "$managed_lua_required" = true ]; then
    require_managed_target_free "$HOME/.local/bin/lua-language-server"
    begin_managed_publication_critical
    if ! mv --no-clobber --no-target-directory \
      "$publish_stage_root/lua-language-server.wrapper" \
      "$HOME/.local/bin/lua-language-server"; then
      fail_managed_publication_critical \
        'could not publish the managed LuaLS wrapper'
    fi
    track_managed_unjournaled_path \
      "$HOME/.local/bin/lua-language-server" regular
    if [ -e "$publish_stage_root/lua-language-server.wrapper" ] \
      || [ -L "$publish_stage_root/lua-language-server.wrapper" ]; then
      fail_managed_publication_critical \
        'managed LuaLS wrapper was not published'
    fi
    if [ ! -x "$HOME/.local/bin/lua-language-server" ] \
      || [ -L "$HOME/.local/bin/lua-language-server" ]; then
      fail_managed_publication_critical \
        'managed LuaLS wrapper has an unexpected type'
    fi
    complete_managed_publication_critical
  fi
  if [ "$managed_taplo_required" = true ]; then
    publish_managed_link \
      "$managed_taplo_target/taplo" "$HOME/.local/bin/taplo"
    maybe_fail_managed_publication taplo-link
  fi
  if [ "$managed_bash_required" = true ]; then
    publish_managed_link \
      "$managed_npm_target/node_modules/.bin/bash-language-server" \
      "$HOME/.local/bin/bash-language-server"
  fi
  if [ "$managed_json_required" = true ]; then
    publish_managed_link \
      "$managed_npm_target/node_modules/.bin/vscode-json-language-server" \
      "$HOME/.local/bin/vscode-json-language-server"
  fi
  if [ "$managed_pyright_required" = true ]; then
    publish_managed_link \
      "$managed_npm_target/node_modules/.bin/pyright-langserver" \
      "$HOME/.local/bin/pyright-langserver"
  fi
  if [ "$managed_yaml_required" = true ]; then
    publish_managed_link \
      "$managed_npm_target/node_modules/.bin/yaml-language-server" \
      "$HOME/.local/bin/yaml-language-server"
  fi
  maybe_fail_managed_publication command-links

  record_managed_language_server_actions
  managed_publish_active=false
}

install_debian_language_servers() {
  debian_manifest_root=$1
  if [ "$managed_node_required" != true ] \
    && [ "$managed_lua_required" != true ] \
    && [ "$managed_taplo_required" != true ] \
    && [ "$managed_npm_required" != true ]; then
    return 0
  fi

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_REAL_MANAGED_INSTALL:-0}" != 1 ]; then
    if [ "$managed_node_required" = true ]; then
      record_test_command direct-install node
    fi
    if [ "$managed_lua_required" = true ]; then
      record_test_command direct-install lua-language-server
    fi
    if [ "$managed_taplo_required" = true ]; then
      record_test_command direct-install taplo
    fi
    if [ "$managed_npm_required" = true ]; then
      record_test_command npm-ci --ignore-scripts --omit=dev --no-audit --no-fund
    fi
    record_managed_language_server_actions
    return 0
  fi

  begin_cleanup_registration_critical
  managed_stage_root=$(temporary_directory) || {
    finish_cleanup_registration_critical
    die 'could not create managed language-server staging storage'
  }
  active_package_tmp=$managed_stage_root
  finish_cleanup_registration_critical
  if [ "$managed_node_required" = true ]; then
    stage_node_runtime "$debian_manifest_root" "$managed_stage_root"
  else
    selected_node=$(command -v node) \
      || die 'satisfactory Node command disappeared before npm staging'
    selected_npm=$(command -v npm) \
      || die 'satisfactory npm command disappeared before npm staging'
    tool_is_satisfied node 22.0.0 \
      || die 'selected Node command no longer satisfies version 22.0.0'
    tool_is_satisfied npm 10.0.0 \
      || die 'selected npm command no longer satisfies version 10.0.0'
  fi
  if [ "$managed_lua_required" = true ]; then
    stage_lua_language_server "$debian_manifest_root" "$managed_stage_root"
  fi
  if [ "$managed_taplo_required" = true ]; then
    stage_taplo "$debian_manifest_root" "$managed_stage_root"
  fi
  if [ "$managed_npm_required" = true ]; then
    stage_npm_language_servers "$debian_manifest_root" "$managed_stage_root"
  fi
  publish_debian_language_servers "$managed_stage_root"
  remove_temporary_directory "$managed_stage_root"
  active_package_tmp=
}

install_direct_tool() {
  tool_name=$1
  required_version=$2
  manifest_root=$3

  if tool_is_satisfied "$tool_name" "$required_version"; then
    printf '  skip package %s (already satisfied)\n' "$tool_name"
    return 0
  fi

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && { [ "$tool_name" != rishot ] \
      || [ "${DOTFILES_BOOTSTRAP_TEST_REAL_RISHOT_INSTALL:-0}" != 1 ]; }; then
    record_test_command direct-install "$tool_name"
    record_package_action direct "$tool_name"
    return 0
  fi

  if [ "$tool_name" = rishot ]; then
    selected_arch=any
  else
    selected_arch=$(normalized_architecture)
  fi
  asset_data=$(direct_asset_record "$tool_name" linux "$selected_arch" "$manifest_root/packages-direct.tsv")
  old_ifs=$IFS
  tab_character=$(printf '\t')
  IFS=$tab_character
  set -f
  # shellcheck disable=SC2086 # Intentional split on the verified manifest tab delimiter.
  set -- $asset_data
  set +f
  IFS=$old_ifs
  [ "$#" -eq 4 ] || die "malformed direct asset entry: $tool_name"
  asset_version=$1
  asset_format=$2
  asset_url=$3
  asset_sha256=$4
  case "$asset_version" in
    ''|*[!A-Za-z0-9._-]*) die "invalid direct asset version: $tool_name" ;;
  esac
  case "$asset_url" in
    https://*) ;;
    *) die "direct asset URL must use HTTPS: $tool_name" ;;
  esac

  local_bin=$HOME/.local/bin
  local_opt=$HOME/.local/opt
  if [ "$tool_name" = rishot ]; then
    prepare_rishot_paths
  fi

  install_tmp=$(temporary_directory) \
    || die "could not create temporary direct asset storage: $tool_name"
  active_package_tmp=$install_tmp
  asset_path=$install_tmp/asset
  download_verified "$asset_url" "$asset_sha256" "$asset_path"
  if [ "$tool_name" = rishot ]; then
    prepare_rishot_paths
  else
    mkdir -p "$local_bin" "$local_opt"
  fi

  case "$tool_name:$asset_format" in
    neovim:tar.gz)
      target_dir=$local_opt/nvim-$asset_version-$selected_arch
      target_link=$local_bin/nvim
      if [ -e "$target_link" ] || [ -L "$target_link" ]; then
        remove_temporary_directory "$install_tmp"
        die "refusing to replace existing direct-tool target: $target_link"
      fi
      if [ ! -d "$target_dir" ]; then
        mkdir "$install_tmp/extract"
        tar -xzf "$asset_path" -C "$install_tmp/extract" \
          || die 'could not extract the verified Neovim archive'
        extracted_dir=$install_tmp/extract/nvim-linux-$selected_arch
        [ -x "$extracted_dir/bin/nvim" ] || die 'verified Neovim archive has an unexpected layout'
        mv "$extracted_dir" "$target_dir"
      fi
      ln -s "$target_dir/bin/nvim" "$target_link"
      ;;
    stylua:zip)
      target_link=$local_bin/stylua
      [ ! -e "$target_link" ] && [ ! -L "$target_link" ] \
        || die "refusing to replace existing direct-tool target: $target_link"
      mkdir "$install_tmp/extract"
      unzip -q "$asset_path" -d "$install_tmp/extract" \
        || die 'could not extract the verified StyLua archive'
      [ -f "$install_tmp/extract/stylua" ] || die 'verified StyLua archive has an unexpected layout'
      install -m 0755 "$install_tmp/extract/stylua" "$target_link"
      ;;
    tree-sitter:gzip)
      target_link=$local_bin/tree-sitter
      [ ! -e "$target_link" ] && [ ! -L "$target_link" ] \
        || die "refusing to replace existing direct-tool target: $target_link"
      gzip -dc "$asset_path" >"$install_tmp/tree-sitter" \
        || die 'could not extract the verified tree-sitter binary'
      install -m 0755 "$install_tmp/tree-sitter" "$target_link"
      ;;
    herdr:binary)
      target_link=$local_bin/herdr
      [ ! -e "$target_link" ] && [ ! -L "$target_link" ] \
        || die "refusing to replace existing direct-tool target: $target_link"
      install -m 0755 "$asset_path" "$target_link"
      ;;
    font-space-mono-nerd:tar.xz)
      target_dir=$HOME/.local/share/fonts/SpaceMonoNerdFont-$asset_version
      [ ! -e "$target_dir" ] && [ ! -L "$target_dir" ] \
        || die "refusing to replace existing direct-tool target: $target_dir"
      mkdir -p "$target_dir"
      tar -xJf "$asset_path" -C "$target_dir" \
        || die 'could not extract the verified SpaceMono Nerd Font archive'
      if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f "$target_dir" >/dev/null 2>&1 || true
      fi
      ;;
    rishot:tar.gz)
      target_dir=$HOME/.local/share/rishot
      target_link=$local_bin/rishot
      extracted_root=rishot-$asset_version
      require_rishot_targets_free
      mkdir "$install_tmp/extract" \
        || die 'could not create the Rishot extraction directory'
      tar -tzf "$asset_path" >"$install_tmp/members" \
        || die 'verified Rishot asset is not valid gzip tar'
      archive_member_list_is_safe "$install_tmp/members" "$extracted_root" \
        || die 'verified Rishot archive contains an unsafe member'
      tar -tvzf "$asset_path" >"$install_tmp/member-details" \
        || die 'could not inspect verified Rishot archive member types'
      awk '
        substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d" { bad = 1 }
        END { exit bad }
      ' "$install_tmp/member-details" \
        || die 'verified Rishot archive contains a non-regular member'
      tar -xzf "$asset_path" -C "$install_tmp/extract" \
        || die 'could not extract the verified Rishot archive'
      extracted_dir=$install_tmp/extract/$extracted_root
      [ -f "$extracted_dir/bin/rishot" ] \
        && [ ! -L "$extracted_dir/bin/rishot" ] \
        || die 'verified Rishot archive is missing bin/rishot'
      [ -f "$extracted_dir/src/shell.qml" ] \
        && [ ! -L "$extracted_dir/src/shell.qml" ] \
        || die 'verified Rishot archive is missing src/shell.qml'
      chmod 0755 "$extracted_dir/bin/rishot" \
        || die 'could not make the verified Rishot launcher executable'
      (umask 022 && printf '%s\n' "$asset_version" \
        >"$extracted_dir/.dotfiles-revision") \
        || die 'could not record the verified Rishot revision'
      publish_rishot_tree "$extracted_dir" "$target_dir" "$target_link"
      ;;
    uv:tar.gz)
      target_dir=$local_opt/uv-$asset_version-$selected_arch
      uv_link=$local_bin/uv
      uvx_link=$local_bin/uvx
      [ ! -e "$uv_link" ] && [ ! -L "$uv_link" ] \
        || die "refusing to replace existing direct-tool target: $uv_link"
      [ ! -e "$uvx_link" ] && [ ! -L "$uvx_link" ] \
        || die "refusing to replace existing direct-tool target: $uvx_link"
      if [ ! -d "$target_dir" ]; then
        mkdir "$install_tmp/extract"
        tar -xzf "$asset_path" -C "$install_tmp/extract" \
          || die 'could not extract the verified uv archive'
        case "$selected_arch" in
          x86_64) uv_archive_arch=x86_64 ;;
          arm64) uv_archive_arch=aarch64 ;;
          *) die "unsupported architecture: $selected_arch" ;;
        esac
        extracted_dir=$install_tmp/extract/uv-$uv_archive_arch-unknown-linux-gnu
        [ -x "$extracted_dir/uv" ] && [ -x "$extracted_dir/uvx" ] \
          || die 'verified uv archive has an unexpected layout'
        mv "$extracted_dir" "$target_dir"
      fi
      ln -s "$target_dir/uv" "$uv_link"
      ln -s "$target_dir/uvx" "$uvx_link"
      ;;
    *)
      remove_temporary_directory "$install_tmp"
      die "unsupported direct asset: $tool_name/$asset_format"
      ;;
  esac

  remove_temporary_directory "$install_tmp"
  active_package_tmp=
  record_package_action direct "$tool_name"
  printf '  installed package %s %s\n' "$tool_name" "$asset_version"
}

apt_offers_ghostty() {
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ -n "${DOTFILES_BOOTSTRAP_TEST_APT_GHOSTTY_OFFICIAL:-}" ]; then
    [ "$DOTFILES_BOOTSTRAP_TEST_APT_GHOSTTY_OFFICIAL" = 1 ]
    return
  fi
  apt-cache show ghostty >/dev/null 2>&1
}

activate_homebrew_path() {
  for brew_candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_candidate" ]; then
      PATH=${brew_candidate%/bin/brew}/bin:${brew_candidate%/bin/brew}/sbin:$PATH
      export PATH
      break
    fi
  done
  command -v brew >/dev/null 2>&1
}

install_homebrew_packages() {
  manifest_root=$1
  selected_window_manager=$2
  window_manager_packages=$(window_manager_package_manifest \
    homebrew "$selected_window_manager" "$manifest_root")
  brew_missing=false
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_BREW_MISSING:-0}" = 1 ]; then
    brew_missing=true
  elif ! command -v brew >/dev/null 2>&1; then
    brew_missing=true
  fi

  if [ "$brew_missing" = true ]; then
    run_pinned_installer homebrew "$manifest_root/installers.tsv" \
      || die 'Homebrew installation failed'
    record_package_action installer homebrew
    if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" != 1 ]; then
      activate_homebrew_path \
        || die 'Homebrew installed but is unavailable on PATH'
    fi
  fi

  while IFS= read -r package_name || [ -n "$package_name" ]; do
    validate_package_name "$package_name" || continue
    if package_is_installed homebrew-formula "$package_name"; then
      printf '  skip package %s (already installed)\n' "$package_name"
    else
      run_command brew install "$package_name" || die "Homebrew formula failed: $package_name"
      record_package_action homebrew-formula "$package_name"
    fi
  done <"$manifest_root/packages-homebrew-formulae.list"

  for homebrew_cask_manifest in \
    "$manifest_root/packages-homebrew-casks.list" \
    "$window_manager_packages"
  do
    [ -n "$homebrew_cask_manifest" ] || continue
    while IFS= read -r package_name || [ -n "$package_name" ]; do
      validate_package_name "$package_name" || continue
      if package_is_installed homebrew-cask "$package_name"; then
        printf '  skip package %s (already installed)\n' "$package_name"
      else
        run_command brew install --cask "$package_name" \
          || die "Homebrew cask failed: $package_name"
        record_package_action homebrew-cask "$package_name"
      fi
    done <"$homebrew_cask_manifest"
  done
}

install_apt_packages() {
  manifest_root=$1
  selected_window_manager=$2
  prepare_debian_language_servers "$manifest_root"
  window_manager_packages=$(window_manager_package_manifest \
    apt "$selected_window_manager" "$manifest_root")
  ghostty_installed=false
  package_is_installed apt ghostty && ghostty_installed=true
  ghostty_official=false
  if [ "$ghostty_installed" = false ] && apt_offers_ghostty; then
    ghostty_official=true
  fi
  if [ "$ghostty_installed" = false ] \
    && [ "$ghostty_official" = false ] \
    && [ "$allow_community_packages" != true ]; then
    die 'Ghostty is unavailable from configured apt repositories; rerun with --allow-community-packages to use the pinned documented community installer' 4
  fi

  set --
  for apt_manifest in "$manifest_root/packages-apt.list" "$window_manager_packages"; do
    [ -n "$apt_manifest" ] || continue
    while IFS= read -r package_name || [ -n "$package_name" ]; do
      validate_package_name "$package_name" || continue
      if ! package_is_installed apt "$package_name"; then
        set -- "$@" "$package_name"
      fi
    done <"$apt_manifest"
  done
  if [ "$ghostty_installed" = false ] && [ "$ghostty_official" = true ]; then
    set -- "$@" ghostty
  fi

  if [ "$#" -gt 0 ]; then
    run_privileged_command apt-get update || die 'apt index refresh failed'
    run_privileged_command apt-get install -y --no-install-recommends --no-remove "$@" \
      || die 'apt package installation failed'
    for installed_apt_package do
      record_package_action apt "$installed_apt_package"
    done
  fi

  install_debian_language_servers "$manifest_root"

  install_direct_tool uv 0.11.6 "$manifest_root"
  install_direct_tool neovim 0.12.0 "$manifest_root"
  install_direct_tool stylua 2.5.0 "$manifest_root"
  install_direct_tool tree-sitter 0.26.1 "$manifest_root"
  install_direct_tool herdr 0.8.0 "$manifest_root"
  install_direct_tool font-space-mono-nerd '' "$manifest_root"

  if [ "$ghostty_installed" = false ] && [ "$ghostty_official" = false ]; then
    if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
      record_test_command community-installer ghostty
    else
      run_pinned_installer ghostty-community "$manifest_root/installers.tsv" \
        || die 'community Ghostty installation failed'
    fi
    record_package_action community ghostty
  fi
}

install_pacman_packages() {
  manifest_root=$1
  selected_window_manager=$2
  window_manager_packages=$(window_manager_package_manifest \
    pacman "$selected_window_manager" "$manifest_root")
  missing_packages=
  for pacman_manifest in \
    "$manifest_root/packages-pacman.list" \
    "$window_manager_packages"
  do
    [ -n "$pacman_manifest" ] || continue
    while IFS= read -r package_name || [ -n "$package_name" ]; do
      validate_package_name "$package_name" || continue
      if ! package_is_installed pacman "$package_name"; then
        if [ -n "$missing_packages" ]; then
          missing_packages="$missing_packages $package_name"
        else
          missing_packages=$package_name
        fi
      fi
    done <"$pacman_manifest"
  done

  if [ -n "$missing_packages" ]; then
    printf 'bootstrap: Arch packages are missing. Run this command, then rerun bootstrap:\n' >&2
    printf '  sudo pacman -Syu --needed %s\n' "$missing_packages" >&2
    exit 4
  fi

  install_direct_tool herdr 0.8.0 "$manifest_root"
  if [ "$selected_window_manager" = hypr ]; then
    install_direct_tool rishot \
      28c273b1b573725e03ef12989451f48009dabc83 \
      "$manifest_root"
  fi
}

parquet_uv_candidate_is_satisfied() {
  parquet_uv_candidate=$1
  case "$parquet_uv_candidate" in
    /*) ;;
    *) return 1 ;;
  esac
  [ -x "$parquet_uv_candidate" ] || return 1
  parquet_uv_candidate_output=$(
    "$parquet_uv_candidate" --version 2>/dev/null
  ) || return 1
  parquet_uv_candidate_version=$(
    printf '%s\n' "$parquet_uv_candidate_output" \
      | awk '
          NR != 1 { exit 1 }
          {
            sub(/^[[:space:]]+/, "")
            sub(/[[:space:]]+$/, "")
            if ($0 !~ /^uv [0-9]+\.[0-9]+\.[0-9]+( \([^()[:cntrl:]]+\))?$/) exit 1
            print $2
          }
        '
  ) || return 1
  [ -n "$parquet_uv_candidate_version" ] || return 1
  version_at_least "$parquet_uv_candidate_version" 0.11.6
}

parquet_uv_executable() {
  parquet_uv_path=$(command -v uv 2>/dev/null || true)
  if [ -n "$parquet_uv_path" ] \
    && parquet_uv_candidate_is_satisfied "$parquet_uv_path"; then
    printf '%s\n' "$parquet_uv_path"
    return 0
  fi
  parquet_uv_managed=$HOME/.local/bin/uv
  if parquet_uv_candidate_is_satisfied "$parquet_uv_managed"; then
    printf '%s\n' "$parquet_uv_managed"
    return 0
  fi
  return 1
}

parquet_viewer_is_satisfied() {
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    tool_is_satisfied visidata 3.4
    return
  fi

  parquet_uv=$(parquet_uv_executable) || return 1
  parquet_tool_root=$(UV_OFFLINE=1 "$parquet_uv" tool dir --no-config 2>/dev/null) \
    || return 1
  case "$parquet_tool_root" in
    /*) ;;
    *) return 1 ;;
  esac
  [ -d "$parquet_tool_root" ] || return 1
  parquet_tool_root=$(CDPATH='' cd -- "$parquet_tool_root" 2>/dev/null && pwd -P) \
    || return 1
  [ "$parquet_tool_root" != / ] || return 1

  parquet_tool_environment=$parquet_tool_root/visidata
  parquet_tool_python=$parquet_tool_environment/bin/python
  parquet_tool_viewer=$parquet_tool_environment/bin/vd
  [ -x "$parquet_tool_python" ] && [ -x "$parquet_tool_viewer" ] || return 1

  PYTHONDONTWRITEBYTECODE=1 "$parquet_tool_python" -I -B -c \
    'import importlib.metadata as m,duckdb,pyarrow; expected={"visidata":"3.4","pyarrow":"25.0.0","duckdb":"1.5.5"}; actual={name:m.version(name) for name in expected}; assert actual == expected, (actual, expected); assert duckdb.__version__ == expected["duckdb"]' \
    >/dev/null 2>&1
}

parquet_install_target_is_safe() {
  parquet_install_target=$1
  case "$parquet_install_target" in
    ''|/|*"
"*|*""*|*"	"*) return 1 ;;
    /*) ;;
    *) return 1 ;;
  esac
  while [ "$parquet_install_target" != / ] \
    && [ "${parquet_install_target%/}" != "$parquet_install_target" ]; do
    parquet_install_target=${parquet_install_target%/}
  done
  [ "$parquet_install_target" != / ] || return 1
  parquet_install_target_components=/${parquet_install_target#/}/
  case "$parquet_install_target_components" in
    *'//'*|*'/./'*|*'/../'*) return 1 ;;
  esac
  if [ -e "$parquet_install_target" ] || [ -L "$parquet_install_target" ]; then
    [ -d "$parquet_install_target" ] || return 1
    parquet_install_target_resolved=$(
      CDPATH='' cd -- "$parquet_install_target" 2>/dev/null && pwd -P
    ) || return 1
    [ "$parquet_install_target_resolved" != / ] || return 1
  fi
}

parquet_install_targets_are_safe() {
  parquet_install_uv=$1
  parquet_install_tool_root=$(
    UV_OFFLINE=1 "$parquet_install_uv" tool dir --no-config 2>/dev/null
  ) || return 1
  parquet_install_target_is_safe "$parquet_install_tool_root" || return 1
  parquet_install_bin_root=$(
    UV_OFFLINE=1 "$parquet_install_uv" tool dir --bin --no-config 2>/dev/null
  ) || return 1
  parquet_install_target_is_safe "$parquet_install_bin_root"
}

install_parquet_viewer() {
  if parquet_viewer_is_satisfied; then
    printf '%s\n' '  skip uv-tool visidata (already exact)'
    return 0
  fi

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_PARQUET_INSTALL_FAIL:-0}" = 1 ]; then
    record_test_command \
      uv tool install --force --with pyarrow==25.0.0 \
      --with duckdb==1.5.5 --no-config visidata==3.4
    return 42
  fi

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    parquet_uv=uv
  else
    parquet_uv=$(parquet_uv_executable) || return 127
  fi
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" != 1 ]; then
    parquet_install_targets_are_safe "$parquet_uv" || return 1
  fi

  (
    unset \
      UV_BUILD_CONSTRAINT \
      UV_CONSTRAINT \
      UV_DEFAULT_INDEX \
      UV_EXCLUDE \
      UV_EXCLUDE_NEWER \
      UV_EXTRA_INDEX_URL \
      UV_FIND_LINKS \
      UV_FORK_STRATEGY \
      UV_INDEX \
      UV_INDEX_STRATEGY \
      UV_INDEX_URL \
      UV_OVERRIDE \
      UV_PRERELEASE \
      UV_RESOLUTION \
      UV_TORCH_BACKEND
    run_command \
      "$parquet_uv" tool install --force \
      --with pyarrow==25.0.0 \
      --with duckdb==1.5.5 \
      --no-config visidata==3.4
  ) || return $?
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" != 1 ]; then
    parquet_viewer_is_satisfied || return 1
  fi
  record_package_action \
    uv-tool visidata@3.4+pyarrow@25.0.0+duckdb@1.5.5
  printf '%s\n' \
    '  installed uv-tool visidata 3.4 with pyarrow 25.0.0 and duckdb 1.5.5'
}

install_packages() {
  selected_manager=$1
  selected_window_manager=$2
  manifest_root=$3
  printf '%s\n' 'Applying packages:'
  case "$selected_manager" in
    homebrew) install_homebrew_packages "$manifest_root" "$selected_window_manager" ;;
    apt) install_apt_packages "$manifest_root" "$selected_window_manager" ;;
    pacman) install_pacman_packages "$manifest_root" "$selected_window_manager" ;;
    *) die "unsupported package manager: $selected_manager" ;;
  esac
  install_parquet_viewer || die 'Parquet viewer installation failed'
}

path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

validate_home_directory() {
  case ${HOME:-} in
    /) die 'refusing to use the filesystem root as HOME' ;;
    /*) ;;
    *) die 'HOME must be an absolute path' ;;
  esac
}

require_managed_target_free() {
  managed_target=$1
  if path_exists "$managed_target"; then
    die "refusing to replace existing managed language-tool target: $managed_target"
  fi
}

require_managed_parent_directory() {
  managed_parent=$1
  if path_exists "$managed_parent" \
    && { [ ! -d "$managed_parent" ] || [ -L "$managed_parent" ]; }; then
    die "managed language-tool parent must be a real directory: $managed_parent"
  fi
}

read_managed_taplo_version() {
  bounded_command_output "$1" --version || return 1
  managed_taplo_version=$(printf '%s\n' "$bounded_probe_output" | awk '
    NR == 1 && /^taplo [0-9]+\.[0-9]+\.[0-9]+$/ { version = $2 }
    END {
      if (NR != 1 || version == "") exit 1
      print version
    }
  ')
}

managed_taplo_external_is_satisfactory() {
  managed_taplo_external_command=$1
  read_managed_taplo_version "$managed_taplo_external_command" || return 1
  version_at_least "$managed_taplo_version" 0.10.0 || return 1
  bounded_command_succeeds \
    "$managed_taplo_external_command" lsp stdio --help
}

managed_taplo_layout_is_exact() {
  [ -d "$managed_taplo_target" ] \
    && [ ! -L "$managed_taplo_target" ] \
    && [ -f "$managed_taplo_target/taplo" ] \
    && [ ! -L "$managed_taplo_target/taplo" ] \
    && [ -x "$managed_taplo_target/taplo" ] \
    && [ -L "$managed_taplo_link" ] \
    || return 1
  managed_taplo_entries=$(find "$managed_taplo_target" \
    -mindepth 1 -maxdepth 1 -printf '%f\n') || return 1
  [ "$managed_taplo_entries" = taplo ] || return 1
  managed_taplo_link_source=$(readlink -- "$managed_taplo_link") || return 1
  [ "$managed_taplo_link_source" = "$managed_taplo_target/taplo" ] || return 1
  managed_taplo_resolved=$(command -v taplo 2>/dev/null || true)
  [ "$managed_taplo_resolved" = "$managed_taplo_link" ] || return 1
  read_managed_taplo_version "$managed_taplo_link" || return 1
  [ "$managed_taplo_version" = "$taplo_fallback_version" ] || return 1
  bounded_command_succeeds "$managed_taplo_link" lsp stdio --help
}

prepare_managed_taplo_scope() {
  managed_taplo_manifest_root=$1
  validate_home_directory
  managed_architecture=$(normalized_architecture) || exit $?
  managed_taplo_target=$HOME/.local/opt/taplo-$taplo_fallback_version-$managed_architecture
  managed_taplo_link=$HOME/.local/bin/taplo
  load_managed_taplo_record "$managed_taplo_manifest_root"

  managed_taplo_command=$(command -v taplo 2>/dev/null || true)
  managed_taplo_target_exists=false
  managed_taplo_link_exists=false
  path_exists "$managed_taplo_target" && managed_taplo_target_exists=true
  path_exists "$managed_taplo_link" && managed_taplo_link_exists=true

  if [ "$managed_taplo_target_exists" = false ] \
    && [ "$managed_taplo_link_exists" = false ]; then
    if [ -n "$managed_taplo_command" ]; then
      managed_taplo_external_is_satisfactory "$managed_taplo_command" \
        || die "existing Taplo command is unsatisfactory: $managed_taplo_command"
      managed_taplo_state=satisfied-external
    else
      case :${PATH:-}: in
        *:"$HOME/.local/bin":*) ;;
        *) die 'managed Taplo activation directory is not present in PATH' ;;
      esac
      require_managed_parent_directory "$HOME/.local"
      require_managed_parent_directory "$HOME/.local/bin"
      require_managed_parent_directory "$HOME/.local/opt"
      managed_taplo_state=missing
    fi
  elif managed_taplo_layout_is_exact; then
    require_managed_parent_directory "$HOME/.local"
    require_managed_parent_directory "$HOME/.local/bin"
    require_managed_parent_directory "$HOME/.local/opt"
    managed_taplo_state=satisfied-managed
  else
    die 'conflicting managed Taplo state'
  fi
}

emit_managed_taplo_plan() {
  case $managed_taplo_state in
    satisfied-external) managed_taplo_action='skip external' ;;
    satisfied-managed) managed_taplo_action='skip managed' ;;
    missing) managed_taplo_action=install ;;
    *) die "unsupported managed Taplo state: $managed_taplo_state" ;;
  esac
  printf '%s\n' \
    "Mode: $mode" \
    'Platform: linux' \
    "Architecture: $managed_architecture" \
    'Managed tool: taplo' \
    "Version: $managed_taplo_asset_version" \
    "Source: $managed_taplo_asset_url" \
    "Target: $managed_taplo_target" \
    "Link: $managed_taplo_link" \
    "State: $managed_taplo_state" \
    "Action: $managed_taplo_action"
}

remove_managed_taplo_publish_storage() {
  scoped_staging_cleanup_status=0
  for scoped_staging_kind in link target; do
    case $scoped_staging_kind in
      link)
        scoped_staging_path=$managed_taplo_link_tmp
        scoped_staging_identity=$managed_taplo_link_tmp_identity
        scoped_staging_parent=bin
        ;;
      target)
        scoped_staging_path=$managed_taplo_publish_tmp
        scoped_staging_identity=$managed_taplo_publish_tmp_identity
        scoped_staging_parent=opt
        ;;
    esac
    [ -n "$scoped_staging_path" ] || continue
    scoped_staging_parent=$HOME/.local/$scoped_staging_parent
    case $scoped_staging_path in
      "$scoped_staging_parent"/dotfiles-bootstrap.*) ;;
      *) scoped_staging_cleanup_status=1; continue ;;
    esac
    if [ ! -d "$scoped_staging_path" ] || [ -L "$scoped_staging_path" ] \
      || [ "$(stat -c '%d:%i:%f:%w' "$scoped_staging_path")" != "$scoped_staging_identity" ]; then
      printf 'bootstrap: refusing cleanup of replaced Taplo staging storage: %s\n' \
        "$scoped_staging_path" >&2
      scoped_staging_cleanup_status=1
      continue
    fi
    if ! rm -rf -- "$scoped_staging_path"; then
      scoped_staging_cleanup_status=1
      continue
    fi
    case $scoped_staging_kind in
      link) managed_taplo_link_tmp=; managed_taplo_link_tmp_identity= ;;
      target) managed_taplo_publish_tmp=; managed_taplo_publish_tmp_identity= ;;
    esac
  done
  return "$scoped_staging_cleanup_status"
}

prepare_managed_taplo_publication_storage() {
  managed_taplo_publish_root=$1
  scoped_stage_device=$(stat -c '%d' "$managed_taplo_publish_root") \
    || die 'could not identify Taplo staging filesystem'
  scoped_target_device=$(stat -c '%d' "$HOME/.local/opt") \
    || die 'could not identify Taplo destination filesystem'
  [ "$scoped_stage_device" != "$scoped_target_device" ] || return 0

  # GNU mv copies on EXDEV. Copy inside an owned private directory first so
  # only the final same-filesystem rename exposes the verified executable.
  begin_cleanup_registration_critical
  managed_taplo_publish_tmp=$(TMPDIR=$HOME/.local/opt temporary_directory) || {
    finish_cleanup_registration_critical
    die 'could not create Taplo publication staging storage'
  }
  managed_taplo_publish_tmp_identity=$(stat -c '%d:%i:%f:%w' "$managed_taplo_publish_tmp") \
    || die 'could not identify Taplo publication staging storage'
  finish_cleanup_registration_critical
  cp -pR "$managed_taplo_publish_root/taplo.ready" "$managed_taplo_publish_tmp/taplo.ready" \
    || die 'could not copy verified Taplo to the destination filesystem'
  scoped_copied_hash=$(file_sha256 "$managed_taplo_publish_tmp/taplo.ready/taplo") \
    || die 'could not checksum copied Taplo'
  [ -n "$scoped_copied_hash" ] \
    && [ "$scoped_copied_hash" = "$(file_sha256 "$managed_taplo_publish_root/taplo.ready/taplo")" ] \
    || die 'copied Taplo checksum does not match verified staging'
  managed_taplo_publish_root=$managed_taplo_publish_tmp
}

prepare_managed_taplo_link_storage() {
  managed_taplo_link_root=$managed_taplo_publish_root
  scoped_link_source_device=$(stat -c '%d' "$managed_taplo_link_root") \
    || die 'could not identify Taplo link staging filesystem'
  scoped_link_target_device=$(stat -c '%d' "$HOME/.local/bin") \
    || die 'could not identify Taplo activation filesystem'
  [ "$scoped_link_source_device" != "$scoped_link_target_device" ] || return 0
  begin_cleanup_registration_critical
  managed_taplo_link_tmp=$(TMPDIR=$HOME/.local/bin temporary_directory) || {
    finish_cleanup_registration_critical
    die 'could not create Taplo link staging storage'
  }
  managed_taplo_link_tmp_identity=$(stat -c '%d:%i:%f:%w' "$managed_taplo_link_tmp") \
    || die 'could not identify Taplo link staging storage'
  finish_cleanup_registration_critical
  managed_taplo_link_root=$managed_taplo_link_tmp
}

publish_managed_taplo_scope() {
  managed_publish_root=$1
  managed_publish_active=true
  create_managed_parent_directory "$HOME/.local"
  create_managed_parent_directory "$HOME/.local/bin"
  create_managed_parent_directory "$HOME/.local/opt"
  prepare_managed_taplo_publication_storage "$managed_publish_root"
  prepare_managed_taplo_link_storage
  publish_managed_directory \
    "$managed_taplo_publish_root/taplo.ready" "$managed_taplo_target" taplo-directory
  publish_managed_link "$managed_taplo_target/taplo" "$managed_taplo_link"
  maybe_fail_managed_publication taplo-link
}

apply_managed_taplo_scope() {
  prepare_managed_taplo_scope "$1"
  emit_managed_taplo_plan
  case $managed_taplo_state in
    satisfied-external|satisfied-managed) return 0 ;;
    missing) ;;
    *) die "unsupported managed Taplo state: $managed_taplo_state" ;;
  esac

  begin_cleanup_registration_critical
  start_package_tracking
  managed_created_identities_file=$package_actions_tmp/managed-created.identities
  : >"$managed_created_identities_file" \
    || die 'could not initialize managed Taplo identity journal'
  finish_cleanup_registration_critical
  begin_cleanup_registration_critical
  managed_stage_root=$(temporary_directory) || {
    finish_cleanup_registration_critical
    die 'could not create managed Taplo staging storage'
  }
  active_package_tmp=$managed_stage_root
  finish_cleanup_registration_critical
  stage_taplo "$1" "$managed_stage_root"
  publish_managed_taplo_scope "$managed_stage_root"
  prepare_managed_taplo_scope "$1"
  [ "$managed_taplo_state" = satisfied-managed ] \
    || die 'published managed Taplo failed final validation'
  record_package_action direct taplo
  remove_managed_taplo_publish_storage \
    || die 'could not remove managed Taplo publication staging storage'
  managed_publish_active=false
  remove_temporary_directory "$managed_stage_root"
  active_package_tmp=
}

run_managed_tool_mode() {
  managed_tool_platform=$1
  managed_tool_manifest_root=$2
  [ "$managed_tool_platform" = linux ] \
    || die 'managed tool taplo is supported only on Linux'
  # This helper is platform-neutral despite its legacy Debian name.
  require_debian_probe_runtime || exit 1
  case $mode in
    dry-run)
      prepare_managed_taplo_scope "$managed_tool_manifest_root"
      emit_managed_taplo_plan
      ;;
    apply) apply_managed_taplo_scope "$managed_tool_manifest_root" ;;
    *) die "unsupported managed Taplo mode: $mode" ;;
  esac
}

prepare_debian_language_servers() {
  managed_manifest_root=$1
  managed_node_required=false
  managed_lua_required=false
  managed_bash_required=false
  managed_json_required=false
  managed_pyright_required=false
  managed_taplo_required=false
  managed_yaml_required=false
  managed_npm_required=false
  managed_architecture=
  managed_node_target=
  managed_lua_target=
  managed_taplo_target=
  validate_home_directory

  tool_is_satisfied node 22.0.0 \
    && tool_is_satisfied npm 10.0.0 \
    || managed_node_required=true
  language_server_is_satisfied bash-language-server \
    || managed_bash_required=true
  language_server_is_satisfied vscode-json-language-server \
    || managed_json_required=true
  language_server_is_satisfied lua-language-server \
    || managed_lua_required=true
  language_server_is_satisfied pyright-langserver \
    || managed_pyright_required=true
  language_server_is_satisfied taplo \
    || managed_taplo_required=true
  language_server_is_satisfied yaml-language-server \
    || managed_yaml_required=true

  if [ "$managed_bash_required" = true ] \
    || [ "$managed_json_required" = true ] \
    || [ "$managed_pyright_required" = true ] \
    || [ "$managed_yaml_required" = true ]; then
    managed_npm_required=true
  fi

  if [ "$managed_node_required" = true ] \
    || [ "$managed_lua_required" = true ] \
    || [ "$managed_taplo_required" = true ]; then
    managed_architecture=$(normalized_architecture) || exit $?
  fi
  if [ "$managed_node_required" = true ]; then
    managed_node_target=$HOME/.local/opt/node-$node_fallback_version-$managed_architecture
  fi
  if [ "$managed_lua_required" = true ]; then
    managed_lua_target=$HOME/.local/opt/lua-language-server-$luals_fallback_version-$managed_architecture
  fi
  if [ "$managed_taplo_required" = true ]; then
    managed_taplo_target=$HOME/.local/opt/taplo-$taplo_fallback_version-$managed_architecture
  fi
  managed_lock_sha256=$npm_language_servers_lock_sha256
  case "$managed_lock_sha256" in
    ''|*[!0-9a-f]*) die 'invalid embedded npm language-server lock SHA-256' ;;
  esac
  [ "${#managed_lock_sha256}" -eq 64 ] \
    || die 'invalid embedded npm language-server lock SHA-256 length'
  if [ -n "$managed_manifest_root" ]; then
    actual_lock_sha256=$(file_sha256 \
      "$managed_manifest_root/packages-npm-language-servers-lock.json")
    [ "$actual_lock_sha256" = "$managed_lock_sha256" ] \
      || die 'npm language-server lockfile does not match the embedded SHA-256'
  fi
  managed_npm_target=$HOME/.local/opt/dotfiles-lsp-node-$managed_lock_sha256

  if [ "$managed_node_required" = true ] \
    || [ "$managed_lua_required" = true ] \
    || [ "$managed_taplo_required" = true ] \
    || [ "$managed_npm_required" = true ]; then
    require_managed_parent_directory "$HOME/.local"
    require_managed_parent_directory "$HOME/.local/bin"
    require_managed_parent_directory "$HOME/.local/opt"
  fi

  if [ "$managed_node_required" = true ]; then
    require_managed_target_free "$managed_node_target"
    require_managed_target_free "$HOME/.local/bin/node"
    require_managed_target_free "$HOME/.local/bin/npm"
  fi
  if [ "$managed_lua_required" = true ]; then
    require_managed_target_free "$managed_lua_target"
    require_managed_target_free "$HOME/.local/bin/lua-language-server"
  fi
  if [ "$managed_taplo_required" = true ]; then
    require_managed_target_free "$managed_taplo_target"
    require_managed_target_free "$HOME/.local/bin/taplo"
  fi
  if [ "$managed_npm_required" = true ]; then
    require_managed_target_free "$managed_npm_target"
  fi
  if [ "$managed_bash_required" = true ]; then
    require_managed_target_free "$HOME/.local/bin/bash-language-server"
  fi
  if [ "$managed_json_required" = true ]; then
    require_managed_target_free "$HOME/.local/bin/vscode-json-language-server"
  fi
  if [ "$managed_pyright_required" = true ]; then
    require_managed_target_free "$HOME/.local/bin/pyright-langserver"
  fi
  if [ "$managed_yaml_required" = true ]; then
    require_managed_target_free "$HOME/.local/bin/yaml-language-server"
  fi
}

state_root_path() {
  state_base=${XDG_STATE_HOME:-$HOME/.local/state}
  case "$state_base" in
    /) die 'refusing to use the filesystem root as XDG_STATE_HOME' ;;
    /*) ;;
    *) die 'XDG_STATE_HOME must be an absolute path when set' ;;
  esac
  printf '%s\n' "$state_base/dotfiles-bootstrap"
}

append_journal_path() {
  journal_file=$1
  journal_path=$2
  validate_manifest_path "$journal_path" \
    || die 'empty journal path is not allowed'
  printf '%s\n' "$journal_path" >>"$journal_file" \
    || die "could not append transaction journal: $journal_file"
}

git_is_ready() {
  command -v git >/dev/null 2>&1 \
    && git --version </dev/null >/dev/null 2>&1
}

require_git_capabilities() {
  git_is_ready || die 'Git is required to prepare the dotfiles repository'
  available_git_version=$(command_version git)
  [ -n "$available_git_version" ] \
    || die 'could not determine the installed Git version'
  version_at_least "$available_git_version" 2.34.0 \
    || die "Git 2.34.0 or newer is required; found $available_git_version"
}

install_standalone_git() {
  standalone_manager=$1
  printf '%s\n' 'Bootstrapping Git for the standalone installer:'
  case "$standalone_manager" in
    apt)
      if ! apt_offers_ghostty \
        && [ "$allow_community_packages" != true ]; then
        die 'Ghostty is unavailable from configured apt repositories; rerun with --allow-community-packages before the standalone installer changes packages' 4
      fi
      run_privileged_command apt-get update \
        || die 'apt index refresh failed while bootstrapping Git'
      run_privileged_command apt-get install -y --no-install-recommends --no-remove \
        ca-certificates curl git \
        || die 'apt could not bootstrap Git'
      for standalone_apt_package in ca-certificates curl git; do
        record_package_action apt "$standalone_apt_package"
      done
      ;;
    pacman)
      printf '%s\n' \
        'bootstrap: Git is required. Run this command, then rerun bootstrap:' \
        '  sudo pacman -Syu --needed ca-certificates curl git' >&2
      exit 4
      ;;
    homebrew)
      if ! command -v brew >/dev/null 2>&1; then
        standalone_brew_tmp=$(temporary_directory) \
          || die 'could not create temporary standalone Homebrew storage'
        active_package_tmp=$standalone_brew_tmp
        standalone_brew_installer=$standalone_brew_tmp/install.sh
        download_verified \
          'https://raw.githubusercontent.com/Homebrew/install/a34ae4ee9151cbce4c3b33bca7043a972b7ae9a5/install.sh' \
          '12479a24be3f5307eecac7cde670fad7118640f031229e964f544b1367b52a41' \
          "$standalone_brew_installer"
        NONINTERACTIVE=1 /bin/bash "$standalone_brew_installer" \
          || die 'Homebrew installation failed while bootstrapping Git'
        record_package_action installer homebrew
        remove_temporary_directory "$standalone_brew_tmp"
        active_package_tmp=
        activate_homebrew_path \
          || die 'Homebrew installed but is unavailable on PATH'
      fi
      run_command brew install git \
        || die 'Homebrew could not bootstrap Git'
      record_package_action homebrew-formula git
      ;;
    *) die "unsupported standalone Git bootstrap manager: $standalone_manager" ;;
  esac
  git_is_ready || die 'Git installation completed but Git is still unavailable'
}

load_remote_manifests() {
  require_git_capabilities
  manifest_temp_root=$(temporary_directory) \
    || die 'could not create temporary standalone manifest storage'
  manifest_gitdir=$manifest_temp_root/source.git
  manifest_source=$manifest_temp_root/bootstrap-source
  manifest_destination=$manifest_source/manifests
  mkdir -p "$manifest_destination" \
    || die 'could not create temporary standalone manifest storage'

  git init --quiet --bare "$manifest_gitdir" \
    || die 'could not initialize standalone manifest repository'
  git --git-dir="$manifest_gitdir" remote add origin "$repo_url" \
    || die 'could not configure standalone manifest remote'
  git --git-dir="$manifest_gitdir" config remote.origin.fetch \
    '+refs/heads/*:refs/remotes/origin/*' \
    || die 'could not configure standalone manifest fetch mapping'
  git --git-dir="$manifest_gitdir" fetch --quiet --no-tags origin "$repo_ref" \
    || die "could not fetch manifests from repository reference: $repo_ref"
  manifest_commit=$(git --git-dir="$manifest_gitdir" \
    rev-parse --verify 'FETCH_HEAD^{commit}') \
    || die "standalone repository reference is not a commit: $repo_ref"
  verify_expected_commit "$manifest_commit"

  for manifest_name in \
    config-common.paths \
    config-excluded.paths \
    config-linux-hypr.paths \
    config-linux-i3.paths \
    config-linux.paths \
    config-macos-aerospace.paths \
    config-macos.paths \
    installers.tsv \
    packages-apt-i3.list \
    packages-apt.list \
    packages-direct.tsv \
    packages-homebrew-aerospace-casks.list \
    packages-homebrew-casks.list \
    packages-homebrew-formulae.list \
    packages-npm-language-servers.json \
    packages-npm-language-servers-lock.json \
    packages-pacman-hypr.list \
    packages-pacman-i3.list \
    packages-pacman.list \
    window-manager-bindings.tsv
  do
    git --git-dir="$manifest_gitdir" show \
      "$manifest_commit:.config/dotfiles/manifests/$manifest_name" \
      >"$manifest_destination/$manifest_name" \
      || die "repository is missing standalone manifest: $manifest_name"
  done
  script_dir=$manifest_source
}

verify_expected_commit() {
  [ -z "$expected_commit" ] || [ "$1" = "$expected_commit" ] \
    || die 'repository changed from the expected commit; preview again before applying'
}

prepare_repository() {
  selected_platform=$1
  selected_window_manager=$2
  manifest_root=$3
  require_git_capabilities

  prepared_root=$(temporary_directory) \
    || die 'could not create temporary repository preparation storage'
  prepared_gitdir=$prepared_root/repository.git
  prepared_worktree=$prepared_root/worktree
  prepared_selected_paths=$prepared_root/selected.paths
  prepared_patterns=$prepared_root/sparse.paths
  prepared_tree_paths=$prepared_root/tree.paths
  mkdir "$prepared_worktree" || die 'could not create the repository staging worktree'

  if [ -n "$manifest_gitdir" ] && [ -d "$manifest_gitdir" ]; then
    mv "$manifest_gitdir" "$prepared_gitdir" \
      || die 'could not reuse the standalone repository fetch'
    manifest_gitdir=
    prepared_commit=$manifest_commit
  else
    git init --quiet --bare "$prepared_gitdir" \
      || die 'could not initialize temporary repository metadata'
    git --git-dir="$prepared_gitdir" remote add origin "$repo_url" \
      || die 'could not configure the dotfiles repository remote'
    git --git-dir="$prepared_gitdir" fetch --quiet --no-tags origin "$repo_ref" \
      || die "could not fetch repository reference: $repo_ref"
    prepared_commit=$(git --git-dir="$prepared_gitdir" rev-parse --verify 'FETCH_HEAD^{commit}') \
      || die "repository reference is not a commit: $repo_ref"
  fi
  verify_expected_commit "$prepared_commit"
  git --git-dir="$prepared_gitdir" config remote.origin.fetch \
    '+refs/heads/*:refs/remotes/origin/*' \
    || die 'could not configure the repository fetch mapping'

  prepared_upstream=
  case "$repo_ref" in
    refs/heads/*)
      prepared_branch=${repo_ref#refs/heads/}
      prepared_upstream=refs/heads/$prepared_branch
      ;;
    *)
      prepared_branch=$repo_ref
      if git --git-dir="$prepared_gitdir" show-ref --verify --quiet \
        "refs/remotes/origin/$prepared_branch"; then
        prepared_upstream=refs/heads/$prepared_branch
      else
        prepared_branch=dotfiles-bootstrap
      fi
      ;;
  esac
  if ! git check-ref-format --branch "$prepared_branch" >/dev/null 2>&1; then
    prepared_branch=dotfiles-bootstrap
    prepared_upstream=
  fi
  git --git-dir="$prepared_gitdir" update-ref "refs/heads/$prepared_branch" "$prepared_commit" \
    || die 'could not create the local dotfiles branch'
  git --git-dir="$prepared_gitdir" symbolic-ref HEAD "refs/heads/$prepared_branch" \
    || die 'could not select the local dotfiles branch'
  if [ -n "$prepared_upstream" ]; then
    git --git-dir="$prepared_gitdir" config "branch.$prepared_branch.remote" origin \
      || die 'could not configure the local branch remote'
    git --git-dir="$prepared_gitdir" config "branch.$prepared_branch.merge" "$prepared_upstream" \
      || die 'could not configure the local branch upstream'
  fi

  emit_selected_paths \
    "$selected_platform" "$selected_window_manager" "$manifest_root" \
    >"$prepared_patterns" \
    || die 'could not write sparse checkout patterns'
  git --git-dir="$prepared_gitdir" --work-tree="$prepared_worktree" \
    checkout --quiet --force "$prepared_branch" \
    || die 'could not materialize the selected repository configuration'
  git --git-dir="$prepared_gitdir" --work-tree="$prepared_worktree" \
    sparse-checkout set --no-cone --no-sparse-index --stdin <"$prepared_patterns" \
    || die 'could not configure the exact-file sparse checkout'
  git --git-dir="$prepared_gitdir" ls-tree -r --name-only "$prepared_commit" \
    >"$prepared_tree_paths" \
    || die 'could not enumerate repository paths'
  : >"$prepared_selected_paths" \
    || die 'could not initialize selected repository path list'
  while IFS= read -r tree_path || [ -n "$tree_path" ]; do
    validate_manifest_path "$tree_path" \
      || die 'empty repository path is not allowed'
    tree_path_selected=false
    while IFS= read -r allowed_path || [ -n "$allowed_path" ]; do
      validate_manifest_path "$allowed_path" || continue
      case "$tree_path" in
        "$allowed_path"|"$allowed_path"/*)
          tree_path_selected=true
          break
          ;;
      esac
    done <"$prepared_patterns"
    if [ "$tree_path_selected" = true ]; then
      printf '%s\n' "$tree_path" >>"$prepared_selected_paths" \
        || die 'could not record a selected repository path'
    fi
  done <"$prepared_tree_paths"
  [ -s "$prepared_selected_paths" ] \
    || die 'the selected platform manifest matched no tracked files'

  while IFS= read -r required_path || [ -n "$required_path" ]; do
    validate_manifest_path "$required_path" || continue
    required_path_matched=false
    while IFS= read -r selected_match || [ -n "$selected_match" ]; do
      case "$selected_match" in
        "$required_path"|"$required_path"/*)
          required_path_matched=true
          break
          ;;
      esac
    done <"$prepared_selected_paths"
    [ "$required_path_matched" = true ] \
      || die "platform manifest path matches no tracked file: $required_path"
  done <"$prepared_patterns"

  while IFS= read -r selected_path || [ -n "$selected_path" ]; do
    validate_manifest_path "$selected_path" \
      || die 'empty selected repository path is not allowed'
    while IFS= read -r excluded_path || [ -n "$excluded_path" ]; do
      validate_manifest_path "$excluded_path" || continue
      case "$selected_path" in
        "$excluded_path"|"$excluded_path"/*)
          die "excluded path was selected by the sparse checkout: $selected_path"
          ;;
      esac
    done <"$manifest_root/config-excluded.paths"
  done <"$prepared_selected_paths"

  for required_bootstrap_path in \
    .config/dotfiles/bootstrap \
    .config/dotfiles/dotfiles
  do
    grep -Fqx "$required_bootstrap_path" "$prepared_selected_paths" \
      || die "repository is missing required bootstrap file: $required_bootstrap_path"
  done
}

emit_conflict_once() {
  conflict_relative=$1
  if grep -Fqx "$conflict_relative" "$prepared_conflicts" 2>/dev/null; then
    return 0
  fi
  printf '%s\n' "$conflict_relative" >>"$prepared_conflicts" \
    || die 'could not record a dry-run conflict'
  printf '  conflict %s\n' "$conflict_relative"
}

scan_selected_conflict() {
  scan_relative=$1
  scan_parent=$(dirname "$scan_relative")
  if [ "$scan_parent" != . ]; then
    scan_old_ifs=$IFS
    IFS=/
    set -f
    # shellcheck disable=SC2086 # Intentional split on validated path separators.
    set -- $scan_parent
    set +f
    IFS=$scan_old_ifs
    scan_current=
    for scan_component do
      if [ -n "$scan_current" ]; then
        scan_current=$scan_current/$scan_component
      else
        scan_current=$scan_component
      fi
      scan_target=$HOME/$scan_current
      if path_exists "$scan_target" \
        && { [ ! -d "$scan_target" ] || [ -L "$scan_target" ]; }; then
        emit_conflict_once "$scan_current"
        return 0
      fi
    done
  fi
  if path_exists "$HOME/$scan_relative"; then
    emit_conflict_once "$scan_relative"
  fi
}

emit_conflict_plan() {
  selected_window_manager=$1
  validate_home_directory
  prepared_conflicts=$prepared_root/conflicts.paths
  : >"$prepared_conflicts" \
    || die 'could not initialize dry-run conflict list'
  printf '%s\n' 'Conflicts to back up during apply:'
  scan_selected_conflict .cfg
  scan_selected_conflict .local/bin/dotfiles
  scan_selected_conflict .local/bin/tmux-workspace
  case "$selected_window_manager" in
    hypr) scan_selected_conflict .config/hypr/hyprland.conf ;;
    aerospace) scan_selected_conflict .aerospace.toml ;;
  esac
  while IFS= read -r conflict_candidate || [ -n "$conflict_candidate" ]; do
    scan_selected_conflict "$conflict_candidate"
  done <"$prepared_selected_paths"
  if [ ! -s "$prepared_conflicts" ]; then
    printf '%s\n' '  none'
  fi
}

boolean_value() {
  boolean_name=$1
  boolean_candidate=$2
  case $boolean_candidate in
    true|false) printf '%s\n' "$boolean_candidate" ;;
    *) die "$boolean_name must be true or false" ;;
  esac
}

emit_selected_services() {
  case "$1:$2" in
    linux:hypr) printf '%s\n' tmux-workspace.service cliphist.service ;;
    linux:*) printf '%s\n' tmux-workspace.service ;;
    macos:*) printf '%s\n' dev.ruohao.tmux-workspace ;;
    *) return 1 ;;
  esac
}

validate_service_identifier() {
  case "$1:$2" in
    linux:tmux-workspace.service|linux:cliphist.service|macos:dev.ruohao.tmux-workspace) return 0 ;;
    *) return 1 ;;
  esac
}

validate_service_inventory() {
  inventory_platform=$1
  inventory_file=$2
  [ -f "$inventory_file" ] && [ ! -L "$inventory_file" ] && [ -s "$inventory_file" ] || return 1
  inventory_seen=' '
  while IFS= read -r inventory_service || [ -n "$inventory_service" ]; do
    validate_service_identifier "$inventory_platform" "$inventory_service" || return 1
    case "$inventory_seen" in *" $inventory_service "*) return 1 ;; esac
    inventory_seen="$inventory_seen$inventory_service "
  done <"$inventory_file"
}

service_unit_path() {
  case "$1:${2:-tmux-workspace.service}" in
    linux:tmux-workspace.service) printf '%s\n' "$HOME/.config/systemd/user/tmux-workspace.service" ;;
    linux:cliphist.service)
      if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
        # Test mode never silently falls back to a host unit.
        case ${DOTFILES_BOOTSTRAP_TEST_CLIPHIST_UNIT_PATH:-} in
          /*) printf '%s\n' "$DOTFILES_BOOTSTRAP_TEST_CLIPHIST_UNIT_PATH" ;;
          *) return 1 ;;
        esac
      else
        printf '%s\n' /usr/lib/systemd/user/cliphist.service
      fi
      ;;
    macos:*) printf '%s\n' "$HOME/Library/LaunchAgents/dev.ruohao.tmux-workspace.plist" ;;
    *) return 1 ;;
  esac
}

service_domain() {
  printf 'gui/%s\n' "$(id -u)"
}

require_service_manager() {
  service_platform=$1
  [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] && return 0
  case "$service_platform" in
    linux)
      command -v systemctl >/dev/null 2>&1 \
        || die 'systemctl is required to activate the Linux user service'
      ;;
    macos)
      command -v launchctl >/dev/null 2>&1 \
        || die 'launchctl is required to activate the macOS LaunchAgent'
      ;;
    *) die "unsupported service platform: $service_platform" ;;
  esac
}

record_initial_service_state() {
  service_platform=$1
  service_profile=$2
  printf '%s\n' "$service_platform" >"$transaction_run/service-platform"
  printf '%s\n' 2 >"$transaction_run/service-journal-version"
  printf '%s\n' false >"$transaction_run/service-manager-reloaded"
  emit_selected_services "$service_platform" "$service_profile" >"$transaction_run/services.list" \
    || die 'could not select login services'
  validate_service_inventory "$service_platform" "$transaction_run/services.list" \
    || die 'invalid login service inventory'
  : >"$transaction_run/service-actions.log"
  while IFS= read -r selected_service; do
    service_state=$transaction_run/services/$selected_service
    mkdir -p "$service_state" || die 'could not create service journal'
    service_was_installed=false
    service_target=$(service_unit_path "$service_platform" "$selected_service") || service_target=
    [ -n "$service_target" ] && path_exists "$service_target" && service_was_installed=true
    service_was_enabled=false
    service_was_active=false
    if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
      case $selected_service in
        cliphist.service)
          service_was_installed=${DOTFILES_BOOTSTRAP_TEST_CLIPHIST_INSTALLED:-$service_was_installed}
          service_was_enabled=${DOTFILES_BOOTSTRAP_TEST_CLIPHIST_ENABLED:-false}
          service_was_active=${DOTFILES_BOOTSTRAP_TEST_CLIPHIST_ACTIVE:-false}
          ;;
        tmux-workspace.service)
          service_was_installed=${DOTFILES_BOOTSTRAP_TEST_SERVICE_INSTALLED:-$service_was_installed}
          service_was_enabled=${DOTFILES_BOOTSTRAP_TEST_SERVICE_ENABLED:-false}
          service_was_active=${DOTFILES_BOOTSTRAP_TEST_SERVICE_ACTIVE:-false}
          ;;
        dev.ruohao.tmux-workspace)
          service_was_installed=${DOTFILES_BOOTSTRAP_TEST_SERVICE_INSTALLED:-$service_was_installed}
          service_was_active=${DOTFILES_BOOTSTRAP_TEST_SERVICE_LOADED:-false}
          ;;
      esac
    else
      case $service_platform in
        linux)
          systemctl --user is-enabled --quiet "$selected_service" >/dev/null 2>&1 && service_was_enabled=true
          systemctl --user is-active --quiet "$selected_service" >/dev/null 2>&1 && service_was_active=true
          ;;
        macos)
          launchctl print "$(service_domain)/$selected_service" >/dev/null 2>&1 && service_was_active=true
          ;;
      esac
    fi
    boolean_value was-installed "$service_was_installed" >"$service_state/was-installed" || die 'invalid installed service state'
    boolean_value was-enabled "$service_was_enabled" >"$service_state/was-enabled" || die 'invalid enabled service state'
    boolean_value was-active "$service_was_active" >"$service_state/was-active" || die 'invalid active service state'
    for service_flag in enabled-by-transaction started-by-transaction new-loaded; do
      printf '%s\n' false >"$service_state/$service_flag"
    done
  done <"$transaction_run/services.list"
}

begin_transaction() {
  selected_platform=$1
  selected_manager=$2
  selected_window_manager=$3
  validate_home_directory
  mkdir -p "$HOME" || die "could not create HOME: $HOME"

  transaction_state_root=$(state_root_path)
  mkdir -p "$transaction_state_root" \
    || die "could not create transaction state: $transaction_state_root"

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ -n "${DOTFILES_BOOTSTRAP_TEST_RUN_ID:-}" ]; then
    transaction_id=$DOTFILES_BOOTSTRAP_TEST_RUN_ID
  else
    transaction_id=$(date -u '+%Y%m%dT%H%M%SZ')-$$
  fi
  case "$transaction_id" in
    ''|*[!A-Za-z0-9._-]*) die 'generated transaction ID contains unsupported characters' ;;
  esac

  transaction_run=$transaction_state_root/$transaction_id
  [ ! -e "$transaction_run" ] \
    || die "transaction already exists: $transaction_id"
  mkdir -p \
    "$transaction_run/backup" \
    "$transaction_run/rollback-current" \
    || die 'could not create the transaction journal'
  {
    : >"$transaction_run/backed-up.paths" \
      && : >"$transaction_run/managed.paths" \
      && : >"$transaction_run/created-directories.paths" \
      && printf '%s\n' active >"$transaction_run/status" \
      && printf '%s\n' "$repo_url" >"$transaction_run/repository" \
      && printf '%s\n' "$repo_ref" >"$transaction_run/reference" \
      && printf '%s\n' "$prepared_commit" >"$transaction_run/commit" \
      && printf '%s\n' "$selected_platform" >"$transaction_run/platform" \
      && printf '%s\n' "$selected_manager" >"$transaction_run/package-manager" \
      && printf '%s\n' "$selected_window_manager" >"$transaction_run/window-manager"
  } || die 'could not initialize transaction metadata'
  record_initial_service_state "$selected_platform" "$selected_window_manager"
  printf '%s\n' \
    'Package changes are retained during rollback.' \
    "Package manager: $selected_manager" \
    'Retained package actions:' \
    >"$transaction_run/packages-retained.txt" \
    || die 'could not initialize retained package report'
  if [ -s "$package_actions_file" ]; then
    while IFS= read -r retained_action || [ -n "$retained_action" ]; do
      printf '%s\n' "$retained_action" >>"$transaction_run/packages-retained.txt" \
        || die 'could not write retained package report'
    done <"$package_actions_file"
  else
    printf '%s\n' none >>"$transaction_run/packages-retained.txt" \
      || die 'could not write retained package report'
  fi
  transaction_active=true
}

backup_existing_path() {
  backup_relative=$1
  backup_target=$HOME/$backup_relative
  path_exists "$backup_target" || return 0
  if grep -Fqx "$backup_relative" "$transaction_run/backed-up.paths" 2>/dev/null; then
    return 0
  fi

  backup_destination=$transaction_run/backup/$backup_relative
  mkdir -p "$(dirname "$backup_destination")" \
    || die "could not create backup parent for: $backup_relative"
  append_journal_path "$transaction_run/backed-up.paths" "$backup_relative"
  mv "$backup_target" "$backup_destination" \
    || die "could not back up conflicting path: $backup_relative"
  printf '  backed up %s\n' "$backup_relative"
}

ensure_target_parents() {
  parents_path=$1
  parents_relative=$(dirname "$parents_path")
  [ "$parents_relative" != . ] || return 0

  parents_old_ifs=$IFS
  IFS=/
  set -f
  # shellcheck disable=SC2086 # Intentional split on validated path separators.
  set -- $parents_relative
  set +f
  IFS=$parents_old_ifs
  parents_current=
  for parents_component do
    if [ -n "$parents_current" ]; then
      parents_current=$parents_current/$parents_component
    else
      parents_current=$parents_component
    fi
    parents_target=$HOME/$parents_current
    if path_exists "$parents_target"; then
      if [ -d "$parents_target" ] && [ ! -L "$parents_target" ]; then
        continue
      fi
      backup_existing_path "$parents_current"
    fi
    if ! path_exists "$parents_target"; then
      append_journal_path "$transaction_run/created-directories.paths" "$parents_current"
      mkdir "$parents_target" \
        || die "could not create configuration directory: $parents_current"
    fi
  done
}

deploy_selected_file() {
  deploy_relative=$1
  deploy_source=$prepared_worktree/$deploy_relative
  deploy_target=$HOME/$deploy_relative
  ensure_target_parents "$deploy_relative"
  backup_existing_path "$deploy_relative"
  append_journal_path "$transaction_run/managed.paths" "$deploy_relative"

  if [ -L "$deploy_source" ]; then
    deploy_link=$(readlink "$deploy_source") \
      || die "could not read repository symlink: $deploy_relative"
    ln -s "$deploy_link" "$deploy_target" \
      || die "could not deploy repository symlink: $deploy_relative"
  elif [ -f "$deploy_source" ]; then
    cp -p "$deploy_source" "$deploy_target" \
      || die "could not deploy repository file: $deploy_relative"
  else
    die "repository path is not a regular file or symlink: $deploy_relative"
  fi
}

install_repository_metadata() {
  backup_existing_path .cfg
  append_journal_path "$transaction_run/managed.paths" .cfg
  mv "$prepared_gitdir" "$HOME/.cfg" \
    || die 'could not install bare repository metadata at ~/.cfg'
  prepared_gitdir=
  git --git-dir="$HOME/.cfg" config status.showUntrackedFiles no \
    || die 'could not configure concise dotfiles status output'
}

install_command_link() {
  command_path=$1
  command_source=$2
  command_label=$3
  ensure_target_parents "$command_path"
  backup_existing_path "$command_path"
  append_journal_path "$transaction_run/managed.paths" "$command_path"
  [ -x "$command_source" ] \
    || die "deployed $command_label is missing or not executable"
  ln -s "$command_source" "$HOME/$command_path" \
    || die "could not install ~/$command_path"
}

install_command_links() {
  install_command_link \
    .local/bin/dotfiles \
    "$HOME/.config/dotfiles/dotfiles" \
    'dotfiles wrapper'
  install_command_link \
    .local/bin/tmux-workspace \
    "$HOME/.config/tmux/scripts/workspace" \
    'tmux workspace helper'
}

preflight_selected_service_assets() {
  preflight_transaction_service || die 'invalid service transaction journal'
  while IFS= read -r selected_service; do
    service_target=$(service_unit_path "$service_platform" "$selected_service") \
      || die 'could not resolve the selected service unit'
    [ -f "$service_target" ] && [ ! -L "$service_target" ] \
      || die 'selected service unit is missing or invalid'
    case $selected_service in
      tmux-workspace.service|dev.ruohao.tmux-workspace)
        [ -f "$HOME/.config/tmux/scripts/workspace" ] \
          && [ ! -L "$HOME/.config/tmux/scripts/workspace" ] \
          && [ -x "$HOME/.config/tmux/scripts/workspace" ] \
          || die 'deployed tmux workspace helper is not executable'
        ;;
      cliphist.service)
        for service_asset in .config/clipboard-history/store .config/cliphist/config .config/systemd/user/cliphist.service.d/override.conf; do
          [ -f "$HOME/$service_asset" ] && [ ! -L "$HOME/$service_asset" ] \
            || die 'deployed clipboard capture asset is missing or invalid'
        done
        [ -x "$HOME/.config/clipboard-history/store" ] || die 'deployed clipboard capture helper is not executable'
        ;;
    esac
  done <"$transaction_run/services.list"
}

clipboard_session_active() {
  [ -n "${WAYLAND_DISPLAY:-}" ] || return 1
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ]; then
    [ "${DOTFILES_BOOTSTRAP_TEST_GRAPHICAL_ACTIVE:-false}" = true ]
  else
    systemctl --user is-active --quiet graphical-session.target >/dev/null 2>&1
  fi
}

activate_login_service() {
  service_platform=$1
  preflight_selected_service_assets
  if [ "$service_platform" = linux ]; then
    printf '%s\n' true >"$transaction_run/service-manager-reloaded"
    run_service_command systemctl --user daemon-reload || die 'could not reload the systemd user manager'
  fi
  while IFS= read -r selected_service; do
    service_state=$transaction_run/services/$selected_service
    case $service_platform in
      linux)
        if [ "$(cat "$service_state/was-enabled")" = false ]; then
          # Journal intent before a command: a failed manager call may have partially succeeded.
          printf '%s\n' true >"$service_state/enabled-by-transaction"
          run_service_command systemctl --user enable "$selected_service" || die 'could not enable the selected user service'
        fi
        service_should_start=true
        if [ "$selected_service" = cliphist.service ] && ! clipboard_session_active; then
          service_should_start=false
          printf '%s\n' 'Clipboard capture is enabled; startup is deferred until a Wayland graphical session.'
        fi
        if [ "$service_should_start" = true ] && [ "$(cat "$service_state/was-active")" = false ]; then
          printf '%s\n' true >"$service_state/started-by-transaction"
          run_service_command systemctl --user start "$selected_service" || die 'could not start the selected user service'
        fi
        ;;
      macos)
        service_target_domain=$(service_domain)
        service_target=$(service_unit_path macos "$selected_service")
        if [ "$(cat "$service_state/was-active")" = true ]; then
          printf '%s\n' true >"$service_state/started-by-transaction"
          if ! run_service_command launchctl bootout "$service_target_domain/$selected_service"; then
            # A failed unload may leave the previous job intact. Do not reload it.
            if run_service_command launchctl print "$service_target_domain/$selected_service" >/dev/null 2>&1; then
              printf '%s\n' false >"$service_state/started-by-transaction"
            fi
            die 'could not unload the previous tmux workspace LaunchAgent'
          fi
        fi
        # Record load intent because bootstrap may fail after registering the job.
        printf '%s\n' true >"$service_state/new-loaded"
        run_service_command launchctl bootstrap "$service_target_domain" "$service_target" \
          || die 'could not bootstrap the tmux workspace LaunchAgent'
        run_service_command launchctl kickstart -k "$service_target_domain/$selected_service" \
          || die 'could not start the tmux workspace LaunchAgent'
        ;;
    esac
  done <"$transaction_run/services.list"
}

install_transaction_preference() {
  preference_name=$1
  preference_label=$2
  preference_helper=$HOME/.config/macos/$preference_name
  [ -x "$preference_helper" ] \
    || die "deployed $preference_label helper is not executable"
  preference_tools=$transaction_run/preference-tools
  mkdir -p "$transaction_run/preferences" "$preference_tools" \
    || die 'could not create transaction preference storage'
  transaction_preference_helper=$preference_tools/$preference_name
  cp -p "$preference_helper" "$transaction_preference_helper" \
    || die "could not journal the $preference_label helper"
  chmod 0700 "$transaction_preference_helper" \
    || die "could not protect the journaled $preference_label helper"
  "$transaction_preference_helper" apply \
    "$transaction_run/preferences/$preference_name" \
    || die "could not configure the $preference_label"
}

install_platform_preferences() {
  selected_platform=$1
  selected_window_manager=$2
  case "$selected_platform" in
    linux) return 0 ;;
    macos) ;;
    *) die "unsupported preference platform: $selected_platform" ;;
  esac

  install_transaction_preference \
    spotlight-shortcut 'macOS Spotlight shortcut'
  if [ "$selected_window_manager" = aerospace ]; then
    install_transaction_preference \
      window-drag-gesture 'macOS window-drag gesture'
  fi
}

migrate_window_manager_entrypoint() {
  selected_window_manager=$1
  case "$selected_window_manager" in
    hypr) backup_existing_path .config/hypr/hyprland.conf ;;
    aerospace) backup_existing_path .aerospace.toml ;;
  esac
}

create_window_manager_local_override() {
  selected_window_manager=$1
  case "$selected_window_manager" in
    hypr)
      local_override=.config/hypr/local.lua
      local_override_kind=hypr
      ;;
    i3)
      local_override=.config/i3/local.conf
      local_override_kind=i3
      ;;
    aerospace)
      local_override=.config/aerospace/local.sh
      local_override_kind=aerospace
      ;;
    none) return 0 ;;
  esac

  path_exists "$HOME/$local_override" && return 0
  ensure_target_parents "$local_override"
  append_journal_path "$transaction_run/managed.paths" "$local_override"
  case "$local_override_kind" in
    hypr)
      printf '%s\n' '-- Machine-local monitor and device overrides.' \
        >"$HOME/$local_override"
      ;;
    i3)
      printf '%s\n' '# Machine-local monitor and device overrides.' \
        >"$HOME/$local_override"
      ;;
    aerospace)
      printf '%s\n' \
        '#!/bin/sh' \
        '# Machine-local monitor commands.' \
        'exit 0' \
        >"$HOME/$local_override"
      chmod 0700 "$HOME/$local_override" \
        || die 'could not make the Aerospace local override executable'
      ;;
  esac
  printf '  created local override %s\n' "$local_override"
}

complete_transaction() {
  git_status=$(git --git-dir="$HOME/.cfg" --work-tree="$HOME" \
    status --porcelain=v1 --untracked-files=no) \
    || die 'could not verify the deployed dotfiles repository'
  [ -z "$git_status" ] \
    || die 'deployed dotfiles do not match the selected repository commit'

  printf '%s\n' complete >"$transaction_run/status" \
    || die 'could not mark the transaction complete'
  latest_tmp=$transaction_state_root/.latest.$transaction_id
  printf '%s\n' "$transaction_id" >"$latest_tmp" \
    || die 'could not stage the latest transaction marker'
  mv "$latest_tmp" "$transaction_state_root/latest" \
    || die 'could not update the latest transaction marker'
  transaction_active=false
  printf 'Configuration installed from %s\n' "$prepared_commit"
  printf 'Backup and rollback journal: %s\n' "$transaction_run"
}

deploy_configuration() {
  selected_platform=$1
  selected_manager=$2
  selected_window_manager=$3
  require_service_manager "$selected_platform"
  begin_transaction \
    "$selected_platform" "$selected_manager" "$selected_window_manager"
  printf '%s\n' 'Applying configuration:'
  install_repository_metadata
  migrate_window_manager_entrypoint "$selected_window_manager"

  while IFS= read -r selected_path || [ -n "$selected_path" ]; do
    deploy_selected_file "$selected_path"
  done <"$prepared_selected_paths"
  create_window_manager_local_override "$selected_window_manager"
  install_command_links
  install_platform_preferences "$selected_platform" "$selected_window_manager"
  activate_login_service "$selected_platform"

  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_FAIL_AFTER_CHECKOUT:-0}" = 1 ]; then
    die 'forced failure after configuration deployment'
  fi
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_SIGNAL_AFTER_CHECKOUT:-}" = TERM ]; then
    kill -TERM "$$"
  fi
  complete_transaction
  if [ "$selected_platform:$selected_window_manager" = macos:aerospace ]; then
    emit_post_apply_manual_steps "$selected_platform" "$selected_window_manager"
  fi
  case "$selected_window_manager" in
    none) ;;
    *)
      printf '%s\n' \
        "Window-manager profile installed: $selected_window_manager" \
        'Reload the manager or start a new session when ready.'
      ;;
  esac
}

reverse_journal() {
  sed '1!G;h;$!d' "$1"
}

rollback_safe_parents() (
  case "$1" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$1" in */../*|*/./*|*/..|*/.|*//*|*[[:cntrl:]]*) return 1 ;; esac
  directory=$1
  while [ "$directory" != / ]; do
    [ ! -L "$directory" ] || return 1
    if [ -e "$directory" ]; then
      [ -d "$directory" ] || return 1
      listing=$(ls -ldn -- "$directory") || return 1
      read -r permissions _ uid _rest <<EOF
$listing
EOF
      case "$uid" in 0|"$ownership_uid") ;; *) return 1 ;; esac
      case "$permissions" in
        ?????w*|????????w*)
          # Root-owned sticky system parents such as /tmp protect private children.
          [ "$uid" = 0 ] || return 1
          case "$permissions" in ?????????t*) ;; *) return 1 ;; esac ;;
      esac
    fi
    directory=${directory%/*}; [ -n "$directory" ] || directory=/
  done
)

rollback_path_restored() (
  [ -r "$transaction_run/backed-up.paths" ] || return 1
  while IFS= read -r saved || [ -n "$saved" ]; do
    case "$1" in
      "$saved"|"$saved"/*)
        # A consumed backup also covers its children if it restored a blocking parent.
        path_exists "$transaction_run/backup/$saved" || return 0 ;;
    esac
  done <"$transaction_run/backed-up.paths"
  return 1
)

validate_rollback_journal() (
  rollback_safe_parents "$transaction_run" || return 1
  # Backups preserve arbitrary user content; only journal metadata must be private.
  records=$(find "$transaction_run" \( -path "$transaction_run/backup" -o -path "$transaction_run/rollback-current" \) -prune -o -print) || return 1
  while IFS= read -r record; do
    [ ! -L "$record" ] && { [ -f "$record" ] || [ -d "$record" ]; } || return 1
    listing=$(ls -ldn -- "$record") || return 1
    read -r permissions _ uid _rest <<EOF
$listing
EOF
    [ "$uid" = "$ownership_uid" ] || return 1
    case "$permissions" in ?????w*|????????w*) return 1 ;; esac
  done <<EOF
$records
EOF
  for name in managed.paths backed-up.paths created-directories.paths; do
    path_exists "$transaction_run/$name" || continue
    [ -f "$transaction_run/$name" ] && [ -r "$transaction_run/$name" ] || return 1
    while IFS= read -r relative || [ -n "$relative" ]; do
      validate_manifest_path "$relative" || return 1
    done <"$transaction_run/$name"
  done
  [ "$(cat "$transaction_run/status")" != rolled-back ] || return 0
  for name in managed.paths backed-up.paths created-directories.paths; do
    [ -r "$transaction_run/$name" ] || continue
    while IFS= read -r relative || [ -n "$relative" ]; do
      rollback_path_restored "$relative" && continue
      set -- "$HOME"
      [ "$name" = created-directories.paths ] || set -- "$@" "$transaction_run/rollback-current"
      [ "$name" != backed-up.paths ] || set -- "$@" "$transaction_run/backup"
      for base do
        target=$base/$relative
        rollback_safe_parents "${target%/*}" || return 1
      done
    done <"$transaction_run/$name"
  done
)

archive_current_path() {
  archive_relative=$1
  archive_current=$HOME/$archive_relative
  path_exists "$archive_current" || return 0
  archive_destination=$transaction_run/rollback-current/$archive_relative
  mkdir -p "$(dirname "$archive_destination")" || return 1
  if path_exists "$archive_destination"; then
    archive_destination=$archive_destination.retry-$$
  fi
  mv "$archive_current" "$archive_destination"
}

prune_created_directories() {
  created_journal=$transaction_run/created-directories.paths
  [ -r "$created_journal" ] || return 0
  awk '{ print length($0) "\t" $0 }' "$created_journal" \
    | sort -rn \
    | cut -f 2- \
    | while IFS= read -r prune_relative || [ -n "$prune_relative" ]; do
        rollback_path_restored "$prune_relative" && continue
        rmdir "$HOME/$prune_relative" >/dev/null 2>&1 || true
      done
}

restore_backups() {
  backup_journal=$transaction_run/backed-up.paths
  [ -r "$backup_journal" ] || return 0
  while IFS= read -r restore_relative || [ -n "$restore_relative" ]; do
    restore_source=$transaction_run/backup/$restore_relative
    path_exists "$restore_source" || continue
    if path_exists "$HOME/$restore_relative"; then
      archive_current_path "$restore_relative" || return 1
    fi
    mkdir -p "$(dirname "$HOME/$restore_relative")" || return 1
    mv "$restore_source" "$HOME/$restore_relative" || return 1
  done <"$backup_journal"
}

report_retained_packages() {
  printf '%s\n' 'Packages are not uninstalled by rollback.'
  retained_report=$transaction_run/packages-retained.txt
  [ -r "$retained_report" ] || return 0
  sed -n '/^Retained package actions:$/,$p' "$retained_report"
}

transaction_preference_helper_path() {
  preference_name=$1
  printf '%s\n' "$transaction_run/preference-tools/$preference_name"
}

preflight_one_transaction_preference() {
  preference_name=$1
  preference_journal=$transaction_run/preferences/$preference_name
  if ! path_exists "$preference_journal"; then
    return 0
  fi
  if [ ! -d "$preference_journal" ] || [ -L "$preference_journal" ]; then
    printf 'bootstrap: transaction has invalid %s preference journal\n' \
      "$preference_name" >&2
    return 1
  fi
  preference_helper=$(transaction_preference_helper_path "$preference_name")
  if [ ! -x "$preference_helper" ]; then
    printf 'bootstrap: transaction is missing its %s rollback helper\n' \
      "$preference_name" >&2
    return 1
  fi
  "$preference_helper" can-restore "$preference_journal"
}

preflight_transaction_preferences() {
  preference_platform=$(cat "$transaction_run/platform" 2>/dev/null || true)
  case "$preference_platform" in
    linux) return 0 ;;
    macos) ;;
    *)
      printf 'bootstrap: transaction has invalid platform metadata: %s\n' \
        "${preference_platform:-missing}" >&2
      return 1
      ;;
  esac

  for preference_name in spotlight-shortcut window-drag-gesture; do
    preflight_one_transaction_preference "$preference_name" || return $?
  done
}

restore_one_transaction_preference() {
  preference_name=$1
  preference_journal=$transaction_run/preferences/$preference_name
  if ! path_exists "$preference_journal"; then
    return 0
  fi
  if [ ! -d "$preference_journal" ] || [ -L "$preference_journal" ]; then
    printf 'bootstrap: transaction has invalid %s preference journal\n' \
      "$preference_name" >&2
    return 1
  fi
  preference_helper=$(transaction_preference_helper_path "$preference_name")
  "$preference_helper" restore "$preference_journal"
}

restore_transaction_preferences() {
  preference_platform=$(cat "$transaction_run/platform" 2>/dev/null || true)
  [ "$preference_platform" = macos ] || return 0
  for preference_name in window-drag-gesture spotlight-shortcut; do
    restore_one_transaction_preference "$preference_name" || return $?
  done
}

transaction_has_service_metadata() {
  [ -f "$transaction_run/service-platform" ]
}

preflight_legacy_transaction_service() {
  transaction_has_service_metadata || return 0
  rollback_service_platform=$(cat "$transaction_run/service-platform" 2>/dev/null || true)
  case $rollback_service_platform in
    linux|macos) ;;
    *)
      printf 'bootstrap: transaction has invalid service platform: %s\n' \
        "${rollback_service_platform:-missing}" >&2
      return 1
      ;;
  esac
  require_service_manager "$rollback_service_platform"
  for service_state_name in \
    service-was-installed \
    service-was-enabled \
    service-was-active \
    service-new-loaded
  do
    service_state_value=$(cat "$transaction_run/$service_state_name" 2>/dev/null || true)
    case $service_state_value in
      true|false) ;;
      *)
        printf 'bootstrap: transaction has invalid %s metadata: %s\n' \
          "$service_state_name" "${service_state_value:-missing}" >&2
        return 1
        ;;
    esac
  done
}

stop_legacy_deployed_service() {
  transaction_has_service_metadata || return 0
  rollback_service_platform=$(cat "$transaction_run/service-platform")
  case $rollback_service_platform in
    linux)
      run_service_command systemctl --user disable --now tmux-workspace.service
      ;;
    macos)
      service_new_loaded=$(cat "$transaction_run/service-new-loaded")
      if [ "$service_new_loaded" = true ]; then
        run_service_command launchctl bootout \
          "$(service_domain)/dev.ruohao.tmux-workspace"
      fi
      ;;
  esac
}

restore_legacy_service_state() {
  transaction_has_service_metadata || return 0
  rollback_service_platform=$(cat "$transaction_run/service-platform")
  service_was_enabled=$(cat "$transaction_run/service-was-enabled")
  service_was_active=$(cat "$transaction_run/service-was-active")
  case $rollback_service_platform in
    linux)
      run_service_command systemctl --user daemon-reload || return 1
      if [ "$service_was_enabled" = true ]; then
        run_service_command systemctl --user enable tmux-workspace.service \
          || return 1
      fi
      if [ "$service_was_active" = true ]; then
        run_service_command systemctl --user start tmux-workspace.service \
          || return 1
      fi
      ;;
    macos)
      if [ "$service_was_active" = true ]; then
        restored_service_target=$(service_unit_path macos)
        [ -f "$restored_service_target" ] && [ ! -L "$restored_service_target" ] \
          || return 1
        restored_service_domain=$(service_domain)
        run_service_command launchctl bootstrap \
          "$restored_service_domain" "$restored_service_target" \
          || return 1
        run_service_command launchctl kickstart -k \
          "$restored_service_domain/dev.ruohao.tmux-workspace" \
          || return 1
      fi
      ;;
  esac
}


preflight_transaction_service() {
  if [ ! -e "$transaction_run/service-journal-version" ]; then
    preflight_legacy_transaction_service
    return $?
  fi
  [ "$(cat "$transaction_run/service-journal-version")" = 2 ] || return 1
  case $(cat "$transaction_run/service-manager-reloaded" 2>/dev/null) in true|false) ;; *) return 1 ;; esac
  rollback_service_platform=$(cat "$transaction_run/service-platform") || return 1
  validate_service_inventory "$rollback_service_platform" "$transaction_run/services.list" || return 1
  require_service_manager "$rollback_service_platform"
  [ -d "$transaction_run/services" ] && [ ! -L "$transaction_run/services" ] || return 1
  while IFS= read -r selected_service; do
    service_state=$transaction_run/services/$selected_service
    [ -d "$service_state" ] && [ ! -L "$service_state" ] || return 1
    for service_flag in was-installed was-enabled was-active enabled-by-transaction started-by-transaction new-loaded; do
      [ -f "$service_state/$service_flag" ] && [ ! -L "$service_state/$service_flag" ] || return 1
      case $(cat "$service_state/$service_flag") in true|false) ;; *) return 1 ;; esac
    done
  done <"$transaction_run/services.list"
}

stop_deployed_service() {
  if [ ! -e "$transaction_run/service-journal-version" ]; then
    stop_legacy_deployed_service
    return $?
  fi
  rollback_service_platform=$(cat "$transaction_run/service-platform")
  reverse_journal "$transaction_run/services.list" | while IFS= read -r selected_service; do
    service_state=$transaction_run/services/$selected_service
    case $rollback_service_platform in
      linux)
        if [ "$(cat "$service_state/started-by-transaction")" = true ]; then
          run_service_command systemctl --user stop "$selected_service" || exit 1
          printf '%s\n' false >"$service_state/started-by-transaction"
        fi
        if [ "$(cat "$service_state/enabled-by-transaction")" = true ]; then
          run_service_command systemctl --user disable "$selected_service" || exit 1
          printf '%s\n' false >"$service_state/enabled-by-transaction"
        fi
        ;;
      macos)
        if [ "$(cat "$service_state/new-loaded")" = true ]; then
          rollback_service_domain=$(service_domain)
          if ! run_service_command launchctl bootout "$rollback_service_domain/$selected_service"; then
            # A failed load (or partially successful unload) can leave no job to remove.
            # Verify the manager is reachable before treating a missing job as clean.
            run_service_command launchctl print "$rollback_service_domain" >/dev/null 2>&1 || exit 1
            if run_service_command launchctl print "$rollback_service_domain/$selected_service" >/dev/null 2>&1; then
              exit 1
            fi
          fi
          printf '%s\n' false >"$service_state/new-loaded"
        fi
        ;;
    esac
  done
}

restore_previous_service_state() {
  if [ ! -e "$transaction_run/service-journal-version" ]; then
    restore_legacy_service_state
    return $?
  fi
  rollback_service_platform=$(cat "$transaction_run/service-platform")
  case $rollback_service_platform in
    linux)
      if [ "$(cat "$transaction_run/service-manager-reloaded")" = true ]; then
        run_service_command systemctl --user daemon-reload || return 1
        printf '%s\n' false >"$transaction_run/service-manager-reloaded"
      fi
      ;;
    macos)
      service_state=$transaction_run/services/dev.ruohao.tmux-workspace
      if [ "$(cat "$service_state/started-by-transaction")" = true ]; then
        restored_service_target=$(service_unit_path macos)
        [ -f "$restored_service_target" ] && [ ! -L "$restored_service_target" ] || return 1
        restored_service_domain=$(service_domain)
        run_service_command launchctl bootstrap "$restored_service_domain" "$restored_service_target" || return 1
        run_service_command launchctl kickstart -k "$restored_service_domain/dev.ruohao.tmux-workspace" || return 1
        printf '%s\n' false >"$service_state/started-by-transaction"
      fi
      ;;
  esac
}

rollback_transaction() {
  ownership_recheck || return 1
  transaction_run=$1
  validate_rollback_journal || {
    printf '%s\n' 'bootstrap: unsafe rollback journal or path parents' >&2
    return 1
  }
  rollback_status=$(cat "$transaction_run/status" 2>/dev/null || true)
  if [ "$rollback_status" = rolled-back ]; then
    printf 'Transaction is already rolled back: %s\n' "${transaction_run##*/}"
    report_retained_packages
    return 0
  fi
  case "$rollback_status" in
    active|complete|rolling-back) ;;
    *)
      printf 'bootstrap: transaction journal has invalid status: %s\n' \
        "${rollback_status:-missing}" >&2
      return 1
      ;;
  esac

  preflight_transaction_preferences || return 1
  preflight_transaction_service || return 1
  printf '%s\n' rolling-back >"$transaction_run/status" || return 1
  stop_deployed_service || return 1
  restore_transaction_preferences || return 1
  managed_journal=$transaction_run/managed.paths
  if [ -r "$managed_journal" ]; then
    reverse_journal "$managed_journal" \
      | while IFS= read -r rollback_relative || [ -n "$rollback_relative" ]; do
          rollback_path_restored "$rollback_relative" && continue
          archive_current_path "$rollback_relative" || exit 1
        done \
      || return 1
  fi
  prune_created_directories || return 1
  restore_backups || return 1
  restore_previous_service_state || return 1
  printf '%s\n' rolled-back >"$transaction_run/status" || return 1
  printf 'Rolled back transaction: %s\n' "${transaction_run##*/}"
  report_retained_packages
}

run_manual_rollback() {
  validate_home_directory
  transaction_state_root=$(state_root_path)
  requested_id=$rollback_id
  if [ "$requested_id" = latest ]; then
    [ -r "$transaction_state_root/latest" ] \
      || die 'no latest dotfiles transaction is available'
    requested_id=$(cat "$transaction_state_root/latest")
  fi
  case "$requested_id" in
    ''|.|..|*[!A-Za-z0-9._-]*) die 'resolved rollback ID contains unsupported characters' ;;
  esac
  requested_run=$transaction_state_root/$requested_id
  [ -d "$requested_run" ] || die "transaction does not exist: $requested_id"
  rollback_transaction "$requested_run" \
    || die "rollback failed for transaction: $requested_id"
}

exit_for_transaction_signal() {
  signal_name=$1
  signal_code=$2
  if [ "$transaction_active" = true ]; then
    printf 'bootstrap: received %s; rolling back configuration\n' "$signal_name" >&2
  else
    printf 'bootstrap: received %s; stopping safely\n' "$signal_name" >&2
  fi
  exit "$signal_code"
}

handle_transaction_signal() {
  signal_name=$1
  signal_code=$2
  if [ "$active_probe_wait_in_progress" = true ]; then
    active_probe_wait_interrupted=true
  fi
  if [ "$managed_publication_critical" = true ] \
    || [ "$cleanup_registration_critical" = true ] \
    || [ "$probe_cleanup_active" = true ] \
    || [ -n "$pending_transaction_signal_name" ]; then
    if [ -z "$pending_transaction_signal_name" ]; then
      pending_transaction_signal_name=$signal_name
      pending_transaction_signal_code=$signal_code
    fi
    return 0
  fi
  exit_for_transaction_signal "$signal_name" "$signal_code"
}

handle_process_exit() {
  trap '' 0 HUP INT TERM
  process_status=$1
  if [ -n "$active_probe_waiter_pid" ] || [ -n "$active_probe_tmp" ]; then
    stop_owned_probe || true
  fi
  remove_managed_taplo_publish_storage || printf '%s\n' \
    'bootstrap: managed Taplo staging cleanup was incomplete; inspect the reported path' >&2
  if [ "$process_status" -ne 0 ] && [ "$managed_publish_active" = true ]; then
    managed_cleanup_incomplete=false
    if ! remove_managed_unjournaled_path; then
      managed_cleanup_incomplete=true
    fi
    if ! remove_managed_created_paths; then
      managed_cleanup_incomplete=true
    fi
    if [ "$managed_cleanup_incomplete" = true ]; then
      printf '%s\n' \
        'bootstrap: managed language-tool cleanup was incomplete; inspect the reported exact paths' >&2
    fi
    managed_publish_active=false
  fi
  if [ "$transaction_active" = true ]; then
    printf '%s\n' 'bootstrap: configuration failed; restoring the transaction backup' >&2
    if ! rollback_transaction "$transaction_run"; then
      printf 'bootstrap: automatic rollback failed; inspect %s\n' "$transaction_run" >&2
    fi
  fi
  if [ -n "$prepared_root" ] && [ -d "$prepared_root" ]; then
    remove_temporary_directory "$prepared_root"
  fi
  if [ "$process_status" -ne 0 ] \
    && { [ -n "$active_rishot_directory" ] \
      || [ -n "$active_rishot_link" ]; }; then
    cleanup_active_rishot_publication || printf '%s\n' \
      'bootstrap: Rishot publication cleanup was incomplete; inspect the exact reported path' >&2
  fi
  if [ -n "$active_package_tmp" ] && [ -d "$active_package_tmp" ]; then
    remove_temporary_directory "$active_package_tmp"
  fi
  if [ -n "$manifest_temp_root" ] && [ -d "$manifest_temp_root" ]; then
    remove_temporary_directory "$manifest_temp_root"
  fi
  if [ -n "$package_actions_tmp" ] && [ -d "$package_actions_tmp" ]; then
    remove_temporary_directory "$package_actions_tmp"
  fi
  ownership_release || printf '%s\n' 'bootstrap: ownership lock cleanup was incomplete' >&2
  exit "$process_status"
}

transaction_active=false
