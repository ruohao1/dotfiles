trap 'handle_process_exit "$?"' 0
trap 'handle_transaction_signal HUP 129' HUP
trap 'handle_transaction_signal INT 130' INT
trap 'handle_transaction_signal TERM 143' TERM

# Coordinate before scoped dispatch, prerequisites, package tracking or Git fetch.
if [ -n "$expected_commit" ]; then
  require_git_capabilities
fi
if [ "$mode" = apply ] || [ "$mode" = rollback ]; then
  ownership_acquire || exit 1
fi

platform=$(detect_platform)
case "$platform" in
  macos|linux) ;;
  *) die "invalid platform selection: $platform" ;;
esac
if [ -n "$managed_tool" ]; then
  [ -n "$script_dir" ] || die 'managed tool mode requires local bootstrap manifests'
  run_managed_tool_mode "$platform" "$script_dir/manifests"
  exit 0
fi

manager=$(detect_manager "$platform")
case "$platform:$manager" in
  macos:homebrew|linux:apt|linux:pacman) ;;
  *) die "package manager $manager is invalid for $platform" ;;
esac

if [ "$mode" = rollback ]; then
  run_manual_rollback
  exit 0
fi

select_window_manager "$platform" "$manager" "$window_manager"

if [ "$manager" = apt ]; then
  require_debian_probe_runtime || exit 1
fi

if [ "$mode" = apply ]; then
  start_package_tracking
fi

if [ -z "$script_dir" ]; then
  if ! git_is_ready; then
    if [ "$mode" = dry-run ]; then
      printf 'Mode: %s\n' "$mode"
      printf 'Platform: %s\n' "$platform"
      printf 'Package manager: %s\n' "$manager"
      printf 'Window manager: %s\n' "$window_manager"
      printf 'Repository: %s\n' "$repo_url"
      printf 'Reference: %s\n' "$repo_ref"
      printf '%s\n' \
        'Git is not installed, so the standalone dry-run cannot fetch its manifests.' \
        'Run with --apply to bootstrap Git, or install Git and rerun the dry-run.'
      exit 0
    fi
    if [ "$manager" = apt ]; then
      prepare_debian_language_servers ''
    fi
    install_standalone_git "$manager"
  fi
  load_remote_manifests
fi

[ -n "$script_dir" ] || die 'cannot locate bootstrap manifests'

if [ -n "$expected_commit" ]; then
  # Retain the reviewed tree through package installation; never fetch it again.
  prepare_repository "$platform" "$window_manager" "$script_dir/manifests"
  printf 'Expected commit: %s\n' "$expected_commit"
fi

printf 'Mode: %s\n' "$mode"
printf 'Platform: %s\n' "$platform"
printf 'Package manager: %s\n' "$manager"
printf 'Window manager: %s\n' "$window_manager"
printf 'Repository: %s\n' "$repo_url"
printf 'Reference: %s\n' "$repo_ref"
printf 'Community packages: %s\n' "$allow_community_packages"
printf '%s\n' 'Configuration paths:'
emit_selected_paths "$platform" "$window_manager" "$script_dir/manifests" \
  | sed 's/^/  install /'
printf '%s\n' 'Packages:'
emit_package_plan "$manager" "$window_manager" "$script_dir/manifests"
emit_platform_preference_plan "$platform" "$window_manager"
emit_service_plan "$platform" "$window_manager"
emit_post_apply_manual_steps "$platform" "$window_manager"

if [ "$mode" = dry-run ]; then
  prepare_dry_run=true
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_PREPARE_DRY_RUN:-0}" != 1 ]; then
    prepare_dry_run=false
  fi
  if [ "$prepare_dry_run" = true ]; then
    if command -v git >/dev/null 2>&1; then
      [ -n "$prepared_gitdir" ] || prepare_repository "$platform" "$window_manager" "$script_dir/manifests"
      emit_conflict_plan "$window_manager"
    else
      printf '%s\n' 'Conflict scan deferred until Git is installed.'
    fi
  fi
  exit 0
fi

if [ "$mode" = apply ]; then
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_SKIP_PACKAGES:-0}" = 1 ]; then
    printf '%s\n' 'Applying packages: skipped by test harness'
  else
    install_packages "$manager" "$window_manager" "$script_dir/manifests"
  fi
  if [ "${DOTFILES_BOOTSTRAP_TESTING:-0}" = 1 ] \
    && [ "${DOTFILES_BOOTSTRAP_TEST_STOP_AFTER_PACKAGES:-0}" = 1 ]; then
    exit 0
  fi
  [ -n "$prepared_gitdir" ] || prepare_repository "$platform" "$window_manager" "$script_dir/manifests"
  deploy_configuration "$platform" "$manager" "$window_manager"
  exit 0
fi
