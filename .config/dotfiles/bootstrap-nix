#!/usr/bin/env python3
"""Delegate to a committed, explicitly selected dotfiles flake."""
import os
from pathlib import Path
import pwd
import re
import shutil
import subprocess
import sys
from urllib.parse import quote

HELP = """Usage: bootstrap-nix --source-root ROOT -- COMMAND [ARG...]

Requires Python 3, Git and Nix with nix-command/flakes enabled.
Install Nix explicitly using https://nixos.org/download/ (never installed here).
ROOT must be a clean committed, non-shallow conventional checkout or registered
Git worktree, with tracked regular flake.nix and flake.lock. Complete shallow
history first with git fetch --unshallow in that repository.
HOME and its ancestors are refused.
Declare and commit your real profile in nix/hosts.nix first.

Preview: bootstrap-nix --source-root ROOT -- plan --profile NAME --output plan.json
Review the plan and resolve conflicts/native prerequisites before explicit apply:
         bootstrap-nix --source-root ROOT -- apply --plan plan.json
Recovery: rollback --generation STORE_PATH or restore-legacy --transaction ID
Relative plan/output paths are relative to your current directory.
"""


def validate_source(source_root):
    """Validate one committed checkout without evaluating or activating it."""
    # Neither Git inspection nor Nix's Git fetch may inherit a different worktree,
    # index, config injection or discovery boundary from the caller environment.
    environment = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
    environment.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM='1')
    if not shutil.which('git'):
        raise ValueError('Git is required to validate the explicit source checkout')
    root = Path(source_root).resolve(strict=True)
    homes = [Path(os.environ.get('HOME', '')).resolve(strict=True), Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()]
    if not root.is_dir() or any(root == home or root in home.parents for home in homes):
        raise ValueError('source root must not be HOME or an ancestor of HOME')
    marker = root / '.git'
    if marker.is_symlink() or not (marker.is_file() or marker.is_dir()):
        raise ValueError('source root must be a conventional checkout or registered linked worktree')

    def git(*args):
        result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(root), *args],
                                env=environment, capture_output=True, text=True, timeout=30)
        if result.returncode:
            raise ValueError('source Git validation failed: ' + result.stderr.strip())
        return result.stdout.strip()

    if git('rev-parse', '--is-inside-work-tree') != 'true' or Path(git('rev-parse', '--show-toplevel')).resolve() != root:
        raise ValueError('source root must be the exact Git checkout top level')
    revision = git('rev-parse', '--verify', 'HEAD^{commit}')
    if not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', revision):
        raise ValueError('source requires an explicit committed revision')
    if git('rev-parse', '--is-shallow-repository') == 'true':
        raise ValueError('source checkout is shallow; complete its history with git fetch --unshallow in that repository, then retry')
    worktrees = git('worktree', 'list', '--porcelain', '-z').split('\0')
    if 'worktree ' + str(root) not in worktrees:
        raise ValueError('source is not a registered Git worktree')
    for name in ['flake.nix', 'flake.lock']:
        path = root / name
        entries = git('ls-files', '--stage', '--', name).splitlines()
        if (path.is_symlink() or not path.is_file() or len(entries) != 1
                or not re.fullmatch(r'100(644|755) [0-9a-f]+ 0\t' + re.escape(name), entries[0])):
            raise ValueError(name + ' must be a tracked regular file')
    if git('status', '--porcelain=v1', '--untracked-files=no', '--ignore-submodules=none'):
        raise ValueError('source checkout has uncommitted tracked changes; review and commit them first')
    return root, revision, environment


def main(arguments):
    if arguments == ['--help']:
        print(HELP, end='')
        return 0
    if len(arguments) < 4 or arguments[0] != '--source-root' or arguments[2] != '--':
        print(HELP, file=sys.stderr, end='')
        return 2
    root, revision, environment = validate_source(arguments[1])
    nix = shutil.which('nix')
    if not nix:
        raise ValueError('Nix is required; install explicitly using https://nixos.org/download/')
    reference = 'git+file://' + quote(str(root), safe='/') + '?rev=' + revision + '#dotfiles'
    os.execve(nix, [nix, 'run', '--no-update-lock-file', reference, '--', *arguments[3:]], environment)


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
        print('bootstrap-nix: ' + str(error), file=sys.stderr)
        sys.exit(1)
