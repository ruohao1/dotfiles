    fi
  else
    fail "could not create a tracked symlink fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-dirty-source
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && printf '%s\n' 'return false' >> "$nvim_fixture/plugin/core.lua"; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_reject \
      "dirty ordinary plugin source is rejected" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" lazy.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-dirty-source" || true
  else
    fail "could not create dirty-source fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-ignored-source
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && printf '%s\n' '/plugin/evil.lua' >> "$nvim_fixture/.git/info/exclude" \
    && printf '%s\n' 'return false' > "$nvim_fixture/plugin/evil.lua"; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_reject \
      "ignored plugin source is rejected" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" lazy.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-ignored-source" || true
  else
    fail "could not create ignored-source fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-extra-untracked
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && printf '%s\n' 'extra' > "$nvim_fixture/extra.txt"; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_reject \
      "extra untracked path is rejected" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" lazy.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-extra-untracked" || true
  else
    fail "could not create extra-untracked fixture"
  fi

  for nvim_tags_style in ignored untracked; do
    case "$nvim_tags_style" in
      ignored) nvim_tags_plugin=lazy.nvim ;;
      untracked) nvim_tags_plugin=mini.icons ;;
    esac

    nvim_fixture=$check_tmp/nvim-trust-$nvim_tags_style-tags-symlink
    nvim_tags_target=$check_tmp/nvim-trust-$nvim_tags_style-tags-target
    if nvim_trust_fixture_init "$nvim_fixture" "$nvim_tags_plugin" \
      && mv "$nvim_fixture/doc/tags" "$nvim_tags_target" \
      && ln -s "$nvim_tags_target" "$nvim_fixture/doc/tags"; then
      nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
      nvim_trust_expect_reject \
        "symlinked $nvim_tags_style doc/tags is rejected" \
        nvim_plugin_checkout_is_trusted \
        "$nvim_fixture" "$nvim_tags_plugin" "$nvim_fixture_lock" \
        "$check_tmp/audit-$nvim_tags_style-tags-symlink" || true
    else
      fail "could not create symlinked $nvim_tags_style tags fixture"
    fi

    nvim_fixture=$check_tmp/nvim-trust-$nvim_tags_style-tags-tampered
    if nvim_trust_fixture_init "$nvim_fixture" "$nvim_tags_plugin" \
      && printf '%s\n' 'tampered' >> "$nvim_fixture/doc/tags"; then
      nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
      nvim_trust_expect_reject \
        "tampered $nvim_tags_style doc/tags is rejected" \
        nvim_plugin_checkout_is_trusted \
        "$nvim_fixture" "$nvim_tags_plugin" "$nvim_fixture_lock" \
        "$check_tmp/audit-$nvim_tags_style-tags-tampered" || true
    else
      fail "could not create tampered $nvim_tags_style tags fixture"
    fi
  done

  if [ "$failures" -eq "$nvim_self_test_start_failures" ]; then
    printf '%s\n' 'Neovim plugin trust self-test: ok'
    return 0
  fi

  return 1
}

git_fixture_init() {
  fixture=$1
  branch=$2

  mkdir -p "$fixture" \
    && "$real_git" -C "$fixture" init -q \
    && "$real_git" -C "$fixture" checkout -qb "$branch" \
    && "$real_git" -C "$fixture" config user.name "Dotfiles Check" \
    && "$real_git" -C "$fixture" config user.email "dotfiles-check@example.invalid" \
    && "$real_git" -C "$fixture" config commit.gpgsign false \
    && printf 'base\n' > "$fixture/tracked.txt" \
    && "$real_git" -C "$fixture" add tracked.txt \
    && "$real_git" -C "$fixture" commit -qm "base"
}

require_plain_git_summary() {
  plain_expected=$1
  plain_label=$2
  shift 2
  plain_output="$check_tmp/git-summary-plain.out"
  plain_error="$check_tmp/git-summary-plain.err"

  run_git_summary \
    "$git_summary" "$plain_output" "$plain_error" "$plain_label" "$@"
  plain_status=$?
  if [ "$plain_status" -ne 0 ]; then
    sed 's/^/      /' "$plain_error" >&2
    fail "$plain_label exits successfully"
    return 1
  fi
  require_output \
    "$plain_output" "$plain_error" "$plain_expected" "$plain_label"
}

capture_git_index_state() {
  git_index_repository=$1
  git_index_prefix=$2
  git_index_path=$("$real_git" -C "$git_index_repository" rev-parse --git-path index) \
    || return 1
  case "$git_index_path" in
    /*) ;;
    *) git_index_path="$git_index_repository/$git_index_path" ;;
  esac
  [ -f "$git_index_path" ] || return 1

  printf '%s\n' "$git_index_path" > "$git_index_prefix.path" \
    && cksum "$git_index_path" > "$git_index_prefix.checksum" \
    || return 1
  case "$platform" in
    linux) stat -c '%s:%Y:%Z:%a:%u:%g' "$git_index_path" > "$git_index_prefix.metadata" ;;
    macos) stat -f '%z:%m:%c:%p:%u:%g' "$git_index_path" > "$git_index_prefix.metadata" ;;
    *) return 1 ;;
  esac
}

git_index_guard_serial=0
git_index_guard_active=false

resolve_git_index_lock() {
  git_index_lock_repository=$1
  git_index_lock=$("$real_git" -C "$git_index_lock_repository" \
    rev-parse --git-path index.lock) || return 1
  case "$git_index_lock" in
    /*) ;;
    *) git_index_lock="$git_index_lock_repository/$git_index_lock" ;;
  esac
  printf '%s\n' "$git_index_lock"
}

begin_git_index_guard() {
  git_index_guard_repository=$1
  git_index_guard_label=$2
  git_index_guard_serial=$((git_index_guard_serial + 1))
  git_index_guard_prefix="$check_tmp/git-index-guard-$git_index_guard_serial"
  git_index_guard_active=false
  if ! capture_git_index_state \
    "$git_index_guard_repository" "$git_index_guard_prefix-before"; then
    fail "$git_index_guard_label could not fingerprint its Git index"
    return 1
  fi

  git_index_guard_lock=$(resolve_git_index_lock "$git_index_guard_repository") || {
    fail "$git_index_guard_label could not resolve index.lock before the helper"
    return 1
  }
  if [ -e "$git_index_guard_lock" ]; then
    fail "$git_index_guard_label started with an existing index.lock"
    return 1
  fi

  git_index_guard_active=true
  return 0
}

end_git_index_guard() {
  [ "$git_index_guard_active" = true ] || return 1
  git_index_guard_active=false
  git_index_guard_ok=true
  if ! capture_git_index_state \
    "$git_index_guard_repository" "$git_index_guard_prefix-after"; then
    fail "$git_index_guard_label could not fingerprint its Git index after the helper"
    return 1
  fi

  if cmp -s "$git_index_guard_prefix-before.path" "$git_index_guard_prefix-after.path" \
    && cmp -s "$git_index_guard_prefix-before.checksum" "$git_index_guard_prefix-after.checksum"; then
    pass "$git_index_guard_label preserves index bytes and path"
  else
    fail "$git_index_guard_label changed index bytes or path"
    git_index_guard_ok=false
  fi
  if cmp -s "$git_index_guard_prefix-before.metadata" "$git_index_guard_prefix-after.metadata"; then
    pass "$git_index_guard_label preserves index metadata"
  else
    fail "$git_index_guard_label changed index metadata"
    git_index_guard_ok=false
  fi

  git_index_guard_lock=$(resolve_git_index_lock "$git_index_guard_repository") || {
    fail "$git_index_guard_label could not resolve index.lock after the helper"
    return 1
  }
  if [ ! -e "$git_index_guard_lock" ]; then
    pass "$git_index_guard_label creates no index.lock"
  else
    fail "$git_index_guard_label created index.lock"
    git_index_guard_ok=false
  fi

  [ "$git_index_guard_ok" = true ]
}

require_guarded_git_summary_usage() {
  usage_guard_repository=$1
  usage_guard_label=$2
  shift 2

  begin_git_index_guard "$usage_guard_repository" "$usage_guard_label" \
    || return 1
  require_git_summary_usage "$usage_guard_label" "$@"
  usage_guard_status=$?
  if ! end_git_index_guard; then
    return 1
  fi
  return "$usage_guard_status"
}

require_task1_repository_summary() {
  repository_path=$1
