wait_status_gate_counts() {
  [ "$#" -eq 3 ] || return 2
  wait_gate_directory=$1
  case "$2" in
    ""|*[!0-9]*) return 2 ;;
  esac
  case "$3" in
    ""|*[!0-9]*) return 2 ;;
  esac
  expected_calls=$2
  expected_running=$3

  gate_attempt=0
  while [ "$gate_attempt" -lt 15 ]; do
    if gate_ready_calls=$(status_call_count "$wait_gate_directory") \
      && gate_running=$(status_running_count "$wait_gate_directory") \
      && [ "$gate_ready_calls" -eq "$expected_calls" ] \
      && [ "$gate_running" -eq "$expected_running" ]; then
      return 0
    fi
    gate_attempt=$((gate_attempt + 1))
    sleep 0.1
  done
  return 1
}

wait_status_running_count() {
  [ "$#" -eq 2 ] || return 2
  wait_running_directory=$1
  case "$2" in
    ""|*[!0-9]*) return 2 ;;
  esac
  expected_running=$2

  running_attempt=0
  while [ "$running_attempt" -lt 40 ]; do
    [ "$(status_running_count "$wait_running_directory")" \
      -eq "$expected_running" ] && return 0
    running_attempt=$((running_attempt + 1))
    sleep 0.1
  done
  return 1
}

