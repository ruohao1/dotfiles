  fi

  printf '%s\n' 'source-f /dev/null' > "$check_tmp/tmux-accept-source-f.conf"
  if [ "$tmux_started" = true ] \
    && tmux -S "$check_socket" source-file "$check_tmp/tmux-accept-source-f.conf" \
      > "$check_tmp/tmux-accept-source-f.txt" 2>&1; then
    pass "tmux accepts the source-f command abbreviation used by the closure probe"
  else
    sed 's/^/      /' "$check_tmp/tmux-accept-source-f.txt" >&2
    fail "tmux did not accept the source-f command abbreviation probe"
