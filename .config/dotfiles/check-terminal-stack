control_status_file_is_exact() {
  [ "$#" -eq 1 ] || return 2
  control_result_path_is_owned "$1" || return 2

  LC_ALL=C awk '
    NR == 1 && index($0, "left-width=") == 1 { next }
    NR == 2 && index($0, "right-width=") == 1 { next }
    NR == 3 && index($0, "left=") == 1 { next }
    NR == 4 && index($0, "right=") == 1 { next }
    NR == 5 && index($0, "windows=") == 1 { next }
    { invalid = 1 }
    END { exit invalid || NR != 5 }
  ' "$1"
}

