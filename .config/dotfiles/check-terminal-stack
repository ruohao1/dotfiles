control_pid_is_exact_positive() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    ""|0|0*|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

control_pid_is_exact_tmux_child() {
  [ "$#" -eq 1 ] || return 2
  control_child_pid=$1
  control_pid_is_exact_positive "$control_child_pid" || return 1

  LC_ALL=C ps -p "$control_child_pid" -o ppid= -o comm= 2>/dev/null |
    LC_ALL=C awk -v expected_parent="$$" '
      $1 == expected_parent \
        && ((NF == 2 && $2 == "tmux") \
          || (NF == 3 && $2 == "tmux:" && $3 == "client")) {
        matches++
      }
      END { exit matches != 1 || NR != 1 }
    '
}

control_session_id_is_exact() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    \$*)
      control_session_digits=${1#\$}
      case "$control_session_digits" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    *)
      return 1
      ;;
  esac
}

control_pane_id_is_exact() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    %*[!0-9]*|%) return 1 ;;
    %*) return 0 ;;
    *) return 1 ;;
  esac
}

tmux_window_id_is_exact() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    @*[!0-9]*|@) return 1 ;;
    @*) return 0 ;;
    *) return 1 ;;
  esac
}

control_socket_path_is_owned() {
  [ "$#" -eq 1 ] || return 2
  [ -n "$check_tmp" ] || return 1
  case "$1" in
    "$check_tmp"/tmux.sock|"$check_tmp"/tmux-control-probe.sock)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

control_result_path_is_owned() {
  [ "$#" -eq 1 ] || return 2
  [ -n "$check_tmp" ] || return 1

  case "$1" in
    "$check_tmp"/*)
      control_result_name=${1#"$check_tmp"/}
      case "$control_result_name" in
        ""|.|..|*/*) return 1 ;;
      esac
      ;;
    *)
      return 1
      ;;
  esac

  case "$1" in
    "$status_client_a_fifo"|"$status_client_b_fifo"|\
    "$status_client_a_output"|"$status_client_b_output"|\
    "$status_client_a_error"|"$status_client_b_error")
      return 1
      ;;
  esac
  [ ! -L "$1" ] \
    && [ ! -d "$1" ] \
    && { [ ! -e "$1" ] || [ -f "$1" ]; }
}

control_command_is_single() {
  [ "$#" -eq 1 ] || return 2
  [ -n "$1" ] || return 1
  case "$1" in
    *';'*) return 1 ;;
  esac

  printf '%s\n' "$1" | LC_ALL=C awk '
    BEGIN { carriage_return = sprintf("%c", 13) }
    NR > 1 { invalid = 1 }
    index($0, carriage_return) != 0 { invalid = 1 }
    END { exit invalid }
  '
}

control_slot_is_empty() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    status-client-a)
      [ -z "$status_client_a" ] \
        && [ -z "$status_client_a_pid" ] \
        && [ -z "$status_client_a_session" ] \
        && [ -z "$status_client_a_session_id" ] \
        && [ -z "$status_client_a_fifo" ] \
        && [ -z "$status_client_a_output" ] \
        && [ -z "$status_client_a_error" ] \
        && [ "$status_client_a_fd_open" = false ]
      ;;
    status-client-b)
      [ -z "$status_client_b" ] \
        && [ -z "$status_client_b_pid" ] \
        && [ -z "$status_client_b_session" ] \
        && [ -z "$status_client_b_session_id" ] \
        && [ -z "$status_client_b_fifo" ] \
        && [ -z "$status_client_b_output" ] \
        && [ -z "$status_client_b_error" ] \
        && [ "$status_client_b_fd_open" = false ]
      ;;
    *)
      return 2
      ;;
  esac
}

control_client_record_is_exact() {
  [ "$#" -eq 5 ] || return 2
  control_record_input=$1
  control_record_pid=$2
  control_record_session=$3
  control_record_session_id=$4
  control_record_result=$5

  control_pid_is_exact_positive "$control_record_pid" || return 2
  control_session_id_is_exact "$control_record_session_id" || return 2
  control_result_path_is_owned "$control_record_result" || return 2
  [ "$control_record_input" != "$control_record_result" ] || return 2

  LC_ALL=C awk -F '\t' \
    -v expected_pid="$control_record_pid" \
    -v expected_session="$control_record_session" \
    -v expected_session_id="$control_record_session_id" '
      $1 == expected_pid {
        matches++
        if (NF == 5 \
          && $2 != "" \
          && $3 == expected_session \
          && $4 == expected_session_id \
          && $5 == "1") {
          client_name = $2
          valid++
        }
      }
      END {
        if (matches != 1 || valid != 1) exit 1
        print client_name
      }
    ' "$control_record_input" > "$control_record_result"
}

control_startup_is_ready() {
  [ "$#" -eq 3 ] || return 2
  control_startup_output=$1
  control_startup_session=$2
  control_startup_session_id=$3

  LC_ALL=C awk \
    -v expected_session="$control_startup_session" \
    -v expected_session_id="$control_startup_session_id" '
      function numeric(value) {
        return value ~ /^[0-9]+$/
      }
      /^%exit($| )/ {
        invalid = 1
        next
      }
      $1 == "%begin" {
        if (inside || NF != 4 \
          || !numeric($2) || !numeric($3) || !numeric($4)) {
          invalid = 1
          next
        }
        begins++
        inside = 1
        tuple = $2 " " $3 " " $4
        next
      }
      $1 == "%end" || $1 == "%error" {
        if (!inside || NF != 4 || ($2 " " $3 " " $4) != tuple) {
          invalid = 1
          next
        }
        if ($1 == "%error") invalid = 1
        ends++
        inside = 0
        startup_closed = 1
        next
      }
      startup_closed \
        && !inside \
        && $1 == "%session-changed" \
        && NF == 3 \
        && $2 == expected_session_id \
        && $3 == expected_session {
        attributed++
        next
      }
      END {
        exit invalid || inside || begins != 1 || ends != 1 || attributed != 1
      }
    ' "$control_startup_output"
}

stop_control_client_slot() {
  [ "$#" -eq 1 ] || return 2
  control_stop_name=$1

  case "$control_stop_name" in
    status-client-a)
      control_stop_client=$status_client_a
      control_stop_pid=$status_client_a_pid
      control_stop_fifo=$status_client_a_fifo
      ;;
    status-client-b)
      control_stop_client=$status_client_b
      control_stop_pid=$status_client_b_pid
      control_stop_fifo=$status_client_b_fifo
      ;;
    *)
      return 2
      ;;
  esac

  control_stop_owned=false
  if control_pid_is_exact_positive "$control_stop_pid" \
    && control_pid_is_exact_tmux_child "$control_stop_pid"; then
    if [ -n "$control_stop_client" ]; then
      if control_live_client_mapping_is_exact "$control_stop_name"; then
        control_stop_owned=true
      fi
    else
      control_stop_owned=true
    fi
  fi

  case "$control_stop_name" in
    status-client-a)
      if [ "$status_client_a_fd_open" = true ]; then
        exec 7>&-
        status_client_a_fd_open=false
      fi
      ;;
    status-client-b)
      if [ "$status_client_b_fd_open" = true ]; then
        exec 8>&-
        status_client_b_fd_open=false
      fi
      ;;
  esac

  if control_pid_is_exact_positive "$control_stop_pid"; then
    control_stop_attempt=0
    while [ "$control_stop_attempt" -lt 10 ] \
      && kill -0 "$control_stop_pid" >/dev/null 2>&1; do
      control_stop_attempt=$((control_stop_attempt + 1))
      sleep 0.1
    done

    control_stop_killed=false
    if kill -0 "$control_stop_pid" >/dev/null 2>&1 \
      && [ "$control_stop_owned" = true ] \
      && control_pid_is_exact_tmux_child "$control_stop_pid"; then
      kill -TERM "$control_stop_pid" >/dev/null 2>&1 || true
      control_stop_attempt=0
      while [ "$control_stop_attempt" -lt 10 ] \
        && kill -0 "$control_stop_pid" >/dev/null 2>&1; do
        control_stop_attempt=$((control_stop_attempt + 1))
        sleep 0.1
      done
    fi

    if kill -0 "$control_stop_pid" >/dev/null 2>&1 \
      && [ "$control_stop_owned" = true ] \
      && control_pid_is_exact_tmux_child "$control_stop_pid"; then
      if kill -KILL "$control_stop_pid" >/dev/null 2>&1; then
        control_stop_killed=true
      fi
    fi
    if ! kill -0 "$control_stop_pid" >/dev/null 2>&1 \
      || [ "$control_stop_killed" = true ]; then
      wait "$control_stop_pid" >/dev/null 2>&1 || true
    fi
  fi

  case "$control_stop_name:$control_stop_fifo" in
    status-client-a:"$check_tmp"/status-client-a.in|\
    status-client-b:"$check_tmp"/status-client-b.in)
      rm -f "$control_stop_fifo"
      ;;
  esac

  case "$control_stop_name" in
    status-client-a)
      status_client_a=""
      status_client_a_pid=""
      status_client_a_session=""
      status_client_a_session_id=""
      status_client_a_fifo=""
      status_client_a_output=""
      status_client_a_error=""
      status_client_a_fd_open=false
      ;;
    status-client-b)
      status_client_b=""
      status_client_b_pid=""
      status_client_b_session=""
      status_client_b_session_id=""
      status_client_b_fifo=""
      status_client_b_output=""
      status_client_b_error=""
      status_client_b_fd_open=false
      ;;
  esac

  if control_slot_is_empty status-client-a \
    && control_slot_is_empty status-client-b; then
    status_control_socket=""
    control_capture_active=false
    control_status_capture_active=false
  fi
}

stop_control_clients() {
  stop_control_client_slot status-client-a || true
  stop_control_client_slot status-client-b || true
  status_control_socket=""
  control_capture_active=false
  control_status_capture_active=false
}

start_control_client() {
  [ "$#" -eq 3 ] || return 2
  control_start_socket=$1
  control_start_session=$2
  control_start_name=$3

  control_socket_path_is_owned "$control_start_socket" || return 2
  case "$control_start_session" in
    ""|*[!A-Za-z0-9_-]*) return 2 ;;
  esac
  control_slot_is_empty "$control_start_name" || return 2

  if [ -n "$status_control_socket" ] \
    && [ "$status_control_socket" != "$control_start_socket" ]; then
    return 2
  fi
  status_control_socket=$control_start_socket

  control_start_session_id=$(tmux -S "$control_start_socket" \
    display-message -p -t "=$control_start_session:" '#{session_id}' \
    2>/dev/null) || {
      if control_slot_is_empty status-client-a \
        && control_slot_is_empty status-client-b; then
        status_control_socket=""
      fi
      return 1
    }
  if ! control_session_id_is_exact "$control_start_session_id"; then
    if control_slot_is_empty status-client-a \
      && control_slot_is_empty status-client-b; then
      status_control_socket=""
    fi
    return 1
  fi

  case "$control_start_name" in
    status-client-a)
      control_start_fifo="$check_tmp/status-client-a.in"
      control_start_output="$check_tmp/status-client-a.out"
      control_start_error="$check_tmp/status-client-a.err"
      ;;
    status-client-b)
      control_start_fifo="$check_tmp/status-client-b.in"
      control_start_output="$check_tmp/status-client-b.out"
      control_start_error="$check_tmp/status-client-b.err"
      ;;
    *)
      return 2
      ;;
  esac

  rm -f "$control_start_fifo" "$control_start_output" "$control_start_error"
  if ! mkfifo "$control_start_fifo"; then
    if control_slot_is_empty status-client-a \
      && control_slot_is_empty status-client-b; then
      status_control_socket=""
    fi
    return 1
  fi

  tmux -S "$control_start_socket" -C attach-session -f no-output \
    -c "$check_tmp" -t "$control_start_session" \
    7>&- 8>&- \
    < "$control_start_fifo" \
    > "$control_start_output" \
    2> "$control_start_error" &
  control_start_pid=$!

  if ! control_pid_is_exact_positive "$control_start_pid"; then
    rm -f "$control_start_fifo"
    if control_slot_is_empty status-client-a \
      && control_slot_is_empty status-client-b; then
      status_control_socket=""
    fi
    return 1
  fi

  case "$control_start_name" in
    status-client-a)
      status_client_a_pid=$control_start_pid
      status_client_a_session=$control_start_session
      status_client_a_session_id=$control_start_session_id
      status_client_a_fifo=$control_start_fifo
      status_client_a_output=$control_start_output
      status_client_a_error=$control_start_error
      exec 7> "$control_start_fifo"
      status_client_a_fd_open=true
      ;;
    status-client-b)
      status_client_b_pid=$control_start_pid
      status_client_b_session=$control_start_session
      status_client_b_session_id=$control_start_session_id
      status_client_b_fifo=$control_start_fifo
      status_client_b_output=$control_start_output
      status_client_b_error=$control_start_error
      exec 8> "$control_start_fifo"
      status_client_b_fd_open=true
      ;;
  esac

  control_start_listing="$check_tmp/control-start-$control_start_name.clients"
  control_start_match="$check_tmp/control-start-$control_start_name.match"
  control_start_attempt=0
  while [ "$control_start_attempt" -lt 50 ]; do
    if tmux -S "$control_start_socket" list-clients \
        -F '#{client_pid}	#{client_name}	#{session_name}	#{session_id}	#{client_control_mode}' \
        > "$control_start_listing" 2>/dev/null \
      && control_client_record_is_exact \
        "$control_start_listing" "$control_start_pid" \
        "$control_start_session" "$control_start_session_id" \
        "$control_start_match"; then
      control_start_client=$(sed -n '1p' "$control_start_match")
      case "$control_start_name" in
        status-client-a) status_client_a=$control_start_client ;;
        status-client-b) status_client_b=$control_start_client ;;
      esac
      if control_startup_is_ready \
        "$control_start_output" "$control_start_session" \
        "$control_start_session_id" \
        && [ ! -s "$control_start_error" ]; then
        return 0
      fi
    fi

    if ! kill -0 "$control_start_pid" >/dev/null 2>&1; then
      break
    fi
    control_start_attempt=$((control_start_attempt + 1))
    sleep 0.1
  done

  stop_control_client_slot "$control_start_name" || true
  return 1
}

control_live_client_mapping_is_exact() {
  [ "$#" -eq 1 ] || return 2
  control_live_name=$1

  case "$control_live_name" in
    status-client-a)
      control_live_client=$status_client_a
      control_live_pid=$status_client_a_pid
      control_live_session=$status_client_a_session
      control_live_session_id=$status_client_a_session_id
      ;;
    status-client-b)
      control_live_client=$status_client_b
      control_live_pid=$status_client_b_pid
      control_live_session=$status_client_b_session
      control_live_session_id=$status_client_b_session_id
      ;;
    *)
      return 2
      ;;
  esac

  [ -n "$control_live_client" ] || return 1
  control_pid_is_exact_positive "$control_live_pid" || return 1
  control_session_id_is_exact "$control_live_session_id" || return 1
  control_socket_path_is_owned "$status_control_socket" || return 1
  kill -0 "$control_live_pid" >/dev/null 2>&1 || return 1

  control_live_listing="$check_tmp/control-live-$control_live_name.clients"
  control_live_match="$check_tmp/control-live-$control_live_name.match"
  tmux -S "$status_control_socket" list-clients \
    -F '#{client_pid}	#{client_name}	#{session_name}	#{session_id}	#{client_control_mode}' \
    > "$control_live_listing" 2>/dev/null \
    || return 1
  control_client_record_is_exact \
    "$control_live_listing" "$control_live_pid" \
    "$control_live_session" "$control_live_session_id" \
    "$control_live_match" \
    || return 1
  control_live_match_value=$(sed -n '1p' "$control_live_match")
  [ "$control_live_match_value" = "$control_live_client" ]
}

control_live_client_is_exact() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    status-client-a) control_live_error=$status_client_a_error ;;
    status-client-b) control_live_error=$status_client_b_error ;;
    *) return 2 ;;
  esac

  [ -n "$control_live_error" ] \
    && [ ! -s "$control_live_error" ] \
    && control_live_client_mapping_is_exact "$1"
}

control_complete_line_offset() {
  [ "$#" -eq 2 ] || return 2
  control_offset_output=$1
  control_offset_result=$2

  case "$control_offset_output" in
    "$status_client_a_output"|"$status_client_b_output")
      [ -n "$control_offset_output" ] || return 2
      ;;
    *)
      return 2
      ;;
  esac
  control_result_path_is_owned "$control_offset_result" || return 2
  [ -r "$control_offset_output" ] || return 1

  control_offset_attempt=0
  while [ "$control_offset_attempt" -lt 40 ]; do
    control_offset_before=$(wc -l < "$control_offset_output" | awk '{ print $1 }') \
      || return 1
    sleep 0.025
    control_offset_after=$(wc -l < "$control_offset_output" | awk '{ print $1 }') \
      || return 1
    case "$control_offset_before:$control_offset_after" in
      *[!0-9:]*|:*|*:)
        return 1
        ;;
    esac
    if [ "$control_offset_before" = "$control_offset_after" ]; then
      printf '%s\n' "$control_offset_after" > "$control_offset_result"
      return 0
    fi
    control_offset_attempt=$((control_offset_attempt + 1))
  done
  return 1
}

control_parse_frame() {
  [ "$#" -eq 3 ] || return 4
  control_parse_output=$1
  control_parse_start=$2
  control_parse_result=$3

  case "$control_parse_output" in
    "$status_client_a_output"|"$status_client_b_output")
      [ -n "$control_parse_output" ] || return 4
      ;;
    *)
      return 4
      ;;
  esac
  case "$control_parse_start" in
    ""|*[!0-9]*) return 4 ;;
  esac
  control_result_path_is_owned "$control_parse_result" || return 4

  LC_ALL=C awk -v start="$control_parse_start" '
    function numeric(value) {
      return value ~ /^[0-9]+$/
    }
    NR <= start { next }
    /^%exit($| )/ {
      fatal = 1
      exit
    }
    !inside && $1 == "%begin" {
      if (NF != 4 || !numeric($2) || !numeric($3) || !numeric($4)) {
        fatal = 1
        exit
      }
      inside = 1
      tuple = $2 " " $3 " " $4
      next
    }
    !inside { next }
    inside && $1 == "%begin" {
      fatal = 1
      exit
    }
    inside && ($1 == "%end" || $1 == "%error") {
      if (NF != 4 || ($2 " " $3 " " $4) != tuple) {
        fatal = 1
        exit
      }
      if ($1 == "%error") failed = 1
      else complete = 1
      exit
    }
    inside { print }
    END {
      if (fatal) exit 3
      if (failed) exit 2
      if (complete) exit 0
      exit 1
    }
  ' "$control_parse_output" > "$control_parse_result"
}

control_command_capture() {
  [ "$#" -eq 3 ] || return 2
  control_capture_client=$1
  control_capture_command=$2
  control_capture_result=$3

  [ "$control_capture_active" = false ] || return 2
  control_command_is_single "$control_capture_command" || return 2
  control_result_path_is_owned "$control_capture_result" || return 2
  control_socket_path_is_owned "$status_control_socket" || return 2

  case "$control_capture_client" in
    "$status_client_a")
      [ -n "$status_client_a" ] || return 2
      control_capture_name=status-client-a
      control_capture_output=$status_client_a_output
      control_capture_pid=$status_client_a_pid
      control_capture_fd=7
      ;;
    "$status_client_b")
      [ -n "$status_client_b" ] || return 2
      control_capture_name=status-client-b
      control_capture_output=$status_client_b_output
      control_capture_pid=$status_client_b_pid
      control_capture_fd=8
      ;;
    *)
      return 2
      ;;
  esac

  control_capture_active=true
  control_capture_sequence=$((control_capture_sequence + 1))
  control_capture_offset_file="$check_tmp/control-offset-$control_capture_name-$control_capture_sequence.txt"
  control_capture_frame_file="$check_tmp/control-frame-$control_capture_name-$control_capture_sequence.txt"
  control_capture_outcome=1
  control_capture_fatal=false
  rm -f "$control_capture_result"

  if ! control_live_client_is_exact "$control_capture_name" \
    || ! control_complete_line_offset \
      "$control_capture_output" "$control_capture_offset_file"; then
    control_capture_fatal=true
  else
    control_capture_start=$(sed -n '1p' "$control_capture_offset_file")
    case "$control_capture_fd" in
      7)
        if ! (printf '%s\n' "$control_capture_command" >&7) 2>/dev/null; then
          control_capture_fatal=true
        fi
        ;;
      8)
        if ! (printf '%s\n' "$control_capture_command" >&8) 2>/dev/null; then
          control_capture_fatal=true
        fi
        ;;
    esac
  fi

  control_capture_attempt=0
  while [ "$control_capture_fatal" = false ] \
    && [ "$control_capture_attempt" -lt 40 ]; do
    if control_parse_frame \
      "$control_capture_output" "$control_capture_start" \
      "$control_capture_frame_file"; then
      if sed -n 'p' "$control_capture_frame_file" \
        > "$control_capture_result"; then
        control_capture_outcome=0
      fi
      break
    else
      control_capture_status=$?
    fi

    case "$control_capture_status" in
      1)
        if ! control_pid_is_exact_positive "$control_capture_pid" \
          || ! kill -0 "$control_capture_pid" >/dev/null 2>&1; then
          control_capture_fatal=true
          break
        fi
        ;;
      2)
        control_capture_outcome=1
        break
        ;;
      *)
        control_capture_fatal=true
        break
        ;;
    esac

    control_capture_attempt=$((control_capture_attempt + 1))
    sleep 0.1
  done

  if [ "$control_capture_attempt" -ge 40 ]; then
    control_capture_fatal=true
  fi
  control_capture_active=false

  if [ "$control_capture_fatal" = true ]; then
    stop_control_client_slot "$control_capture_name" || true
    control_capture_active=false
    return 1
  fi
  return "$control_capture_outcome"
}

control_append_capture() {
  [ "$#" -eq 3 ] || return 2
  control_append_label=$1
  control_append_input=$2
  control_append_output=$3

  case "$control_append_label" in
    left-width|right-width|left|right|windows) ;;
    *) return 2 ;;
  esac
  control_result_path_is_owned "$control_append_input" || return 2
  control_result_path_is_owned "$control_append_output" || return 2
  [ "$control_append_input" != "$control_append_output" ] || return 2

  LC_ALL=C awk -v prefix="$control_append_label=" '
    NR == 1 && index($0, prefix) == 1 {
      valid = 1
      value = $0
      next
    }
    { invalid = 1 }
    END {
      if (invalid || NR != 1 || !valid) exit 1
      print value
    }
  ' "$control_append_input" >> "$control_append_output"
}

capture_field() {
  [ "$#" -eq 2 ] || return 2
  control_field_file=$1
  control_field_name=$2

  control_result_path_is_owned "$control_field_file" || return 2
  case "$control_field_name" in
    left-width|right-width|left|right|windows) ;;
    *) return 2 ;;
  esac

  LC_ALL=C awk -v prefix="$control_field_name=" '
    index($0, prefix) == 1 {
      matches++
      value = substr($0, length(prefix) + 1)
    }
    END {
      if (matches != 1) exit 1
      print value
    }
  ' "$control_field_file"
}

tmux_format_visible() {
  LC_ALL=C awk '
    {
      line = $0
      visible = ""
      position = 1
      while (position <= length(line)) {
        character = substr(line, position, 1)
        if (character != "#") {
          visible = visible character
          position++
          continue
        }

        hashes = 0
        while (substr(line, position + hashes, 1) == "#") hashes++
        if (substr(line, position + hashes, 1) != "[") {
          visible = visible substr(line, position, hashes)
          position += hashes
          continue
        }

        literal_hashes = int(hashes / 2)
        while (literal_hashes > 0) {
          visible = visible "#"
          literal_hashes--
        }
        if ((hashes % 2) == 0) {
          visible = visible "["
          position += hashes + 1
          continue
        }

        remainder = substr(line, position + hashes + 1)
        closing = index(remainder, "]")
        if (closing == 0) position = length(line) + 1
        else position += hashes + closing + 1
      }
      print visible
    }
  '
}

