    control_semicolon_status=$?
    if [ "$control_empty_status" -eq 2 ] \
      && [ "$control_cr_status" -eq 2 ] \
      && [ "$control_lf_status" -eq 2 ] \
      && [ "$control_semicolon_status" -eq 2 ] \
      && control_command_capture "$status_client_a" \
        "display-message -p 'validation=still-live'" \
        "$check_tmp/control-validation-recovery.txt" \
      && grep -Fqx 'validation=still-live' \
        "$check_tmp/control-validation-recovery.txt"; then
      pass "control capture rejects empty CR LF and multi-command input before writing"
    else
      fail "control command validation changed or poisoned the client"
      control_probe_ready=false
    fi
  fi

  if [ "$control_probe_ready" = true ] \
    && control_status_capture \
      "$status_client_a" "$control_probe_first" 80 \
      "$check_tmp/control-status-a.txt" \
    && control_status_capture \
      "$status_client_b" "$control_probe_second" 120 \
      "$check_tmp/control-status-b.txt" \
    && control_status_file_is_exact "$check_tmp/control-status-a.txt" \
    && control_status_file_is_exact "$check_tmp/control-status-b.txt" \
    && capture_field "$check_tmp/control-status-a.txt" left-width \
      > "$check_tmp/control-left-width-a.txt" \
    && capture_field "$check_tmp/control-status-b.txt" right-width \
      > "$check_tmp/control-right-width-b.txt" \
    && grep -Eq '^[0-9]+$' "$check_tmp/control-left-width-a.txt" \
    && grep -Eq '^[0-9]+$' "$check_tmp/control-right-width-b.txt" \
    && control_status_left_probe \
      "$status_client_a" "$control_probe_first" \
      "$check_tmp/control-left-probe.txt" \
    && grep -q '^left=' "$check_tmp/control-left-probe.txt"; then
    pass "both persistent clients returned exact attributed five-line status captures"
  else
    fail "persistent exact status capture failed"
    control_probe_ready=false
  fi

  control_visible_probe=$(printf '#[fg=red]alpha##[beta]\n' | tmux_format_visible)
  require_text_contains "$control_visible_probe" 'alpha#[beta]' \
    "tmux visible-style helper preserves escaped literal hashes"
  require_text_absent "$control_visible_probe" 'fg=red' \
    "tmux visible-style helper removes style directives"

  control_probe_a_pid=$status_client_a_pid
  control_probe_b_pid=$status_client_b_pid
  control_probe_a_fifo=$status_client_a_fifo
  control_probe_b_fifo=$status_client_b_fifo
  stop_control_clients
  stop_control_clients

  if control_pid_is_exact_positive "$control_probe_a_pid" \
    && control_pid_is_exact_positive "$control_probe_b_pid" \
    && ! kill -0 "$control_probe_a_pid" 2>/dev/null \
    && ! kill -0 "$control_probe_b_pid" 2>/dev/null \
    && ! ( : >&7 ) 2>/dev/null \
    && ! ( : >&8 ) 2>/dev/null \
    && [ ! -e "$control_probe_a_fifo" ] \
    && [ ! -e "$control_probe_b_fifo" ] \
    && control_slot_is_empty status-client-a \
    && control_slot_is_empty status-client-b \
    && [ -z "$status_control_socket" ]; then
    pass "control cleanup is bounded idempotent and fully resets owned state"
  else
    fail "control cleanup left an owned client descriptor FIFO or state field"
  fi

  if [ "$control_probe_socket_owned" = true ]; then
    if tmux -S "$control_probe_socket" kill-server >/dev/null 2>&1; then
      control_probe_socket_owned=false
      rm -f "$control_probe_socket"
    else
      fail "control probe private server did not stop cleanly"
    fi
  fi
  if [ "$control_probe_socket_owned" = false ] \
    && [ ! -e "$control_probe_socket" ]; then
    pass "control probe removed its exact private socket"
  else
    fail "control probe retained ownership or left its private socket"
  fi
fi

if command -v infocmp >/dev/null 2>&1; then
