control_status_capture_active=false
control_status_capture_sequence=0
control_probe_socket=""
control_probe_socket_owned=false
nvim_path=""

pass() {
  printf 'PASS  %s\n' "$1"
}

fail() {
  printf 'FAIL  %s\n' "$1" >&2
  failures=$((failures + 1))
}

warn() {
  printf 'WARN  %s\n' "$1" >&2
  warnings=$((warnings + 1))
}

tmux_url_version_is_eligible() {
  version_at_least "$1" "3.7"
}

version_at_least() {
  awk -v actual="$1" -v required="$2" 'BEGIN {
    split(actual, a, ".")
    split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      av = (a[i] == "" ? 0 : a[i]) + 0
      rv = (r[i] == "" ? 0 : r[i]) + 0
      if (av > rv) exit 0
      if (av < rv) exit 1
    }
    exit 0
  }'
}

require_command() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "command available: $1"
    return 0
  fi

  fail "missing command: $1"
  return 1
}

require_file() {
  if [ -r "$1" ]; then
    pass "readable file: $1"
    return 0
  fi

  fail "missing file: $1"
  return 1
}

require_output() {
  output_file=$1
  error_file=$2
  expected=$3
  label=$4
  expected_file="$output_file.expected"

  if ! printf '%s\n' "$expected" > "$expected_file"; then
    fail "$label could not create its exact expected output"
    return 1
  fi
  if cmp -s "$expected_file" "$output_file" && [ ! -s "$error_file" ]; then
    pass "$label"
    return 0
  fi

  sed 's/^/      /' "$output_file" >&2
  sed 's/^/      /' "$error_file" >&2
  fail "$label"
  return 1
}

run_git_summary() {
  helper=$1
  output_file=$2
  error_file=$3
  run_label=$4
  shift 4

  TMPDIR="$git_summary_tmp" \
    "$helper" "$@" > "$output_file" 2> "$error_file"
  summary_run_status=$?

  summary_tmp_clean=true
  for summary_tmp_artifact in "$git_summary_tmp"/dotfiles-git-summary.*; do
    [ -e "$summary_tmp_artifact" ] || continue
    printf '      %s\n' "$summary_tmp_artifact" >&2
    summary_tmp_clean=false
  done
  if [ "$summary_tmp_clean" = true ]; then
    pass "$run_label leaves no Git summary temporary file"
  else
    fail "$run_label leaked a Git summary temporary file"
  fi

  return "$summary_run_status"
}

require_git_summary_usage() {
  usage_label=$1
  shift
  usage_output="$check_tmp/git-summary-usage.out"
  usage_error="$check_tmp/git-summary-usage.err"
  usage_expected_file="$check_tmp/git-summary-usage.expected"
  usage_expected='usage: git-summary (--path ABSOLUTE_PATH | --tmux-pane %DIGITS) --profile (compact|medium|wide)'

  printf '%s\n' "$usage_expected" > "$usage_expected_file"
  run_git_summary \
    "$git_summary" "$usage_output" "$usage_error" "$usage_label" "$@"
  usage_status=$?
  if [ "$usage_status" -eq 2 ] \
    && [ ! -s "$usage_output" ] \
    && cmp -s "$usage_expected_file" "$usage_error"; then
    pass "$usage_label"
    return 0
  fi

  sed 's/^/      /' "$usage_output" >&2
  sed 's/^/      /' "$usage_error" >&2
  fail "$usage_label"
  return 1
}

require_normalized_line() {
  file=$1
  expected=$2
  label=$3

  if [ -r "$file" ] && sed 's/[[:space:]]//g' "$file" | grep -Fqx "$expected"; then
    pass "$label"
    return 0
  fi

  fail "$label"
  return 1
}

herdr_command_block_matches_exactly() {
  command_config=$1

  HERDR_EXPECTED_COMMAND='command="exec \"${XDG_CONFIG_HOME:-$HOME/.config}/herdr/scripts/move-pane\""' \
    awk '
      function clear_block(    item) {
        for (item in seen) delete seen[item]
        property_count = 0
        in_command_block = 0
      }
      function finish_block() {
        if (!in_command_block) return
        if (seen["key=\"prefix+m\""] == 1) {
          matching_key_blocks++
          if (property_count == 6 &&
              seen["key=\"prefix+m\""] == 1 &&
              seen["type=\"popup\""] == 1 &&
              seen[ENVIRON["HERDR_EXPECTED_COMMAND"]] == 1 &&
              seen["description=\"move pane to tab\""] == 1 &&
              seen["width=\"80%\""] == 1 &&
              seen["height=\"80%\""] == 1) exact_blocks++
        }
      }
      BEGIN { clear_block() }
      /^[[:space:]]*\[\[keys\.command\]\][[:space:]]*$/ {
        finish_block()
        clear_block()
        in_command_block = 1
        next
      }
      /^[[:space:]]*\[/ {
        finish_block()
        clear_block()
        next
      }
      in_command_block {
        normalized = $0
        sub(/^[[:space:]]+/, "", normalized)
        sub(/[[:space:]]+$/, "", normalized)
        if (normalized == "" || normalized ~ /^#/) next

        separator = index(normalized, "=")
        if (separator > 0) {
          property_name = substr(normalized, 1, separator - 1)
          property_value = substr(normalized, separator + 1)
          sub(/[[:space:]]+$/, "", property_name)
          sub(/^[[:space:]]+/, "", property_value)
          normalized = property_name "=" property_value
        }

        seen[normalized]++
        property_count++
      }
      END {
        finish_block()
        exit !(matching_key_blocks == 1 && exact_blocks == 1)
      }
    ' "$command_config"
}

tmux_parse_probe_contains() {
  [ "$#" -ge 4 ] || return 2
  parse_socket=$1
  parse_source=$2
  parse_output=$3
  shift 3

  tmux -S "$parse_socket" source-file -nv "$parse_source" > "$parse_output" 2>&1 || return 1
  for parse_fragment in "$@"; do
    grep -Fq "$parse_fragment" "$parse_output" || return 1
  done
}

tmux_binding_matches_exactly() {
  binding_file=$1
  table=$2
  key=$3
  expected_command=$4

  TMUX_EXPECTED_TABLE=$table \
  TMUX_EXPECTED_KEY=$key \
  TMUX_EXPECTED_COMMAND=$expected_command \
    awk '
      function take_token(    token) {
        token = remaining
        sub(/[[:space:]].*$/, "", token)
        remaining = substr(remaining, length(token) + 1)
        sub(/^[[:space:]]+/, "", remaining)
        return token
      }
      {
        remaining = $0
        token = take_token()
        if (token != "bind-key") next
        token = take_token()
        while (token == "-r") token = take_token()
        if (token != "-T") next
        table = take_token()
        key = take_token()
        if (table == ENVIRON["TMUX_EXPECTED_TABLE"] && key == ENVIRON["TMUX_EXPECTED_KEY"]) {
          matches++
          if (remaining == ENVIRON["TMUX_EXPECTED_COMMAND"]) exact++
        }
      }
      END { exit !(matches == 1 && exact == 1) }
    ' "$binding_file"
}

tmux_binding_is_absent() {
  binding_file=$1
  table=$2
  key=$3

  TMUX_EXPECTED_TABLE=$table \
  TMUX_EXPECTED_KEY=$key \
    awk '
      function take_token(    token) {
        token = remaining
        sub(/[[:space:]].*$/, "", token)
        remaining = substr(remaining, length(token) + 1)
        sub(/^[[:space:]]+/, "", remaining)
        return token
      }
      {
        remaining = $0
        token = take_token()
        if (token != "bind-key") next
        token = take_token()
        while (token == "-r") token = take_token()
        if (token != "-T") next
        table = take_token()
        key = take_token()
        if (table == ENVIRON["TMUX_EXPECTED_TABLE"] && key == ENVIRON["TMUX_EXPECTED_KEY"]) found++
      }
      END { exit found != 0 }
    ' "$binding_file"
}

tmux_binding_count() {
  binding_file=$1
  table=$2
  key=$3

  TMUX_EXPECTED_TABLE=$table \
  TMUX_EXPECTED_KEY=$key \
    awk '
      function take_token(    token) {
        token = remaining
        sub(/[[:space:]].*$/, "", token)
        remaining = substr(remaining, length(token) + 1)
        sub(/^[[:space:]]+/, "", remaining)
        return token
      }
      {
        remaining = $0
        token = take_token()
        if (token != "bind-key") next
        token = take_token()
        while (token == "-r") token = take_token()
        if (token != "-T") next
        table = take_token()
        key = take_token()
        if (table == ENVIRON["TMUX_EXPECTED_TABLE"] && key == ENVIRON["TMUX_EXPECTED_KEY"]) found++
      }
      END { print found + 0 }
    ' "$binding_file"
}

tmux_table_binding_count() {
  binding_file=$1
  expected_table=$2

  TMUX_EXPECTED_TABLE=$expected_table \
    awk '
      function take_token(    token) {
        token = remaining
        sub(/[[:space:]].*$/, "", token)
        remaining = substr(remaining, length(token) + 1)
        sub(/^[[:space:]]+/, "", remaining)
        return token
      }
      /^[[:space:]]*$/ { next }
      {
        remaining = $0
        token = take_token()
        if (token != "bind-key") {
          invalid = 1
          next
        }
        token = take_token()
        while (token == "-r") token = take_token()
        if (token != "-T") {
          invalid = 1
          next
        }
        table = take_token()
        take_token()
        if (table != ENVIRON["TMUX_EXPECTED_TABLE"] || remaining == "") invalid = 1
        count++
      }
      END { print invalid ? -1 : count + 0 }
    ' "$binding_file"
}

tmux_describe_binding() {
  binding_file=$1
  table=$2
  key=$3

  TMUX_EXPECTED_TABLE=$table \
  TMUX_EXPECTED_KEY=$key \
    awk '
      function take_token(    token) {
        token = remaining
        sub(/[[:space:]].*$/, "", token)
        remaining = substr(remaining, length(token) + 1)
        sub(/^[[:space:]]+/, "", remaining)
        return token
      }
      {
        source_line = $0
        remaining = $0
        token = take_token()
        if (token != "bind-key") next
        token = take_token()
        while (token == "-r") token = take_token()
        if (token != "-T") next
        table = take_token()
        key = take_token()
        if (table == ENVIRON["TMUX_EXPECTED_TABLE"] && key == ENVIRON["TMUX_EXPECTED_KEY"]) print source_line
      }
    ' "$binding_file"
}

tmux_binding_command() {
  binding_file=$1
  table=$2
  key=$3

  TMUX_EXPECTED_TABLE=$table \
  TMUX_EXPECTED_KEY=$key \
    awk '
      function take_token(    token) {
        token = remaining
        sub(/[[:space:]].*$/, "", token)
        remaining = substr(remaining, length(token) + 1)
        sub(/^[[:space:]]+/, "", remaining)
        return token
      }
      {
        remaining = $0
        token = take_token()
        if (token != "bind-key") next
        token = take_token()
        while (token == "-r") token = take_token()
        if (token != "-T") next
        parsed_table = take_token()
        parsed_key = take_token()
        if (parsed_table == ENVIRON["TMUX_EXPECTED_TABLE"] \
          && parsed_key == ENVIRON["TMUX_EXPECTED_KEY"] \
          && remaining != "") {
          print remaining
          matches++
        }
      }
      END { exit matches != 1 }
    ' "$binding_file"
}

require_tmux_binding() {
  binding_file=$1
  table=$2
  key=$3
  expected_command=$4
  label=$5

  if tmux_binding_matches_exactly "$binding_file" "$table" "$key" "$expected_command"; then
    pass "$label"
    return 0
  fi

  tmux_describe_binding "$binding_file" "$table" "$key" | sed 's/^/      /' >&2
  fail "$label"
  return 1
}

require_tmux_unbound() {
  binding_file=$1
  table=$2
  key=$3
  label=$4

  if tmux_binding_is_absent "$binding_file" "$table" "$key"; then
    pass "$label"
    return 0
  fi

  tmux_describe_binding "$binding_file" "$table" "$key" | sed 's/^/      /' >&2
  fail "$label"
  return 1
}

tmux_source_commands_are_allowed() {
  source_policy=$1
  source_file=$2

  TMUX_EXPECTED_PERSISTENCE_SOURCE=${tmux_persistence_source:-} \
  TMUX_EXPECTED_PERSISTENCE_HELPER_SOURCE=${tmux_persistence_helper_source:-} \
  TMUX_EXPECTED_URL_SOURCE_GUARD=$tmux_url_source_guard \
  TMUX_EXPECTED_URL_SOURCE_DOWN=$tmux_url_source_down \
  TMUX_EXPECTED_URL_SOURCE_UP=$tmux_url_source_up \
  TMUX_EXPECTED_URL_SOURCE_CONTINUATION=$tmux_url_source_continuation \
  TMUX_EXPECTED_URL_SOURCE_ENDIF=$tmux_url_source_endif \
  TMUX_EXPECTED_PERSISTENCE_PROMPT=${tmux_persistence_prompt:-} \
    awk -v policy="$source_policy" '
    function clear_tokens(depth,    token_index) {
      for (token_index = 1; token_index <= parsed_token_count[depth]; token_index++) {
        delete parsed_token[depth, token_index]
        delete parsed_token_kind[depth, token_index]
        delete parsed_token_line[depth, token_index]
      }
      parsed_token_count[depth] = 0
      parsed_lex_error[depth] = 0
      parsed_error_line[depth] = 1
      parsed_final_brace_level[depth] = 0
      parsed_final_quote[depth] = ""
      parsed_final_comment[depth] = 0
      parsed_final_continuation[depth] = 0
      word_value[depth] = ""
      word_has_token[depth] = 0
    }
    function flush_word(depth, line_number,    token_index) {
      if (!word_has_token[depth]) return
      token_index = ++parsed_token_count[depth]
      parsed_token[depth, token_index] = word_value[depth]
      parsed_token_kind[depth, token_index] = "word"
      parsed_token_line[depth, token_index] = line_number
      word_value[depth] = ""
      word_has_token[depth] = 0
    }
    function emit_boundary(depth, kind, line_number,    token_index) {
      flush_word(depth, line_number)
      token_index = ++parsed_token_count[depth]
      parsed_token_kind[depth, token_index] = kind
      parsed_token_line[depth, token_index] = line_number
    }
    function tokenize_tmux_source(input, depth, base_line,    brace_level, character, character_index, comment, continued_line, input_length, line_number, next_character, quote) {
      clear_tokens(depth)
      input_length = length(input)
      line_number = base_line
      brace_level = 0
      comment = 0
      continued_line = 0
      quote = ""

      for (character_index = 1; character_index <= input_length; character_index++) {
        character = substr(input, character_index, 1)
        next_character = character_index < input_length ? substr(input, character_index + 1, 1) : ""

        if (comment) {
          if (character == "\\" && next_character == "\n") {
            character_index++
            line_number++
            continued_line = 1
          } else if (character == "\n") {
            emit_boundary(depth, "newline", line_number)
            comment = 0
            line_number++
            continued_line = 0
          }
          continue
        }

        if (quote == "\047") {
          if (character == "\047") {
            quote = ""
          } else if (character == "\n") {
            parsed_lex_error[depth] = 1
            parsed_error_line[depth] = line_number
            line_number++
            continued_line = 0
          } else {
            word_value[depth] = word_value[depth] character
          }
          continue
        }

        if (quote == "\"") {
          if (character == "\"") {
            quote = ""
          } else if (character == "\\") {
            if (next_character == "\n") {
              character_index++
              line_number++
              continued_line = 1
            } else if (next_character == "") {
              word_value[depth] = word_value[depth] "\\"
            } else {
              word_value[depth] = word_value[depth] next_character
              word_has_token[depth] = 1
              character_index++
            }
          } else if (character == "\n") {
            parsed_lex_error[depth] = 1
            parsed_error_line[depth] = line_number
            line_number++
            continued_line = 0
          } else {
            word_value[depth] = word_value[depth] character
          }
          continue
        }

        if (character == "\\") {
          if (next_character == "\n") {
            character_index++
            line_number++
            continued_line = 1
          } else if (next_character == "") {
            word_value[depth] = word_value[depth] "\\"
            word_has_token[depth] = 1
          } else {
            word_value[depth] = word_value[depth] next_character
            word_has_token[depth] = 1
            character_index++
          }
        } else if (character == "\047" || character == "\"") {
          quote = character
          word_has_token[depth] = 1
        } else if (character == "#" && !word_has_token[depth]) {
          flush_word(depth, line_number)
          comment = 1
        } else if (character == "\n") {
          emit_boundary(depth, "newline", line_number)
          line_number++
          continued_line = 0
        } else if (character ~ /[[:space:]]/) {
          flush_word(depth, line_number)
        } else if (character == ";") {
          emit_boundary(depth, "semicolon", line_number)
        } else if (character == "{") {
          emit_boundary(depth, "open-brace", line_number)
          brace_level++
        } else if (character == "}") {
          if (brace_level == 0) {
            parsed_lex_error[depth] = 1
            parsed_error_line[depth] = line_number
          } else {
            brace_level--
          }
          emit_boundary(depth, "close-brace", line_number)
        } else {
          word_value[depth] = word_value[depth] character
          word_has_token[depth] = 1
        }
      }

      if (quote != "" || brace_level != 0) {
        parsed_lex_error[depth] = 1
        parsed_error_line[depth] = line_number
      }
      flush_word(depth, line_number)
      parsed_final_brace_level[depth] = brace_level
      parsed_final_quote[depth] = quote
      parsed_final_comment[depth] = comment
      parsed_final_continuation[depth] = continued_line
      return parsed_token_count[depth]
    }
    function effective_policy_name(current_policy, scope, brace_level) {
      if (current_policy == "options" && (scope == "branch" || brace_level > 0)) return "options-branch"
      return current_policy
    }
    function verb_is_allowed(current_policy, scope, brace_level, verb,    effective_policy) {
      effective_policy = effective_policy_name(current_policy, scope, brace_level)
      if (effective_policy == "entry") {
        return verb == "set-option" || verb == "if-shell" || verb == "display-message" || verb == "source-file"
      }
      if (effective_policy == "options") return verb == "set" || verb == "setw" || verb == "if-shell"
      if (effective_policy == "options-branch") return verb == "set-option"
      if (effective_policy == "keys") return verb == "bind-key" || verb == "unbind-key"
      if (effective_policy == "persistence") return verb == "bind-key"
      if (effective_policy == "status" || effective_policy == "platform") return verb == "set"
      return 0
    }
    function audit_entry_source(depth, start, end,    target) {
      if (end != start + 1) {
        print "unapproved tmux source-file arguments: policy=entry line=" parsed_token_line[depth, start]
        return 1
      }
      target = parsed_token[depth, start + 1]
      if (!(target in expected_source_count)) {
        print "unapproved tmux source-file target: policy=entry target=" target " line=" parsed_token_line[depth, start]
        return 1
      }
      seen_source_count[target]++
      return 0
    }
    function audit_shell_condition(condition, line_number,    seen_count) {
      seen_count = ++seen_condition_count[condition]
      if (!(condition in expected_condition_count)) {
        print "unapproved tmux if-shell condition: policy=" policy " line=" line_number
        print "  actual: " condition
        return 1
      }
      if (seen_count > expected_condition_count[condition]) {
        print "duplicate tmux if-shell condition: policy=" policy " line=" line_number
        print "  actual: " condition
        return 1
      }
      return 0
    }
    function audit_if_shell_arguments(current_policy, scope, depth, start, end,    condition, invalid, token_index, token) {
      token_index = start + 1
      invalid = 0
      while (token_index <= end) {
        token = parsed_token[depth, token_index]
        if (token == "--") {
          token_index++
          break
        }
        if (token ~ /^-[bF]+$/) {
          token_index++
          continue
        }
        if (token == "-t") {
          if (token_index + 1 > end) return 1
          token_index += 2
          continue
        }
        if (token ~ /^-t./) {
          token_index++
          continue
        }
        break
      }

      if (token_index > end) {
        print "missing tmux if-shell condition: policy=" effective_policy_name(current_policy, scope, 0) " line=" parsed_token_line[depth, start]
        return 1
      }
      condition = parsed_token[depth, token_index]
      if (audit_shell_condition(condition, parsed_token_line[depth, token_index])) invalid = 1
      token_index++

      while (token_index <= end) {
        if (audit_command_text(parsed_token[depth, token_index], current_policy, "branch", depth + 1, parsed_token_line[depth, token_index])) invalid = 1
        token_index++
      }
      return invalid
    }
    function audit_persistence_binding(scope, brace_level, depth, start, end) {
      seen_persistence_binding_count++
      if (scope != "top" || brace_level != 0) {
        print "noncanonical tmux persistence binding scope: line=" parsed_token_line[depth, start]
        return 1
      }
      if (end == start + 5 \
        && parsed_token[depth, start + 1] == "s" \
        && parsed_token[depth, start + 2] == "confirm-before" \
        && parsed_token[depth, start + 3] == "-p" \
        && parsed_token[depth, start + 4] == persistence_prompt \
        && parsed_token[depth, start + 5] \
          == ("run-shell \047" persistence_helper_source " save\047")) {
        return 0
      }
      print "noncanonical tmux persistence binding: line=" parsed_token_line[depth, start]
      return 1
    }
    function audit_persistence_manifest() {
      if (policy != "persistence") return 0
      if (seen_persistence_binding_count == 1) return 0
      print "tmux persistence binding count mismatch: expected=1 actual=" (seen_persistence_binding_count + 0)
      return 1
    }
    function audit_segment(current_policy, scope, brace_level, depth, start, end,    effective_policy, invalid, verb) {
      verb = parsed_token[depth, start]
      effective_policy = effective_policy_name(current_policy, scope, brace_level)
      invalid = 0

      if (!verb_is_allowed(current_policy, scope, brace_level, verb)) {
        print "unapproved tmux command verb: policy=" effective_policy " verb=" verb " line=" parsed_token_line[depth, start]
        invalid = 1
      }
      if ((verb == "if-shell" || verb == "if") \
        && audit_if_shell_arguments(current_policy, scope, depth, start, end)) invalid = 1
      if (current_policy == "entry" && verb == "source-file" \
        && audit_entry_source(depth, start, end)) invalid = 1
      if (current_policy == "persistence" && verb == "bind-key" \
        && audit_persistence_binding(scope, brace_level, depth, start, end)) invalid = 1
      return invalid
    }
    function audit_command_text(input, current_policy, scope, depth, base_line,    brace_level, end, invalid, kind, start, token_count, token_index) {
      if (depth > 12) {
        print "tmux source command recursion exceeds twelve levels: policy=" current_policy " line=" base_line
        return 1
      }
      token_count = tokenize_tmux_source(input, depth, base_line)
      if (parsed_lex_error[depth]) {
        print "tmux source lexer error: policy=" effective_policy_name(current_policy, scope, 0) " line=" parsed_error_line[depth]
        return 1
      }

      invalid = 0
      brace_level = 0
      token_index = 1
      while (token_index <= token_count) {
        kind = parsed_token_kind[depth, token_index]
        if (kind == "open-brace") {
          brace_level++
          token_index++
          continue
        }
        if (kind == "close-brace") {
          brace_level--
          token_index++
          continue
        }
        if (kind != "word") {
          token_index++
          continue
        }

        start = token_index
        while (token_index <= token_count \
          && parsed_token_kind[depth, token_index] == "word") token_index++
        end = token_index - 1

        if ((current_policy == "keys" || current_policy == "status" || current_policy == "platform") \
          && brace_level > 0) continue
        if (audit_segment(current_policy, scope, brace_level, depth, start, end)) invalid = 1
      }
      return invalid
    }
    function audit_entry_graph(    expected_count, item, invalid) {
      invalid = 0
      for (item in expected_source_count) {
        expected_count = expected_source_count[item]
        if (seen_source_count[item] != expected_count) {
          print "tmux source graph count mismatch: target=" item " expected=" expected_count " actual=" (seen_source_count[item] + 0)
          invalid = 1
        }
      }
      return invalid
    }
    function audit_condition_manifest(    condition, expected_count, invalid) {
      invalid = 0
      for (condition in expected_condition_count) {
        expected_count = expected_condition_count[condition]
        if (seen_condition_count[condition] != expected_count) {
          print "tmux if-shell condition count mismatch: policy=" policy " expected=" expected_count " actual=" (seen_condition_count[condition] + 0)
          print "  condition: " condition
          invalid = 1
        }
      }
      return invalid
    }
    BEGIN {
      persistence_source = ENVIRON["TMUX_EXPECTED_PERSISTENCE_SOURCE"]
      persistence_helper_source = ENVIRON["TMUX_EXPECTED_PERSISTENCE_HELPER_SOURCE"]
      persistence_prompt = ENVIRON["TMUX_EXPECTED_PERSISTENCE_PROMPT"]
      expected_url_line[1] = ENVIRON["TMUX_EXPECTED_URL_SOURCE_GUARD"]
      expected_url_line[2] = ENVIRON["TMUX_EXPECTED_URL_SOURCE_DOWN"]
      expected_url_line[3] = ENVIRON["TMUX_EXPECTED_URL_SOURCE_UP"]
      expected_url_line[4] = ENVIRON["TMUX_EXPECTED_URL_SOURCE_CONTINUATION"]
      expected_url_line[5] = ENVIRON["TMUX_EXPECTED_URL_SOURCE_ENDIF"]
      if (persistence_source == "" \
        || persistence_helper_source == "" \
        || persistence_prompt == "") {
        print "internal tmux persistence contract is incomplete"
        persistence_contract_invalid = 1
      }

      macos_bundle_condition = "tmux -S \"#{socket_path}\" source-file \"$HOME/.config/tmux/conf/options.conf\" \"$HOME/.config/tmux/conf/keys.conf\" \"" persistence_source "\" \"$HOME/.config/tmux/conf/status.conf\" \"$HOME/.config/tmux/conf/platform/macos.conf\""
      linux_bundle_condition = "tmux -S \"#{socket_path}\" source-file \"$HOME/.config/tmux/conf/options.conf\" \"$HOME/.config/tmux/conf/keys.conf\" \"" persistence_source "\" \"$HOME/.config/tmux/conf/status.conf\" \"$HOME/.config/tmux/conf/platform/linux.conf\""

      if (policy == "entry") {
        expected_condition_count["for file in \"$HOME/.config/tmux/conf/options.conf\" \"$HOME/.config/tmux/conf/keys.conf\" \"" persistence_source "\" \"$HOME/.config/tmux/conf/status.conf\"; do test -r \"$file\" || exit 1; done"] = 1
        expected_condition_count["test \"$(uname -s)\" = Darwin"] = 1
        expected_condition_count["test -r \"$HOME/.config/tmux/conf/platform/macos.conf\""] = 1
        expected_condition_count[macos_bundle_condition] = 1
        expected_condition_count["test \"$(uname -s)\" = Linux"] = 1
        expected_condition_count["test -r \"$HOME/.config/tmux/conf/platform/linux.conf\""] = 1
        expected_condition_count[linux_bundle_condition] = 1
        expected_condition_count["test ! -r \"$HOME/.config/tmux/conf/options.conf\""] = 1
        expected_condition_count["test ! -r \"$HOME/.config/tmux/conf/keys.conf\""] = 1
        expected_condition_count["test ! -r \"" persistence_source "\""] = 1
      } else if (policy == "options") {
        expected_condition_count["tmux show-options -sv extended-keys-format >/dev/null 2>&1"] = 1
      }

      expected_source_count["/dev/null/tmux-foundation-load-failed"] = 2
      expected_source_count["/dev/null/tmux-unsupported-platform"] = 1
      expected_source_count["$HOME/.config/tmux/conf/platform/macos.conf"] = 1
      expected_source_count["$HOME/.config/tmux/conf/platform/linux.conf"] = 1
      expected_source_count["$HOME/.config/tmux/conf/options.conf"] = 1
      expected_source_count["$HOME/.config/tmux/conf/keys.conf"] = 1
      expected_source_count[persistence_source] = 1
      expected_source_count["$HOME/.config/tmux/conf/status.conf"] = 1
    }
    {
      if (policy == "keys") {
        if (url_line_index > 0) {
          if ($0 == expected_url_line[url_line_index + 1]) {
            url_line_index++
            if (url_line_index == 5) {
              url_line_index = 0
              complete_url_block_count++
            }
            next
          }
          print "noncanonical tmux URL source block: line=" NR " expected-line=" (url_line_index + 1)
          url_source_invalid = 1
          url_line_index = 0
        }
        if ($0 == expected_url_line[1]) {
          url_guard_count++
          tokenize_tmux_source(source_text, 11, 1)
          if (parsed_final_brace_level[11] != 0 \
            || parsed_final_quote[11] != "" \
            || parsed_final_comment[11] \
            || parsed_final_continuation[11]) {
            print "tmux URL source block is not top-level: line=" NR
            url_source_invalid = 1
          }
          url_line_index = 1
          next
        }
        if ($0 ~ /^[[:space:]]*%/) {
          print "unapproved tmux URL source directive: line=" NR
          url_source_invalid = 1
        }
        if ($0 ~ /^[[:space:]]*bind-key[[:space:]]/ \
          && $0 ~ /C-Mouse(Down|Up)1Pane/) {
          print "tmux URL binding outside exact source guard: line=" NR
          url_source_invalid = 1
        }
      }
      source_text = source_text $0 "\n"
    }
    END {
      invalid = audit_command_text(source_text, policy, "top", 0, 1)
      if (policy == "keys" \
        && (url_guard_count != 1 || complete_url_block_count != 1 || url_line_index != 0)) {
        print "tmux URL source block count mismatch: expected=1 complete=1 actual-guards=" (url_guard_count + 0) " actual-complete=" (complete_url_block_count + 0)
        url_source_invalid = 1
      }
      if (url_source_invalid) invalid = 1
      if (persistence_contract_invalid) invalid = 1
      if (audit_persistence_manifest()) invalid = 1
      if (audit_condition_manifest()) invalid = 1
      if (policy == "entry" && audit_entry_graph()) invalid = 1
      exit invalid
    }
  ' "$source_file"
}

tmux_url_source_fixture() {
  url_fixture_kind=$1
  url_fixture_file=$2

  TMUX_EXPECTED_URL_SOURCE_GUARD=$tmux_url_source_guard \
  TMUX_EXPECTED_URL_SOURCE_DOWN=$tmux_url_source_down \
  TMUX_EXPECTED_URL_SOURCE_UP=$tmux_url_source_up \
  TMUX_EXPECTED_URL_SOURCE_CONTINUATION=$tmux_url_source_continuation \
  TMUX_EXPECTED_URL_SOURCE_ENDIF=$tmux_url_source_endif \
    awk -v kind="$url_fixture_kind" '
      BEGIN {
        guard = ENVIRON["TMUX_EXPECTED_URL_SOURCE_GUARD"]
        down = ENVIRON["TMUX_EXPECTED_URL_SOURCE_DOWN"]
        up = ENVIRON["TMUX_EXPECTED_URL_SOURCE_UP"]
        continuation = ENVIRON["TMUX_EXPECTED_URL_SOURCE_CONTINUATION"]
        endif = ENVIRON["TMUX_EXPECTED_URL_SOURCE_ENDIF"]
      }
      $0 == guard {
        guards++
        if (kind == "brace-wrapped-block") print "bind-key -n F11 {"
        if (kind == "quoted-brace-prefix") print "bind-key -n F11 display-message \"{\""
        if (kind == "escaped-brace-prefix") print "bind-key -n F11 display-message \\{"
        if (kind == "continued-line-block") print "bind-key -n F11 display-message \\"
        if (kind == "changed-version-guard") print "%if 1"
        else print
        if (kind == "nested-guard") print guard
        next
      }
      $0 == endif {
        endifs++
        if (kind == "third-guarded-binding") {
          print "bind-key -n C-MouseDragEnd1Pane send-keys -M"
        }
        if (kind != "missing-endif") print
        if (kind == "duplicate-block") {
          print guard
          print down
          print up
          print continuation
          print endif
        }
        if (kind == "URL-binding-outside-guard") print down
        if (kind == "brace-wrapped-block") print "}"
        next
      }
      { print }
      END {
        if (kind == "extra-endif") print endif
        if (guards != 1 || endifs != 1) exit 1
      }
    ' "$tmux_keys" > "$url_fixture_file"
}

tmux_ctrl_url_matches_pristine() {
  ctrl_pristine_file=$1
  ctrl_candidate_file=$2
  for ctrl_key in C-MouseDown1Pane C-MouseUp1Pane; do
    ctrl_pristine_count=$(tmux_binding_count "$ctrl_pristine_file" root "$ctrl_key")
    ctrl_candidate_count=$(tmux_binding_count "$ctrl_candidate_file" root "$ctrl_key")
    [ "$ctrl_pristine_count" -eq "$ctrl_candidate_count" ] || return 1
    [ "$ctrl_pristine_count" -le 1 ] || return 1
    if [ "$ctrl_pristine_count" -eq 1 ]; then
      tmux_binding_command "$ctrl_pristine_file" root "$ctrl_key" \
        > "$check_tmp/tmux-pristine-$ctrl_key.txt" || return 1
      tmux_binding_command "$ctrl_candidate_file" root "$ctrl_key" \
        > "$check_tmp/tmux-candidate-$ctrl_key.txt" || return 1
      cmp -s "$check_tmp/tmux-pristine-$ctrl_key.txt" \
        "$check_tmp/tmux-candidate-$ctrl_key.txt" || return 1
    fi
  done
}

