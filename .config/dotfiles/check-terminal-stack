  nvim_fixture=$check_tmp/nvim-trust-valid-which-key-tags
  if nvim_trust_fixture_init "$nvim_fixture" which-key.nvim; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_accept \
      "WhichKey generated tags are accepted" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" which-key.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-valid-which-key-tags" || true
  else
    fail "could not create WhichKey tags fixture"
  fi

  nvim_fixture_target=$check_tmp/nvim-trust-symlink-root-target
  nvim_fixture_link=$check_tmp/nvim-trust-symlink-root
  if nvim_trust_fixture_init "$nvim_fixture_target" lazy.nvim \
    && ln -s "$nvim_fixture_target" "$nvim_fixture_link"; then
    nvim_trust_expect_reject \
      "symlinked checkout root is rejected" \
      nvim_plugin_checkout_path_is_exact "$nvim_fixture_link" || true
  else
    fail "could not create symlinked checkout fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-symlink-git
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && mv "$nvim_fixture/.git" "$nvim_fixture/.git-real" \
    && ln -s .git-real "$nvim_fixture/.git"; then
    nvim_trust_expect_reject \
      "symlinked .git entry is rejected" \
      nvim_plugin_checkout_path_is_exact "$nvim_fixture" || true
  else
    fail "could not create symlinked .git fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-wrong-top
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && git -C "$nvim_fixture" config core.worktree ../..; then
    nvim_trust_expect_reject \
      "checkout with a different top level is rejected" \
      nvim_plugin_checkout_path_is_exact "$nvim_fixture" || true
  else
