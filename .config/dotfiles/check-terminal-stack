ghostty_keybind_trigger_violations() {
  ghostty_trigger_file=$1
  ghostty_trigger_rule=$2

  awk -v rule="$ghostty_trigger_rule" '
    /^[[:space:]]*keybind[[:space:]]*=/ {
      source_line = $0
      trigger = $0
      sub(/^[[:space:]]*keybind[[:space:]]*=[[:space:]]*/, "", trigger)

      action_separator = 0
      for (i = 1; i < length(trigger); i++) {
        if (substr(trigger, i, 1) == "=" && substr(trigger, i + 1, 1) ~ /[[:alpha:]_]/) {
          action_separator = i
          break
        }
      }
      if (action_separator != 0) {
        trigger = substr(trigger, 1, action_separator - 1)
      }
      normalized_trigger = tolower(trigger)
      violation = 0

      if (rule == "global-flags") {
        violation = normalized_trigger ~ /(^|[^[:alnum:]_])(global|all):/
      } else if (rule == "key-tables") {
        violation = index(trigger, "/") != 0
      } else if (rule == "option-aliases") {
        violation = normalized_trigger ~ /(^|[+>\/:])(opt|option)([+>\/:]|$)/
      }

      if (violation) printf "%d:%s\n", FNR, source_line
    }
  ' "$ghostty_trigger_file"
}

