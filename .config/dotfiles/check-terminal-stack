    "$git_watchdog_label" || true
  if [ "$git_watch_status" -eq 0 ]; then
    require_output "$check_tmp/git-watchdog.out" "$check_tmp/git-watchdog.err" '' \
      "Git helper watchdog returns one empty success line" || true
  else
    sed 's/^/      /' "$check_tmp/git-watchdog.err" >&2
    fail "Git helper watchdog returns renderer-facing empty success"
  fi

  if [ "$git_watch_elapsed" -ge 3 ] && [ "$git_watch_elapsed" -le 4 ]; then
    pass "Git helper watchdog completes in three to four integer seconds"
  else
    fail "Git helper watchdog took $git_watch_elapsed seconds"
  fi

  git_watch_pid_valid=false
  if read_exact_positive_pid_file "$git_watch_pid_file"; then
    git_watch_pid=$exact_positive_pid
    pass "Git helper watchdog records one exact positive decimal child PID line"
    git_watch_pid_valid=true
  else
    sed 's/^/      /' "$git_watch_pid_file" >&2
    fail "Git helper watchdog fake records exactly one positive decimal child PID line"
  fi

  if [ "$git_watch_pid_valid" = true ]; then
    if kill -0 "$git_watch_pid" 2>/dev/null; then
      fail "Git helper watchdog left child $git_watch_pid running"
      kill -KILL "$git_watch_pid" >/dev/null 2>&1 || true
    else
