nvim_trust_fixture_init() {
  [ "$#" -eq 2 ] || return 2
  nvim_fixture_checkout=$1
  nvim_fixture_name=$2

  case "$nvim_fixture_name" in
    lazy.nvim)
      nvim_fixture_help_name=lazy.nvim.txt
      nvim_fixture_ignore_tags=true
      ;;
    mini.icons)
      nvim_fixture_help_name=mini-icons.txt
      nvim_fixture_ignore_tags=false
      ;;
    nvim-treesitter)
      nvim_fixture_help_name=nvim-treesitter.txt
      nvim_fixture_ignore_tags=true
      ;;
    tokyonight.nvim)
      nvim_fixture_help_name=tokyonight.nvim.txt
      nvim_fixture_ignore_tags=true
      ;;
    which-key.nvim)
      nvim_fixture_help_name=which-key.nvim.txt
      nvim_fixture_ignore_tags=true
      ;;
    *)
      return 2
      ;;
  esac

  nvim_fixture_generated=$nvim_fixture_checkout.generated-doc
  nvim_fixture_nvim_output=$nvim_fixture_checkout.helptags
  mkdir -p "$nvim_fixture_checkout/doc" \
    "$nvim_fixture_checkout/plugin" "$nvim_fixture_generated" \
    || return 1
  git -C "$nvim_fixture_checkout" init -q \
    && git -C "$nvim_fixture_checkout" config user.name "Dotfiles Check" \
    && git -C "$nvim_fixture_checkout" config user.email \
      "dotfiles-check@example.invalid" \
    && git -C "$nvim_fixture_checkout" config commit.gpgsign false \
    || return 1

  printf '%s\n' \
    '*dotfiles-trust-fixture*' \
    'Checker-owned generated help fixture.' \
    > "$nvim_fixture_checkout/doc/$nvim_fixture_help_name" \
    || return 1
  printf '%s\n' 'return true' \
    > "$nvim_fixture_checkout/plugin/core.lua" \
    || return 1
  if [ "$nvim_fixture_ignore_tags" = true ]; then
    printf '%s\n' '/doc/tags' > "$nvim_fixture_checkout/.gitignore" \
      || return 1
  fi
  git -C "$nvim_fixture_checkout" add . \
    && git -C "$nvim_fixture_checkout" commit -qm "trust fixture" \
    || return 1

  cp "$nvim_fixture_checkout/doc/$nvim_fixture_help_name" \
    "$nvim_fixture_generated/$nvim_fixture_help_name" \
    || return 1
  if ! env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
    XDG_CONFIG_HOME="$config_root" \
    XDG_DATA_HOME="$check_tmp/nvim-trust-data" \
    XDG_STATE_HOME="$XDG_STATE_HOME" \
    XDG_CACHE_HOME="$XDG_CACHE_HOME" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    DOTFILES_PLUGIN_DOC="$nvim_fixture_generated" \
    nvim --clean --headless -i NONE \
    -c 'lua local ok, err = pcall(vim.cmd.helptags, { vim.env.DOTFILES_PLUGIN_DOC, magic = { file = false, bar = false } }); if not ok then vim.api.nvim_err_writeln(tostring(err)); vim.cmd("cquit 1") end' \
    -c qa > "$nvim_fixture_nvim_output" 2>&1 \
    || nvim_log_has_error "$nvim_fixture_nvim_output" \
    || [ ! -f "$nvim_fixture_generated/tags" ]; then
    return 1
  fi
  cp "$nvim_fixture_generated/tags" "$nvim_fixture_checkout/doc/tags"
}

nvim_trust_case_serial=0

nvim_trust_expect_accept() {
  [ "$#" -ge 2 ] || return 2
  nvim_expect_label=$1
  shift
  nvim_trust_case_serial=$((nvim_trust_case_serial + 1))
  nvim_expect_output=$check_tmp/nvim-trust-case-$nvim_trust_case_serial.out

  if "$@" > "$nvim_expect_output" 2>&1; then
    pass "$nvim_expect_label"
    return 0
  fi

  sed 's/^/      /' "$nvim_expect_output" >&2
  fail "$nvim_expect_label"
  return 1
}

nvim_trust_expect_reject() {
  [ "$#" -ge 2 ] || return 2
  nvim_expect_label=$1
  shift
  nvim_trust_case_serial=$((nvim_trust_case_serial + 1))
  nvim_expect_output=$check_tmp/nvim-trust-case-$nvim_trust_case_serial.out

  if "$@" > "$nvim_expect_output" 2>&1; then
    sed 's/^/      /' "$nvim_expect_output" >&2
    fail "$nvim_expect_label"
    return 1
  fi

  pass "$nvim_expect_label"
  return 0
}

