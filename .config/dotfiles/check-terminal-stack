                assert result.returncode==0 and not result.stdout and not result.stderr
                assert not list(history_dir.glob('.store.*')), 'capture temporary payload remains'
            before=clip('list')
            capture(b'');capture(b'x'*1048577)
            assert clip('list')==before, 'empty or oversized capture was stored'
            maximum=marker+b'x'*(1048576-len(marker))
            capture(maximum)
            assert clip('decode',clip('list').splitlines()[0])==maximum, '1 MiB capture changed bytes'
        stage = 'retention, dedupe, delete, and wipe'
        clip('wipe')
        for index in range(501): clip('store',marker+str(index).encode())
        rows=clip('list').splitlines()
        assert len(rows)==500, 'private retention is not 500'
        assert clip('decode',rows[-1])==marker+b'1', 'retention did not evict oldest item'
