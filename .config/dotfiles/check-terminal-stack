  PYTHONDONTWRITEBYTECODE=1 "$parquet_tool_python" -I -B -c \
    'import hashlib,pathlib,stat,sys; path=pathlib.Path(sys.argv[1]); metadata=path.stat(); print("{}:{}:{}:{:o}".format(hashlib.sha256(path.read_bytes()).hexdigest(),metadata.st_size,metadata.st_mtime_ns,stat.S_IMODE(metadata.st_mode)))' \
