      rev-parse HEAD:plugin/core.lua)
    nvim_stat_worktree=$(hardened_plugin_git "$nvim_fixture" \
      hash-object --no-filters plugin/core.lua)
    if [ "$nvim_stat_locked" = "$nvim_stat_worktree" ]; then
      fail "stat-cache fixture did not change the tracked worktree bytes"
    else
      nvim_trust_expect_reject \
        "same-size same-mtime tracked mutation is rejected" \
        nvim_plugin_checkout_is_trusted \
