if [ -r "$tmux_entry" ] \
  && [ -r "$tmux_options" ] \
  && [ -r "$tmux_keys" ] \
  && [ -r "$tmux_persistence" ] \
  && [ -r "$tmux_status" ] \
  && [ -r "$tmux_linux" ] \
  && [ -r "$tmux_macos" ]; then
  printf '%s\n' 'sou /dev/null' > "$check_tmp/tmux-accept-sou.conf"
  if [ "$tmux_started" = true ] \
    && tmux -S "$check_socket" source-file "$check_tmp/tmux-accept-sou.conf" \
      > "$check_tmp/tmux-accept-sou.txt" 2>&1; then
