tmux_modules_use_allowed_commands() {
  [ "$#" -eq 6 ] || return 2

  module_invalid=false
  if ! tmux_source_commands_are_allowed options "$1"; then module_invalid=true; fi
  if ! tmux_source_commands_are_allowed keys "$2"; then module_invalid=true; fi
  if ! tmux_source_commands_are_allowed persistence "$3"; then module_invalid=true; fi
  if ! tmux_source_commands_are_allowed status "$4"; then module_invalid=true; fi
  if ! tmux_source_commands_are_allowed platform "$5"; then module_invalid=true; fi
  if ! tmux_source_commands_are_allowed platform "$6"; then module_invalid=true; fi

  [ "$module_invalid" = false ]
}

tmux_audit_reports_only_condition_manifest_errors() {
  awk '
    /^unapproved tmux if-shell condition:/ { found = 1; next }
    /^duplicate tmux if-shell condition:/ { found = 1; next }
    /^tmux if-shell condition count mismatch:/ { found = 1; next }
