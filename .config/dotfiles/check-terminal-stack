  nvim_fixture=$check_tmp/nvim-trust-file-symlink
  nvim_file_symlink_target=$check_tmp/nvim-trust-file-symlink-target.lua
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && mv "$nvim_fixture/plugin/core.lua" "$nvim_file_symlink_target" \
