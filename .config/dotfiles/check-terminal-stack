      "tracked regular file replaced by a symlink is rejected" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" lazy.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-file-symlink" || true
  else
    fail "could not create a regular-file symlink fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-retargeted-symlink
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && ln -s core.lua "$nvim_fixture/plugin/pinned-link.lua" \
    && git -C "$nvim_fixture" add plugin/pinned-link.lua \
