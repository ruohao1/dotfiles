set -u

failures=0
warnings=0
check_socket=""
check_tmp=""
nvim_bashls_parent=""
tmux_started=false
tmux_socket_owned=false
tmux_move_socket=""
tmux_move_socket_owned=false
status_control_socket=""
status_client_a=""
status_client_b=""
status_client_a_pid=""
status_client_b_pid=""
status_client_a_session=""
status_client_b_session=""
status_client_a_session_id=""
status_client_b_session_id=""
status_client_a_fifo=""
status_client_b_fifo=""
status_client_a_output=""
status_client_b_output=""
status_client_a_error=""
status_client_b_error=""
status_client_a_fd_open=false
status_client_b_fd_open=false
control_capture_active=false
