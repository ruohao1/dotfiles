    url_source_audit="$check_tmp/tmux-url-source-$url_source_case-audit.txt"
    if tmux_url_source_fixture "$url_source_case" "$url_source_fixture" \
      && tmux_source_commands_are_allowed keys "$url_source_fixture" \
        > "$url_source_audit"; then
      pass "tmux URL source fixture keeps $url_source_case at top level"
    else
      sed 's/^/      /' "$url_source_audit" >&2
      fail "tmux URL source fixture misclassified $url_source_case"
    fi
  done

  if tmux_source_commands_are_allowed options "$tmux_options"; then
    pass "tmux options exact condition manifest accepts its canonical quoted condition"
  else
    fail "tmux options exact condition manifest rejects its canonical quoted condition"
  fi

  if tmux_sources_are_plugin_free \
    "$tmux_entry" "$tmux_options" "$tmux_keys" "$tmux_persistence" \
    "$tmux_status" "$tmux_linux" "$tmux_macos"; then
