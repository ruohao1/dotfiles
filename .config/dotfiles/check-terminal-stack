  printf '%s\n' 'display-message harmless#x ; sou /dev/null' > "$check_tmp/tmux-hash-entry-sou.conf"
  if [ "$tmux_started" = true ] \
    && tmux_parse_probe_contains \
      "$check_socket" \
      "$check_tmp/tmux-hash-entry-sou.conf" \
      "$check_tmp/tmux-hash-entry-sou-parse.txt" \
