  printf '%s\n' \
    'display-message harmless # ; run-s true' \
    'display-message "quoted#hash ; run-s true"' \
    'display-message escaped\#hash' \
    'display-message harmless#hash' \
    > "$check_tmp/tmux-hash-positive-controls.conf"
  if [ "$tmux_started" = true ] \
    && tmux_parse_probe_contains \
      "$check_socket" \
      "$check_tmp/tmux-hash-positive-controls.conf" \
      "$check_tmp/tmux-hash-positive-controls-parse.txt" \
      'display-message harmless' \
      'quoted#hash ; run-s true' \
      'escaped#hash' \
      'harmless#hash' \
    && ! grep -Fq '; run-shell true' "$check_tmp/tmux-hash-positive-controls-parse.txt"; then
    pass "tmux preserves word-start comment, quoted hash, escaped hash, and harmless midword hash controls"
  else
    sed 's/^/      /' "$check_tmp/tmux-hash-positive-controls-parse.txt" >&2
    fail "tmux hash positive controls did not parse as expected"
  fi

  if [ "$tmux_started" = true ] \
    && tmux_parse_probe_contains \
      "$check_socket" \
      "$tmux_keys" \
      "$check_tmp/tmux-pane-rearrangement-parse.txt" \
      'if-shell -F "#{window_zoomed_flag}"' \
      'if-shell -F \"#{pane_at_left}\"' \
      'if-shell -F \"#{pane_at_bottom}\"' \
      'if-shell -F \"#{pane_at_top}\"' \
      'if-shell -F \"#{pane_at_right}\"' \
      'swap-pane -Z -s '\''#{pane_id}'\'' -t '\''{left-of}'\''' \
      'swap-pane -Z -s '\''#{pane_id}'\'' -t '\''{down-of}'\''' \
      'swap-pane -Z -s '\''#{pane_id}'\'' -t '\''{up-of}'\''' \
      'swap-pane -Z -s '\''#{pane_id}'\'' -t '\''{right-of}'\''' \
      'select-pane -t '\''#{pane_id}'\''' \
      'resize-pane -Z -t '\''#{pane_id}'\''' \
      'run-shell -C "choose-tree -Zw' \
