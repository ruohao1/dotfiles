  fi

  nvim_fixture=$check_tmp/nvim-trust-head-mismatch
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim; then
    nvim_trust_expect_reject \
      "HEAD-to-lock mismatch is rejected" \
      nvim_plugin_revision_is_exact "$nvim_fixture" \
