    # Other terminal checks may add the sticky bit without granting group/other access.
    private_directory(parent, allow_sticky=True)
    assert root.parent == parent and root.name == 'clipboard-history'
    identity = private_directory(root)
    stage = 'static capture policy'
    capture_paths = ['.config/clipboard-history/store', '.config/cliphist/config',
                     '.config/systemd/user/cliphist.service.d/override.conf']
    for relative in capture_paths:
        ordinary_file(config/relative.removeprefix('.config/'), relative.endswith('/store'))
    policy = ['max-items 500','max-dedupe-search 500','min-store-length 1','preview-width 100']
    assert normalized(config/'cliphist/config') == policy, 'unexpected retention policy'
    override = ['[Service]','ExecStart=',
                'ExecStart=/usr/bin/wl-paste --type text --watch %h/.config/clipboard-history/store',
                'ExecStartPre=%h/.config/clipboard-history/store --prepare','UMask=0077']
    assert normalized(config/'systemd/user/cliphist.service.d/override.conf') == override, 'unexpected text watcher policy'
    manifests = config/'dotfiles/manifests'
    for path in manifests.glob('*.paths'):
        entries = normalized(path)
        for relative in capture_paths:
            assert entries.count(relative) == (1 if path.name == 'config-linux-hypr.paths' else 0), 'clipboard paths are not Hyprland-only'
    for path in manifests.glob('packages*.list'):
        assert normalized(path).count('cliphist') == (1 if path.name == 'packages-pacman-hypr.list' else 0), 'Cliphist package is not Hyprland-only'
    print('PASS  clipboard history capture policy and Hyprland-only manifests are exact')

    for name in ['home','config','cache','state','data','runtime','bin']:
        (root/name).mkdir(mode=0o700)
    (root/'config/cliphist').mkdir(mode=0o700)
    policy_file = root/'config/cliphist/config'
    policy_file.write_text('\n'.join(policy)+'\n')
    history_dir = root/'cache/cliphist'; history_dir.mkdir(mode=0o700)
    db = history_dir/'db'
    env = dict(os.environ, HOME=str(root/'home'), XDG_CONFIG_HOME=str(root/'config'),
        XDG_CACHE_HOME=str(root/'cache'), XDG_STATE_HOME=str(root/'state'), XDG_DATA_HOME=str(root/'data'),
        XDG_RUNTIME_DIR=str(root/'runtime'), CLIPHIST_CONFIG_PATH=str(policy_file), CLIPHIST_DB_PATH=str(db),
        DBUS_SESSION_BUS_ADDRESS='unix:path='+str(root/'no-session-bus'))
    env.pop('WAYLAND_DISPLAY',None)
    env.pop('DISPLAY',None)
    if binary:
        stage = 'Cliphist version'
        assert Path(binary).is_absolute() and os.access(binary,os.X_OK)
        def clip(action, payload=None):
            assert private_directory(root) == identity
            private_directory(history_dir)
            if db.exists() or db.is_symlink():
                info=db.lstat()
                assert stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and info.st_nlink == 1
                assert stat.S_IMODE(info.st_mode) == 0o600
            result = subprocess.run([binary,'-config-path',str(policy_file),'-db-path',str(db),action],
                input=payload,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=10,umask=0o077)
            assert result.returncode == 0, 'private Cliphist command failed'
            return result.stderr.splitlines()[0] if action == 'version' else result.stdout
        version = clip('version').decode().strip()
        match = re.fullmatch(r'version\t(\d+)\.(\d+)\.(\d+)',version)
        assert match and tuple(map(int,match.groups())) >= (0,7,0), 'Cliphist stable version is too old'
