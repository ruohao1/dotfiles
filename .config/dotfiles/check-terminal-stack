    && ! tmux_pristine_binding_delta_is_exact \
      "$check_tmp/tmux-pristine-all-keys.txt" \
      "$check_tmp/tmux-inherited-space-removed.txt" \
      "$tmux_reload_command" \
      "$serialized_backslash_key" \
      > "$check_tmp/tmux-inherited-space-removal-delta.txt" \
    && grep -Fq 'unexpected tmux binding removal: table=prefix key=Space' \
      "$check_tmp/tmux-inherited-space-removal-delta.txt"; then
    pass "tmux symmetric pristine delta rejects removal of inherited prefix Space"
  else
    sed 's/^/      /' "$check_tmp/tmux-inherited-space-removal-delta.txt" >&2
    fail "tmux symmetric pristine delta accepted or could not create removal of inherited prefix Space"
  fi

  if [ "$inherited_space_count" -eq 1 ] \
    && tmux -S "$check_socket" source-file "$check_tmp/tmux-inherited-space-original.conf" \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-inherited-space-restored.txt" 2>&1 \
    && cmp -s "$check_tmp/tmux-all-keys.txt" "$check_tmp/tmux-inherited-space-restored.txt"; then
    pass "tmux inherited Space mutation restores the exact approved key baseline"
  else
    fail "tmux inherited Space mutation did not restore the exact approved key baseline"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 if-shell -F 1 'run-shell wl-copy' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-if-shell-mutation.txt" 2>&1 \
    && ! tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-nested-if-shell-mutation.txt"; then
    pass "tmux copy-pipe/run-shell payload audit rejects nested if-shell run-shell wl-copy"
  else
    fail "tmux copy-pipe/run-shell payload audit accepted or could not create nested if-shell run-shell wl-copy"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 if-shell -F 1 'send-keys -X copy-pipe-and-cancel wl-copy' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-copy-pipe-mutation.txt" 2>&1 \
    && ! tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-nested-copy-pipe-mutation.txt"; then
    pass "tmux copy-pipe/run-shell payload audit rejects a nested explicit copy-pipe payload"
  else
    fail "tmux copy-pipe/run-shell payload audit accepted or could not create a nested explicit copy-pipe payload"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 confirm-before 'run-shell wl-copy' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-confirm-mutation.txt" 2>&1 \
    && ! tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-nested-confirm-mutation.txt"; then
    pass "tmux copy-pipe/run-shell payload audit rejects nested confirm-before run-shell wl-copy"
  else
    fail "tmux copy-pipe/run-shell payload audit accepted or could not create nested confirm-before run-shell wl-copy"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 command-prompt 'run-shell %%' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-command-prompt-mutation.txt" 2>&1 \
    && ! tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-nested-command-prompt-mutation.txt"; then
    pass "tmux copy-pipe/run-shell payload audit rejects a command-prompt run-shell template"
  else
    fail "tmux copy-pipe/run-shell payload audit accepted or could not create a command-prompt run-shell template"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 if-shell -F 1 'display-message "run-shell wl-copy"' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-display-message-decoy.txt" 2>&1 \
    && tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-display-message-decoy.txt"; then
    pass "tmux copy-pipe/run-shell payload audit ignores harmless nested run-shell text"
  else
    fail "tmux copy-pipe/run-shell payload audit rejects harmless nested display-message text"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 if-shell -F 1 'run-shell -d 0.3' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-delay-only.txt" 2>&1 \
    && tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-nested-delay-only.txt"; then
    pass "tmux copy-pipe/run-shell payload audit preserves nested delay-only run-shell"
  else
    fail "tmux copy-pipe/run-shell payload audit rejects nested delay-only run-shell"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 if-shell -F 1 'run-shell -d0.3' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-attached-delay-only.txt" 2>&1 \
    && tmux_copy_pipe_and_run_shell_payloads_are_safe \
      "$check_tmp/tmux-nested-attached-delay-only.txt"; then
    pass "tmux copy-pipe/run-shell payload audit preserves an attached delay-only run-shell"
  else
    fail "tmux copy-pipe/run-shell payload audit rejects an attached delay-only run-shell"
  fi

  if tmux -S "$check_socket" bind-key -T root F11 if-shell -F 1 'run-shell -d0.3 wl-copy' \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-nested-attached-delay-payload.txt" 2>&1 \
    && ! tmux_copy_pipe_and_run_shell_payloads_are_safe \
      "$check_tmp/tmux-nested-attached-delay-payload.txt"; then
    pass "tmux copy-pipe/run-shell payload audit rejects a payload after an attached delay"
  else
    fail "tmux copy-pipe/run-shell payload audit accepted a payload after an attached delay"
  fi

  tmux -S "$check_socket" unbind-key -q -T root F11 >/dev/null 2>&1 || true
  if tmux -S "$check_socket" list-keys > "$check_tmp/tmux-canonical-rename-template.txt" 2>&1 \
    && tmux_binding_matches_exactly "$check_tmp/tmux-canonical-rename-template.txt" root M-r 'command-prompt -I "#W" "rename-window -- '\''%%'\''"' \
    && tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-canonical-rename-template.txt"; then
    pass "tmux copy-pipe/run-shell payload audit preserves the canonical rename command-prompt"
  else
    fail "tmux copy-pipe/run-shell payload audit rejects or cannot find the canonical rename command-prompt"
  fi

  if capture_tmux_reload_snapshot "$check_socket" "$check_tmp" before-reload; then
    pass "captured the complete tmux state before the idempotence reload"
  else
    fail "could not capture the complete tmux state before the idempotence reload"
  fi

  copy_mode_ca_original_count=$(tmux_binding_count "$check_tmp/tmux-before-reload-all-keys.txt" copy-mode C-a)
  tmux_describe_binding "$check_tmp/tmux-before-reload-all-keys.txt" copy-mode C-a \
    > "$check_tmp/tmux-copy-mode-ca-original.conf"
  if tmux -S "$check_socket" bind-key -T copy-mode C-a send-keys -X copy-pipe-and-cancel wl-copy \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-copy-mode-mutation-all-keys.txt" 2>&1 \
    && tmux_binding_matches_exactly "$check_tmp/tmux-copy-mode-mutation-all-keys.txt" copy-mode C-a 'send-keys -X copy-pipe-and-cancel wl-copy' \
    && ! cmp -s "$check_tmp/tmux-before-reload-all-keys.txt" "$check_tmp/tmux-copy-mode-mutation-all-keys.txt" \
    && ! tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-copy-mode-mutation-all-keys.txt"; then
    pass "tmux complete snapshot and copy-pipe/run-shell payload gates reject explicit copy-pipe-and-cancel wl-copy"
  else
    fail "tmux complete snapshot or copy-pipe/run-shell payload gate accepted explicit copy-pipe-and-cancel wl-copy"
  fi

  copy_mode_ca_restored=false
  case "$copy_mode_ca_original_count" in
    0)
      if tmux -S "$check_socket" unbind-key -q -T copy-mode C-a; then
        copy_mode_ca_restored=true
      fi
      ;;
    1)
      if tmux -S "$check_socket" source-file "$check_tmp/tmux-copy-mode-ca-original.conf"; then
        copy_mode_ca_restored=true
      fi
      ;;
    *)
      fail "tmux baseline contains $copy_mode_ca_original_count copy-mode C-a bindings"
      ;;
  esac
  if [ "$copy_mode_ca_restored" = true ] \
    && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-copy-mode-restored-all-keys.txt" 2>&1 \
    && cmp -s "$check_tmp/tmux-before-reload-all-keys.txt" "$check_tmp/tmux-copy-mode-restored-all-keys.txt" \
    && tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-copy-mode-restored-all-keys.txt"; then
    pass "tmux non-vi copy-mode mutation restores to the complete copy-pipe/run-shell-safe baseline"
  else
    fail "tmux non-vi copy-mode mutation did not restore to the complete copy-pipe/run-shell-safe baseline"
  fi

  # shellcheck disable=SC2031  # The pristine-self subshell cannot change this value.
  if [ "$tmux_url_enabled" = true ]; then
    tmux_url_reload_mutated=false
    # shellcheck disable=SC2088  # The literal tilde is a private tmux binding fixture.
    if tmux -S "$check_socket" bind-key -T root C-MouseUp1Pane \
        send-keys -M '\;' run-shell -b -t = \
        '~/.config/tmux/scripts/not-open-url || :' \
      && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-url-reload-mutated-all-keys.txt" 2>&1 \
      && ! cmp -s "$check_tmp/tmux-before-reload-all-keys.txt" \
        "$check_tmp/tmux-url-reload-mutated-all-keys.txt" \
      && ! tmux_binding_matches_exactly \
        "$check_tmp/tmux-url-reload-mutated-all-keys.txt" root C-MouseUp1Pane \
        "$tmux_url_up_command"; then
      tmux_url_reload_mutated=true
      pass "tmux URL reload fixture changes the route before reload"
    else
      fail "tmux URL reload fixture could not change the route before reload"
    fi
    if [ "$tmux_url_reload_mutated" = true ] \
      && tmux -S "$check_socket" source-file "$tmux_root/tmux.conf" \
        > "$check_tmp/tmux-url-reload-restore.txt" 2>&1 \
      && tmux -S "$check_socket" list-keys > "$check_tmp/tmux-url-reload-restored-all-keys.txt" 2>&1 \
      && cmp -s "$check_tmp/tmux-before-reload-all-keys.txt" \
        "$check_tmp/tmux-url-reload-restored-all-keys.txt" \
      && tmux_binding_matches_exactly \
        "$check_tmp/tmux-url-reload-restored-all-keys.txt" root C-MouseUp1Pane \
        "$tmux_url_up_command"; then
      pass "tmux URL reload restores the exact approved full key snapshot"
    else
      sed 's/^/      /' "$check_tmp/tmux-url-reload-restore.txt" >&2
      fail "tmux URL reload did not restore the exact approved full key snapshot"
    fi
  fi

  printf '%s\n' 'bind-key -n M-f run-shell "resize-pane -Z"' > "$check_tmp/tmux-reload-regression.conf"
  if tmux -S "$check_socket" source-file "$check_tmp/tmux-reload-regression.conf" > "$check_tmp/tmux-reload-regression-source.txt" 2>&1 \
    && tmux -S "$check_socket" list-keys -T root > "$check_tmp/tmux-reload-regression-root.txt" 2>&1 \
    && tmux_binding_matches_exactly "$check_tmp/tmux-reload-regression-root.txt" root M-f 'run-shell "resize-pane -Z"' \
    && ! cmp -s "$check_tmp/tmux-before-reload-root-keys.txt" "$check_tmp/tmux-reload-regression-root.txt"; then
    pass "tmux reload snapshot gate detects a source-induced binding regression"
  else
    fail "tmux reload snapshot gate missed or could not create a binding regression"
  fi

  if tmux -S "$check_socket" source-file "$tmux_root/tmux.conf" > "$check_tmp/tmux-regression-restore.txt" 2>&1 \
    && tmux -S "$check_socket" list-keys -T root > "$check_tmp/tmux-regression-restored-root.txt" 2>&1 \
    && cmp -s "$check_tmp/tmux-before-reload-root-keys.txt" "$check_tmp/tmux-regression-restored-root.txt"; then
    pass "tmux foundation restores the canonical root table after the regression mutation"
  else
    fail "tmux foundation did not restore the canonical root table after the regression mutation"
  fi

  if tmux -S "$check_socket" source-file "$tmux_root/tmux.conf" > "$check_tmp/tmux-resource.txt" 2>&1; then
    pass "tmux.conf completed the idempotence reload"
  else
    sed 's/^/      /' "$check_tmp/tmux-resource.txt" >&2
    fail "tmux.conf failed during the idempotence reload"
  fi

  attempts=0
  while [ "$attempts" -lt 5 ]; do
    foundation_loaded=$(tmux -S "$check_socket" show-options -gqv @dotfiles_foundation_loaded 2>/dev/null || true)
    if [ "$foundation_loaded" = "1" ]; then
      break
    fi
    attempts=$((attempts + 1))
    sleep 1
  done

  if capture_tmux_reload_snapshot "$check_socket" "$check_tmp" after-reload; then
    pass "captured the complete tmux state after the idempotence reload"
  else
    fail "could not capture the complete tmux state after the idempotence reload"
  fi

  # shellcheck disable=SC2031  # The pristine-self subshell cannot change this value.
  if [ "$tmux_url_enabled" = true ]; then
    require_tmux_binding "$check_tmp/tmux-after-reload-root-keys.txt" root C-MouseDown1Pane \
      "$tmux_url_down_command" \
      "tmux reload keeps exact eligible Ctrl-down forwarding" || true
    require_tmux_binding "$check_tmp/tmux-after-reload-root-keys.txt" root C-MouseUp1Pane \
      "$tmux_url_up_command" \
      "tmux reload keeps the exact eligible Ctrl-up URL route" || true
  elif tmux_ctrl_url_matches_pristine \
      "$check_tmp/tmux-pristine-all-keys.txt" \
      "$check_tmp/tmux-after-reload-root-keys.txt"; then
    pass "tmux reload keeps ineligible Ctrl identities pristine"
  else
    fail "tmux reload changed an ineligible Ctrl identity from pristine"
  fi

  for snapshot_component in marker platform prefix prefix2 copy-command features feature-slot server-options session-options window-options prefix-keys root-keys resize-keys copy-keys all-keys; do
    if cmp -s \
      "$check_tmp/tmux-before-reload-$snapshot_component.txt" \
      "$check_tmp/tmux-after-reload-$snapshot_component.txt"; then
      pass "tmux reload preserves $snapshot_component exactly"
    else
      fail "tmux reload changed $snapshot_component"
    fi
  done

  if tmux_pristine_binding_delta_is_exact \
    "$check_tmp/tmux-pristine-all-keys.txt" \
    "$check_tmp/tmux-after-reload-all-keys.txt" \
    "$tmux_reload_command" \
    "$serialized_backslash_key" \
    > "$check_tmp/tmux-after-reload-owned-delta.txt"; then
    pass "tmux symmetric pristine delta accepts only the canonical binding changes after reload"
  else
    sed 's/^/      /' "$check_tmp/tmux-after-reload-owned-delta.txt" >&2
    fail "tmux reload adds or changes an unowned or noncanonical binding"
  fi

  if tmux_copy_pipe_and_run_shell_payloads_are_safe "$check_tmp/tmux-after-reload-all-keys.txt"; then
    pass "all effective tmux copy-pipe and run-shell routes retain no unapproved explicit payloads after reload"
  else
    fail "a post-reload tmux copy-pipe or run-shell route contains an unapproved explicit payload"
  fi

  require_tmux_option_value "$check_socket" session @dotfiles_foundation_loaded 1 "tmux reload preserves the foundation marker" || true
  require_tmux_option_value "$check_socket" session @dotfiles_platform "$platform" "tmux reload preserves the platform marker" || true
  require_tmux_option_value "$check_socket" session prefix M-Space "tmux reload preserves prefix" || true
  require_tmux_option_value "$check_socket" session prefix2 None "tmux reload preserves disabled prefix2" || true
  require_tmux_option_value "$check_socket" server escape-time 10 "tmux reload preserves escape-time" || true
  require_tmux_option_value "$check_socket" server copy-command '' "tmux reload preserves empty copy-command" || true
  require_tmux_option_value "$check_socket" server default-terminal tmux-256color "tmux reload preserves default-terminal" || true
  require_tmux_option_value "$check_socket" server 'terminal-features[100]' 'xterm-ghostty:RGB:clipboard:extkeys' "tmux reload preserves the Ghostty feature slot" || true
  require_tmux_option_value "$check_socket" server extended-keys on "tmux reload preserves extended-keys" || true
  if tmux_option_value "$check_socket" server extended-keys-format > "$check_tmp/tmux-after-reload-key-format.txt" 2>/dev/null; then
    value=$(sed -n '1p' "$check_tmp/tmux-after-reload-key-format.txt")
    if [ "$value" = "csi-u" ]; then
      pass "tmux reload preserves extended-keys-format"
    else
      fail "tmux reload changed extended-keys-format to ${value:-unset}"
    fi
  elif version_at_least "${tmux_version:-0.0}" "3.5"; then
    fail "tmux 3.5 or newer lacks extended-keys-format after reload"
  else
    pass "tmux 3.2-3.4 reload preserves negotiated xterm-style extended keys"
  fi
  require_tmux_option_value "$check_socket" server set-clipboard external "tmux reload preserves set-clipboard" || true
  require_tmux_option_value "$check_socket" server focus-events on "tmux reload preserves focus-events" || true
  require_tmux_option_value "$check_socket" window allow-passthrough on \
    "tmux reload preserves graphics passthrough" || true
  require_tmux_option_value "$check_socket" session base-index 1 "tmux reload preserves base-index" || true
  require_tmux_option_value "$check_socket" window pane-base-index 1 "tmux reload preserves pane-base-index" || true
  require_tmux_option_value "$check_socket" session renumber-windows on "tmux reload preserves renumber-windows" || true
  require_tmux_option_value "$check_socket" window history-limit 100000 "tmux reload preserves history-limit" || true
  require_tmux_option_value "$check_socket" session mouse on "tmux reload preserves mouse" || true
  require_tmux_option_value "$check_socket" window mode-keys vi "tmux reload preserves mode-keys" || true
  require_tmux_option_value "$check_socket" session status-keys vi "tmux reload preserves status-keys" || true
  require_tmux_option_value "$check_socket" session status on "tmux reload preserves status" || true
  require_tmux_option_value "$check_socket" session status-interval 5 "tmux reload preserves status-interval" || true
  require_tmux_option_value "$check_socket" session status-position bottom "tmux reload preserves status-position" || true
  require_tmux_option_value "$check_socket" session status-justify absolute-centre "tmux reload preserves absolute window centering" || true
  require_tmux_option_value "$check_socket" session status-left-length 48 "tmux reload preserves the 48-cell left limit" || true
  require_tmux_option_value "$check_socket" session status-right-length 48 "tmux reload preserves the 48-cell right limit" || true
  require_tmux_option_value "$check_socket" session status-style 'fg=#a9b1d6,bg=#1A1B26' "tmux reload preserves the row base style" || true
  require_tmux_option_value "$check_socket" session status-left-style 'fg=#a9b1d6,bg=#1A1B26' "tmux reload preserves the left base style" || true
  require_tmux_option_value "$check_socket" session status-right-style 'fg=#a9b1d6,bg=#1A1B26' "tmux reload preserves the right base style" || true
  require_tmux_option_value "$check_socket" window monitor-activity on "tmux reload preserves window activity monitoring" || true
  require_tmux_option_value "$check_socket" window monitor-bell on "tmux reload preserves window bell monitoring" || true
  require_tmux_option_value "$check_socket" session visual-activity off "tmux reload preserves disabled activity overlays" || true
  require_tmux_option_value "$check_socket" session visual-bell off "tmux reload preserves disabled bell overlays" || true
  require_tmux_option_value "$check_socket" session window-status-separator '' "tmux reload preserves the gapless window list" || true
  require_tmux_option_value "$check_socket" session window-status-style 'fg=#787c99,bg=#1A1B26' "tmux reload preserves the inactive window style" || true
  require_tmux_option_value "$check_socket" session window-status-current-style 'fg=#a9b1d6,bg=#2A2F41,bold' "tmux reload preserves the current window style" || true
  require_tmux_option_value "$check_socket" session window-status-activity-style 'fg=#7dcfff,bg=#1A1B26' "tmux reload preserves the activity window style" || true
  require_tmux_option_value "$check_socket" session window-status-bell-style 'fg=#f7768e,bg=#1A1B26' "tmux reload preserves the bell window style" || true
  require_tmux_option_value "$check_socket" session window-status-format "$task6_expected_window_status_format" "tmux reload preserves the exact inactive window format" || true
  require_tmux_option_value "$check_socket" session window-status-current-format "$task6_expected_window_status_current_format" "tmux reload preserves the exact current window format" || true
  if tmux_status_jobs_are_exact \
    "$check_socket" terminal-stack-check \
    > "$check_tmp/tmux-status-job-after-reload.txt" 2>&1; then
    pass "tmux reload preserves the one exact native Git job key"
  else
    sed 's/^/      /' "$check_tmp/tmux-status-job-after-reload.txt" >&2
    fail "tmux reload changed the exact native Git job-key contract"
  fi
  case "$platform" in
    linux)
      expected_update_environment='DISPLAY
KRB5CCNAME
SSH_ASKPASS
SSH_AUTH_SOCK
SSH_AGENT_PID
SSH_CONNECTION
WINDOWID
XAUTHORITY
WAYLAND_DISPLAY
XDG_RUNTIME_DIR'
      ;;
    macos)
      expected_update_environment='DISPLAY
KRB5CCNAME
SSH_ASKPASS
SSH_AUTH_SOCK
SSH_AGENT_PID
SSH_CONNECTION
WINDOWID
XAUTHORITY'
      ;;
    *)
      expected_update_environment=''
      ;;
  esac
  require_tmux_option_value "$check_socket" session update-environment "$expected_update_environment" "tmux reload preserves platform update-environment" || true

  if grep -Fqx '1' "$check_tmp/tmux-after-reload-marker.txt" \
    && grep -Fqx "$platform" "$check_tmp/tmux-after-reload-platform.txt" \
    && grep -Fqx 'M-Space' "$check_tmp/tmux-after-reload-prefix.txt" \
    && grep -Fqx 'None' "$check_tmp/tmux-after-reload-prefix2.txt"; then
    pass "tmux reload leaves marker, platform, prefix, and prefix2 at canonical values"
  else
    fail "tmux reload snapshot contains a noncanonical scalar value"
  fi

  prefix_binding_count=0
  for key in M-Space '?' R Q f r v H J K L m s; do
    prefix_binding_count=$((prefix_binding_count + $(tmux_binding_count "$check_tmp/tmux-after-reload-prefix-keys.txt" prefix "$key")))
  done
  if [ "$prefix_binding_count" -eq 13 ]; then
    pass "tmux reload leaves exactly thirteen canonical prefix bindings"
  else
    fail "tmux reload must leave thirteen canonical prefix bindings; found $prefix_binding_count"
  fi

  require_tmux_binding \
    "$check_tmp/tmux-after-reload-prefix-keys.txt" prefix s \
    "$tmux_persistence_save_command" \
    "tmux reload preserves the confirmed workspace save binding" || true

  root_binding_count=0
  for key in M-n M-1 M-2 M-3 M-4 M-5 M-6 M-7 M-8 M-9 M-r M-Q "$serialized_backslash_key" 'M-|' M-h M-j M-k M-l M-q M-f; do
    root_binding_count=$((root_binding_count + $(tmux_binding_count "$check_tmp/tmux-after-reload-root-keys.txt" root "$key")))
  done
  if [ "$root_binding_count" -eq 20 ]; then
    pass "tmux reload leaves exactly twenty canonical root bindings"
  else
    fail "tmux reload must leave twenty canonical root bindings; found $root_binding_count"
  fi

  resize_binding_count=$(tmux_table_binding_count "$check_tmp/tmux-after-reload-resize-keys.txt" resize)
  if [ "$resize_binding_count" -eq 5 ]; then
    pass "tmux reload leaves exactly five resize bindings"
  else
    fail "tmux reload must leave five resize bindings; found $resize_binding_count"
  fi

  require_tmux_binding "$check_tmp/tmux-after-reload-copy-keys.txt" copy-mode-vi y 'send-keys -X copy-selection-and-cancel' "tmux reload preserves native vi copy-mode y" || true
fi

nvim_version=""
if command -v nvim >/dev/null 2>&1; then
  nvim_version=$(nvim --version | sed -n '1s/^NVIM v\([0-9][0-9.]*\).*/\1/p')
  if [ -n "$nvim_version" ] && version_at_least "$nvim_version" "0.12"; then
    pass "Neovim version $nvim_version"
  else
    fail "Neovim 0.12 or newer required; found ${nvim_version:-unknown}"
  fi
fi

nvim_config_ready=true
for nvim_file in \
  "$nvim_root/init.lua" \
  "$nvim_root/lazy-lock.json" \
