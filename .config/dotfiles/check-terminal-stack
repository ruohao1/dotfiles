  printf '%s\n' 'run-s true' > "$check_tmp/tmux-accept-run-s.conf"
  if [ "$tmux_started" = true ] \
    && tmux -S "$check_socket" source-file "$check_tmp/tmux-accept-run-s.conf" \
      > "$check_tmp/tmux-accept-run-s.txt" 2>&1; then
