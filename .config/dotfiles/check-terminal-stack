run_nvim_notebook_roundtrip() {
  [ "$#" -eq 6 ] || return 2
  nvim_roundtrip_name=$1
  nvim_roundtrip_notebook=$2
  nvim_roundtrip_invalid=$3
  nvim_roundtrip_ordinary=$4
  nvim_roundtrip_live=$5
  nvim_roundtrip_label=$6
  nvim_roundtrip_output="$check_tmp/nvim-roundtrip-$nvim_roundtrip_name.out"
  nvim_roundtrip_log="$check_tmp/nvim-roundtrip-$nvim_roundtrip_name.log"
  nvim_roundtrip_inspect="$check_tmp/nvim-roundtrip-$nvim_roundtrip_name.inspect"
  nvim_roundtrip_status_file="$check_tmp/nvim-roundtrip-$nvim_roundtrip_name.status"
  if ! nvim_roundtrip_invalid_before=$(cksum "$nvim_roundtrip_invalid" \
    | awk '{ print $1 ":" $2 }'); then
    fail "$nvim_roundtrip_label"
    return 1
  fi

  # The pinned Kitty transport accepts a pipe-backed stdout but rejects a
  # regular file descriptor. Capture through sed while recording Neovim's
  # status separately so the real image.nvim backend remains under test.
  : > "$nvim_roundtrip_log"
  (
    env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
      HOME="$check_tmp/nvim-notebook-home" \
      TMPDIR="$check_tmp" \
      VIRTUAL_ENV="$nvim_data_root/notebook-python" \
      XDG_CONFIG_HOME="$config_root" \
      XDG_DATA_HOME="$data_home" \
      XDG_STATE_HOME="$XDG_STATE_HOME" \
      XDG_CACHE_HOME="$XDG_CACHE_HOME" \
      XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
      JUPYTER_RUNTIME_DIR="$JUPYTER_RUNTIME_DIR" \
      NVIM_LOG_FILE="$nvim_roundtrip_log" \
      PYTHONDONTWRITEBYTECODE=1 \
      TERM_PROGRAM=ghostty \
      DOTFILES_NVIM_SKIP_PARSER_INSTALL=1 \
      DOTFILES_NOTEBOOK_FIXTURE="$nvim_roundtrip_notebook" \
      DOTFILES_NOTEBOOK_INVALID="$nvim_roundtrip_invalid" \
      DOTFILES_NOTEBOOK_ORDINARY="$nvim_roundtrip_ordinary" \
      DOTFILES_NOTEBOOK_TEST_SCRIPT="$nvim_root/tests/notebook_roundtrip.lua" \
      DOTFILES_NOTEBOOK_LIVE_KERNEL="$nvim_roundtrip_live" \
      nvim --headless -i NONE \
      -c 'lua vim.defer_fn(function() vim.api.nvim_err_writeln("notebook round trip exceeded 45 seconds"); vim.cmd("cquit 124") end, 45000)' \
      -c 'lua local plugins = require("lazy.core.config").plugins; local image = assert(plugins["image.nvim"], "image.nvim spec is unavailable"); assert(type(image.opts) == "table" and image.opts.backend == "kitty", "image.nvim must retain the Kitty backend"); assert(vim.g.molten_image_provider == "image.nvim", "Molten must retain the image.nvim provider"); assert(not image._.loaded, "image.nvim loaded before the notebook opened")' \
      -c 'lua vim.cmd.edit(vim.fn.fnameescape(vim.env.DOTFILES_NOTEBOOK_ORDINARY))' \
      -c 'lua dofile(vim.env.DOTFILES_NOTEBOOK_TEST_SCRIPT); io.stdout:write("\nnotebook round-trip assertions: ok\n"); io.stdout:flush()' \
      -c qa
    nvim_roundtrip_child_status=$?
    printf '%s\n' "$nvim_roundtrip_child_status" \
      > "$nvim_roundtrip_status_file"
  ) 2>&1 | sed -n 'p' > "$nvim_roundtrip_output"
  nvim_roundtrip_capture_status=$?
  printf '\n' >> "$nvim_roundtrip_output"
  nvim_roundtrip_nvim_status=""
  if [ -r "$nvim_roundtrip_status_file" ]; then
    IFS= read -r nvim_roundtrip_nvim_status \
      < "$nvim_roundtrip_status_file" || nvim_roundtrip_nvim_status=""
  fi
  rm -f "$nvim_roundtrip_status_file"

  if [ "$nvim_roundtrip_capture_status" -eq 0 ] \
    && [ "$nvim_roundtrip_nvim_status" = 0 ] \
    && ! nvim_log_has_error "$nvim_roundtrip_output" \
    && grep -Fqx 'notebook round-trip assertions: ok' "$nvim_roundtrip_output" \
    && [ ! -s "$nvim_roundtrip_log" ]; then
    nvim_roundtrip_run_ok=true
  else
    nvim_roundtrip_run_ok=false
  fi

  if [ "$nvim_roundtrip_live" = 1 ]; then
    nvim_roundtrip_expected=42
    nvim_roundtrip_shape=live
  else
    nvim_roundtrip_expected=41
    nvim_roundtrip_shape=stored
  fi
  if ! nvim_notebook_output_is_exact \
    "$nvim_roundtrip_notebook" "$nvim_roundtrip_expected" \
    "$nvim_roundtrip_shape" > "$nvim_roundtrip_inspect" 2>&1; then
    nvim_roundtrip_run_ok=false
  fi

  nvim_roundtrip_invalid_after=$(cksum "$nvim_roundtrip_invalid" \
    | awk '{ print $1 ":" $2 }') || nvim_roundtrip_run_ok=false
  if [ "$nvim_roundtrip_invalid_after" != "$nvim_roundtrip_invalid_before" ]; then
    nvim_roundtrip_run_ok=false
  fi

  nvim_roundtrip_directory=${nvim_roundtrip_notebook%/*}
  nvim_roundtrip_basename=${nvim_roundtrip_notebook##*/}
  nvim_roundtrip_sidecar=${nvim_roundtrip_notebook%.ipynb}.md
  for nvim_roundtrip_artifact in \
    "$nvim_roundtrip_sidecar" \
    "$nvim_roundtrip_directory/.notebook-roundtrip-probe.ipynb" \
    "$nvim_roundtrip_directory/.$nvim_roundtrip_basename.nvim-molten."*.ipynb
  do
    if [ -e "$nvim_roundtrip_artifact" ] || [ -L "$nvim_roundtrip_artifact" ]; then
      printf '      unexpected notebook artifact: %s\n' \
        "$nvim_roundtrip_artifact" >&2
      nvim_roundtrip_run_ok=false
    fi
  done

  if [ "$nvim_roundtrip_run_ok" = true ]; then
    pass "$nvim_roundtrip_label"
    return 0
  fi

  [ ! -s "$nvim_roundtrip_output" ] \
    || sed 's/^/      /' "$nvim_roundtrip_output" >&2
  [ ! -s "$nvim_roundtrip_log" ] \
    || sed 's/^/      /' "$nvim_roundtrip_log" >&2
  [ ! -s "$nvim_roundtrip_inspect" ] \
    || sed 's/^/      /' "$nvim_roundtrip_inspect" >&2
  fail "$nvim_roundtrip_label"
  return 1
}

require_terminfo_capability() {
  terminfo_file=$1
  terminfo_name=$2
  terminfo_capability=$3

  if grep -Eq "(^|[[:space:],])${terminfo_capability}=" "$terminfo_file"; then
    pass "$terminfo_name exposes $terminfo_capability"
    return 0
  fi

  fail "$terminfo_name is missing required capability $terminfo_capability"
  return 1
}

hardened_plugin_git() {
  [ "$#" -ge 2 ] || return 2
  [ -n "$real_git" ] || return 127
  hardened_git_checkout=$1
  shift

  LC_ALL=C \
    env GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
    "$real_git" -c core.fsmonitor=false -c core.hooksPath=/dev/null \
    -c core.untrackedCache=false \
    -C "$hardened_git_checkout" "$@"
}

nvim_lock_is_exact() {
  [ "$#" -eq 1 ] || return 2

  jq -e '
    keys == ["fzf-lua", "image.nvim", "jupytext.nvim", "lazy.nvim", "mini.icons", "mini.pairs", "mini.starter", "mini.surround", "molten-nvim", "nvim-treesitter", "oil.nvim", "otter.nvim", "quarto-nvim", "smart-splits.nvim", "tokyonight.nvim", "which-key.nvim"]
    and all(.[];
      if type == "object" then
        ((.commit? | type) == "string")
        and (.commit | test("^[0-9a-f]{40}$"))
      else
        false
      end
    )
  ' "$1" >/dev/null 2>&1
}

nvim_trust_reject() {
  [ "$#" -eq 1 ] || return 2
  printf 'plugin trust rejection: %s\n' "$1" >&2
  return 1
}

nvim_plugin_checkout_path_is_exact() {
  [ "$#" -eq 1 ] || return 2
  nvim_checkout_path=$1

  if [ ! -d "$nvim_checkout_path" ] || [ -L "$nvim_checkout_path" ]; then
    nvim_trust_reject "checkout root is missing or symlinked: $nvim_checkout_path"
    return 1
  fi
  if { [ ! -d "$nvim_checkout_path/.git" ] && [ ! -f "$nvim_checkout_path/.git" ]; } \
    || [ -L "$nvim_checkout_path/.git" ]; then
    nvim_trust_reject "checkout has no real .git entry: $nvim_checkout_path"
    return 1
  fi

  nvim_checkout_top=$(hardened_plugin_git "$nvim_checkout_path" \
    rev-parse --show-toplevel 2>/dev/null) || {
    nvim_trust_reject "could not resolve checkout top level: $nvim_checkout_path"
    return 1
  }
  nvim_checkout_expected=$(CDPATH='' cd "$nvim_checkout_path" 2>/dev/null \
    && pwd -P) || {
    nvim_trust_reject "could not resolve physical checkout path: $nvim_checkout_path"
    return 1
  }
  if [ "$nvim_checkout_top" != "$nvim_checkout_expected" ]; then
    nvim_trust_reject "checkout top level differs from expected path: $nvim_checkout_path"
    return 1
  fi

  return 0
}

nvim_plugin_revision_is_exact() {
  [ "$#" -eq 2 ] || return 2
  nvim_revision_checkout=$1
  nvim_revision_lock=$2

  nvim_revision_head=$(hardened_plugin_git "$nvim_revision_checkout" \
    rev-parse HEAD 2>/dev/null) || {
    nvim_trust_reject "could not read checkout HEAD: $nvim_revision_checkout"
    return 1
  }
  if [ "$nvim_revision_head" != "$nvim_revision_lock" ]; then
    nvim_trust_reject "checkout HEAD differs from its lock: $nvim_revision_checkout"
    return 1
  fi

  return 0
}

nvim_plugin_locked_tree_is_exact() {
  [ "$#" -eq 4 ] || return 2
  nvim_locked_checkout=$1
  nvim_locked_name=$2
  nvim_locked_commit=$3
  nvim_locked_audit_prefix=$4
  nvim_locked_output=$nvim_locked_audit_prefix.locked-tree

  if env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
    XDG_CONFIG_HOME="$config_root" \
    XDG_DATA_HOME="$check_tmp/nvim-trust-data" \
    XDG_STATE_HOME="$XDG_STATE_HOME" \
    XDG_CACHE_HOME="$XDG_CACHE_HOME" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    TERM_PROGRAM=ghostty \
    DOTFILES_PLUGIN_CHECKOUT="$nvim_locked_checkout" \
    DOTFILES_PLUGIN_NAME="$nvim_locked_name" \
    DOTFILES_PLUGIN_LOCK="$nvim_locked_commit" \
    DOTFILES_GIT_BIN="$real_git" \
    nvim --clean --headless -u NONE -i NONE \
    -l "$nvim_root/tests/plugin_source.lua" \
    > "$nvim_locked_output" 2>&1 \
    && ! nvim_log_has_error "$nvim_locked_output" \
    && grep -Fqx 'Neovim plugin source byte assertions: ok' \
      "$nvim_locked_output"; then
    return 0
  fi

  [ ! -s "$nvim_locked_output" ] \
    || sed 's/^/      /' "$nvim_locked_output" >&2
  nvim_trust_reject "worktree bytes differ from locked objects: $nvim_locked_name"
  return 1
}

