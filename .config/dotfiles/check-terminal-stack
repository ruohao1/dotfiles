    url_source_audit="$check_tmp/tmux-url-source-$url_source_case-audit.txt"
    if tmux_url_source_fixture "$url_source_case" "$url_source_fixture" \
      && ! cmp -s "$tmux_keys" "$url_source_fixture" \
      && ! tmux_source_commands_are_allowed keys "$url_source_fixture" \
        > "$url_source_audit" \
