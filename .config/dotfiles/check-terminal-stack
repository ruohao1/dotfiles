      "$data_query_integration_processes" \
      "$data_query_mode_require_records" \
      >> "$data_query_integration_output" 2>&1 \
      || data_query_mode_postcheck_ready=false

    data_query_mode_ready=true
    [ "$data_query_mode_status" -eq 0 ] || data_query_mode_ready=false
    [ "$data_query_mode_postcheck_ready" = true ] || data_query_mode_ready=false
    nvim_log_has_error "$data_query_integration_output" \
