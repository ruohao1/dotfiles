  require_tmux_status_source_replacement_rejected alternate-path-modifier \
    '#{qh:@dotfiles_nvim_path}' '#{p8:@dotfiles_nvim_path}' \
    "tmux status source audit rejects an alternate Neovim-path display modifier" || true
  require_tmux_status_source_replacement_rejected alternate-pane-path-modifier \
    '#{qh:pane_current_path}' '#{p8:pane_current_path}' \
    "tmux status source audit rejects an alternate pane-path display modifier" || true
  require_tmux_status_source_replacement_rejected alternate-window-name-modifier \
    '#{qh:window_name}' '#{p8:window_name}' \
    "tmux status source audit rejects an alternate window-name display modifier" || true
  require_tmux_status_source_replacement_rejected alternate-session-name-modifier \
    'APP' '#{p8:session_name}' \
    "tmux status source audit rejects every session-name key mention" || true
  require_tmux_status_source_replacement_rejected double-expand-e \
    '#{qh:@dotfiles_nvim_path}' '#{E:@dotfiles_nvim_path}' \
    "tmux status source audit rejects E expansion" || true
  require_tmux_status_source_replacement_rejected double-expand-t \
    '#{qh:@dotfiles_nvim_path}' '#{T:@dotfiles_nvim_path}' \
    "tmux status source audit rejects T expansion" || true
  require_tmux_status_source_append_rejected session-name \
    "set -g status-left '#S'" \
    "tmux status source audit rejects session-name display" || true
  require_tmux_status_source_append_rejected theme-source \
    'source-file ~/.config/tmux/conf/theme.conf' \
    "tmux status source audit rejects a theme source" || true
  require_tmux_status_source_append_rejected stock-status-format \
    "set -g status-format[0] '#{l:unchanged}'" \
    "tmux status assignment manifest rejects status-format[0]" || true
  require_tmux_status_source_append_rejected duplicate-status-left \
    "set -g status-left '#{l:duplicate}'" \
    "tmux status assignment manifest rejects a duplicate renderer option" || true
  require_tmux_status_source_append_rejected forced-refresh \
    'run-shell "tmux refresh-client -S"' \
    "tmux status source audit rejects forced status refresh" || true
  require_tmux_status_source_append_rejected raw-mode-display \
    "set -g status-right '#{@dotfiles_nvim_mode}'" \
    "tmux status source audit rejects an appended raw mode display" || true
  require_tmux_status_source_append_rejected raw-error-display \
    "set -g status-right '#{@dotfiles_nvim_errors}'" \
    "tmux status source audit rejects an appended raw error display" || true
  require_tmux_status_source_append_rejected raw-warning-display \
    "set -g status-right '#{@dotfiles_nvim_warnings}'" \
    "tmux status source audit rejects an appended raw warning display" || true
  require_tmux_status_source_append_rejected raw-line-display \
    "set -g status-right '#{@dotfiles_nvim_line}'" \
    "tmux status source audit rejects an appended raw line display" || true
  require_tmux_status_source_append_rejected raw-column-display \
    "set -g status-right '#{@dotfiles_nvim_column}'" \
    "tmux status source audit rejects an appended raw column display" || true
  tmux_powerline_append=$(printf '\356\202\260')
  require_tmux_status_source_append_rejected powerline \
    "set -g status-left '$tmux_powerline_append'" \
    "tmux status source audit rejects Powerline separators" || true

  tmux_status_comment_palette="$check_tmp/tmux-status-comment-palette.conf"
  tmux_status_comment_palette_audit="$check_tmp/tmux-status-comment-palette-audit.txt"
  if tmux_status_source_replace_all \
      "$tmux_status" '#73daca' '#7dcfff' \
      "$tmux_status_comment_palette" \
    && printf '%s\n' '# #[fg=#73daca]' >> "$tmux_status_comment_palette" \
    && ! tmux_status_source_is_safe "$tmux_status_comment_palette" \
      > "$tmux_status_comment_palette_audit"; then
    pass "tmux status palette audit ignores colors that exist only in comments"
  else
    sed 's/^/      /' "$tmux_status_comment_palette_audit" >&2
    fail "tmux status palette audit counted a comment-only required color"
  fi

  tmux_shared_sequence="\"\$HOME/.config/tmux/conf/options.conf\" \"\$HOME/.config/tmux/conf/keys.conf\" \"$tmux_persistence_source\" \"\$HOME/.config/tmux/conf/status.conf\""
  # shellcheck disable=SC2016  # Mutation text must retain literal tmux paths.
  tmux_missing_persistence_sequence='"$HOME/.config/tmux/conf/options.conf" "$HOME/.config/tmux/conf/keys.conf" "$HOME/.config/tmux/conf/status.conf"'
  tmux_duplicate_persistence_sequence="\"\$HOME/.config/tmux/conf/options.conf\" \"\$HOME/.config/tmux/conf/keys.conf\" \"$tmux_persistence_source\" \"$tmux_persistence_source\" \"\$HOME/.config/tmux/conf/status.conf\""
  tmux_reordered_persistence_sequence="\"\$HOME/.config/tmux/conf/options.conf\" \"\$HOME/.config/tmux/conf/keys.conf\" \"\$HOME/.config/tmux/conf/status.conf\" \"$tmux_persistence_source\""
  # shellcheck disable=SC2016  # Mutation text must retain literal tmux paths.
  tmux_substituted_persistence_sequence='"$HOME/.config/tmux/conf/options.conf" "$HOME/.config/tmux/conf/keys.conf" "$HOME/.config/tmux/conf/not-persistence.conf" "$HOME/.config/tmux/conf/status.conf"'

  require_tmux_entry_module_sequence_rejected \
    persistence-missing "$tmux_shared_sequence" "$tmux_missing_persistence_sequence" \
    "tmux entry audit rejects a missing persistence module" || true
  require_tmux_entry_module_sequence_rejected \
    persistence-duplicate "$tmux_shared_sequence" "$tmux_duplicate_persistence_sequence" \
    "tmux entry audit rejects a duplicate persistence module" || true
  require_tmux_entry_module_sequence_rejected \
    persistence-reordered "$tmux_shared_sequence" "$tmux_reordered_persistence_sequence" \
    "tmux entry audit rejects a reordered persistence module" || true
  require_tmux_entry_module_sequence_rejected \
    persistence-substituted "$tmux_shared_sequence" "$tmux_substituted_persistence_sequence" \
    "tmux entry audit rejects a substituted persistence module" || true

  task6_replace_all 'workspace save' 'workspace restore' \
    < "$tmux_persistence" > "$check_tmp/tmux-persistence-action-mutation.conf"
  if ! tmux_source_commands_are_allowed persistence \
      "$check_tmp/tmux-persistence-action-mutation.conf" \
      > "$check_tmp/tmux-persistence-action-mutation-audit.txt" 2>&1 \
    && grep -Fq 'noncanonical tmux persistence binding' \
      "$check_tmp/tmux-persistence-action-mutation-audit.txt"; then
    pass "tmux persistence source audit rejects a restore action"
  else
    sed 's/^/      /' "$check_tmp/tmux-persistence-action-mutation-audit.txt" >&2
    fail "tmux persistence source audit accepted or misclassified a restore action"
  fi

  sed -n 'p' "$tmux_persistence" \
    "$tmux_persistence" > "$check_tmp/tmux-persistence-duplicate-mutation.conf"
  if ! tmux_source_commands_are_allowed persistence \
      "$check_tmp/tmux-persistence-duplicate-mutation.conf" \
      > "$check_tmp/tmux-persistence-duplicate-mutation-audit.txt" 2>&1 \
    && grep -Fq 'tmux persistence binding count mismatch' \
      "$check_tmp/tmux-persistence-duplicate-mutation-audit.txt"; then
    pass "tmux persistence source audit rejects a duplicate binding"
  else
    sed 's/^/      /' "$check_tmp/tmux-persistence-duplicate-mutation-audit.txt" >&2
    fail "tmux persistence source audit accepted or misclassified a duplicate binding"
  fi

  {
    printf '%s\n' '{'
    sed 's/^/  /' "$tmux_persistence"
    printf '%s\n' '}'
  } > "$check_tmp/tmux-persistence-nested-mutation.conf"
  if ! tmux_source_commands_are_allowed persistence \
      "$check_tmp/tmux-persistence-nested-mutation.conf" \
      > "$check_tmp/tmux-persistence-nested-mutation-audit.txt" 2>&1 \
    && grep -Fq 'noncanonical tmux persistence binding scope' \
      "$check_tmp/tmux-persistence-nested-mutation-audit.txt"; then
    pass "tmux persistence source audit rejects a binding below module top level"
  else
    sed 's/^/      /' "$check_tmp/tmux-persistence-nested-mutation-audit.txt" >&2
    fail "tmux persistence source audit accepted or misclassified a nested binding"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-theme-mutation.conf"
  printf '%s\n' 'source-file ~/.config/tmux/themes/generic.conf' >> "$check_tmp/tmux-entry-theme-mutation.conf"
  if tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-theme-mutation.conf"; then
    fail "tmux source-graph audit accepted a generic theme source mutation"
  else
    pass "tmux source-graph audit rejects a generic theme source mutation"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-tpm-mutation.conf"
  printf '%s\n' 'run-shell ~/.config/tmux/plugins/tpm/tpm' >> "$check_tmp/tmux-entry-tpm-mutation.conf"
  if tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-tpm-mutation.conf"; then
    fail "tmux entry audit accepted a direct TPM run-shell mutation"
  else
    pass "tmux entry audit rejects a direct TPM run-shell mutation"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-run-alias-mutation.conf"
  printf '%s\n' 'run ~/.config/tmux/plugins/tpm/tpm' >> "$check_tmp/tmux-entry-run-alias-mutation.conf"
  if tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-run-alias-mutation.conf"; then
    fail "tmux entry audit accepted the documented run alias mutation"
  else
    pass "tmux entry audit rejects the documented run alias mutation"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-source-alias-mutation.conf"
  printf '%s\n' 'source ~/.config/tmux/conf/theme.conf' >> "$check_tmp/tmux-entry-source-alias-mutation.conf"
  if tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-source-alias-mutation.conf"; then
    fail "tmux entry audit accepted the documented source alias mutation"
  else
    pass "tmux entry audit rejects the documented source alias mutation"
  fi

  printf '%s\n' 'run-shell wl-copy' > "$check_tmp/tmux-module-run-shell-mutation.conf"
  if tmux_source_commands_are_allowed options "$check_tmp/tmux-module-run-shell-mutation.conf"; then
    fail "tmux module audit accepted a run-shell wl-copy mutation"
  else
    pass "tmux module audit rejects a run-shell wl-copy mutation"
  fi

  printf '%s\n' 'source ~/.config/tmux/conf/theme.conf' > "$check_tmp/tmux-module-source-alias-mutation.conf"
  if tmux_source_commands_are_allowed options "$check_tmp/tmux-module-source-alias-mutation.conf"; then
    fail "tmux module audit accepted the documented source alias mutation"
  else
    pass "tmux module audit rejects the documented source alias mutation"
  fi

  printf '%s\n' 'source-file ~/.config/tmux/conf/theme.conf' > "$check_tmp/tmux-module-source-file-mutation.conf"
  if tmux_source_commands_are_allowed options "$check_tmp/tmux-module-source-file-mutation.conf"; then
    fail "tmux module audit accepted a nested source-file mutation"
  else
    pass "tmux module audit rejects a nested source-file mutation"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-sou-mutation.conf"
  printf '%s\n' 'sou /dev/null' >> "$check_tmp/tmux-entry-sou-mutation.conf"
  if ! tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-sou-mutation.conf" \
    > "$check_tmp/tmux-entry-sou-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=entry verb=sou' "$check_tmp/tmux-entry-sou-audit.txt"; then
    pass "tmux entry positive audit rejects the sou abbreviation"
  else
    fail "tmux entry positive audit accepted the sou abbreviation"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-source-f-mutation.conf"
  printf '%s\n' 'source-f /dev/null' >> "$check_tmp/tmux-entry-source-f-mutation.conf"
  if ! tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-source-f-mutation.conf" \
    > "$check_tmp/tmux-entry-source-f-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=entry verb=source-f' "$check_tmp/tmux-entry-source-f-audit.txt"; then
    pass "tmux entry positive audit rejects the source-f abbreviation"
  else
    fail "tmux entry positive audit accepted the source-f abbreviation"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-run-s-mutation.conf"
  printf '%s\n' 'run-s true' >> "$check_tmp/tmux-entry-run-s-mutation.conf"
  if ! tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-run-s-mutation.conf" \
    > "$check_tmp/tmux-entry-run-s-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=entry verb=run-s' "$check_tmp/tmux-entry-run-s-audit.txt"; then
    pass "tmux entry positive audit rejects the run-s abbreviation"
  else
    fail "tmux entry positive audit accepted the run-s abbreviation"
  fi

  printf '%s\n' 'sou /dev/null' > "$check_tmp/tmux-module-sou-mutation.conf"
  if ! tmux_source_commands_are_allowed options "$check_tmp/tmux-module-sou-mutation.conf" \
    > "$check_tmp/tmux-module-sou-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=options verb=sou' "$check_tmp/tmux-module-sou-audit.txt"; then
    pass "tmux module positive audit rejects the sou abbreviation"
  else
    fail "tmux module positive audit accepted the sou abbreviation"
  fi

  printf '%s\n' 'source-f /dev/null' > "$check_tmp/tmux-module-source-f-mutation.conf"
  if ! tmux_source_commands_are_allowed options "$check_tmp/tmux-module-source-f-mutation.conf" \
    > "$check_tmp/tmux-module-source-f-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=options verb=source-f' "$check_tmp/tmux-module-source-f-audit.txt"; then
    pass "tmux module positive audit rejects the source-f abbreviation"
  else
    fail "tmux module positive audit accepted the source-f abbreviation"
  fi

  printf '%s\n' 'run-s true' > "$check_tmp/tmux-module-run-s-mutation.conf"
  if ! tmux_source_commands_are_allowed options "$check_tmp/tmux-module-run-s-mutation.conf" \
    > "$check_tmp/tmux-module-run-s-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=options verb=run-s' "$check_tmp/tmux-module-run-s-audit.txt"; then
    pass "tmux module positive audit rejects the run-s abbreviation"
  else
    fail "tmux module positive audit accepted the run-s abbreviation"
  fi

  printf '%s\n' "if-shell true 'run-s true'" > "$check_tmp/tmux-module-nested-run-s-mutation.conf"
  if ! tmux_source_commands_are_allowed options "$check_tmp/tmux-module-nested-run-s-mutation.conf" \
    > "$check_tmp/tmux-module-nested-run-s-audit.txt" \
    && grep -Fq 'unapproved tmux command verb: policy=options-branch verb=run-s' \
      "$check_tmp/tmux-module-nested-run-s-audit.txt"; then
    pass "tmux module positive audit rejects run-s inside an executable if-shell argument"
  else
    fail "tmux module positive audit accepted nested run-s inside if-shell"
  fi

  for hash_second_command in 'run-s true' 'sou /dev/null'; do
    hash_second_verb=${hash_second_command%% *}
    sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-midword-hash-$hash_second_verb.conf"
    printf '%s\n' "display-message harmless#x ; $hash_second_command" \
      >> "$check_tmp/tmux-entry-midword-hash-$hash_second_verb.conf"
    if ! tmux_entry_source_graph_is_allowed \
      "$check_tmp/tmux-entry-midword-hash-$hash_second_verb.conf" \
      > "$check_tmp/tmux-entry-midword-hash-$hash_second_verb-audit.txt" \
      && grep -Fq "unapproved tmux command verb: policy=entry verb=$hash_second_verb" \
        "$check_tmp/tmux-entry-midword-hash-$hash_second_verb-audit.txt"; then
      pass "tmux entry audit rejects $hash_second_verb after a midword hash"
    else
      sed 's/^/      /' "$check_tmp/tmux-entry-midword-hash-$hash_second_verb-audit.txt" >&2
      fail "tmux entry audit accepted $hash_second_verb after a midword hash"
    fi

    sed -n 'p' "$tmux_options" > "$check_tmp/tmux-module-midword-hash-$hash_second_verb.conf"
    printf '%s\n' "set -g @hash_probe harmless#x ; $hash_second_command" \
      >> "$check_tmp/tmux-module-midword-hash-$hash_second_verb.conf"
    if ! tmux_source_commands_are_allowed options \
      "$check_tmp/tmux-module-midword-hash-$hash_second_verb.conf" \
      > "$check_tmp/tmux-module-midword-hash-$hash_second_verb-audit.txt" \
      && grep -Fq "unapproved tmux command verb: policy=options verb=$hash_second_verb" \
        "$check_tmp/tmux-module-midword-hash-$hash_second_verb-audit.txt"; then
      pass "tmux module audit rejects $hash_second_verb after a midword hash"
    else
      sed 's/^/      /' "$check_tmp/tmux-module-midword-hash-$hash_second_verb-audit.txt" >&2
      fail "tmux module audit accepted $hash_second_verb after a midword hash"
    fi
  done

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-hash-positive-controls.conf"
  printf '%s\n' \
    'display-message harmless # ; run-s true' \
    'display-message "quoted#hash ; run-s true"' \
    'display-message escaped\#hash' \
    'display-message harmless#hash' \
    >> "$check_tmp/tmux-entry-hash-positive-controls.conf"
  if tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-hash-positive-controls.conf" \
    > "$check_tmp/tmux-entry-hash-positive-controls-audit.txt"; then
    pass "tmux entry audit accepts all four harmless hash controls"
  else
    sed 's/^/      /' "$check_tmp/tmux-entry-hash-positive-controls-audit.txt" >&2
    fail "tmux entry audit rejected a harmless hash control"
  fi

  sed -n 'p' "$tmux_options" > "$check_tmp/tmux-module-hash-positive-controls.conf"
  printf '%s\n' \
    'set -g @hash_probe_comment harmless # ; run-s true' \
    'set -g @hash_probe_quoted "quoted#hash ; run-s true"' \
    'set -g @hash_probe_escaped escaped\#hash' \
    'set -g @hash_probe_midword harmless#hash' \
    >> "$check_tmp/tmux-module-hash-positive-controls.conf"
  if tmux_source_commands_are_allowed options "$check_tmp/tmux-module-hash-positive-controls.conf" \
    > "$check_tmp/tmux-module-hash-positive-controls-audit.txt"; then
    pass "tmux module audit accepts all four harmless hash controls"
  else
    sed 's/^/      /' "$check_tmp/tmux-module-hash-positive-controls-audit.txt" >&2
    fail "tmux module audit rejected a harmless hash control"
  fi

  for entry_condition_wrapper in 'command tmux -S' 'env tmux -S' '/path/to/tmux -S'; do
    entry_condition_label=$(printf '%s' "$entry_condition_wrapper" | sed 's/[^[:alnum:]]\{1,\}/-/g; s/^-//; s/-$//')
    entry_condition_mutation="$check_tmp/tmux-entry-condition-$entry_condition_label.conf"
    entry_condition_audit="$check_tmp/tmux-entry-condition-$entry_condition_label-audit.txt"
    if TMUX_CONDITION_REPLACEMENT=$entry_condition_wrapper awk '
        !mutated && /if-shell .*tmux -S .*platform\/macos[.]conf/ {
          sub(/tmux -S/, ENVIRON["TMUX_CONDITION_REPLACEMENT"])
          mutated = 1
        }
        { print }
        END { exit !mutated }
      ' "$tmux_entry" > "$entry_condition_mutation" \
      && ! tmux_entry_source_graph_is_allowed "$entry_condition_mutation" > "$entry_condition_audit" \
      && grep -Fq "  actual: $entry_condition_wrapper \"#{socket_path}\" source-file" "$entry_condition_audit" \
      && tmux_audit_reports_only_condition_manifest_errors "$entry_condition_audit"; then
      pass "tmux entry exact condition manifest rejects the $entry_condition_wrapper source-file wrapper"
    else
      sed 's/^/      /' "$entry_condition_audit" >&2
      fail "tmux entry condition audit did not reject only the $entry_condition_wrapper wrapper"
    fi
  done

  if TMUX_CONDITION_REPLACEMENT='command tmux run-shell true' awk '
      !mutated && /if-shell .*extended-keys-format/ {
        sub(/tmux show-options -sv extended-keys-format >\/dev\/null 2>&1/, ENVIRON["TMUX_CONDITION_REPLACEMENT"])
        mutated = 1
      }
      { print }
      END { exit !mutated }
    ' "$tmux_options" > "$check_tmp/tmux-options-command-wrapper-mutation.conf" \
    && ! tmux_source_commands_are_allowed options "$check_tmp/tmux-options-command-wrapper-mutation.conf" \
      > "$check_tmp/tmux-options-command-wrapper-audit.txt" \
    && grep -Fq '  actual: command tmux run-shell true' "$check_tmp/tmux-options-command-wrapper-audit.txt" \
    && tmux_audit_reports_only_condition_manifest_errors "$check_tmp/tmux-options-command-wrapper-audit.txt"; then
    pass "tmux options exact condition manifest rejects command tmux run-shell"
  else
    sed 's/^/      /' "$check_tmp/tmux-options-command-wrapper-audit.txt" >&2
    fail "tmux options condition audit did not reject only command tmux run-shell"
  fi

  sed -n 'p' "$tmux_options" > "$check_tmp/tmux-options-duplicate-condition-mutation.conf"
  printf '%s\n' \
    "if-shell 'tmux show-options -sv extended-keys-format >/dev/null 2>&1' 'set-option -s extended-keys-format csi-u'" \
    >> "$check_tmp/tmux-options-duplicate-condition-mutation.conf"
  if ! tmux_source_commands_are_allowed options "$check_tmp/tmux-options-duplicate-condition-mutation.conf" \
    > "$check_tmp/tmux-options-duplicate-condition-audit.txt" \
    && grep -Fq 'duplicate tmux if-shell condition: policy=options' \
      "$check_tmp/tmux-options-duplicate-condition-audit.txt" \
    && tmux_audit_reports_only_condition_manifest_errors "$check_tmp/tmux-options-duplicate-condition-audit.txt"; then
    pass "tmux options exact condition manifest rejects a duplicate canonical condition"
  else
    sed 's/^/      /' "$check_tmp/tmux-options-duplicate-condition-audit.txt" >&2
    fail "tmux options condition audit accepted or misclassified a duplicate condition"
  fi

  sed -n 'p' "$tmux_entry" > "$check_tmp/tmux-entry-quoted-decoy.conf"
  printf '%s\n' 'display-message "quoted \"run-s\" \; source-file run-shell # harmless"' \
    >> "$check_tmp/tmux-entry-quoted-decoy.conf"
  printf '%s\n' 'display-message harmless # source-file run-shell sou source-f run-s' \
    >> "$check_tmp/tmux-entry-quoted-decoy.conf"
  if tmux_entry_source_graph_is_allowed "$check_tmp/tmux-entry-quoted-decoy.conf" \
    > "$check_tmp/tmux-entry-quoted-decoy-audit.txt"; then
    pass "tmux entry positive audit ignores quoted, escaped, and commented command decoys"
  else
    sed 's/^/      /' "$check_tmp/tmux-entry-quoted-decoy-audit.txt" >&2
    fail "tmux entry positive audit rejected harmless command decoys"
  fi

  sed -n 'p' "$tmux_options" > "$check_tmp/tmux-module-quoted-decoy.conf"
  printf '%s\n' 'set -g @source_closure_decoy "quoted \"run-s\" \; source-file run-shell # harmless"' \
    >> "$check_tmp/tmux-module-quoted-decoy.conf"
  printf '%s\n' 'set -g @source_closure_comment harmless # source-file run-shell sou source-f run-s' \
    >> "$check_tmp/tmux-module-quoted-decoy.conf"
  if tmux_source_commands_are_allowed options "$check_tmp/tmux-module-quoted-decoy.conf" \
    > "$check_tmp/tmux-module-quoted-decoy-audit.txt"; then
    pass "tmux module positive audit ignores quoted, escaped, and commented command decoys"
  else
    sed 's/^/      /' "$check_tmp/tmux-module-quoted-decoy-audit.txt" >&2
    fail "tmux module positive audit rejected harmless command decoys"
  fi

  printf '%s\n' 'set -g @plugin example/theme' > "$check_tmp/tmux-plugin-mutation.conf"
  if tmux_sources_are_plugin_free "$check_tmp/tmux-plugin-mutation.conf"; then
    fail "tmux plugin audit accepted an @plugin mutation"
  else
    pass "tmux plugin audit rejects an @plugin mutation"
  fi
fi

if [ -r "$tmux_options" ]; then
  require_normalized_line \
    "$tmux_options" \
    'set-scopy-command""' \
    'tmux options explicitly leave copy-command empty' || true
fi

if [ -r "$tmux_root/conf/platform/linux.conf" ]; then
