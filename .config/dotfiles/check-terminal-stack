check_clipboard_history() {
  for clipboard_command in python3 id find; do
    require_command "$clipboard_command" || return 1
  done
  if ! python3 - "$config_root" "$0" "$checker_workspace_source" <<'CLIPBOARD_SOURCE_CHECK'
import importlib.util
from pathlib import Path
