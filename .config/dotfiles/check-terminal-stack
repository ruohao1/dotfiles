resolve_nvim_parquet_tool() {
  parquet_resolver_root="$check_tmp/nvim-parquet-resolver"
  parquet_resolver_report="$parquet_resolver_root/report.json"
  parquet_resolver_log="$parquet_resolver_root/nvim.log"
  parquet_resolver_nvim=$(command -v nvim 2>/dev/null || true)
  parquet_resolver_jq=$(command -v jq 2>/dev/null || true)
  case "$parquet_resolver_nvim" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$parquet_resolver_jq" in
    /*) ;;
    *) return 1 ;;
  esac
  if ! (umask 077 && mkdir -p \
    "$parquet_resolver_root/config" \
    "$parquet_resolver_root/state" \
    "$parquet_resolver_root/cache" \
    "$parquet_resolver_root/runtime"); then
    return 1
  fi
  : > "$parquet_resolver_log"

  if ! env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
    XDG_CONFIG_HOME="$parquet_resolver_root/config" \
    XDG_DATA_HOME="$data_home" \
    XDG_STATE_HOME="$parquet_resolver_root/state" \
    XDG_CACHE_HOME="$parquet_resolver_root/cache" \
    XDG_RUNTIME_DIR="$parquet_resolver_root/runtime" \
    NVIM_LOG_FILE="$parquet_resolver_log" \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_OFFLINE=1 \
    DOTFILES_NVIM_ROOT="$nvim_root" \
    DOTFILES_PARQUET_REPORT="$parquet_resolver_report" \
    "$parquet_resolver_nvim" --clean --headless -u NONE -i NONE \
    -c 'lua vim.opt.runtimepath:prepend(vim.env.DOTFILES_NVIM_ROOT)' \
    -c 'lua local report = require("parquet.tool").probe({ refresh = true }); assert(vim.fn.writefile({ vim.json.encode(report) }, vim.env.DOTFILES_PARQUET_REPORT) == 0)' \
    -c qa > "$parquet_probe_output" 2>&1 \
    || nvim_log_has_error "$parquet_probe_output" \
    || [ -s "$parquet_resolver_log" ]; then
    return 1
  fi

  if ! "$parquet_resolver_jq" -e '
      def safe_absolute:
        type == "string"
        and length > 1
        and startswith("/")
        and (test("[[:cntrl:]]") | not);
      type == "object"
      and .ok == true
      and (.errors | type == "array" and length == 0)
      and .expected == {"pyarrow":"25.0.0","uv":"0.11.6","visidata":"3.4"}
      and (.uv | type == "object" and .ok == true and (.path | safe_absolute) and (.version | type == "string"))
      and (.environment | safe_absolute)
      and (.python | safe_absolute)
      and (.viewer | type == "object" and .ok == true and .version == "3.4" and (.path | safe_absolute))
      and (.pyarrow | type == "object" and .ok == true and .version == "25.0.0" and (.path | safe_absolute))
    ' "$parquet_resolver_report" > /dev/null 2>> "$parquet_probe_output"; then
    return 1
  fi

  parquet_tool_uv=$("$parquet_resolver_jq" -er '.uv.path' \
    "$parquet_resolver_report" 2>> "$parquet_probe_output") || return 1
  parquet_tool_environment=$("$parquet_resolver_jq" -er '.environment' \
    "$parquet_resolver_report" 2>> "$parquet_probe_output") || return 1
  parquet_tool_python=$("$parquet_resolver_jq" -er '.python' \
    "$parquet_resolver_report" 2>> "$parquet_probe_output") || return 1
  parquet_tool_viewer=$("$parquet_resolver_jq" -er '.viewer.path' \
    "$parquet_resolver_report" 2>> "$parquet_probe_output") || return 1
  parquet_tool_pyarrow=$("$parquet_resolver_jq" -er '.pyarrow.path' \
    "$parquet_resolver_report" 2>> "$parquet_probe_output") || return 1
  parquet_tool_uv_directory=${parquet_tool_uv%/*}
  [ -n "$parquet_tool_uv_directory" ] || parquet_tool_uv_directory=/

  [ -x "$parquet_tool_uv" ] \
    && [ -d "$parquet_tool_uv_directory" ] \
    && [ -d "$parquet_tool_environment" ] \
    && [ -x "$parquet_tool_python" ] \
    && [ -x "$parquet_tool_viewer" ] \
    && [ -r "$parquet_tool_pyarrow" ] \
    || return 1
  case "$parquet_tool_viewer" in
    "$parquet_tool_environment"/*) ;;
    *) return 1 ;;
  esac
  case "$parquet_tool_pyarrow" in
    "$parquet_tool_environment"/*) ;;
    *) return 1 ;;
  esac
  nvim_parquet_versions_are_exact "$parquet_tool_python" \
    >> "$parquet_probe_output" 2>&1
}

