}

run_nvim_trust_self_test() {
  nvim_self_test_start_failures=$failures
  printf '%s\n' 'Neovim plugin trust self-test'

  for nvim_self_test_command in git jq nvim cmp grep mkdir ln cp mv chmod touch; do
    if ! command -v "$nvim_self_test_command" >/dev/null 2>&1; then
      fail "Neovim trust self-test requires $nvim_self_test_command"
    fi
  done
  if [ "$failures" -ne "$nvim_self_test_start_failures" ]; then
    return 1
  fi

  for nvim_lock_fixture_mode in valid extra missing nonhex nonobject; do
    nvim_lock_fixture=$check_tmp/nvim-lock-$nvim_lock_fixture_mode.json
    if ! nvim_trust_write_lock_fixture \
      "$nvim_lock_fixture" "$nvim_lock_fixture_mode"; then
      fail "could not create $nvim_lock_fixture_mode lock fixture"
    fi
  done
  nvim_trust_expect_accept \
    "exact sixteen-object lock is accepted" \
    nvim_lock_is_exact "$check_tmp/nvim-lock-valid.json" || true
  nvim_trust_expect_reject \
    "extra lock key is rejected" \
    nvim_lock_is_exact "$check_tmp/nvim-lock-extra.json" || true
  nvim_trust_expect_reject \
    "missing plugin commit is rejected" \
    nvim_lock_is_exact "$check_tmp/nvim-lock-missing.json" || true
  nvim_trust_expect_reject \
    "non-40-hex plugin commit is rejected" \
    nvim_lock_is_exact "$check_tmp/nvim-lock-nonhex.json" || true
  nvim_trust_expect_reject \
    "non-object plugin lock value is rejected" \
    nvim_lock_is_exact "$check_tmp/nvim-lock-nonobject.json" || true

  nvim_fixture=$check_tmp/nvim-trust-valid-ignored
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_accept \
      "byte-identical ignored generated tags are accepted" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" lazy.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-valid-ignored" || true
  else
    fail "could not create valid ignored-tags fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-valid-untracked
  if nvim_trust_fixture_init "$nvim_fixture" mini.icons; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_accept \
      "byte-identical untracked generated tags are accepted" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" mini.icons "$nvim_fixture_lock" \
      "$check_tmp/audit-valid-untracked" || true
  else
    fail "could not create valid untracked-tags fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-valid-treesitter-tags
  if nvim_trust_fixture_init "$nvim_fixture" nvim-treesitter; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_accept \
      "nvim-treesitter generated tags are accepted" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" nvim-treesitter "$nvim_fixture_lock" \
      "$check_tmp/audit-valid-treesitter-tags" || true
  else
    fail "could not create nvim-treesitter tags fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-valid-tokyonight-tags
  if nvim_trust_fixture_init "$nvim_fixture" tokyonight.nvim; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_accept \
      "TokyoNight generated tags are accepted" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" tokyonight.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-valid-tokyonight-tags" || true
  else
    fail "could not create TokyoNight tags fixture"
