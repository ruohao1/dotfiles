      changed-version-guard|extra-endif) url_source_diagnostic='unapproved tmux URL source directive' ;;
      missing-endif|nested-guard|third-guarded-binding) url_source_diagnostic='noncanonical tmux URL source block' ;;
      duplicate-block) url_source_diagnostic='tmux URL source block count mismatch' ;;
      URL-binding-outside-guard) url_source_diagnostic='tmux URL binding outside exact source guard' ;;
      brace-wrapped-block|continued-line-block) url_source_diagnostic='tmux URL source block is not top-level' ;;
    esac
