stage = 'private fixture identity'
identity = None

def private_directory(path, allow_sticky=False):
    info = path.lstat()
    assert stat.S_ISDIR(info.st_mode), 'directory type'
    assert info.st_uid == os.getuid(), 'directory owner'
    accepted_modes = (0o700, 0o1700) if allow_sticky else (0o700,)
    assert stat.S_IMODE(info.st_mode) in accepted_modes, 'directory mode'
    return info.st_dev, info.st_ino

def normalized(path):
    return [line.split('#',1)[0].strip() for line in path.read_text().splitlines()
            if line.split('#',1)[0].strip()]

def ordinary_file(path, executable=False):
    assert path.is_file() and not path.is_symlink(), 'missing or unsafe source file'
    if executable: assert os.access(path, os.X_OK), 'source helper is not executable'

