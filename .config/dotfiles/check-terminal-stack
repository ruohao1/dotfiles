  esac

  if [ ! -d "$nvim_tags_checkout/doc" ] \
    || [ -L "$nvim_tags_checkout/doc" ] \
    || [ ! -f "$nvim_tags_checkout/doc/tags" ] \
    || [ -L "$nvim_tags_checkout/doc/tags" ]; then
    nvim_trust_reject "doc/tags is not a real nonsymlinked file: $nvim_tags_name"
    return 1
  fi

  nvim_tags_tree_entry=$nvim_tags_audit_prefix.locked-tags
  if ! hardened_plugin_git "$nvim_tags_checkout" \
    ls-tree --name-only "$nvim_tags_lock" -- doc/tags \
    > "$nvim_tags_tree_entry" 2>&1 \
    || [ -s "$nvim_tags_tree_entry" ]; then
    nvim_trust_reject "locked tree contains doc/tags: $nvim_tags_name"
    return 1
  fi

  # shellcheck disable=SC2086  # The values are fixed reviewed Git paths.
  for nvim_tags_source in $nvim_tags_sources; do
    nvim_tags_source_entry=$nvim_tags_audit_prefix.source-entry
    if ! hardened_plugin_git "$nvim_tags_checkout" \
      ls-tree "$nvim_tags_lock" -- "$nvim_tags_source" \
      > "$nvim_tags_source_entry" 2>&1 \
      || ! LC_ALL=C awk -v expected="$nvim_tags_source" '
        NF == 4 \
          && ($1 == "100644" || $1 == "100755") \
          && $2 == "blob" \
          && $3 ~ /^[0-9a-f]{40}$/ \
          && $4 == expected { valid++ }
        END { exit NR != 1 || valid != 1 }
      ' "$nvim_tags_source_entry"; then
      nvim_trust_reject "locked help source is not a regular blob: $nvim_tags_source"
      return 1
    fi
  done

  nvim_tags_generated_dir=$nvim_tags_audit_prefix-generated-doc
  case "$nvim_tags_generated_dir" in
    "$check_tmp"/*) ;;
    *)
      nvim_trust_reject "generated help directory escaped checker temp"
      return 1
      ;;
  esac
  if [ -e "$nvim_tags_generated_dir" ] \
    || ! mkdir -p "$nvim_tags_generated_dir"; then
    nvim_trust_reject "could not create unique generated help directory: $nvim_tags_name"
    return 1
  fi

  # shellcheck disable=SC2086  # The values are fixed reviewed Git paths.
  for nvim_tags_source in $nvim_tags_sources; do
    nvim_tags_basename=${nvim_tags_source##*/}
    if ! hardened_plugin_git "$nvim_tags_checkout" \
      show "${nvim_tags_lock}:$nvim_tags_source" \
      > "$nvim_tags_generated_dir/$nvim_tags_basename"; then
      nvim_trust_reject "could not extract locked help source: $nvim_tags_source"
      return 1
    fi
  done

  nvim_tags_nvim_output=$nvim_tags_audit_prefix.helptags
  if ! env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
    XDG_CONFIG_HOME="$config_root" \
    XDG_DATA_HOME="$check_tmp/nvim-trust-data" \
    XDG_STATE_HOME="$XDG_STATE_HOME" \
    XDG_CACHE_HOME="$XDG_CACHE_HOME" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    DOTFILES_PLUGIN_DOC="$nvim_tags_generated_dir" \
    nvim --clean --headless -i NONE \
    -c 'lua local ok, err = pcall(vim.cmd.helptags, { vim.env.DOTFILES_PLUGIN_DOC, magic = { file = false, bar = false } }); if not ok then vim.api.nvim_err_writeln(tostring(err)); vim.cmd("cquit 1") end' \
    -c qa > "$nvim_tags_nvim_output" 2>&1 \
    || nvim_log_has_error "$nvim_tags_nvim_output" \
    || [ ! -f "$nvim_tags_generated_dir/tags" ] \
    || [ -L "$nvim_tags_generated_dir/tags" ] \
    || ! cmp -s "$nvim_tags_generated_dir/tags" \
      "$nvim_tags_checkout/doc/tags"; then
    nvim_trust_reject "doc/tags does not match locked help sources: $nvim_tags_name"
    return 1
  fi

  return 0
}

nvim_plugin_source_is_exact() {
  [ "$#" -eq 4 ] || return 2
  nvim_source_checkout=$1
  nvim_source_name=$2
  nvim_source_lock=$3
  nvim_source_audit_prefix=$4

  nvim_source_filter_output=$nvim_source_audit_prefix.filters
  nvim_source_filter_error=$nvim_source_audit_prefix.filters.err
  hardened_plugin_git "$nvim_source_checkout" \
    config --includes --show-origin \
    --get-regexp '^filter\..*\.(clean|process)$' \
    > "$nvim_source_filter_output" 2> "$nvim_source_filter_error"
  nvim_source_filter_status=$?
  case "$nvim_source_filter_status" in
    1)
      ;;
    0)
      nvim_trust_reject "effective clean or process filter configured: $nvim_source_name"
      return 1
      ;;
    *)
      nvim_trust_reject "effective filter inspection failed: $nvim_source_name"
      return 1
      ;;
  esac

  nvim_source_index_output=$nvim_source_audit_prefix.index
  if ! hardened_plugin_git "$nvim_source_checkout" ls-files -v \
    > "$nvim_source_index_output" 2>&1; then
    nvim_trust_reject "could not inspect index flags: $nvim_source_name"
    return 1
  fi
  if LC_ALL=C grep -Eq '^[a-z]|^S ' "$nvim_source_index_output"; then
    nvim_trust_reject "assume-unchanged or skip-worktree index flag found: $nvim_source_name"
    return 1
  fi

  if ! nvim_plugin_locked_tree_is_exact \
    "$nvim_source_checkout" "$nvim_source_name" \
    "$nvim_source_lock" "$nvim_source_audit_prefix"; then
    return 1
  fi

  nvim_source_status_output=$nvim_source_audit_prefix.status
  nvim_source_status_error=$nvim_source_audit_prefix.status.err
  if ! hardened_plugin_git "$nvim_source_checkout" \
    status --porcelain=v1 --untracked-files=all --ignored=matching \
    > "$nvim_source_status_output" 2> "$nvim_source_status_error"; then
    nvim_trust_reject "could not inspect complete worktree status: $nvim_source_name"
    return 1
  fi
  if [ ! -s "$nvim_source_status_output" ]; then
    return 0
  fi

  case "$nvim_source_name" in
    lazy.nvim|fzf-lua|jupytext.nvim|oil.nvim|otter.nvim|nvim-treesitter|tokyonight.nvim|which-key.nvim)
      nvim_source_expected_status='!! doc/tags'
      ;;
    mini.icons|mini.pairs|mini.starter|mini.surround)
      nvim_source_expected_status='?? doc/tags'
      ;;
    *)
      nvim_trust_reject "plugin does not permit optional generated tags: $nvim_source_name"
      return 1
      ;;
  esac
  nvim_source_expected_file=$nvim_source_audit_prefix.status.expected
  printf '%s\n' "$nvim_source_expected_status" > "$nvim_source_expected_file"
  if ! cmp -s "$nvim_source_expected_file" "$nvim_source_status_output"; then
    nvim_trust_reject "complete worktree status is outside the allowlist: $nvim_source_name"
    return 1
  fi

  nvim_plugin_generated_tags_are_exact \
    "$nvim_source_checkout" "$nvim_source_name" \
    "$nvim_source_lock" "$nvim_source_audit_prefix"
}

# shellcheck disable=SC2329  # Invoked indirectly by the trust-case harness.
nvim_plugin_checkout_is_trusted() {
  [ "$#" -eq 4 ] || return 2

  nvim_plugin_checkout_path_is_exact "$1" \
    && nvim_plugin_revision_is_exact "$1" "$3" \
    && nvim_plugin_source_is_exact "$1" "$2" "$3" "$4"
}

require_clean_git_worktree() {
  [ "$#" -eq 4 ] || return 2
  worktree_path=$1
  worktree_name=$2
  worktree_lock=$3
  worktree_audit_prefix=$4

  if nvim_plugin_source_is_exact \
    "$worktree_path" "$worktree_name" "$worktree_lock" \
    "$worktree_audit_prefix"; then
    pass "$worktree_name source state matches its pinned objects"
    return 0
  fi

  for worktree_audit_file in \
    "$worktree_audit_prefix.filters" \
    "$worktree_audit_prefix.filters.err" \
    "$worktree_audit_prefix.index" \
    "$worktree_audit_prefix.status" \
    "$worktree_audit_prefix.status.err" \
    "$worktree_audit_prefix.locked-tree" \
    "$worktree_audit_prefix.helptags"
  do
    [ ! -s "$worktree_audit_file" ] \
      || sed 's/^/      /' "$worktree_audit_file" >&2
  done
  fail "$worktree_name source state is outside the exact trust policy"
  return 1
}

