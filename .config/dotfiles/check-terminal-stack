capture_tmux_global_environment() {
  [ "$#" -eq 3 ] || return 2
  environment_socket=$1
  environment_name=$2
  environment_result=$3

  control_socket_path_is_owned "$environment_socket" || return 2
  control_result_path_is_owned "$environment_result" || return 2
  case "$environment_name" in
    PATH|DOTFILES_REAL_GIT|DOTFILES_GIT_CALL_DIR|DOTFILES_HOSTILE_BRANCH) ;;
    *) return 2 ;;
  esac

  environment_visible="$environment_result.visible"
  environment_hidden="$environment_result.hidden"
  environment_visible_error="$environment_result.visible-error"
  environment_hidden_error="$environment_result.hidden-error"
  for environment_path in \
    "$environment_visible" \
    "$environment_hidden" \
    "$environment_visible_error" \
    "$environment_hidden_error"
  do
    control_result_path_is_owned "$environment_path" || return 2
  done
  rm -f \
    "$environment_result" "$environment_visible" "$environment_hidden" \
    "$environment_visible_error" "$environment_hidden_error"

  tmux -S "$environment_socket" show-environment -g "$environment_name" \
    > "$environment_visible" 2> "$environment_visible_error"
  environment_visible_status=$?
  tmux -S "$environment_socket" show-environment -gh "$environment_name" \
    > "$environment_hidden" 2> "$environment_hidden_error"
  environment_hidden_status=$?

  if [ "$environment_visible_status" -ne 0 ] \
    && [ "$environment_hidden_status" -ne 0 ]; then
    if [ ! -s "$environment_visible" ] \
      && [ ! -s "$environment_hidden" ] \
      && grep -Fqx "unknown variable: $environment_name" \
        "$environment_visible_error" \
      && grep -Fqx "unknown variable: $environment_name" \
        "$environment_hidden_error"; then
      printf '%s\n' absent > "$environment_result"
      return 0
    fi
    return 1
  fi

  if [ "$environment_visible_status" -ne 0 ] \
    || [ "$environment_hidden_status" -ne 0 ] \
    || [ -s "$environment_visible_error" ] \
    || [ -s "$environment_hidden_error" ]; then
    return 1
  fi

  if [ -s "$environment_visible" ] && [ ! -s "$environment_hidden" ]; then
    environment_raw_file=$environment_visible
    environment_visibility=visible
  elif [ ! -s "$environment_visible" ] && [ -s "$environment_hidden" ]; then
    environment_raw_file=$environment_hidden
    environment_visibility=hidden
  else
    return 1
  fi

  if ! LC_ALL=C awk -v name="$environment_name" '
    NR == 1 && ($0 == "-" name || index($0, name "=") == 1) {
      valid = 1
    }
    END { exit NR != 1 || !valid }
  ' "$environment_raw_file"; then
    return 1
  fi
  environment_raw=$(sed -n '1p' "$environment_raw_file")
  case "$environment_raw" in
    -"$environment_name")
      printf '%s-removed\n' "$environment_visibility" \
        > "$environment_result"
      ;;
    "$environment_name"=*)
      environment_value=${environment_raw#"$environment_name"=}
      printf '%s-value\n%s\n' \
        "$environment_visibility" "$environment_value" \
        > "$environment_result"
      ;;
    *)
      return 1
      ;;
  esac
}

restore_tmux_global_environment() {
  [ "$#" -eq 3 ] || return 2
  environment_socket=$1
  environment_name=$2
  environment_snapshot=$3

  control_socket_path_is_owned "$environment_socket" || return 2
  control_result_path_is_owned "$environment_snapshot" || return 2
  case "$environment_name" in
    PATH|DOTFILES_REAL_GIT|DOTFILES_GIT_CALL_DIR|DOTFILES_HOSTILE_BRANCH) ;;
    *) return 2 ;;
  esac
  [ -f "$environment_snapshot" ] && [ ! -L "$environment_snapshot" ] \
    || return 1

  environment_state=$(sed -n '1p' "$environment_snapshot")
  case "$environment_state" in
    absent|visible-removed|hidden-removed)
      [ "$(LC_ALL=C awk 'END { print NR + 0 }' \
        "$environment_snapshot")" -eq 1 ] || return 1
      ;;
    visible-value|hidden-value)
      [ "$(LC_ALL=C awk 'END { print NR + 0 }' \
        "$environment_snapshot")" -eq 2 ] || return 1
      environment_value=$(sed -n '2p' "$environment_snapshot")
      ;;
    *)
      return 1
      ;;
  esac

  case "$environment_state" in
    absent)
      tmux -S "$environment_socket" set-environment \
        -gu "$environment_name"
      ;;
    visible-value)
      tmux -S "$environment_socket" set-environment \
        -g "$environment_name" "$environment_value"
      ;;
    hidden-value)
      tmux -S "$environment_socket" set-environment \
        -gh "$environment_name" "$environment_value"
      ;;
    visible-removed)
      tmux -S "$environment_socket" set-environment \
        -g "$environment_name" "" \
        && tmux -S "$environment_socket" set-environment \
          -gr "$environment_name"
      ;;
    hidden-removed)
      tmux -S "$environment_socket" set-environment \
        -gh "$environment_name" "" \
        && tmux -S "$environment_socket" set-environment \
          -gr "$environment_name"
      ;;
  esac
}

status_call_count() {
  [ "$#" -eq 1 ] || return 2
  status_call_directory=$1
  [ "$status_call_directory" = "$hostile_calls" ] || return 2
  case "$status_call_directory" in
    "$check_tmp"/hostile-git-calls) ;;
    *) return 2 ;;
  esac
  [ -d "$status_call_directory" ] \
    && [ ! -L "$status_call_directory" ] || return 1

  call_count=0
  for call_path in "$status_call_directory"/call-*; do
    [ -d "$call_path" ] && [ ! -L "$call_path" ] || continue
    call_ready_path="$call_path/ready"
    [ -f "$call_ready_path" ] \
      && [ ! -L "$call_ready_path" ] \
      && [ ! -s "$call_ready_path" ] || continue
    call_count=$((call_count + 1))
  done
  printf '%s\n' "$call_count"
}

status_running_count() {
