tmux_status_source_replace_all() {
  tmux_status_replace_source=$1
  tmux_status_replace_from=$2
  tmux_status_replace_to=$3
  tmux_status_replace_destination=$4

  [ -n "$tmux_status_replace_from" ] || return 2
  LC_ALL=C awk -v from="$tmux_status_replace_from" -v to="$tmux_status_replace_to" '
    {
      remaining = $0
      result = ""
      while ((position = index(remaining, from)) != 0) {
        result = result substr(remaining, 1, position - 1) to
        remaining = substr(remaining, position + length(from))
        changed = 1
      }
      print result remaining
    }
    END { exit !changed }
  ' "$tmux_status_replace_source" > "$tmux_status_replace_destination"
}

