    'child_net=os.readlink("/proc/self/ns/net")' \
    'default_route=False' \
    'with open("/proc/net/route",encoding="ascii") as handle:' \
    '    next(handle,None)' \
    '    default_route=any(line.split()[1] == "00000000" for line in handle if len(line.split()) > 1)' \
    'connection_failed=False' \
    'probe_socket=socket.socket()' \
    'probe_socket.settimeout(0.25)' \
    'try:' \
    '    probe_socket.connect(("1.1.1.1",53))' \
    'except OSError:' \
    '    connection_failed=True' \
    'finally:' \
    '    probe_socket.close()' \
    'forbidden={"VIRTUAL_ENV","CONDA_PREFIX","CONDA_DEFAULT_ENV","PYTHONPATH","PYTHONHOME","UV_PROJECT_ENVIRONMENT","POETRY_ACTIVE","PIP_CONFIG_FILE","AWS_ACCESS_KEY_ID","AWS_SECRET_ACCESS_KEY","AWS_SESSION_TOKEN","GOOGLE_APPLICATION_CREDENTIALS","AZURE_CLIENT_ID","AZURE_CLIENT_SECRET","HTTP_PROXY","HTTPS_PROXY","ALL_PROXY","NO_PROXY","http_proxy","https_proxy","all_proxy","no_proxy","DUCKDB_EXTENSION_REPOSITORY"}' \
    'record={"source_write_blocked":blocked_write(args.source),"sibling_write_blocked":blocked_create(args.probe_sibling),"home_write_blocked":blocked_create(args.probe_home),"host_tmp_write_blocked":blocked_create(args.probe_host_tmp),"workspace_write_succeeded":os.path.isfile(marker),"network_namespace_changed":child_net != args.parent_net_ns,"default_route_absent":not default_route,"network_connection_failed":connection_failed,"environment_isolated":not (forbidden & set(os.environ)) and os.environ.get("HOME") == "/nonexistent"}' \
    'print(json.dumps(record,sort_keys=True,separators=(",",":")))' \
    > "$data_query_sandbox_probe"

  # shellcheck disable=SC2016  # Preserve Python source literally.
  printf '%s\n' \
    'import json,subprocess,sys' \
    'argv=json.load(open(sys.argv[1],encoding="utf-8"))' \
    'insert_at=argv.index("--chdir")' \
    'argv[insert_at:insert_at]=["--ro-bind",sys.argv[2],"/tmp/dotfiles-data-query-probe.py"]' \
    'runner_at=argv.index(sys.argv[3])' \
    'argv[runner_at]="/tmp/dotfiles-data-query-probe.py"' \
    'argv.extend(["--probe-sibling",sys.argv[4],"--probe-home",sys.argv[5],"--probe-host-tmp",sys.argv[6],"--parent-net-ns",sys.argv[7]])' \
    'poisoned={"PATH":"/usr/bin:/bin","VIRTUAL_ENV":"/poison/venv","CONDA_PREFIX":"/poison/conda","PYTHONPATH":"/poison/python","UV_PROJECT_ENVIRONMENT":"/poison/uv","POETRY_ACTIVE":"1","HTTP_PROXY":"http://poison.invalid","AWS_ACCESS_KEY_ID":"poison","GOOGLE_APPLICATION_CREDENTIALS":"/poison/google.json","AZURE_CLIENT_SECRET":"poison","DUCKDB_EXTENSION_REPOSITORY":"https://poison.invalid"}' \
    'result=subprocess.run(argv,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,env=poisoned,check=False)' \
    'sys.stdout.write(result.stdout)' \
    'sys.stderr.write(result.stderr)' \
    'raise SystemExit(result.returncode)' \
    > "$data_query_sandbox_launcher"
  chmod 600 "$data_query_sandbox_probe" "$data_query_sandbox_launcher"

  data_query_sandbox_source_before=$(parquet_file_fingerprint \
    "$data_query_sandbox_source" 2>/dev/null || true)
  [ -n "$data_query_sandbox_source_before" ] || return 1
  : > "$data_query_sandbox_log"

  if ! env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
    HOME="$data_query_sandbox_home" \
    XDG_CONFIG_HOME="$data_query_sandbox_root/config" \
    XDG_DATA_HOME="$data_home" \
    XDG_STATE_HOME="$data_query_sandbox_root/state" \
    XDG_CACHE_HOME="$data_query_sandbox_root/cache" \
    XDG_RUNTIME_DIR="$data_query_sandbox_root/runtime" \
    NVIM_LOG_FILE="$data_query_sandbox_log" \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_OFFLINE=1 \
    DOTFILES_NVIM_ROOT="$nvim_root" \
    DOTFILES_DATA_QUERY_SANDBOX_ARGV="$data_query_sandbox_argv" \
    DOTFILES_DATA_QUERY_SANDBOX_SOURCE="$data_query_sandbox_source" \
    DOTFILES_DATA_QUERY_SANDBOX_WORKSPACE="$data_query_sandbox_workspace" \
    DOTFILES_DATA_QUERY_SANDBOX_RESULT="$data_query_sandbox_result" \
    nvim --clean --headless -u NONE -i NONE \
    -c 'lua vim.opt.runtimepath:prepend(vim.env.DOTFILES_NVIM_ROOT)' \
    -c 'lua local argv, virtual, failure = require("data_query.tool").command({ source = vim.env.DOTFILES_DATA_QUERY_SANDBOX_SOURCE, visible_name = "sandbox.csv", workspace = vim.env.DOTFILES_DATA_QUERY_SANDBOX_WORKSPACE, result = vim.env.DOTFILES_DATA_QUERY_SANDBOX_RESULT }); assert(argv, failure); assert(virtual == "/tmp/dotfiles-data-query-source/sandbox.csv"); assert(vim.fn.writefile({ vim.json.encode(argv) }, vim.env.DOTFILES_DATA_QUERY_SANDBOX_ARGV) == 0)' \
    -c qa >> "$data_query_sandbox_error" 2>&1 \
    || nvim_log_has_error "$data_query_sandbox_error" \
    || [ -s "$data_query_sandbox_error" ] \
    || [ -s "$data_query_sandbox_log" ]; then
    return 1
  fi

  data_query_sandbox_status=0
  PYTHONDONTWRITEBYTECODE=1 \
    "$data_query_timeout" --kill-after=5s 45s \
    "$data_query_tool_python" -I -B \
      "$data_query_sandbox_launcher" \
      "$data_query_sandbox_argv" \
      "$data_query_sandbox_probe" \
      "$data_query_tool_runner" \
      "$data_query_sandbox_sibling" \
      "$data_query_sandbox_home_target" \
      "$data_query_sandbox_tmp_target" \
      "$data_query_sandbox_parent_net" \
      > "$data_query_sandbox_output" 2> "$data_query_sandbox_error" \
    || data_query_sandbox_status=$?
  if [ "$data_query_sandbox_status" -ne 0 ]; then
    data_query_reap_owned_processes \
      "$data_query_sandbox_root" "$data_query_sandbox_pids" \
      >> "$data_query_sandbox_error" 2>&1 \
      || true
    data_query_processes_absent \
      "$data_query_sandbox_root" "$data_query_sandbox_processes" \
      || return 1
    return 1
  fi

  if jq -e '
      . == {
        "default_route_absent":true,
        "environment_isolated":true,
        "home_write_blocked":true,
        "host_tmp_write_blocked":true,
        "network_connection_failed":true,
        "network_namespace_changed":true,
        "sibling_write_blocked":true,
        "source_write_blocked":true,
        "workspace_write_succeeded":true
      }
    ' "$data_query_sandbox_output" > /dev/null 2>> "$data_query_sandbox_error" \
    && [ ! -s "$data_query_sandbox_error" ] \
    && [ ! -s "$data_query_sandbox_log" ] \
    && [ -f "$data_query_sandbox_marker" ] \
    && [ ! -e "$data_query_sandbox_result" ] \
    && [ ! -L "$data_query_sandbox_result" ] \
    && PYTHONDONTWRITEBYTECODE=1 "$data_query_tool_python" -I -B -c \
      'import os,sys; assert set(os.listdir(sys.argv[1])) == {"sandbox-marker","spill"}; assert open(os.path.join(sys.argv[1],"sandbox-marker"),"rb").read() == b"workspace-only\n"' \
      "$data_query_sandbox_workspace" \
    && [ "$(parquet_file_fingerprint "$data_query_sandbox_source")" = "$data_query_sandbox_source_before" ] \
    && [ ! -e "$data_query_sandbox_sibling" ] \
    && [ ! -L "$data_query_sandbox_sibling" ] \
    && [ ! -e "$data_query_sandbox_home_target" ] \
    && [ ! -L "$data_query_sandbox_home_target" ] \
    && [ ! -e "$data_query_sandbox_tmp_target" ] \
    && [ ! -L "$data_query_sandbox_tmp_target" ] \
    && data_query_processes_absent \
      "$data_query_sandbox_root" "$data_query_sandbox_processes"; then
    return 0
  fi
  data_query_reap_owned_processes \
    "$data_query_sandbox_root" "$data_query_sandbox_pids" \
    >> "$data_query_sandbox_error" 2>&1 \
    || true
  data_query_processes_absent \
    "$data_query_sandbox_root" "$data_query_sandbox_processes" \
    || return 1
  return 1
}

