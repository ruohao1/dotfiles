control_status_target_for_client() {
  [ "$#" -eq 3 ] || return 2
  control_target_client=$1
  control_target_pane=$2
  control_target_result=$3

  control_pane_id_is_exact "$control_target_pane" || return 2
  control_result_path_is_owned "$control_target_result" || return 2
  control_socket_path_is_owned "$status_control_socket" || return 2
  control_target_raw="$control_target_result.raw"
  control_result_path_is_owned "$control_target_raw" || return 2
  rm -f "$control_target_result" "$control_target_raw"

  case "$control_target_client" in
    "$status_client_a")
      [ -n "$status_client_a" ] || return 2
      control_target_name=status-client-a
      control_target_session=$status_client_a_session
      ;;
    "$status_client_b")
      [ -n "$status_client_b" ] || return 2
      control_target_name=status-client-b
      control_target_session=$status_client_b_session
      ;;
    *)
      return 2
      ;;
  esac
  case "$control_target_session" in
    ""|*[!A-Za-z0-9_-]*) return 2 ;;
  esac
  control_live_client_is_exact "$control_target_name" || return 1

  tmux -S "$status_control_socket" list-panes \
    -s -t "=$control_target_session:" \
    -F '#{window_id}|#{pane_id}' \
    > "$control_target_raw" 2>/dev/null || return 1
  control_target_window=$(LC_ALL=C awk -F '|' \
    -v expected="$control_target_pane" '
      NF != 2 || $1 !~ /^@[0-9]+$/ || $2 !~ /^%[0-9]+$/ {
        invalid = 1
        next
      }
      $2 == expected {
        window = $1
        matches++
      }
      END {
        if (invalid || matches != 1) exit 1
        print window
      }
    ' "$control_target_raw") || return 1
  tmux_window_id_is_exact "$control_target_window" || return 1

  printf '=%s:%s.%s\n' \
    "$control_target_session" "$control_target_window" "$control_target_pane" \
    > "$control_target_result"
}

control_status_capture() {
  [ "$#" -eq 4 ] || return 2
  control_status_client=$1
  control_status_pane=$2
  control_status_width=$3
  control_status_result=$4

  [ "$control_status_capture_active" = false ] || return 2
  case "$control_status_client" in
    "$status_client_a")
      [ -n "$status_client_a" ] || return 2
      control_status_name=status-client-a
      ;;
    "$status_client_b")
      [ -n "$status_client_b" ] || return 2
      control_status_name=status-client-b
      ;;
    *)
      return 2
      ;;
  esac
  control_pane_id_is_exact "$control_status_pane" || return 2
  case "$control_status_width" in
    ""|0|0*|*[!0-9]*) return 2 ;;
  esac
  control_result_path_is_owned "$control_status_result" || return 2
  control_socket_path_is_owned "$status_control_socket" || return 2
  control_live_client_is_exact "$control_status_name" || return 1

  control_status_capture_active=true
  control_status_capture_sequence=$((control_status_capture_sequence + 1))
  control_status_prefix="$check_tmp/control-status-$control_status_name-$control_status_capture_sequence"
  control_status_aggregate="$control_status_prefix.aggregate"
  control_status_direct="$control_status_prefix.direct"
  control_status_field="$control_status_prefix.field"
  control_status_left_field="$control_status_prefix.left"
  control_status_right_field="$control_status_prefix.right"
  control_status_cleanup_file="$control_status_prefix.options"
  control_status_target_file="$control_status_prefix.target"
  control_status_left_option="@dotfiles_check_status_left_$control_status_capture_sequence"
  control_status_right_option="@dotfiles_check_status_right_$control_status_capture_sequence"
  control_status_ok=true
  control_status_target_ready=false
  control_status_cleanup_ok=true

  if ! control_result_path_is_owned "$control_status_aggregate" \
    || ! control_result_path_is_owned "$control_status_direct" \
    || ! control_result_path_is_owned "$control_status_field" \
    || ! control_result_path_is_owned "$control_status_left_field" \
    || ! control_result_path_is_owned "$control_status_right_field" \
    || ! control_result_path_is_owned "$control_status_cleanup_file" \
    || ! control_result_path_is_owned "$control_status_target_file" \
    || ! control_status_pane_option_is_owned "$control_status_left_option" \
    || ! control_status_pane_option_is_owned "$control_status_right_option" \
    || [ "$control_status_left_option" = "$control_status_right_option" ]; then
    control_status_capture_active=false
    return 2
  fi

  rm -f \
    "$control_status_result" "$control_status_aggregate" \
    "$control_status_direct" "$control_status_field" \
    "$control_status_left_field" "$control_status_right_field" \
    "$control_status_cleanup_file" "$control_status_target_file"
  : > "$control_status_aggregate"
  : > "$control_status_direct"

  if control_status_target_for_client \
      "$control_status_client" "$control_status_pane" \
      "$control_status_target_file"; then
    control_status_target=$(sed -n '1p' "$control_status_target_file")
    control_status_target_ready=true
  else
    control_status_ok=false
  fi

  if [ "$control_status_ok" = true ] \
    && ! tmux -S "$status_control_socket" refresh-client \
    -t "$control_status_client" -C "${control_status_width}x24" \
    >/dev/null 2>&1; then
    control_status_ok=false
  fi

  if [ "$control_status_ok" = true ]; then
    control_status_command="display-message -p -t $control_status_target 'left=#{T:status-left}'"
    control_command_capture \
      "$control_status_client" "$control_status_command" \
      "$control_status_left_field" \
      && control_append_capture \
        left "$control_status_left_field" "$control_status_direct" \
      || control_status_ok=false
  fi
  if [ "$control_status_ok" = true ]; then
    control_status_command="display-message -p -t $control_status_target 'right=#{T:status-right}'"
    control_command_capture \
      "$control_status_client" "$control_status_command" \
      "$control_status_right_field" \
      && control_append_capture \
        right "$control_status_right_field" "$control_status_direct" \
      || control_status_ok=false
  fi

  if [ "$control_status_ok" = true ]; then
    control_status_left_value=$(capture_field "$control_status_direct" left) \
      || control_status_ok=false
  fi
  if [ "$control_status_ok" = true ]; then
    control_status_right_value=$(capture_field "$control_status_direct" right) \
      || control_status_ok=false
  fi
  if [ "$control_status_ok" = true ] \
    && { ! tmux -S "$status_control_socket" set-option -p \
        -t "$control_status_target" "$control_status_left_option" \
        "$control_status_left_value" >/dev/null 2>&1 \
      || ! control_status_left_staged=$(tmux -S "$status_control_socket" \
        show-options -pv -t "$control_status_target" \
        "$control_status_left_option" 2>/dev/null) \
      || [ "$control_status_left_staged" != "$control_status_left_value" ]; }; then
    control_status_ok=false
  fi
  if [ "$control_status_ok" = true ] \
    && { ! tmux -S "$status_control_socket" set-option -p \
        -t "$control_status_target" "$control_status_right_option" \
        "$control_status_right_value" >/dev/null 2>&1 \
      || ! control_status_right_staged=$(tmux -S "$status_control_socket" \
        show-options -pv -t "$control_status_target" \
        "$control_status_right_option" 2>/dev/null) \
      || [ "$control_status_right_staged" != "$control_status_right_value" ]; }; then
    control_status_ok=false
  fi

  if [ "$control_status_ok" = true ]; then
    control_status_command="display-message -p -t $control_status_target 'left-width=#{w:#{${control_status_left_option}}}'"
    control_status_one_field \
      "$control_status_client" "$control_status_command" left-width \
      "$control_status_field" "$control_status_aggregate" \
      || control_status_ok=false
  fi
  if [ "$control_status_ok" = true ]; then
    control_status_command="display-message -p -t $control_status_target 'right-width=#{w:#{${control_status_right_option}}}'"
    control_status_one_field \
      "$control_status_client" "$control_status_command" right-width \
      "$control_status_field" "$control_status_aggregate" \
      || control_status_ok=false
  fi

  if [ "$control_status_target_ready" = true ]; then
    tmux -S "$status_control_socket" set-option -pqu \
      -t "$control_status_target" "$control_status_left_option" \
      >/dev/null 2>&1 || control_status_cleanup_ok=false
    tmux -S "$status_control_socket" set-option -pqu \
      -t "$control_status_target" "$control_status_right_option" \
      >/dev/null 2>&1 || control_status_cleanup_ok=false
    if ! tmux -S "$status_control_socket" show-options -p \
        -t "$control_status_target" > "$control_status_cleanup_file" 2>/dev/null \
      || ! LC_ALL=C awk \
        -v left="$control_status_left_option" \
        -v right="$control_status_right_option" '
          $1 == left || $1 == right { found = 1 }
          END { exit found }
        ' "$control_status_cleanup_file"; then
      control_status_cleanup_ok=false
    fi
  fi
  [ "$control_status_cleanup_ok" = true ] || control_status_ok=false

  if [ "$control_status_ok" = true ]; then
    control_append_capture \
      left "$control_status_left_field" "$control_status_aggregate" \
      || control_status_ok=false
  fi
  if [ "$control_status_ok" = true ]; then
    control_append_capture \
      right "$control_status_right_field" "$control_status_aggregate" \
      || control_status_ok=false
  fi
  if [ "$control_status_ok" = true ]; then
    control_status_command="display-message -p -t $control_status_target 'windows=#{W:#{T:window-status-format},#{T:window-status-current-format}}'"
    control_status_one_field \
      "$control_status_client" "$control_status_command" windows \
      "$control_status_field" "$control_status_aggregate" \
      || control_status_ok=false
  fi

  if [ "$control_status_ok" = true ] \
    && control_status_file_is_exact "$control_status_aggregate" \
    && sed -n 'p' "$control_status_aggregate" > "$control_status_result" \
    && control_status_file_is_exact "$control_status_result"; then
    control_status_outcome=0
  else
    control_status_outcome=1
    rm -f "$control_status_result"
  fi
  control_status_capture_active=false
  return "$control_status_outcome"
}

control_status_left_probe() {
  [ "$#" -eq 3 ] || return 2
  control_left_client=$1
  control_left_pane=$2
  control_left_result=$3

  [ "$control_status_capture_active" = false ] || return 2
  control_pane_id_is_exact "$control_left_pane" || return 2
  control_result_path_is_owned "$control_left_result" || return 2

  control_status_capture_active=true
  control_status_capture_sequence=$((control_status_capture_sequence + 1))
  control_left_raw="$check_tmp/control-left-$control_status_capture_sequence.raw"
  control_left_aggregate="$check_tmp/control-left-$control_status_capture_sequence.aggregate"
  control_left_target_file="$check_tmp/control-left-$control_status_capture_sequence.target"
  rm -f \
    "$control_left_result" "$control_left_raw" \
    "$control_left_aggregate" "$control_left_target_file"
  : > "$control_left_aggregate"

  if control_status_target_for_client \
      "$control_left_client" "$control_left_pane" \
      "$control_left_target_file"; then
    control_left_target=$(sed -n '1p' "$control_left_target_file")
  else
    control_left_target=""
  fi
  control_left_command="display-message -p -t $control_left_target 'left=#{T:status-left}'"

  if [ -n "$control_left_target" ] \
    && control_command_capture \
      "$control_left_client" "$control_left_command" "$control_left_raw" \
    && control_append_capture \
      left "$control_left_raw" "$control_left_aggregate" \
    && sed -n 'p' "$control_left_aggregate" > "$control_left_result" \
    && [ "$(awk 'END { print NR + 0 }' "$control_left_result")" -eq 1 ] \
    && grep -Fq 'left=' "$control_left_result"; then
    control_left_outcome=0
  else
    control_left_outcome=1
    rm -f "$control_left_result"
  fi
  control_status_capture_active=false
  return "$control_left_outcome"
}

wait_control_left_contains() {
  [ "$#" -eq 4 ] || return 2
  left_wait_client=$1
  left_wait_pane=$2
  left_wait_expected=$3
  left_wait_output=$4

  [ -n "$left_wait_expected" ] || return 2
  control_pane_id_is_exact "$left_wait_pane" || return 2
  control_result_path_is_owned "$left_wait_output" || return 2

  left_wait_attempt=0
  while [ "$left_wait_attempt" -lt 40 ]; do
    if control_status_left_probe \
        "$left_wait_client" "$left_wait_pane" "$left_wait_output"; then
      left_wait_raw=$(capture_field "$left_wait_output" left) || return 1
      left_wait_visible=$(printf '%s\n' "$left_wait_raw" |
        tmux_format_visible) || return 1
      case "$left_wait_visible" in
        *"$left_wait_expected"*) return 0 ;;
      esac
    fi
    left_wait_attempt=$((left_wait_attempt + 1))
    sleep 0.1
  done
  return 1
}

pane_status_option_name_is_owned() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    @dotfiles_nvim_owner|\
    @dotfiles_nvim_active|\
    @dotfiles_nvim_mode|\
    @dotfiles_nvim_root|\
    @dotfiles_nvim_path|\
    @dotfiles_nvim_modified|\
    @dotfiles_nvim_errors|\
    @dotfiles_nvim_warnings|\
    @dotfiles_nvim_line|\
    @dotfiles_nvim_column)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

pane_status_snapshot() {
  [ "$#" -eq 10 ] || return 2
  snapshot_socket=$1
  snapshot_pane=$2
  snapshot_owner=$3
  snapshot_mode=$4
  snapshot_root=$5
  snapshot_path=$6
  snapshot_errors=$7
  snapshot_warnings=$8
  snapshot_line=$9
  shift 9
  snapshot_column=$1

  control_socket_path_is_owned "$snapshot_socket" || return 2
  control_pane_id_is_exact "$snapshot_pane" || return 2
  printf '%s\n' "$snapshot_owner" |
    LC_ALL=C awk '
      NR == 1 && /^[0-9]+_[0-9]+$/ { valid = 1 }
      END { exit NR != 1 || !valid }
    ' \
    || return 2
  case "$snapshot_mode" in
    NORMAL|INSERT|VISUAL|SELECT|REPLACE|COMMAND|PROMPT|TERMINAL) ;;
    *) return 2 ;;
  esac
  case "$snapshot_root" in
    /*) ;;
    *) return 2 ;;
  esac
  for snapshot_decimal in \
    "$snapshot_errors" "$snapshot_warnings" "$snapshot_line" "$snapshot_column"
  do
    case "$snapshot_decimal" in
      ""|*[!0-9]*) return 2 ;;
    esac
  done

  tmux -S "$snapshot_socket" \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_owner "$snapshot_owner" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_active 0 \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_mode "$snapshot_mode" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_root "$snapshot_root" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_path "$snapshot_path" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_modified 0 \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_errors "$snapshot_errors" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_warnings "$snapshot_warnings" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_line "$snapshot_line" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_column "$snapshot_column" \; \
    set-option -pt "$snapshot_pane" @dotfiles_nvim_active 1
}

clear_pane_status_snapshot() {
  [ "$#" -eq 2 ] || return 2
  clear_socket=$1
  clear_pane=$2

  control_socket_path_is_owned "$clear_socket" || return 2
  control_pane_id_is_exact "$clear_pane" || return 2
  for clear_option in \
    @dotfiles_nvim_active \
    @dotfiles_nvim_mode \
    @dotfiles_nvim_root \
    @dotfiles_nvim_path \
    @dotfiles_nvim_modified \
    @dotfiles_nvim_errors \
    @dotfiles_nvim_warnings \
    @dotfiles_nvim_line \
    @dotfiles_nvim_column \
    @dotfiles_nvim_owner
  do
    tmux -S "$clear_socket" set-option -pu \
      -t "$clear_pane" "$clear_option" || return 1
  done
}

capture_pane_status_options() {
  [ "$#" -eq 3 ] || return 2
  option_socket=$1
  option_pane=$2
  option_output=$3

  control_socket_path_is_owned "$option_socket" || return 2
  control_pane_id_is_exact "$option_pane" || return 2
  control_result_path_is_owned "$option_output" || return 2
  option_raw="$check_tmp/pane-status-options.raw"
  [ "$option_output" != "$option_raw" ] || return 2

  tmux -S "$option_socket" show-options -p -t "$option_pane" \
    > "$option_raw" 2>/dev/null \
    || return 1
  LC_ALL=C awk '
    $1 ~ /^@dotfiles_nvim_(owner|active|mode|root|path|modified|errors|warnings|line|column)$/ {
      print
    }
  ' "$option_raw" > "$option_output"
}

wait_pane_option() {
  [ "$#" -eq 4 ] || return 2
  wait_socket=$1
  wait_pane=$2
  wait_name=$3
  wait_expected=$4

  control_socket_path_is_owned "$wait_socket" || return 2
  control_pane_id_is_exact "$wait_pane" || return 2
  pane_status_option_name_is_owned "$wait_name" || return 2

  wait_attempt=0
  while [ "$wait_attempt" -lt 80 ]; do
    wait_actual=$(tmux -S "$wait_socket" show-options -pqt "$wait_pane" \
      -v "$wait_name" 2>/dev/null || true)
    [ "$wait_actual" = "$wait_expected" ] && return 0
    wait_attempt=$((wait_attempt + 1))
    sleep 0.1
  done
  return 1
}

wait_pane_command() {
  [ "$#" -eq 3 ] || return 2
  wait_socket=$1
  wait_pane=$2
  wait_expected=$3

  control_socket_path_is_owned "$wait_socket" || return 2
  control_pane_id_is_exact "$wait_pane" || return 2
  case "$wait_expected" in
    nvim|sh) ;;
    *) return 2 ;;
  esac

  wait_attempt=0
  while [ "$wait_attempt" -lt 80 ]; do
    wait_actual=$(tmux -S "$wait_socket" display-message -p \
      -t "$wait_pane" '#{b:pane_current_command}' 2>/dev/null || true)
    case "$wait_expected:$wait_actual" in
      nvim:nvim|\
      nvim:nvimdiff|\
      nvim:nvim-wrapped|\
      nvim:nvimdiff-wrapped|\
      sh:sh|\
      sh:bash|\
      sh:zsh|\
      sh:fish|\
      sh:dash|\
      sh:ksh|\
      sh:nu)
        return 0
        ;;
    esac
    wait_attempt=$((wait_attempt + 1))
    sleep 0.1
  done
  return 1
}

wait_pane_status_absent() {
  [ "$#" -eq 2 ] || return 2
  wait_socket=$1
  wait_pane=$2

  wait_attempt=0
  while [ "$wait_attempt" -lt 50 ]; do
    if capture_pane_status_options "$wait_socket" "$wait_pane" \
      "$check_tmp/wait-pane-options.txt" \
      && [ ! -s "$check_tmp/wait-pane-options.txt" ]; then
      return 0
    fi
    wait_attempt=$((wait_attempt + 1))
    sleep 0.1
  done
  return 1
}

checker_nested_file_is_owned() {
  [ "$#" -eq 1 ] || return 2
  case "$1" in
    "$check_tmp"/*)
      checker_nested_relative=${1#"$check_tmp"/}
      case "/$checker_nested_relative/" in
        */../*|*/./*) return 1 ;;
      esac
      [ -f "$1" ] && [ ! -L "$1" ]
      ;;
    *)
      return 1
      ;;
  esac
}

shell_single_quote() {
  [ "$#" -eq 1 ] || return 2
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

start_configured_nvim() {
  [ "$#" -eq 3 ] || return 2
  start_socket=$1
  start_pane=$2
  start_file=$3

  control_socket_path_is_owned "$start_socket" || return 2
  control_pane_id_is_exact "$start_pane" || return 2
  checker_nested_file_is_owned "$start_file" || return 2
  [ -n "$nvim_path" ] && [ -x "$nvim_path" ] || return 1

  start_nvim_quoted=$(shell_single_quote "$nvim_path") || return 1
  start_config_quoted=$(shell_single_quote "$config_root") || return 1
  start_data_quoted=$(shell_single_quote "$data_home") || return 1
  start_state_quoted=$(shell_single_quote "$XDG_STATE_HOME") || return 1
  start_cache_quoted=$(shell_single_quote "$XDG_CACHE_HOME") || return 1
  start_file_quoted=$(shell_single_quote "$start_file") || return 1
  start_lsp_command='lua local names = { "bashls", "jsonls", "lua_ls", "pyright", "taplo", "yamlls" }; assert(vim.bo.filetype ~= "bash" and vim.bo.filetype ~= "sh" and vim.bo.filetype ~= "json" and vim.bo.filetype ~= "jsonc" and vim.bo.filetype ~= "lua" and vim.bo.filetype ~= "python" and vim.bo.filetype ~= "toml" and vim.bo.filetype ~= "yaml" and vim.bo.filetype ~= "yaml.docker-compose" and vim.bo.filetype ~= "yaml.gitlab" and vim.bo.filetype ~= "yaml.helm-values", "checker TUI fixture must start without an LSP-matching buffer"); for _, name in ipairs(names) do assert(vim.lsp.is_enabled(name), name .. " is not enabled before checker TUI fixture"); assert(#vim.lsp.get_clients({ name = name, _uninitialized = true }) == 0, name .. " client spawned before checker TUI fixture"); vim.lsp.enable(name, false); assert(not vim.lsp.is_enabled(name), name .. " remained enabled for checker TUI fixture"); assert(#vim.lsp.get_clients({ name = name, _uninitialized = true }) == 0, name .. " client remained after checker TUI disable") end; vim.cmd.edit(vim.fn.fnameescape(vim.env.DOTFILES_NVIM_START_FILE)); for _, name in ipairs(names) do assert(#vim.lsp.get_clients({ name = name, _uninitialized = true }) == 0, name .. " client spawned after checker TUI fixture opened") end'
  start_lsp_command_quoted=$(shell_single_quote "$start_lsp_command") || return 1
  start_command="env -u NVIM_APPNAME XDG_CONFIG_HOME=$start_config_quoted XDG_DATA_HOME=$start_data_quoted XDG_STATE_HOME=$start_state_quoted XDG_CACHE_HOME=$start_cache_quoted DOTFILES_NVIM_START_FILE=$start_file_quoted TERM=tmux-256color $start_nvim_quoted -i NONE -c $start_lsp_command_quoted"

  tmux -S "$start_socket" send-keys -t "$start_pane" -l "$start_command" \
    && tmux -S "$start_socket" send-keys -t "$start_pane" Enter
}

quit_tui_nvim() {
  [ "$#" -eq 2 ] || return 2
  quit_socket=$1
  quit_pane=$2

  control_socket_path_is_owned "$quit_socket" || return 2
  control_pane_id_is_exact "$quit_pane" || return 2
  tmux -S "$quit_socket" send-keys -t "$quit_pane" Escape \
    && tmux -S "$quit_socket" send-keys -t "$quit_pane" -l ':qa!' \
    && tmux -S "$quit_socket" send-keys -t "$quit_pane" Enter
}

require_decimal_pane_option() {
  [ "$#" -eq 4 ] || return 2
  decimal_socket=$1
  decimal_pane=$2
  decimal_name=$3
  decimal_label=$4

  control_socket_path_is_owned "$decimal_socket" || return 2
  control_pane_id_is_exact "$decimal_pane" || return 2
  pane_status_option_name_is_owned "$decimal_name" || return 2
  decimal_value=$(tmux -S "$decimal_socket" show-options -pqt "$decimal_pane" \
    -v "$decimal_name" 2>/dev/null || true)
  case "$decimal_value" in
    ""|*[!0-9]*) fail "$decimal_label"; return 1 ;;
    *) pass "$decimal_label"; return 0 ;;
  esac
}

capture_status_contract() {
  [ "$#" -eq 3 ] || return 2
  contract_socket=$1
  contract_pane=$2
  contract_output=$3

  control_socket_path_is_owned "$contract_socket" || return 2
  control_pane_id_is_exact "$contract_pane" || return 2
  control_result_path_is_owned "$contract_output" || return 2
  : > "$contract_output"
  for contract_name in \
    status-left \
    status-left-length \
    status-right \
    status-right-length \
    window-status-format \
    window-status-current-format
  do
    contract_value=$(tmux -S "$contract_socket" show-options -gv \
      -t "$contract_pane" "$contract_name") || return 1
    printf '%s=%s\n' "$contract_name" "$contract_value" \
      >> "$contract_output"
  done
}

control_client_location_is_exact() {
  [ "$#" -eq 6 ] || return 2
  location_socket=$1
  location_client=$2
  location_session=$3
  location_window=$4
  location_pane=$5
  location_output=$6

  control_socket_path_is_owned "$location_socket" || return 2
  control_pane_id_is_exact "$location_pane" || return 2
  control_result_path_is_owned "$location_output" || return 2
  [ -n "$location_session" ] && [ -n "$location_window" ] || return 2
  case "$location_session:$location_window" in
    *[!A-Za-z0-9_.:+-]*) return 2 ;;
  esac
  case "$location_client" in
    "$status_client_a"|"$status_client_b") [ -n "$location_client" ] || return 2 ;;
    *) return 2 ;;
  esac

  control_command_capture "$location_client" \
    "display-message -p 'location=#{session_name}:#{window_name}:#{pane_id}'" \
    "$location_output" \
    && grep -Fqx \
      "location=$location_session:$location_window:$location_pane" \
      "$location_output"
}

select_control_client_location() {
  [ "$#" -eq 6 ] || return 2
  select_socket=$1
  select_client=$2
  select_session=$3
  select_window=$4
  select_pane=$5
  select_output=$6

  control_socket_path_is_owned "$select_socket" || return 2
  control_pane_id_is_exact "$select_pane" || return 2
  control_result_path_is_owned "$select_output" || return 2
  [ -n "$select_session" ] && [ -n "$select_window" ] || return 2
  case "$select_session:$select_window" in
    *[!A-Za-z0-9_.:+-]*) return 2 ;;
  esac
  case "$select_client" in
    "$status_client_a"|"$status_client_b") [ -n "$select_client" ] || return 2 ;;
    *) return 2 ;;
  esac
  tmux -S "$select_socket" switch-client \
    -c "$select_client" -t "=$select_session:$select_window" \
    && tmux -S "$select_socket" select-pane -t "$select_pane" \
    && control_client_location_is_exact \
      "$select_socket" "$select_client" "$select_session" \
      "$select_window" "$select_pane" "$select_output"
}

# shellcheck disable=SC2329  # Invoked by trap.
cleanup() {
  stop_control_clients

  control_probe_remove_ready=true
  if [ "$control_probe_socket_owned" = true ]; then
    if [ -z "$control_probe_socket" ] \
      || ! command -v tmux >/dev/null 2>&1; then
      control_probe_remove_ready=false
    elif tmux -S "$control_probe_socket" kill-server >/dev/null 2>&1; then
        control_probe_socket_owned=false
    else
      control_probe_remove_ready=false
    fi
  fi

  if [ "$control_probe_remove_ready" = true ]; then
    case "$control_probe_socket" in
      "$check_tmp"/tmux-control-probe.sock)
        rm -f "$control_probe_socket"
        ;;
      "")
        ;;
      *)
        printf 'WARN  refused to remove unexpected control-probe socket: %s\n' \
          "$control_probe_socket" >&2
        ;;
    esac
  fi

  if [ "$tmux_move_socket_owned" = true ] && [ -n "$tmux_move_socket" ] && command -v tmux >/dev/null 2>&1; then
    tmux -S "$tmux_move_socket" kill-server >/dev/null 2>&1 || true
  fi

  if [ "$tmux_socket_owned" = true ] && [ -n "$check_socket" ] && command -v tmux >/dev/null 2>&1; then
    tmux -S "$check_socket" kill-server >/dev/null 2>&1 || true
  fi

  if [ -n "$tmux_move_socket" ]; then
    case "$tmux_move_socket" in
      "$check_tmp"/tmux-move.sock)
        rm -f "$tmux_move_socket"
        ;;
      *)
        printf 'WARN  refused to remove unexpected tmux move socket path: %s\n' "$tmux_move_socket" >&2
        ;;
    esac
  fi

  if [ -n "$check_socket" ]; then
    case "$check_socket" in
      "$check_tmp"/tmux.sock)
        rm -f "$check_socket"
        ;;
      *)
        printf 'WARN  refused to remove unexpected tmux socket path: %s\n' "$check_socket" >&2
        ;;
    esac
  fi

  if [ -n "$nvim_bashls_parent" ] && [ -d "$nvim_bashls_parent" ]; then
    case "$nvim_bashls_parent" in
      /var/tmp/terminal-stack-bashls.*)
        rm -rf "$nvim_bashls_parent"
        ;;
      *)
        warn "refused to remove unexpected BashLS temporary path: $nvim_bashls_parent"
        ;;
    esac
  fi

  if [ -n "$check_tmp" ] && [ -d "$check_tmp" ]; then
    case "$check_tmp" in
      "${TMPDIR:-/tmp}"/terminal-stack-check.*)
        rm -rf "$check_tmp"
        ;;
      *)
        warn "refused to remove unexpected temporary path: $check_tmp"
        ;;
    esac
  fi
}

