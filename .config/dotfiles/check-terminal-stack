    'def blocked_write(path):' \
    '    try:' \
    '        with open(path,"r+b") as handle: handle.write(b"blocked-write")' \
    '    except OSError:' \
    '        return True' \
    '    return False' \
    'def blocked_create(path):' \
    '    descriptor=None' \
    '    try:' \
    '        descriptor=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)' \
    '        os.write(descriptor,b"forbidden-create")' \
    '    except OSError:' \
    '        return True' \
    '    finally:' \
    '        if descriptor is not None: os.close(descriptor)' \
    '    return False' \
    'marker=os.path.join(args.workspace,"sandbox-marker")' \
