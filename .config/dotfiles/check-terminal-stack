data_query_recorded_processes_absent() {
  [ "$#" -eq 2 ] || return 2
  [ "$platform" = "linux" ] || return 2
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  case "$2" in
    0|1) ;;
    *) return 2 ;;
  esac
  PYTHONDONTWRITEBYTECODE=1 "$data_query_tool_python" -I -B -c \
    'import pathlib,re,sys; records=pathlib.Path(sys.argv[1]).read_text(encoding="ascii").splitlines(); assert records or sys.argv[2] == "0"; assert all(re.fullmatch(r"[1-9][0-9]*:[1-9][0-9]*",record) for record in records); assert len(records) == len(set(records)); active=[]
for record in records:
 pid_text,ticks_text=record.split(":",1); path=pathlib.Path("/proc")/pid_text/"stat"
 try: value=path.read_text(encoding="ascii")
 except (FileNotFoundError,ProcessLookupError): continue
 except PermissionError as error: raise AssertionError(f"permission denied reading {path}") from error
 close=value.rfind(")"); assert close > 1, (record,value); assert value[:value.find(" ")] == pid_text, (record,value); fields=value[close+1:].split(); assert len(fields) >= 20 and fields[19].isdigit() and int(fields[19]) > 0, (record,value)
 if fields[19] == ticks_text: active.append(record)
assert not active, active' \
    "$1" "$2"
}

data_query_reap_owned_processes() {
  [ "$#" -eq 2 ] || return 2
  [ "$platform" = "linux" ] || return 2
  data_query_reap_root=$1
  data_query_reap_records=$2
  case "$data_query_reap_root" in
    "$check_tmp"/nvim-data-query-*) ;;
    *) return 2 ;;
  esac
  [ -f "$data_query_reap_records" ] \
    && [ ! -L "$data_query_reap_records" ] \
    || return 1
  PYTHONDONTWRITEBYTECODE=1 "$data_query_tool_python" -I -B -c \
    'import os,pathlib,re,signal,sys,time
root=sys.argv[1].encode(); record_path=pathlib.Path(sys.argv[2]); lines=record_path.read_text(encoding="ascii").splitlines(); assert all(re.fullmatch(r"[1-9][0-9]*:[1-9][0-9]*",line) for line in lines); recorded={int(line.split(":",1)[0]):int(line.split(":",1)[1]) for line in lines}; assert len(recorded) == len(lines)
def identity(pid,strict=False):
 path=pathlib.Path("/proc")/str(pid)/"stat"
 try: value=path.read_text(encoding="ascii")
 except (FileNotFoundError,ProcessLookupError): return None
 except PermissionError:
  if strict: raise
  return None
 close=value.rfind(")")
 if close <= 1:
  if strict: raise AssertionError(f"malformed {path}")
  return None
 fields=value[close+1:].split()
 if len(fields) < 20 or not fields[19].isdigit():
  if strict: raise AssertionError(f"malformed {path}")
  return None
 return int(fields[19])
def owned():
 matches={}
 for entry in pathlib.Path("/proc").iterdir():
  if not entry.name.isdigit(): continue
  pid=int(entry.name)
  if pid in (os.getpid(),os.getppid()): continue
  expected=recorded.get(pid); ticks=identity(pid,expected is not None)
  if ticks is None: continue
  exact=expected == ticks
  try: command=(entry/"cmdline").read_bytes()
  except (FileNotFoundError,ProcessLookupError,PermissionError): command=b""
  if exact or root in command: matches[pid]=ticks
 return matches
def signal_owned(sig):
 for pid,ticks in owned().items():
  if identity(pid,True) != ticks: continue
  try: os.kill(pid,sig)
  except (FileNotFoundError,ProcessLookupError): pass
signal_owned(signal.SIGTERM)
deadline=time.monotonic()+2.0
while owned() and time.monotonic()<deadline: time.sleep(0.02)
signal_owned(signal.SIGKILL)
deadline=time.monotonic()+5.0
while owned() and time.monotonic()<deadline: time.sleep(0.02)
assert not owned(), owned()' \
    "$data_query_reap_root" "$data_query_reap_records"
}

