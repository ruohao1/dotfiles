  ask "tmux Meta-backslash split right and Meta-pipe split down"
  ask "tmux Meta-h j k l moved through Neovim splits, crossed into tmux panes at editor edges, and returned"
  ask "tmux prefix+Shift-h j k l swapped with the matching neighbor and kept that process focused"
  ask "tmux pane swaps did not wrap at outer edges"
  ask "tmux prefix+m moved a disposable pane to the right side of a selected window and followed it"
  ask "Escape cancelled the tmux pane-move chooser without changing the layout"
  ask "tmux Meta-q closed a disposable pane and Meta-f toggled zoom"
  ask "tmux prefix+r then h j k l resized one cell repeatedly and Escape exited"
  ask "tmux prefix+v entered vi copy mode and y updated the OSC 52 clipboard"
  ask "tmux showed NORMAL, INSERT, VISUAL, REPLACE, COMMAND, and TERMINAL with the approved colors"
  ask "tmux COPY, RESIZE, and PREFIX overrode the Neovim or application mode in priority order"
  ask "the Git block showed a clean branch and exact + staged, ~ unstaged, ? untracked, and ! conflicted counts"
  ask "switching buffers between two repositories changed Git root and project-relative file without stale output"
  ask "Neovim unsaved, error, warning, line, and visual-column values updated without adding a second persistent row"
  ask "at 80 columns or wider, local applications showed path and time while SSH and mosh showed time only"
  ask "active, zoom, activity, and bell window states used the approved block colors and markers"
  ask "clicking an inactive tmux window selected it through the native window range"
  ask "tmux kept exactly one useful persistent row at 80 columns and at 120 or more columns"
  ask "standalone Neovim showed the equivalent native row without a tmux window list"
  ask "tmux and Herdr were tested separately and were never nested"
  ask "standalone Neovim still handled Meta-h j k l and Meta-Shift-h j k l"
  ask "Enter, Shift-Enter, and Ctrl-Enter arrived as three distinct Neovim keys"
  ask "Ctrl-I and Tab arrived as two distinct Neovim keys"
  ask "24-bit color gradients rendered without banding"
  ask "Normal, Insert, and Terminal cursor shapes changed correctly"
  ask "FocusGained and FocusLost fired when Ghostty focus changed"
  ask "Unicode text and required Nerd Font glyphs rendered correctly"
  ask "mouse selection, tmux pane selection, and Neovim mouse input behaved correctly"
  ask "Ghostty copy and paste worked"
  ask "tmux vi copy-mode y updated the system clipboard through OSC 52"
  ask "Neovim yank updated the selected native, tmux, or OSC 52 provider"
  ask "terminal paste entered Neovim through bracketed paste"
}

if [ "${1:-}" = "--interactive" ]; then
  printf '\nInteractive matrix\n'
  if [ "$failures" -ne 0 ]; then
    printf 'SKIP  interactive matrix because automated checks reported %s failure(s)\n' "$failures"
  elif [ ! -t 0 ] || [ ! -t 1 ]; then
    fail "interactive matrix requires a real TTY on stdin and stdout; piped answers are not accepted"
  else
    printf 'Keep this checker open in its own fresh Ghostty window. Perform each check elsewhere, then return here to answer.\n'
    printf 'Run raw-key and standalone Neovim checks from separate fresh normal-shell windows.\n'
    printf 'Start Herdr in another fresh Ghostty window, complete its prompts, then exit Herdr completely.\n'
    printf 'Only after Herdr exits, start tmux in a different fresh Ghostty window. Never nest Herdr and tmux.\n'
    printf 'For raw key bytes, run: od -An -tx1\n'
    printf 'For Neovim key names, run: :lua vim.on_key(function(key) print(vim.fn.keytrans(key)) end)\n'
    run_interactive_matrix
  fi
fi

check_clipboard_history

printf '\nSummary: %s failure(s), %s warning(s)\n' "$failures" "$warnings"

if [ "$failures" -ne 0 ]; then
  exit 1
fi

exit 0
