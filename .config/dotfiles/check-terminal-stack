  nvim_fixture=$check_tmp/nvim-trust-fsmonitor
  nvim_fsmonitor_sentinel=$check_tmp/nvim-trust-fsmonitor.sentinel
  nvim_fsmonitor_hook=$check_tmp/nvim-trust-fsmonitor-hook
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && printf '#!/bin/sh\n: > "%s"\n' "$nvim_fsmonitor_sentinel" \
      > "$nvim_fsmonitor_hook" \
    && chmod 700 "$nvim_fsmonitor_hook" \
    && git -C "$nvim_fixture" config core.fsmonitor "$nvim_fsmonitor_hook"; then
    nvim_fixture_lock=$(hardened_plugin_git "$nvim_fixture" rev-parse HEAD)
    nvim_trust_expect_accept \
      "hardened wrapper overrides hostile core.fsmonitor" \
      nvim_plugin_checkout_is_trusted \
      "$nvim_fixture" lazy.nvim "$nvim_fixture_lock" \
      "$check_tmp/audit-fsmonitor" || true
    nvim_trust_expect_accept \
      "hostile core.fsmonitor sentinel remains absent" \
      nvim_trust_path_is_absent "$nvim_fsmonitor_sentinel" || true
  else
    fail "could not create core.fsmonitor fixture"
  fi

  nvim_fixture=$check_tmp/nvim-trust-clean-filter
  if nvim_trust_fixture_init "$nvim_fixture" lazy.nvim \
    && git -C "$nvim_fixture" config filter.hostile.clean cat; then
