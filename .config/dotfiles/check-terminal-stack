  printf '%s\n' 'set -g @hash_probe harmless#x ; run-s true' > "$check_tmp/tmux-hash-module-run.conf"
  if [ "$tmux_started" = true ] \
    && tmux_parse_probe_contains \
      "$check_socket" \
      "$check_tmp/tmux-hash-module-run.conf" \
      "$check_tmp/tmux-hash-module-run-parse.txt" \
      'harmless#x' \
      '; run-shell true'; then
    pass "tmux parses run-s after a module midword hash"
  else
    sed 's/^/      /' "$check_tmp/tmux-hash-module-run-parse.txt" >&2
    fail "tmux did not expose run-s after a module midword hash"
  fi

  printf '%s\n' 'set -g @hash_probe harmless#x ; sou /dev/null' > "$check_tmp/tmux-hash-module-sou.conf"
  if [ "$tmux_started" = true ] \
    && tmux_parse_probe_contains \
      "$check_socket" \
      "$check_tmp/tmux-hash-module-sou.conf" \
      "$check_tmp/tmux-hash-module-sou-parse.txt" \
      'harmless#x' \
      '; source-file /dev/null'; then
    pass "tmux parses sou after a module midword hash"
  else
    sed 's/^/      /' "$check_tmp/tmux-hash-module-sou-parse.txt" >&2
    fail "tmux did not expose sou after a module midword hash"
