require_file "$tmux_root/tmux.conf" || true
require_file "$tmux_root/conf/options.conf" || true
require_file "$tmux_root/conf/keys.conf" || true
require_file "$tmux_root/conf/persistence.conf" || true
require_file "$tmux_root/conf/status.conf" || true
require_file "$tmux_root/conf/platform/linux.conf" || true
require_file "$tmux_root/conf/platform/macos.conf" || true
require_file "$tmux_fresh_start_test" || true
if [ -x "$tmux_root/scripts/session-navigator" ]; then
