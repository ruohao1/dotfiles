  printf 'argc=7\t--no-optional-locks\t-C\t%s\tstatus\t--porcelain=v2\t--branch\t--untracked-files=normal\n' \
    "$fake_git_expected_path" > "$fake_git_expected"
  if cmp -s "$fake_git_expected" "$task1_fake_git_log"; then
    pass "$fake_git_label invokes fake Git exactly once with the approved arguments"
    return 0
  fi

  sed 's/^/      /' "$task1_fake_git_log" >&2
  fail "$fake_git_label changed the fake Git invocation contract"
  return 1
}

require_git_count_saturation() {
  git_saturation_count=$1
  git_saturation_profile=$2
  git_saturation_expected=$3
  git_saturation_label=$4
  git_saturation_output="$check_tmp/git-saturation-$git_saturation_profile.out"
  git_saturation_error="$check_tmp/git-saturation-$git_saturation_profile.err"
  git_saturation_ok=true

  begin_git_index_guard "$check_tmp/git-clean" "$git_saturation_label" \
    || return 1
  : > "$task1_fake_git_log"
  PATH="$task1_fake_bin:$PATH" \
    TASK1_FAKE_GIT_LOG="$task1_fake_git_log" \
    TASK1_FAKE_GIT_PATH="$check_tmp/git-clean" \
    TASK1_FAKE_GIT_MODE=counts \
    TASK1_FAKE_COUNT="$git_saturation_count" \
    TASK1_FAKE_BRANCH=count-boundary \
    run_git_summary "$git_summary" \
      "$git_saturation_output" "$git_saturation_error" \
      "$git_saturation_label" \
      --path "$check_tmp/git-clean" --profile "$git_saturation_profile"
  git_saturation_status=$?
  if ! end_git_index_guard; then
    git_saturation_ok=false
  fi

  if require_task1_fake_git_call "$check_tmp/git-clean" \
    "$git_saturation_label"; then
    :
  else
    git_saturation_ok=false
  fi
  if [ "$git_saturation_status" -eq 0 ]; then
    pass "$git_saturation_label exits successfully"
    if ! require_output "$git_saturation_output" "$git_saturation_error" \
      "$git_saturation_expected" "$git_saturation_label"; then
      git_saturation_ok=false
    fi
  else
    sed 's/^/      /' "$git_saturation_error" >&2
    fail "$git_saturation_label exits successfully"
    git_saturation_ok=false
  fi

  [ "$git_saturation_ok" = true ]
}

read_exact_positive_pid_file() {
  positive_pid_file=$1
  positive_pid_expected="$positive_pid_file.expected"
  exact_positive_pid=""

  if ! awk '
    NR == 1 && /^[1-9][0-9]*$/ { decimal_pid = $0 }
    END { exit !(NR == 1 && decimal_pid != "") }
  ' "$positive_pid_file"; then
    return 1
  fi
  exact_positive_pid=$(sed -n '1p' "$positive_pid_file")
  printf '%s\n' "$exact_positive_pid" > "$positive_pid_expected" \
    || return 1
  cmp -s "$positive_pid_expected" "$positive_pid_file"
}

