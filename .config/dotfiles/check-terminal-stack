    url_actual_eligibility=false
    if [ "$tmux_url_guard_shape_valid" = true ] \
      && printf '%s\n' "$url_test_version" \
        | LC_ALL=C grep -Eq "$tmux_url_guard_regex"; then
      url_actual_eligibility=true
    fi
    if [ "$url_actual_eligibility" = "$url_expected_eligibility" ]; then
      pass "tmux literal URL source guard version $url_test_version evaluates $url_expected_eligibility"
    else
      fail "tmux literal URL source guard version $url_test_version evaluated $url_actual_eligibility"
    fi
