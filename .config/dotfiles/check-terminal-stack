resolve_nvim_data_query_tool() {
  [ "$platform" = "linux" ] || return 2
  [ "$data_query_linux_tools_ready" = true ] || return 1
  data_query_resolver_root="$check_tmp/nvim-data-query-resolver"
  data_query_resolver_report="$data_query_resolver_root/report.json"
  data_query_resolver_log="$data_query_resolver_root/nvim.log"
  data_query_resolver_nvim=$(command -v nvim 2>/dev/null || true)
  data_query_resolver_jq=$(command -v jq 2>/dev/null || true)
  case "$data_query_resolver_nvim" in
    /*) [ -x "$data_query_resolver_nvim" ] || return 1 ;;
    *) return 1 ;;
  esac
  case "$data_query_resolver_jq" in
    /*) [ -x "$data_query_resolver_jq" ] || return 1 ;;
    *) return 1 ;;
  esac
  if ! (umask 077 && mkdir -p \
    "$data_query_resolver_root/home" \
    "$data_query_resolver_root/config" \
    "$data_query_resolver_root/state" \
    "$data_query_resolver_root/cache" \
    "$data_query_resolver_root/runtime"); then
    return 1
  fi
  : > "$data_query_resolver_log"

  if ! env -u TMUX -u TMUX_PANE -u NVIM_APPNAME \
    HOME="$data_query_resolver_root/home" \
    XDG_CONFIG_HOME="$data_query_resolver_root/config" \
    XDG_DATA_HOME="$data_home" \
    XDG_STATE_HOME="$data_query_resolver_root/state" \
    XDG_CACHE_HOME="$data_query_resolver_root/cache" \
    XDG_RUNTIME_DIR="$data_query_resolver_root/runtime" \
    NVIM_LOG_FILE="$data_query_resolver_log" \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_OFFLINE=1 \
    DOTFILES_NVIM_ROOT="$nvim_root" \
    DOTFILES_DATA_QUERY_REPORT="$data_query_resolver_report" \
    "$data_query_resolver_nvim" --clean --headless -u NONE -i NONE \
    -c 'lua vim.opt.runtimepath:prepend(vim.env.DOTFILES_NVIM_ROOT)' \
    -c 'lua local report = require("data_query.tool").probe({ refresh = true }); assert(vim.fn.writefile({ vim.json.encode(report) }, vim.env.DOTFILES_DATA_QUERY_REPORT) == 0)' \
    -c qa > "$data_query_probe_output" 2>&1 \
    || nvim_log_has_error "$data_query_probe_output" \
    || [ -s "$data_query_resolver_log" ]; then
    return 1
  fi

  data_query_expected_runner=$(realpath "$nvim_root/scripts/data-query-runner.py" \
    2>> "$data_query_probe_output") || return 1

  # shellcheck disable=SC2016  # Preserve the jq $runner binding literally.
  if ! "$data_query_resolver_jq" -e \
    --arg runner "$data_query_expected_runner" '
      def safe_absolute:
        type == "string"
        and length > 1
        and startswith("/")
        and (test("[[:cntrl:]]") | not);
      type == "object"
      and .ok == true
      and (.errors | type == "array" and length == 0)
      and .expected == {"duckdb":"1.5.5","pyarrow":"25.0.0","uv":"0.11.6","visidata":"3.4"}
      and .platform == "Linux"
      and (.uv | type == "object" and .ok == true and (.path | safe_absolute) and (.version | type == "string"))
      and (.environment | safe_absolute)
      and (.python | safe_absolute)
      and (.viewer | type == "object" and .ok == true and .version == "3.4" and (.path | safe_absolute))
      and (.pyarrow | type == "object" and .ok == true and .version == "25.0.0" and (.path | safe_absolute))
      and (.duckdb | type == "object" and .ok == true and .version == "1.5.5" and (.path | safe_absolute))
      and (.sandbox | type == "object" and .ok == true and (.path | safe_absolute) and (.version | type == "string") and .probe == "data-query-sandbox-ok")
      and (.runner | type == "object" and .ok == true and .path == $runner)
    ' "$data_query_resolver_report" > /dev/null 2>> "$data_query_probe_output"; then
    return 1
  fi

  data_query_tool_uv=$("$data_query_resolver_jq" -er '.uv.path' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_environment=$("$data_query_resolver_jq" -er '.environment' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_python=$("$data_query_resolver_jq" -er '.python' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_viewer=$("$data_query_resolver_jq" -er '.viewer.path' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_pyarrow=$("$data_query_resolver_jq" -er '.pyarrow.path' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_duckdb=$("$data_query_resolver_jq" -er '.duckdb.path' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_bwrap=$("$data_query_resolver_jq" -er '.sandbox.path' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_runner=$("$data_query_resolver_jq" -er '.runner.path' \
    "$data_query_resolver_report" 2>> "$data_query_probe_output") || return 1
  data_query_tool_uv_directory=${data_query_tool_uv%/*}
  [ -n "$data_query_tool_uv_directory" ] || data_query_tool_uv_directory=/

  [ "$data_query_tool_uv" = "$parquet_tool_uv" ] \
    && [ "$data_query_tool_environment" = "$parquet_tool_environment" ] \
    && [ "$data_query_tool_python" = "$parquet_tool_python" ] \
    && [ "$data_query_tool_viewer" = "$parquet_tool_viewer" ] \
    && [ "$data_query_tool_pyarrow" = "$parquet_tool_pyarrow" ] \
    && [ "$data_query_tool_runner" = "$data_query_expected_runner" ] \
    && [ -x "$data_query_tool_python" ] \
    && [ -x "$data_query_tool_viewer" ] \
    && [ -r "$data_query_tool_pyarrow" ] \
    && [ -r "$data_query_tool_duckdb" ] \
    && [ -x "$data_query_tool_bwrap" ] \
    && [ -r "$data_query_tool_runner" ] \
    || return 1
  case "$data_query_tool_pyarrow" in
    "$data_query_tool_environment"/*) ;;
    *) return 1 ;;
  esac
  case "$data_query_tool_duckdb" in
    "$data_query_tool_environment"/*) ;;
    *) return 1 ;;
  esac
  PYTHONDONTWRITEBYTECODE=1 "$data_query_tool_python" -I -B -c \
    'import os,stat,sys; path=sys.argv[1]; value=os.lstat(path); assert stat.S_ISREG(value.st_mode); assert value.st_uid == 0; assert value.st_mode & 0o022 == 0; assert os.access(path,os.X_OK)' \
    "$data_query_tool_bwrap" >> "$data_query_probe_output" 2>&1 \
    && nvim_data_query_versions_are_exact "$data_query_tool_python" \
      >> "$data_query_probe_output" 2>&1 \
    && [ ! -e "$data_query_resolver_root/cache/nvim/dotfiles-data-query" ] \
    && [ ! -L "$data_query_resolver_root/cache/nvim/dotfiles-data-query" ]
}

data_query_cache_parent_is_empty() {
  [ "$#" -eq 1 ] || return 2
  data_query_instance_parent=$1
  [ ! -L "$data_query_instance_parent" ] || return 1
  if [ ! -e "$data_query_instance_parent" ]; then
    return 0
  fi
  [ -d "$data_query_instance_parent" ] || return 1
  for data_query_instance_path in \
    "$data_query_instance_parent"/* \
    "$data_query_instance_parent"/.[!.]* \
    "$data_query_instance_parent"/..?*
  do
    [ ! -e "$data_query_instance_path" ] \
      && [ ! -L "$data_query_instance_path" ] \
      && continue
    return 1
  done
  return 0
}

