    "tmux status source audit rejects an indexed color token" || true
  require_tmux_status_source_replacement_rejected palette-suffix \
    '#73daca' '#73daca80' \
    "tmux status source audit rejects an allowed-color prefix with a suffix" || true
  require_tmux_status_source_append_rejected palette-inline-named \
