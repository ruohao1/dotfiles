# Avoid the per-user io_uring memory budget shared with other desktop processes.
async-backend = epoll

# Linux terminal-stack keys: physical Alt becomes the canonical Meta protocol.
keybind = alt+space=text:\x1b\x20
keybind = alt+n=esc:n
keybind = alt+physical:one=esc:1
keybind = alt+1=esc:1
keybind = alt+physical:two=esc:2
keybind = alt+2=esc:2
keybind = alt+physical:three=esc:3
keybind = alt+3=esc:3
keybind = alt+physical:four=esc:4
keybind = alt+4=esc:4
keybind = alt+physical:five=esc:5
keybind = alt+5=esc:5
keybind = alt+physical:six=esc:6
keybind = alt+6=esc:6
keybind = alt+physical:seven=esc:7
keybind = alt+7=esc:7
keybind = alt+physical:eight=esc:8
keybind = alt+8=esc:8
keybind = alt+physical:nine=esc:9
keybind = alt+9=esc:9
keybind = alt+r=esc:r
keybind = alt+q=esc:q
keybind = alt+shift+q=esc:Q
keybind = alt+backslash=text:\x1b\x5c
keybind = alt+shift+backslash=esc:|
keybind = alt+f=esc:f
keybind = alt+h=esc:h
keybind = alt+j=esc:j
keybind = alt+k=esc:k
keybind = alt+l=esc:l
keybind = alt+shift+h=esc:H
keybind = alt+shift+j=esc:J
keybind = alt+shift+k=esc:K
keybind = alt+shift+l=esc:L
