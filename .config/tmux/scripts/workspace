#!/bin/sh
set -eu

# Keep parsing deterministic without passing the C locale to interactive programs.
workspace_inherited_lc_all=${LC_ALL-}
workspace_process_locale=
LC_ALL=C
export LC_ALL
umask 077

# Resolve the selected generation before touching any mutable workspace state.
# Initial discovery uses only readlink; all subsequent tools come from the
# selected HM profile whose immutable workspace source matches this helper.
# The profile is switched before service activation; current-home is switched
# afterwards, so either retained GCroot may corroborate that exact generation.
canonical_workspace() (
  source_path=$1
  case $source_path in
    */*) ;;
    *) source_path=./$source_path ;;
  esac
  source_links=0
  while [ -L "$source_path" ]; do
    source_links=$((source_links + 1))
    [ "$source_links" -le 40 ] || exit 1
    # Native command -p lookup is preferable; minimal Nix builder images may
    # provide readlink only in the inherited package environment.
    source_target=$(command -p readlink "$source_path" 2>/dev/null \
      || command readlink "$source_path") || exit 1
    case $source_target in
      /*) source_path=$source_target ;;
      *) source_path=${source_path%/*}/$source_target ;;
    esac
  done
  source_parent=${source_path%/*}
  [ "$source_parent" != "$source_path" ] || source_parent=.
  source_parent=$(CDPATH='' cd -P "$source_parent" && pwd -P) || exit 1
  printf '%s/%s\n' "$source_parent" "${source_path##*/}"
)
workspace_source=
workspace_generation=
workspace_source_root=
initialize_workspace_source() {
workspace_source=$(canonical_workspace "$0") || exit 1
workspace_generation=
workspace_source_root=
case $workspace_source in
  /nix/store/*-dotfiles-runtime/.config/tmux/scripts/workspace)
    workspace_source_root=${workspace_source%/.config/tmux/scripts/workspace}
    workspace_profile_state=${XDG_STATE_HOME:-$HOME/.local/state}
    if [ -d "$workspace_profile_state/nix/profiles" ]; then
      workspace_pointer=$workspace_profile_state/nix/profiles/home-manager
    else
      workspace_username=$(command -p id -un 2>/dev/null || command id -un) || exit 1
      workspace_pointer=/nix/var/nix/profiles/per-user/$workspace_username/home-manager
    fi
    workspace_generation=$(CDPATH='' cd -P "$workspace_pointer" && pwd -P) || {
      printf '%s\n' 'tmux-workspace: selected Home Manager generation is unavailable' >&2
      exit 1
    }
    case $workspace_generation in
      /nix/store/*-home-manager-generation) ;;
      *) printf '%s\n' 'tmux-workspace: selected generation is not immutable' >&2; exit 1 ;;
    esac
    # Native application paths are intentional fallbacks for resumed programs.
    # The selected profile owns shared tools; inherited PATH never precedes it.
    PATH=$workspace_generation/home-path/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
    export PATH
    selected_workspace=$(canonical_workspace "$workspace_generation/home-files/.config/tmux/scripts/workspace") || exit 1
    [ "$selected_workspace" = "$workspace_source" ] || {
      printf '%s\n' 'tmux-workspace: selected generation does not match this helper' >&2
      exit 1
    }
    python3 - "$workspace_pointer" "$workspace_generation" "$workspace_profile_state" <<'PYPROFILE'
import os
from pathlib import Path
import stat
import sys
try:
    pointer, generation, state = map(Path, sys.argv[1:])
    # Owned links/directories only, including the mutable pointer's ancestors.
    # The store generation itself must retain immutable root ownership/modes.
    for path in [pointer, *pointer.parents]:
        info = path.lstat()
        if info.st_uid not in {0, os.geteuid()} or (not stat.S_ISLNK(info.st_mode) and info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX):
            raise ValueError("unsafe selected-generation pointer")
    info = generation.stat()
    if info.st_uid != 0 or info.st_mode & 0o022 or pointer.resolve(strict=True) != generation:
        raise ValueError("unsafe immutable generation")
    retained = [state / "home-manager/gcroots" / name for name in ["current-home", "new-home"]]
    if not any(path.exists() and path.lstat().st_uid in {0, os.geteuid()} and path.resolve(strict=True) == generation for path in retained):
        raise ValueError("selected generation has no matching retained GCroot")
except (OSError, RuntimeError, ValueError) as error:
    sys.exit(f"tmux-workspace: {error}")
PYPROFILE
    ;;
  *)
    if [ "${TMUX_WORKSPACE_TESTING:-0}" != 1 ]; then
      PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
    fi
    export PATH
    ;;
esac
}

program=tmux-workspace
schema=1
retention=10
workspace_state=
workspace_runtime=
lock_path=
lock_held=0
staging_dir=
capture_reached_server=0
capture_has_sessions=0
restore_in_progress=0
restore_committed=0
restore_created_file=
restore_renumber_original=
restore_window_map=
restore_pane_map=
restore_session_map=
restore_group_map=
supervisor_lock_path=
supervisor_lock_held=0
supervisor_stop=0
sleeper=
hook_temp=

usage() {
  destination=$1
  if [ "$destination" -eq 1 ]; then
    output=/dev/stdout
  else
    output=/dev/stderr
  fi
  printf '%s\n' \
    'usage: tmux-workspace COMMAND' \
    '' \
    '  tmux-workspace save         checkpoint the current server' \
    '  tmux-workspace restore      restore a safe detached server' \
    '  tmux-workspace ensure       wait for or perform login restore' \
    '  tmux-workspace status       report snapshot and supervisor state' \
    '  tmux-workspace doctor       validate persistence dependencies' \
    '  tmux-workspace supervise    restore, checkpoint, and save on stop' \
    '  tmux-workspace codex-hook   handle Codex hook JSON from stdin' \
    '  tmux-workspace resume-pane GENERATION PANE_KEY' \
    >"$output"
}

die() {
  printf '%s: %s\n' "$program" "$1" >&2
  exit "$2"
}

state_root() {
  if [ -n "${TMUX_WORKSPACE_STATE_ROOT-}" ]; then
    printf '%s\n' "$TMUX_WORKSPACE_STATE_ROOT"
  elif [ -n "${XDG_STATE_HOME-}" ]; then
    printf '%s\n' "$XDG_STATE_HOME/dotfiles/tmux"
  else
    printf '%s\n' "$HOME/.local/state/dotfiles/tmux"
  fi
}

runtime_root() {
  if [ -n "${TMUX_WORKSPACE_RUNTIME_ROOT-}" ]; then
    printf '%s\n' "$TMUX_WORKSPACE_RUNTIME_ROOT"
  elif [ -n "${XDG_RUNTIME_DIR-}" ]; then
    printf '%s\n' "$XDG_RUNTIME_DIR/dotfiles-tmux"
  else
    printf '%s\n' "${TMPDIR:-/tmp}/dotfiles-tmux-$(id -u)"
  fi
}

require_test_socket() {
  if [ "${TMUX_WORKSPACE_TESTING:-0}" = 1 ] \
    && [ -z "${TMUX_WORKSPACE_SOCKET-}" ]; then
    die 'TMUX_WORKSPACE_SOCKET is required in test mode' 2
  fi
}

select_process_locale() {
  [ -z "$workspace_process_locale" ] || return 0
  for locale_candidate in "$workspace_inherited_lc_all" "${LC_CTYPE-}" "${LANG-}" \
    C.UTF-8 en_US.UTF-8; do
    [ -n "$locale_candidate" ] || continue
    if locale_charmap=$(LC_ALL="$locale_candidate" command locale charmap 2>/dev/null) \
      && [ "$locale_charmap" = UTF-8 ]; then
      workspace_process_locale=$locale_candidate
      return 0
    fi
  done
  die 'an available UTF-8 locale is required for tmux and resumed programs' 1
}

tmux_run() {
  require_test_socket
  select_process_locale
  if [ -n "${TMUX_WORKSPACE_SOCKET-}" ]; then
    LC_ALL="$workspace_process_locale" command tmux -S "$TMUX_WORKSPACE_SOCKET" "$@"
  else
    LC_ALL="$workspace_process_locale" command tmux "$@"
  fi
}

set_root_paths() {
  workspace_state=$(state_root)
  workspace_runtime=$(runtime_root)
  case $workspace_state:$workspace_runtime in
    /*:/*) ;;
    *) die 'state and runtime roots must be absolute paths' 2 ;;
  esac
}

ensure_private_directory() {
  private_directory=$1
  [ ! -L "$private_directory" ] \
    || die "refusing symlinked private directory: $private_directory" 1
  mkdir -p "$private_directory"
  [ -d "$private_directory" ] && [ ! -L "$private_directory" ] \
    || die "private directory is unavailable: $private_directory" 1
  chmod 0700 "$private_directory"
}

cleanup_stale_staging() {
  for stale_staging in "$workspace_state"/snapshots/.staging-*; do
    [ -d "$stale_staging" ] && [ ! -L "$stale_staging" ] || continue
    staging_name=${stale_staging##*/}
    staging_identity=${staging_name#.staging-}
    staging_owner=${staging_identity%%-*}
    staging_generation=${staging_identity#*-}
    case $staging_owner:$staging_generation in
      *[!0-9]*:*|:*) continue ;;
    esac
    generation_is_valid "$staging_generation" || continue
    pid_is_live "$staging_owner" && continue
    case $stale_staging in
      "$workspace_state"/snapshots/.staging-*) rm -rf "$stale_staging" ;;
    esac
  done
}

prepare_roots() {
  set_root_paths
  ensure_private_directory "$workspace_state"
  ensure_private_directory "$workspace_state/snapshots"
  ensure_private_directory "$workspace_runtime"
  cleanup_stale_staging
}

pid_is_live() {
  owner_pid=$1
  case $owner_pid in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$owner_pid" >/dev/null 2>&1
}

create_lock_directory() {
  # Some multicall mkdir versions return success to concurrent creators.
  # GNU compatibility names are available alongside them on those systems.
  if command -v gnumkdir >/dev/null 2>&1; then
    command gnumkdir "$1"
  elif command -v gmkdir >/dev/null 2>&1; then
    command gmkdir "$1"
  else
    command mkdir "$1"
  fi
}

acquire_lock() {
  lock_name=$1
  lock_path=$workspace_runtime/$lock_name.lock
  lock_held=0

  if create_lock_directory "$lock_path" 2>/dev/null; then
    printf '%s\n' "$$" >"$lock_path/owner"
    chmod 0600 "$lock_path/owner"
    lock_held=1
    return 0
  fi

  [ ! -L "$lock_path" ] || return 1
  [ -d "$lock_path" ] || return 1
  lock_owner=$(sed -n '1p' "$lock_path/owner" 2>/dev/null || :)
  # mkdir wins the lock before the PID is published. An ownerless lock may
  # still be initializing; reclaim only a recorded, demonstrably dead owner.
  case $lock_owner in ''|*[!0-9]*) return 1 ;; esac
  if pid_is_live "$lock_owner"; then
    return 1
  fi

  rm -f "$lock_path/owner"
  rmdir "$lock_path" 2>/dev/null || return 1
  if create_lock_directory "$lock_path" 2>/dev/null; then
    printf '%s\n' "$$" >"$lock_path/owner"
    chmod 0600 "$lock_path/owner"
    lock_held=1
    return 0
  fi
  return 1
}

release_lock() {
  [ "$lock_held" -eq 1 ] || return 0
  [ -n "$lock_path" ] || return 0
  case $lock_path in
    "$workspace_runtime"/*.lock) ;;
    *) return 1 ;;
  esac
  recorded_owner=$(sed -n '1p' "$lock_path/owner" 2>/dev/null || :)
  if [ "$recorded_owner" = "$$" ]; then
    rm -f "$lock_path/owner"
    rmdir "$lock_path" 2>/dev/null || :
  fi
  lock_held=0
  lock_path=
}

generation_is_valid() {
  candidate=$1
  if [ "${TMUX_WORKSPACE_TESTING:-0}" = 1 ]; then
    printf '%s\n' "$candidate" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'
  else
    printf '%s\n' "$candidate" | grep -Eq '^[0-9]{8}T[0-9]{6}Z-[0-9]+$'
  fi
}

line_pins_directory() {
  printf '%s\n' "${workspace_source%/*}"
}

workspace_line_pins() {
  workspace_pin_action=$1
  workspace_pin_session=$2
  workspace_pin_socket=$(tmux_run display-message -p -t "$workspace_pin_session:" '#{socket_path}' </dev/null) \
    || return 1
  workspace_pin_pid=$(tmux_run display-message -p -t "$workspace_pin_session:" '#{pid}' </dev/null) \
    || return 1
  "$(line_pins_directory)/location-pins" "$workspace_pin_action" \
    --socket "$workspace_pin_socket" --session "$workspace_pin_session" --server-pid "$workspace_pin_pid"
}

validate_snapshot() {
  snapshot_file=$1
  [ -f "$snapshot_file" ] && [ ! -L "$snapshot_file" ] || return 1
  [ "$(file_mode "$snapshot_file" 2>/dev/null || :)" = 600 ] || return 1
  pin_module_dir=$(line_pins_directory) || return 1
  iconv -f UTF-8 -t UTF-8 "$snapshot_file" >/dev/null 2>&1 || return 1
  jq -L "$pin_module_dir" -e '
    include "location-pins";
    def safe_text($limit):
      type == "string"
      and utf8bytelength <= $limit
      and (test("[\u0000-\u001f\u007f-\u009f]") | not);
    def positive: type == "number" and floor == . and . > 0;
    def topology($root; $session_key):
      [$root.windows[] as $window
        | $window.links[]
        | select(.session_key == $session_key)
        | {window_key: $window.key, index: .index}]
      | sort_by(.index, .window_key);
    . as $root
    | .schema == 1
    and (.saved_at | type == "number" and floor == . and . > 0)
    and (.tmux_version | safe_text(128))
    and (.sessions | type == "array")
    and (.windows | type == "array")
    and (.panes | type == "array")
    and ([.sessions[].key] | unique | length) == (.sessions | length)
    and ([.sessions[].name] | unique | length) == (.sessions | length)
    and ([.windows[].key] | unique | length) == (.windows | length)
    and ([.panes[].key] | unique | length) == (.panes | length)
    and all(.sessions[];
      (.key | type == "string" and test("^\\$[0-9]+$"))
      and (.name | safe_text(256) and length > 0)
      and (.path | safe_text(8192) and startswith("/"))
      and (.group == null or (.group | safe_text(256) and length > 0))
      and (.active_window_index | positive)
      and (.last_window_index | positive)
      and ((has("line_pins") | not) or (.line_pins | line_pin_state)))
    and all(.windows[];
      (.key | type == "string" and test("^@[0-9]+$"))
      and (.name | safe_text(512))
      and (.layout | type == "string" and test("^[0-9A-Fa-fx,{}\\[\\]]+$"))
      and (.zoomed | type == "boolean")
      and (.active_pane_index | positive)
      and (.automatic_rename | type == "boolean")
      and (.links | type == "array" and length > 0)
      and (.panes | type == "array" and length > 0)
      and ([.links[] | .session_key + ":" + (.index | tostring)] | unique | length) == (.links | length)
      and ([.panes[]] | unique | length) == (.panes | length))
    and all(.windows[].links[];
      (.session_key | type == "string")
      and (.index | positive)
      and (.session_key as $key | any($root.sessions[]; .key == $key)))
    and all(.panes[];
      (.key | type == "string" and test("^%[0-9]+$"))
      and (.window_key | type == "string" and test("^@[0-9]+$"))
      and (.index | positive)
      and (.path | safe_text(8192) and startswith("/"))
      and (.title | safe_text(1024))
      and ((has("line_pin_session_key") | not) or (
        . as $pane
        | (.line_pin_session_key | type == "string" and test("^\\$[0-9]+$"))
        and any($root.windows[]; .key == $pane.window_key
          and any(.links[]; .session_key == $pane.line_pin_session_key))))
      and (.process | type == "object")
      and (.process.kind == "shell"
        or .process.kind == "nvim"
        or .process.kind == "codex"
        or .process.kind == "other")
      and (.process.codex_session_id == null or (.process.codex_session_id | safe_text(512) and length > 0))
      and (.process.nvim_session == null
        or (.process.nvim_session
          | safe_text(1024) and test("^nvim/pane-[0-9]+\\.vim$")))
      and (if .process.kind == "codex" then .process.nvim_session == null
        elif .process.kind == "nvim" then .process.codex_session_id == null
        else .process.codex_session_id == null and .process.nvim_session == null end))
    and all(.windows[];
      . as $window
      | all($window.panes[];
          . as $pane_key
          | any($root.panes[]; .key == $pane_key and .window_key == $window.key)))
    and all(.panes[];
      . as $pane
      | any($root.windows[];
          .key == $pane.window_key and any(.panes[]; . == $pane.key)))
    and all(.sessions[];
      . as $session
      | any($root.windows[].links[];
          .session_key == $session.key and .index == $session.active_window_index)
        and any($root.windows[].links[];
          .session_key == $session.key and .index == $session.last_window_index))
    and all(.windows[];
      . as $window
      | any($root.panes[];
          .window_key == $window.key and .index == $window.active_pane_index))
    and all(.sessions[];
      . as $left
      | all($root.sessions[];
          . as $right
          | if $left.group != null and $left.group == $right.group then
              topology($root; $left.key) == topology($root; $right.key)
            else true end))
  ' "$snapshot_file" >/dev/null 2>&1 || return 1
  # Check canonical identities before any restored tmux server is created.
  jq -c '.sessions[] | select(has("line_pins")) | .line_pins' "$snapshot_file" |
    while IFS= read -r snapshot_pin_state; do
      printf '%s\n' "$snapshot_pin_state" | "$pin_module_dir/location-pins" validate >/dev/null 2>&1 \
        || exit 1
    done
}

safe_text() {
  value=$1
  maximum=$2
  byte_count=$(printf '%s' "$value" | wc -c | tr -d '[:space:]')
  [ "$byte_count" -le "$maximum" ] || return 1
  jq -ne --arg value "$value" \
    '$value | test("[\u0000-\u001f\u007f-\u009f]") | not' \
    >/dev/null 2>&1
}

session_id_is_valid() {
  session_id=$1
  case $session_id in
    ''|-*) return 1 ;;
  esac
  safe_text "$session_id" 512
}

require_safe_text() {
  value=$1
  maximum=$2
  label=$3
  safe_text "$value" "$maximum" || die "unsafe $label in tmux state" 1
}

require_identifier() {
  value=$1
  expression=$2
  label=$3
  printf '%s\n' "$value" | grep -Eq "$expression" \
    || die "invalid $label in tmux state" 1
}

require_positive() {
  value=$1
  label=$2
  case $value in
    ''|*[!0-9]*|0) die "invalid $label in tmux state" 1 ;;
  esac
}

display_field() {
  target=$1
  format=$2
  label=$3
  maximum=$4
  field_value=$(tmux_run display-message -p -t "$target" "$format") \
    || die "could not read $label from tmux" 1
  require_safe_text "$field_value" "$maximum" "$label"
  printf '%s\n' "$field_value"
}

checkpoint_nvim() {
  checkpoint_pane=$1
  checkpoint_server=$2
  require_identifier "$checkpoint_pane" '^%[0-9]+$' 'Neovim pane identifier'
  require_safe_text "$checkpoint_server" 8192 'Neovim server address'
  case $checkpoint_server in
    /*) ;;
    *) return 1 ;;
  esac
  command -v nvim >/dev/null 2>&1 || return 1

  checkpoint_relative=nvim/pane-${checkpoint_pane#%}.vim
  checkpoint_file=$staging_dir/$checkpoint_relative
  mkdir -p "$staging_dir/nvim"
  chmod 0700 "$staging_dir/nvim"
  encoded_checkpoint=$(jq -Rn --arg path "$checkpoint_file" '$path')
  checkpoint_expression="luaeval(\"require('integrations.tmux_persistence').checkpoint(_A)\",$encoded_checkpoint)"
  # Message pagers defer RPC evaluation. Bound the client wait so one editor
  # cannot hold the checkpoint lock indefinitely; leave the editor untouched.
  if checkpoint_result=$(python3 - "$checkpoint_server" "$checkpoint_expression" 2>/dev/null <<'PY'
import signal
import subprocess
import sys


def interrupted(signum, _frame):
    raise SystemExit(128 + signum)


for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
    signal.signal(signum, interrupted)
try:
    result = subprocess.run(
        ["nvim", "--server", sys.argv[1], "--remote-expr", sys.argv[2]],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
        check=False,
    )
except subprocess.TimeoutExpired:
    sys.exit(124)
except OSError:
    sys.exit(1)
sys.stdout.buffer.write(result.stdout)
sys.exit(result.returncode)
PY
  ); then
    :
  else
    case $? in
      124)
        append_warning "Neovim checkpoint timed out in pane $checkpoint_pane; a clean editor will be restored"
        ;;
      *)
        append_warning 'a Neovim checkpoint RPC failed; a clean editor will be restored'
        ;;
    esac
    return 1
  fi
  if [ "$checkpoint_result" != ok ] \
    || [ ! -f "$checkpoint_file" ] \
    || [ -L "$checkpoint_file" ] \
    || [ ! -s "$checkpoint_file" ]; then
    append_warning 'a Neovim checkpoint was invalid; a clean editor will be restored'
    return 1
  fi
  chmod 0600 "$checkpoint_file"
  printf '%s\n' "$checkpoint_relative"
}

capture_snapshot() {
  destination=$1
  capture_reached_server=0
  capture_has_sessions=0
  sessions_file=$staging_dir/sessions.ndjson
  windows_file=$staging_dir/windows.ndjson
  panes_file=$staging_dir/panes.ndjson
  session_ids_file=$staging_dir/session-ids
  window_ids_file=$staging_dir/window-ids
  pane_ids_file=$staging_dir/pane-ids
  links_file=$staging_dir/window-links
  : >"$sessions_file"
  : >"$windows_file"
  : >"$panes_file"
  : >"$session_ids_file"
  : >"$window_ids_file"
  : >"$pane_ids_file"
  : >"$links_file"

  if tmux_run list-sessions -F '#{session_id}' >"$session_ids_file" 2>/dev/null; then
    capture_reached_server=1
    if [ -s "$session_ids_file" ]; then
      capture_has_sessions=1
      tmux_run list-windows -a -F '#{window_id}' | sort -u >"$window_ids_file"
      tmux_run list-panes -a -F '#{pane_id}' | sort -u >"$pane_ids_file"
      tmux_run list-windows -a \
        -F '#{session_id}|#{window_id}|#{window_index}|#{window_active}|#{window_last_flag}' \
        >"$links_file"
    fi
  fi

  while IFS= read -r session_key; do
    [ -n "$session_key" ] || continue
    require_identifier "$session_key" '^\$[0-9]+$' 'session identifier'
    session_name=$(display_field "$session_key:" '#{session_name}' 'session name' 256)
    session_path=$(display_field "$session_key:" '#{session_path}' 'session path' 8192)
    session_group=$(display_field "$session_key:" '#{session_group}' 'session group' 256)
    [ -n "$session_name" ] || die 'empty session name in tmux state' 1
    case $session_path in
      /*) ;;
      *) die 'relative session path in tmux state' 1 ;;
    esac

    active_window_index=$(awk -F '|' -v key="$session_key" \
      '$1 == key && $4 == "1" { print $3; exit }' "$links_file")
    last_window_index=$(awk -F '|' -v key="$session_key" \
      '$1 == key && $5 == "1" { print $3; exit }' "$links_file")
    require_positive "$active_window_index" 'active window index'
    if [ -z "$last_window_index" ]; then
      last_window_index=$active_window_index
    fi
    require_positive "$last_window_index" 'last window index'

    session_line_pins=$(workspace_line_pins list "$session_key") \
      || die 'could not capture session line pins' 1
    if [ -n "$session_group" ]; then
      jq -n \
        --arg key "$session_key" \
        --arg name "$session_name" \
        --arg path "$session_path" \
        --arg group "$session_group" \
        --argjson active_window_index "$active_window_index" \
        --argjson last_window_index "$last_window_index" \
        --argjson line_pins "$session_line_pins" \
        '{line_pins:$line_pins,key:$key,name:$name,path:$path,group:$group,
          active_window_index:$active_window_index,last_window_index:$last_window_index}' \
        >>"$sessions_file"
    else
      jq -n \
        --arg key "$session_key" \
        --arg name "$session_name" \
        --arg path "$session_path" \
        --argjson active_window_index "$active_window_index" \
        --argjson last_window_index "$last_window_index" \
        --argjson line_pins "$session_line_pins" \
        '{line_pins:$line_pins,key:$key,name:$name,path:$path,group:null,
          active_window_index:$active_window_index,last_window_index:$last_window_index}' \
        >>"$sessions_file"
    fi
  done <"$session_ids_file"

  while IFS= read -r window_key; do
    [ -n "$window_key" ] || continue
    require_identifier "$window_key" '^@[0-9]+$' 'window identifier'
    window_name=$(display_field "$window_key" '#{window_name}' 'window name' 512)
    window_layout=$(display_field "$window_key" '#{window_layout}' 'window layout' 8192)
    printf '%s\n' "$window_layout" | grep -Eq '^[][0-9A-Fa-fx,{}]+$' \
      || die 'invalid window layout in tmux state' 1
    window_zoomed=$(display_field "$window_key" '#{window_zoomed_flag}' 'window zoom flag' 1)
    case $window_zoomed in
      0) window_zoomed_json=false ;;
      1) window_zoomed_json=true ;;
      *) die 'invalid window zoom flag in tmux state' 1 ;;
    esac
    automatic_rename=$(tmux_run show-options -Awqv -t "$window_key" automatic-rename) \
      || die 'could not read automatic-rename from tmux' 1
    case $automatic_rename in
      on) automatic_rename_json=true ;;
      off) automatic_rename_json=false ;;
      *) die 'invalid automatic-rename value in tmux state' 1 ;;
    esac

    window_panes_file=$staging_dir/window-panes-${window_key#@}
    window_links_file=$staging_dir/window-links-${window_key#@}.ndjson
    tmux_run list-panes -t "$window_key" -F '#{pane_id}' >"$window_panes_file"
    : >"$window_links_file"
    while IFS='|' read -r link_session link_window link_index link_active link_last; do
      [ "$link_window" = "$window_key" ] || continue
      require_identifier "$link_session" '^\$[0-9]+$' 'linked session identifier'
      require_positive "$link_index" 'linked window index'
      case $link_active:$link_last in
        0:0|0:1|1:0|1:1) ;;
        *) die 'invalid linked window flags in tmux state' 1 ;;
      esac
      jq -n --arg session_key "$link_session" --argjson index "$link_index" \
        '{session_key:$session_key,index:$index}' >>"$window_links_file"
    done <"$links_file"

    active_pane_index=$(tmux_run list-panes -t "$window_key" \
      -F '#{pane_index}|#{pane_active}' | awk -F '|' '$2 == "1" { print $1; exit }')
    require_positive "$active_pane_index" 'active pane index'
    jq -n \
      --arg key "$window_key" \
      --arg name "$window_name" \
      --arg layout "$window_layout" \
      --argjson zoomed "$window_zoomed_json" \
      --argjson active_pane_index "$active_pane_index" \
      --argjson automatic_rename "$automatic_rename_json" \
      --slurpfile links "$window_links_file" \
      --rawfile pane_lines "$window_panes_file" \
      '{
        key:$key,
        name:$name,
        layout:$layout,
        zoomed:$zoomed,
        active_pane_index:$active_pane_index,
        automatic_rename:$automatic_rename,
        links:$links,
        panes:($pane_lines | split("\n") | map(select(length > 0)))
      }' >>"$windows_file"
  done <"$window_ids_file"

  while IFS= read -r pane_key; do
    [ -n "$pane_key" ] || continue
    require_identifier "$pane_key" '^%[0-9]+$' 'pane identifier'
    pane_window=$(display_field "$pane_key" '#{window_id}' 'pane window identifier' 64)
    require_identifier "$pane_window" '^@[0-9]+$' 'pane window identifier'
    pane_index=$(display_field "$pane_key" '#{pane_index}' 'pane index' 16)
    require_positive "$pane_index" 'pane index'
    pane_path=$(display_field "$pane_key" '#{pane_current_path}' 'pane path' 8192)
    case $pane_path in
      /*) ;;
      *) die 'relative pane path in tmux state' 1 ;;
    esac
    pane_title=$(display_field "$pane_key" '#{pane_title}' 'pane title' 1024)
    pane_command=$(display_field "$pane_key" '#{pane_current_command}' 'pane command' 256)
    pane_pin_session=$(tmux_run show-options -pqv -t "$pane_key" \
      @dotfiles_line_pin_session 2>/dev/null || :)
    # An editor records its explicit origin; old/unseen panes use the first
    # saved window link. Ignore stale metadata after a pane moves sessions.
    if ! jq -se --arg window "$pane_window" --arg session "$pane_pin_session" '
      any(.[]; .key == $window and any(.links[]; .session_key == $session))
    ' "$windows_file" >/dev/null; then
      pane_pin_session=$(jq -ser --arg window "$pane_window" '
        .[] | select(.key == $window) | .links[0].session_key
      ' "$windows_file")
    fi
    codex_session_id=
    nvim_session=
    case ${pane_command##*/} in
      nvim|nvimdiff|nvim-wrapped|nvimdiff-wrapped)
        process_kind=nvim
        nvim_server=$(tmux_run show-options -pqv -t "$pane_key" \
          @dotfiles_nvim_server 2>/dev/null || :)
        if [ -n "$nvim_server" ]; then
          nvim_session=$(checkpoint_nvim "$pane_key" "$nvim_server" || :)
        fi
        ;;
      codex|codex-*)
        codex_active=$(tmux_run show-options -pqv -t "$pane_key" \
          @dotfiles_codex_active 2>/dev/null || :)
        codex_session_id=$(tmux_run show-options -pqv -t "$pane_key" \
          @dotfiles_codex_session_id 2>/dev/null || :)
        if [ "$codex_active" = 1 ] \
          && { [ -z "$codex_session_id" ] \
            || session_id_is_valid "$codex_session_id"; }; then
          process_kind=codex
        else
          process_kind=other
          codex_session_id=
        fi
        ;;
      sh|ash|bash|dash|fish|ksh|mksh|nu|tcsh|zsh|elvish)
        process_kind=shell
        ;;
      *)
        process_kind=other
        ;;
    esac
    jq -n \
      --arg key "$pane_key" \
      --arg window_key "$pane_window" \
      --argjson index "$pane_index" \
      --arg path "$pane_path" \
      --arg title "$pane_title" \
      --arg line_pin_session_key "$pane_pin_session" \
      --arg process_kind "$process_kind" \
      --arg codex_session_id "$codex_session_id" \
      --arg nvim_session "$nvim_session" \
      '{
        key:$key,
        window_key:$window_key,
        index:$index,
        path:$path,
        title:$title,
        line_pin_session_key:$line_pin_session_key,
        process:{
          kind:$process_kind,
          codex_session_id:(if $codex_session_id == "" then null else $codex_session_id end),
          nvim_session:(if $nvim_session == "" then null else $nvim_session end)
        }
      }' >>"$panes_file"
  done <"$pane_ids_file"

  if [ "${TMUX_WORKSPACE_TESTING:-0}" = 1 ] \
    && [ "${TMUX_WORKSPACE_TEST_FAIL_CAPTURE:-0}" = 1 ]; then
    die 'injected capture failure' 1
  fi

  saved_at=$(date '+%s')
  tmux_version=$(tmux -V 2>/dev/null || printf '%s' unavailable)
  jq -n \
    --argjson schema "$schema" \
    --argjson saved_at "$saved_at" \
    --arg tmux_version "$tmux_version" \
    --slurpfile sessions "$sessions_file" \
    --slurpfile windows "$windows_file" \
    --slurpfile panes "$panes_file" \
    '{
      schema:$schema,
      saved_at:$saved_at,
      tmux_version:$tmux_version,
      sessions:$sessions,
      windows:$windows,
      panes:$panes
    }' >"$destination"

  rm -f "$sessions_file" "$windows_file" "$panes_file" \
    "$session_ids_file" "$window_ids_file" "$pane_ids_file" "$links_file"
  for temporary in "$staging_dir"/window-panes-* "$staging_dir"/window-links-*.ndjson; do
    [ -e "$temporary" ] || continue
    rm -f "$temporary"
  done
}

select_snapshot() {
  selected_generation=
  selected_manifest=
  current_file=$workspace_state/current

  if [ -f "$current_file" ] && [ ! -L "$current_file" ] \
    && [ "$(file_mode "$current_file" 2>/dev/null || :)" = 600 ]; then
    current_generation=$(sed -n '1p' "$current_file" 2>/dev/null || :)
    if generation_is_valid "$current_generation"; then
      current_manifest=$workspace_state/snapshots/$current_generation/snapshot.json
      if [ -d "$workspace_state/snapshots/$current_generation" ] \
        && [ ! -L "$workspace_state/snapshots/$current_generation" ] \
        && [ "$(file_mode "$workspace_state/snapshots/$current_generation" \
          2>/dev/null || :)" = 700 ] \
        && validate_snapshot "$current_manifest"; then
        selected_generation=$current_generation
        selected_manifest=$current_manifest
        return 0
      fi
    fi
  fi

  generations=$(find "$workspace_state/snapshots" -mindepth 1 -maxdepth 1 -type d \
    ! -name '.staging-*' -exec basename {} \; 2>/dev/null | sort -r)
  for candidate in $generations; do
    generation_is_valid "$candidate" || continue
    candidate_manifest=$workspace_state/snapshots/$candidate/snapshot.json
    if [ "$(file_mode "$workspace_state/snapshots/$candidate" \
        2>/dev/null || :)" = 700 ] \
      && validate_snapshot "$candidate_manifest"; then
      selected_generation=$candidate
      selected_manifest=$candidate_manifest
      return 0
    fi
  done
  return 1
}

new_generation() {
  if [ -n "${TMUX_WORKSPACE_TEST_GENERATION-}" ]; then
    candidate=$TMUX_WORKSPACE_TEST_GENERATION
    printf '%s\n' "$candidate" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' \
      || die 'invalid test generation' 2
  else
    sequence_file=$workspace_runtime/generation-sequence
    generation_sequence=$(sed -n '1p' "$sequence_file" 2>/dev/null || printf '0')
    case $generation_sequence in
      ''|*[!0-9]*) generation_sequence=0 ;;
    esac
    generation_sequence=$((generation_sequence + 1))
    sequence_staging=$workspace_runtime/.generation-sequence-$$
    printf '%s\n' "$generation_sequence" >"$sequence_staging"
    chmod 0600 "$sequence_staging"
    mv "$sequence_staging" "$sequence_file"
    generation_suffix=$(printf '%s%06d' "$$" "$generation_sequence")
    candidate=$(date -u '+%Y%m%dT%H%M%SZ')-$generation_suffix
  fi
  generation_is_valid "$candidate" || die 'invalid generated snapshot name' 1
  [ ! -e "$workspace_state/snapshots/$candidate" ] \
    || die "snapshot generation already exists: $candidate" 1
  printf '%s\n' "$candidate"
}

prune_generations() {
  kept=0
  generations=$(find "$workspace_state/snapshots" -mindepth 1 -maxdepth 1 -type d \
    ! -name '.staging-*' -exec basename {} \; 2>/dev/null | sort -r)
  for candidate in $generations; do
    generation_is_valid "$candidate" || continue
    kept=$((kept + 1))
    [ "$kept" -le "$retention" ] && continue
    obsolete=$workspace_state/snapshots/$candidate
    case $obsolete in
      "$workspace_state"/snapshots/*) rm -rf "$obsolete" ;;
      *) die 'refusing to prune an unsafe path' 1 ;;
    esac
  done
}

publish_generation() {
  generation=$1
  manifest_file=$staging_dir/snapshot.json
  validate_snapshot "$manifest_file" || die 'refusing to publish an invalid snapshot' 1
  chmod 0600 "$manifest_file"

  completed_dir=$workspace_state/snapshots/$generation
  mv "$staging_dir" "$completed_dir"
  staging_dir=

  pointer_file=$workspace_state/.current-$generation
  printf '%s\n' "$generation" >"$pointer_file"
  chmod 0600 "$pointer_file"
  mv "$pointer_file" "$workspace_state/current"
  prune_generations
}

save_snapshot() {
  checkpoint_policy=$1
  case $checkpoint_policy in
    explicit|automatic) ;;
    *) die 'invalid checkpoint policy' 2 ;;
  esac

  prepare_roots
  acquire_lock checkpoint || die 'checkpoint already in progress' 1
  generation=$(new_generation)
  staging_dir=$workspace_state/snapshots/.staging-$$-$generation
  [ ! -e "$staging_dir" ] \
    || die "staging generation already exists: $generation" 1
  mkdir "$staging_dir"
  chmod 0700 "$staging_dir"

  capture_snapshot "$staging_dir/snapshot.json"

  if [ "$checkpoint_policy" = automatic ] \
    && { [ "$capture_reached_server" -eq 0 ] \
      || [ "$capture_has_sessions" -eq 0 ]; }; then
    case $staging_dir in
      "$workspace_state"/snapshots/.staging-*) rm -rf "$staging_dir" ;;
      *) die 'refusing to discard an unsafe staging generation' 1 ;;
    esac
    staging_dir=
    release_lock
    return 0
  fi

  publish_generation "$generation"
  if tmux_run list-sessions >/dev/null 2>&1; then
    if ! tmux_run set-option -g @dotfiles_workspace_generation "$generation" \
      \; set-option -guq @dotfiles_workspace_adopted; then
      append_warning 'the live tmux server could not be marked with its checkpoint generation'
    fi
  fi
  if [ -f "$workspace_runtime/ready" ] && [ ! -L "$workspace_runtime/ready" ]; then
    publish_ready "$generation"
  fi
  release_lock
  printf '%s\n' "$generation"
}

status_add_warning() {
  new_status_warning=$1
  if [ -z "$status_warnings" ]; then
    status_warnings=$new_status_warning
  else
    status_warnings="$status_warnings; $new_status_warning"
  fi
}

status_snapshot() {
  set_root_paths
  if ! select_snapshot; then
    die 'no valid snapshot' 1
  fi

  status_warnings=
  current_file=$workspace_state/current
  pointer_generation=
  if [ -f "$current_file" ] && [ ! -L "$current_file" ] \
    && [ "$(file_mode "$current_file" 2>/dev/null || :)" = 600 ]; then
    pointer_generation=$(sed -n '1p' "$current_file" 2>/dev/null || :)
  fi
  if [ "$pointer_generation" != "$selected_generation" ]; then
    status_add_warning 'the current pointer is invalid; a fallback snapshot was selected'
  fi

  supervisor_state=stopped
  supervisor_status_lock=$workspace_runtime/supervisor.lock
  if [ -L "$supervisor_status_lock" ]; then
    supervisor_state=invalid
    status_add_warning 'the supervisor lock is a symlink and was ignored'
  elif [ -d "$supervisor_status_lock" ]; then
    supervisor_status_owner=$(sed -n '1p' \
      "$supervisor_status_lock/owner" 2>/dev/null || :)
    if pid_is_live "$supervisor_status_owner"; then
      supervisor_state=running
    else
      supervisor_state=stale
      status_add_warning 'the supervisor lock is stale'
    fi
  fi

  readiness_state=not-ready
  ready_file=$workspace_runtime/ready
  if [ -f "$ready_file" ] && [ ! -L "$ready_file" ] \
    && [ "$(file_mode "$ready_file" 2>/dev/null || :)" = 600 ]; then
    status_ready_generation=$(sed -n '1p' "$ready_file" 2>/dev/null || :)
    if [ -z "$status_ready_generation" ] \
      || { generation_is_valid "$status_ready_generation" \
        && [ "$status_ready_generation" = "$selected_generation" ]; }; then
      readiness_state=ready
    else
      readiness_state=stale-ready-marker
      status_add_warning 'the ready marker does not match the selected snapshot'
    fi
  elif [ -e "$ready_file" ] || [ -L "$ready_file" ]; then
    readiness_state=invalid-ready-marker
    status_add_warning 'the ready marker is invalid'
  fi

  last_restore=never
  last_restore_file=$workspace_state/last-restore.json
  if [ -f "$last_restore_file" ] && [ ! -L "$last_restore_file" ] \
    && [ "$(file_mode "$last_restore_file" 2>/dev/null || :)" = 600 ]; then
    restore_generation=$(jq -er \
      '.generation | select(type == "string")' "$last_restore_file" 2>/dev/null || :)
    restored_at=$(jq -er \
      '.restored_at | select(type == "number" and floor == . and . > 0)' \
      "$last_restore_file" 2>/dev/null || :)
    if generation_is_valid "$restore_generation" \
      && [ -n "$restored_at" ]; then
      last_restore="$restore_generation at $restored_at"
    else
      last_restore=invalid
      status_add_warning 'the last restore record is invalid'
    fi
  elif [ -e "$last_restore_file" ] || [ -L "$last_restore_file" ]; then
    last_restore=invalid
    status_add_warning 'the last restore record is invalid'
  fi

  server_state=stopped
  if tmux_run list-sessions >/dev/null 2>&1; then
    if [ "$(tmux_run show-options -gqv @dotfiles_workspace_adopted \
        2>/dev/null || :)" = 1 ]; then
      server_state=adopted
    else
      status_server_generation=$(tmux_run show-options -gqv \
        @dotfiles_workspace_generation 2>/dev/null || :)
      if [ "$status_server_generation" = "$selected_generation" ]; then
        server_state="restored $selected_generation"
      else
        server_state=running-unmanaged
      fi
    fi
  fi

  private_warning_file=$workspace_state/last-warning
  if [ -f "$private_warning_file" ] && [ ! -L "$private_warning_file" ] \
    && [ "$(file_mode "$private_warning_file" 2>/dev/null || :)" = 600 ]; then
    private_warning=$(sed -n '1p' "$private_warning_file" 2>/dev/null || :)
    if [ -n "$private_warning" ] && safe_text "$private_warning" 1024; then
      status_add_warning "$private_warning"
    elif [ -n "$private_warning" ]; then
      status_add_warning 'the private warning record is invalid'
    fi
  elif [ -e "$private_warning_file" ] || [ -L "$private_warning_file" ]; then
    status_add_warning 'the private warning record is invalid'
  fi

  [ -n "$status_warnings" ] || status_warnings=none
  printf 'Supervisor: %s, %s\n' "$supervisor_state" "$readiness_state"
  printf 'Current snapshot: %s\n' "$selected_generation"
  printf 'Last checkpoint: %s\n' "$(jq -r '.saved_at' "$selected_manifest")"
  printf 'Last restore: %s\n' "$last_restore"
  printf 'Server state: %s\n' "$server_state"
  printf 'Warnings: %s\n' "$status_warnings"
}

doctor_failure=0

doctor_fail() {
  printf '%s doctor: %s\n' "$program" "$1"
  doctor_failure=1
}

doctor_hook_is_valid() {
  doctor_hook_file=$1
  [ -f "$doctor_hook_file" ] && [ ! -L "$doctor_hook_file" ] || return 1
  jq -e '
    def workspace_hook:
      .type == "command"
      and .command == "\"$HOME/.config/tmux/scripts/workspace\" codex-hook";
    (.hooks.SessionStart | type == "array")
    and (.hooks.SessionEnd | type == "array")
    and any(.hooks.SessionStart[]?.hooks[]?; workspace_hook)
    and any(.hooks.SessionEnd[]?.hooks[]?; workspace_hook)
  ' "$doctor_hook_file" >/dev/null 2>&1
}

doctor_service_enabled() {
  doctor_platform=$1
  if [ "${TMUX_WORKSPACE_TESTING:-0}" = 1 ]; then
    case ${TMUX_WORKSPACE_TEST_SERVICE_ENABLED:-false} in
      true) return 0 ;;
      false) return 1 ;;
      *) return 1 ;;
    esac
  fi
  case $doctor_platform in
    Linux)
      command -v systemctl >/dev/null 2>&1 \
        && systemctl --user is-enabled --quiet tmux-workspace.service \
          >/dev/null 2>&1
      ;;
    Darwin)
      command -v launchctl >/dev/null 2>&1 \
        && launchctl print "gui/$(id -u)/dev.ruohao.tmux-workspace" \
          >/dev/null 2>&1
      ;;
    *) return 1 ;;
  esac
}

doctor_config_source() {
  doctor_path=$1
  doctor_relative=$2
  shift 2
  if [ -n "$workspace_generation" ]; then
    doctor_expected=$(canonical_workspace "$workspace_generation/home-files/$doctor_relative") || return 1
    python3 "$workspace_source_root/.config/dotfiles/lib/config-source.py" \
      --path "$doctor_path" --expected "$doctor_expected" "$@"
  else
    [ -f "$doctor_path" ] && [ ! -L "$doctor_path" ] || return 1
    if [ "$#" -gt 0 ]; then [ -x "$doctor_path" ]; fi
  fi
}

doctor_launchd_copy() {
  doctor_expected=$(canonical_workspace "$workspace_generation/LaunchAgents/dev.ruohao.tmux-workspace.plist") || return 1
  python3 "$workspace_source_root/.config/dotfiles/lib/config-source.py" \
    --path "$doctor_expected" --expected "$doctor_expected" || return 1
  python3 - "$doctor_service" "$doctor_expected" <<'PYCOPY'
import os
from pathlib import Path
import stat
import sys
try:
    path, expected = map(Path, sys.argv[1:])
    info = path.lstat()
    valid = stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid() and stat.S_IMODE(info.st_mode) == 0o444 and path.read_bytes() == expected.read_bytes()
except OSError:
    valid = False
sys.exit(0 if valid else 1)
PYCOPY
}

doctor_workspace() {
  set_root_paths
  doctor_failure=0
  doctor_has_jq=1
  command -v tmux >/dev/null 2>&1 \
    || doctor_fail 'tmux dependency is missing'
  command -v python3 >/dev/null 2>&1 \
    || doctor_fail 'python3 dependency is missing'
  if ! command -v jq >/dev/null 2>&1; then
    doctor_fail 'jq dependency is missing'
    doctor_has_jq=0
  fi

  if [ ! -d "$workspace_state" ] \
    || [ -L "$workspace_state" ] \
    || [ ! -w "$workspace_state" ] \
    || [ "$(file_mode "$workspace_state" 2>/dev/null || :)" != 700 ]; then
    doctor_fail 'writable private state root is missing or invalid'
  fi

  doctor_hook_file=$HOME/.codex/hooks.json
  if [ "$doctor_has_jq" -ne 1 ] \
    || ! doctor_hook_is_valid "$doctor_hook_file"; then
    doctor_fail 'Codex hook JSON is missing or invalid'
  fi

  doctor_helper=$HOME/.config/tmux/scripts/workspace
  if ! doctor_config_source "$doctor_helper" .config/tmux/scripts/workspace --executable; then
    doctor_fail 'workspace helper is missing or not executable'
  fi

  doctor_nvim=$HOME/.config/nvim/lua/integrations/tmux_persistence.lua
  if ! doctor_config_source "$doctor_nvim" .config/nvim/lua/integrations/tmux_persistence.lua; then
    doctor_fail 'Neovim integration file is missing'
  fi

  doctor_platform=$(uname -s 2>/dev/null || printf '%s' unknown)
  case $doctor_platform in
    Linux)
      doctor_service=$HOME/.config/systemd/user/tmux-workspace.service
      ;;
    Darwin)
      doctor_service=$HOME/Library/LaunchAgents/dev.ruohao.tmux-workspace.plist
      ;;
    *)
      doctor_service=
      doctor_fail 'platform service file is missing for this operating system'
      ;;
  esac
  if [ -n "$doctor_service" ]; then
    doctor_service_valid=0
    if [ -n "$workspace_generation" ] && [ "$doctor_platform" = Darwin ]; then
      doctor_launchd_copy && doctor_service_valid=1
    elif doctor_config_source "$doctor_service" .config/systemd/user/tmux-workspace.service; then
      doctor_service_valid=1
    fi
    if [ "$doctor_service_valid" -ne 1 ]; then
      doctor_fail 'platform service file is missing'
    elif ! doctor_service_enabled "$doctor_platform"; then
      doctor_fail 'platform login service is not enabled'
    fi
  fi

  if [ "$doctor_failure" -eq 0 ]; then
    printf '%s doctor: ok\n' "$program"
  fi
  printf '%s\n' 'Codex hook trust: review with /hooks'
  [ "$doctor_failure" -eq 0 ]
}

append_warning() {
  warning=$1
  warning_file=$workspace_state/last-warning
  printf '%s\n' "$warning" >"$warning_file"
  chmod 0600 "$warning_file"
}

file_mode() {
  mode_path=$1
  case $(uname -s) in
    Linux) stat -c %a "$mode_path" ;;
    Darwin) stat -f %Lp "$mode_path" ;;
    *) return 1 ;;
  esac
}

restore_path() {
  saved_path=$1
  if [ -d "$saved_path" ]; then
    printf '%s\n' "$saved_path"
  else
    append_warning 'a saved working directory is missing; HOME was used'
    printf '%s\n' "$HOME"
  fi
}

map_lookup() {
  map_file=$1
  saved_key=$2
  jq -s -er --arg saved "$saved_key" \
    'map(select(.saved == $saved))[0].actual // empty' "$map_file"
}

group_lookup() {
  group_name=$1
  jq -s -er --arg name "$group_name" \
    'map(select(.name == $name))[0].leader // empty' "$restore_group_map"
}

record_created_session() {
  created_session_id=$1
  require_identifier "$created_session_id" '^\$[0-9]+$' 'created session identifier'
  printf '%s\n' "$created_session_id" >>"$restore_created_file"
}

restore_dimensions() {
  saved_layout=$1
  dimensions=${saved_layout#*,}
  restore_width=${dimensions%%x*}
  dimensions=${dimensions#*x}
  restore_height=${dimensions%%,*}
  require_positive "$restore_width" 'restored window width'
  require_positive "$restore_height" 'restored window height'
}

prepare_restore_files() {
  restore_prefix=$workspace_runtime/restore-$$
  restore_created_file=$restore_prefix-created
  restore_window_map=$restore_prefix-windows.ndjson
  restore_pane_map=$restore_prefix-panes.ndjson
  restore_session_map=$restore_prefix-sessions.ndjson
  restore_group_map=$restore_prefix-groups.ndjson
  : >"$restore_created_file"
  : >"$restore_window_map"
  : >"$restore_pane_map"
  : >"$restore_session_map"
  : >"$restore_group_map"
  chmod 0600 "$restore_created_file" "$restore_window_map" "$restore_pane_map" \
    "$restore_session_map" "$restore_group_map"
}

cleanup_restore_files() {
  for restore_file in "$restore_created_file" "$restore_window_map" \
    "$restore_pane_map" "$restore_session_map" "$restore_group_map"; do
    [ -n "$restore_file" ] || continue
    case $restore_file in
      "$workspace_runtime"/restore-*) rm -f "$restore_file" ;;
    esac
  done
}

rollback_restore() {
  [ "$restore_in_progress" -eq 1 ] || return 0
  if [ -n "$restore_created_file" ] && [ -f "$restore_created_file" ]; then
    while IFS= read -r created_session_id; do
      require_identifier "$created_session_id" '^\$[0-9]+$' \
        'rollback session identifier'
      tmux_run kill-session -t "$created_session_id" >/dev/null 2>&1 || :
    done <"$restore_created_file"
  fi
  if [ -n "$restore_renumber_original" ]; then
    tmux_run set-option -g renumber-windows "$restore_renumber_original" \
      >/dev/null 2>&1 || :
  fi
  cleanup_restore_files
  restore_in_progress=0
}

build_restored_windows() {
  restore_windows_file=$workspace_runtime/restore-$$-window-input.ndjson
  jq -c '.windows[]' "$selected_manifest" >"$restore_windows_file"
  chmod 0600 "$restore_windows_file"
  first_window=1
  staging_session_id=
  staging_name=__dotfiles_restore_$(printf '%s' "$selected_generation" | \
    tr '.-' '__' | cut -c 1-80)_$$
  while jq -e --arg name "$staging_name" 'any(.sessions[]; .name == $name)' \
    "$selected_manifest" >/dev/null; do
    staging_name=${staging_name}_x
  done
  pane_base=$(jq -r '[.panes[].index] | min // 1' "$selected_manifest")
  require_positive "$pane_base" 'pane base index'

  while IFS= read -r window_json; do
    [ -n "$window_json" ] || continue
    saved_window_key=$(printf '%s\n' "$window_json" | jq -er '.key')
    saved_window_name=$(printf '%s\n' "$window_json" | jq -er '.name')
    saved_layout=$(printf '%s\n' "$window_json" | jq -er '.layout')
    restore_dimensions "$saved_layout"
    pane_keys_file=$workspace_runtime/restore-$$-pane-keys
    printf '%s\n' "$window_json" | jq -r '.panes[]' >"$pane_keys_file"
    first_saved_pane=$(sed -n '1p' "$pane_keys_file")
    first_saved_path=$(jq -er --arg key "$first_saved_pane" \
      '.panes[] | select(.key == $key) | .path' "$selected_manifest")
    first_restore_path=$(restore_path "$first_saved_path")

    if [ "$first_window" -eq 1 ]; then
      creation=$(tmux_run new-session -d -P \
        -F '#{session_id}|#{window_id}|#{pane_id}' \
        -s "$staging_name" -n "$saved_window_name" -c "$first_restore_path" \
        -x "$restore_width" -y "$restore_height") \
        || die 'could not create the restore staging session' 1
      staging_session_id=${creation%%|*}
      creation_remainder=${creation#*|}
      actual_window_id=${creation_remainder%%|*}
      actual_first_pane=${creation_remainder#*|}
      require_identifier "$staging_session_id" '^\$[0-9]+$' \
        'staging session identifier'
      require_identifier "$actual_window_id" '^@[0-9]+$' \
        'restored window identifier'
      require_identifier "$actual_first_pane" '^%[0-9]+$' \
        'restored pane identifier'
      record_created_session "$staging_session_id"
      restore_renumber_original=$(tmux_run show-options -gqv renumber-windows)
      case $restore_renumber_original in
        on|off) ;;
        *) die 'could not read renumber-windows' 1 ;;
      esac
      tmux_run set-option -g renumber-windows off
      tmux_run set-option -gw pane-base-index "$pane_base"
      first_window=0
    else
      creation=$(tmux_run new-window -d -P -F '#{window_id}|#{pane_id}' \
        -t "$staging_session_id:" -n "$saved_window_name" -c "$first_restore_path") \
        || die 'could not create a restored staging window' 1
      actual_window_id=${creation%%|*}
      actual_first_pane=${creation#*|}
      require_identifier "$actual_window_id" '^@[0-9]+$' \
        'restored window identifier'
      require_identifier "$actual_first_pane" '^%[0-9]+$' \
        'restored pane identifier'
    fi

    tmux_run resize-window -t "$actual_window_id" \
      -x "$restore_width" -y "$restore_height"
    jq -n --arg saved "$saved_window_key" --arg actual "$actual_window_id" \
      '{saved:$saved,actual:$actual}' >>"$restore_window_map"
    jq -n --arg saved "$first_saved_pane" --arg actual "$actual_first_pane" \
      '{saved:$saved,actual:$actual}' >>"$restore_pane_map"

    pane_number=0
    while IFS= read -r saved_pane_key; do
      [ -n "$saved_pane_key" ] || continue
      pane_number=$((pane_number + 1))
      if [ "$pane_number" -eq 1 ]; then
        continue
      fi
      saved_pane_path=$(jq -er --arg key "$saved_pane_key" \
        '.panes[] | select(.key == $key) | .path' "$selected_manifest")
      pane_restore_path=$(restore_path "$saved_pane_path")
      actual_pane_id=$(tmux_run split-window -d -P -F '#{pane_id}' \
        -t "$actual_window_id" -c "$pane_restore_path") \
        || die 'could not split a restored pane' 1
      require_identifier "$actual_pane_id" '^%[0-9]+$' \
        'restored pane identifier'
      jq -n --arg saved "$saved_pane_key" --arg actual "$actual_pane_id" \
        '{saved:$saved,actual:$actual}' >>"$restore_pane_map"
    done <"$pane_keys_file"

    tmux_run select-layout -t "$actual_window_id" "$saved_layout" \
      >/dev/null || die 'could not apply a restored window layout' 1
    # resize-window forces manual sizing while the saved layout is rebuilt.
    # Inherit the configured policy again so attached clients can resize it.
    tmux_run set-option -wu -t "$actual_window_id" window-size
    tmux_run rename-window -t "$actual_window_id" "$saved_window_name"
    saved_automatic_rename=$(printf '%s\n' "$window_json" | \
      jq -r 'if .automatic_rename then "on" else "off" end')
    tmux_run set-option -w -t "$actual_window_id" automatic-rename \
      "$saved_automatic_rename"

    while IFS= read -r saved_pane_key; do
      [ -n "$saved_pane_key" ] || continue
      actual_pane_id=$(map_lookup "$restore_pane_map" "$saved_pane_key") \
        || die 'missing restored pane mapping' 1
      saved_pane_title=$(jq -er --arg key "$saved_pane_key" \
        '.panes[] | select(.key == $key) | .title' "$selected_manifest")
      tmux_run select-pane -t "$actual_pane_id" -T "$saved_pane_title"
    done <"$pane_keys_file"
    rm -f "$pane_keys_file"
  done <"$restore_windows_file"
  rm -f "$restore_windows_file"
}

link_session_windows() {
  saved_session_key=$1
  actual_session_id=$2
  link_input=$workspace_runtime/restore-$$-links
  jq -r --arg key "$saved_session_key" '
    .windows[] as $window
    | $window.links[]
    | select(.session_key == $key)
    | [$window.key, (.index | tostring)]
    | @tsv
  ' "$selected_manifest" >"$link_input"
  chmod 0600 "$link_input"
  while IFS='	' read -r saved_window_key saved_window_index; do
    [ -n "$saved_window_key" ] || continue
    require_positive "$saved_window_index" 'restored window index'
    actual_window_id=$(map_lookup "$restore_window_map" "$saved_window_key") \
      || die 'missing restored window mapping' 1
    tmux_run link-window -d -s "$actual_window_id" \
      -t "$actual_session_id:$saved_window_index"
  done <"$link_input"
  rm -f "$link_input"
}

build_restored_sessions() {
  restore_sessions_file=$workspace_runtime/restore-$$-session-input.ndjson
  jq -c '.sessions[]' "$selected_manifest" >"$restore_sessions_file"
  chmod 0600 "$restore_sessions_file"
  disposable_index=9999
  while jq -e --argjson index "$disposable_index" \
    'any(.windows[].links[]; .index == $index)' "$selected_manifest" >/dev/null; do
    disposable_index=$((disposable_index + 1))
  done

  while IFS= read -r session_json; do
    [ -n "$session_json" ] || continue
    saved_session_key=$(printf '%s\n' "$session_json" | jq -er '.key')
    saved_session_name=$(printf '%s\n' "$session_json" | jq -er '.name')
    saved_session_path=$(printf '%s\n' "$session_json" | jq -er '.path')
    saved_session_group=$(printf '%s\n' "$session_json" | jq -r '.group // empty')
    session_restore_path=$(restore_path "$saved_session_path")

    group_leader=
    if [ -n "$saved_session_group" ]; then
      group_leader=$(group_lookup "$saved_session_group" 2>/dev/null || :)
    fi
    if [ -n "$group_leader" ]; then
      actual_session_id=$(tmux_run new-session -d -P -F '#{session_id}' \
        -s "$saved_session_name" -t "$saved_session_group" \
        -c "$session_restore_path") \
        || die 'could not create a restored grouped session' 1
      require_identifier "$actual_session_id" '^\$[0-9]+$' \
        'restored session identifier'
      record_created_session "$actual_session_id"
    else
      if [ -n "$saved_session_group" ]; then
        actual_session_id=$(tmux_run new-session -d -P -F '#{session_id}' \
          -s "$saved_session_name" -t "$saved_session_group" \
          -c "$session_restore_path") \
          || die 'could not create a restored group leader' 1
      else
        actual_session_id=$(tmux_run new-session -d -P -F '#{session_id}' \
          -s "$saved_session_name" -n __restore_disposable \
          -c "$session_restore_path") \
          || die 'could not create a restored session' 1
      fi
      require_identifier "$actual_session_id" '^\$[0-9]+$' \
        'restored session identifier'
      record_created_session "$actual_session_id"
      initial_window_id=$(tmux_run display-message -p -t "$actual_session_id:" \
        '#{window_id}')
      tmux_run move-window -d -s "$initial_window_id" \
        -t "$actual_session_id:$disposable_index"
      link_session_windows "$saved_session_key" "$actual_session_id"
      tmux_run kill-window -t "$actual_session_id:$disposable_index"
      if [ -n "$saved_session_group" ]; then
        jq -n --arg name "$saved_session_group" --arg leader "$actual_session_id" \
          '{name:$name,leader:$leader}' >>"$restore_group_map"
      fi
    fi

    printf '%s\n' "$session_json" | jq -c '.line_pins // {version:1,pins:[]}' |
      workspace_line_pins import "$actual_session_id" \
      || die 'could not restore session line pins' 1

    jq -n \
      --arg saved "$saved_session_key" \
      --arg actual "$actual_session_id" \
      --arg name "$saved_session_name" \
      '{saved:$saved,actual:$actual,name:$name}' >>"$restore_session_map"
  done <"$restore_sessions_file"
  rm -f "$restore_sessions_file"
}

start_restored_panes() {
  # Only panes created by this restore are restarted. Their staging shells
  # inherited a temporary TMUX session, so start them in the mapped origin
  # before resuming any editor. A linked pane must have one explicit origin.
  jq -c '. as $root | .panes[] as $pane
    | ($root.windows[] | select(.key == $pane.window_key)) as $window
    | ($pane.line_pin_session_key // $window.links[0].session_key) as $origin
    | ($window.links[] | select(.session_key == $origin)) as $link
    | $pane + {origin:$origin,window_index:$link.index}
  ' "$selected_manifest" |
  while IFS= read -r start_pane; do
    saved_pane_key=$(printf '%s\n' "$start_pane" | jq -er '.key')
    saved_origin=$(printf '%s\n' "$start_pane" | jq -er '.origin')
    actual_origin=$(map_lookup "$restore_session_map" "$saved_origin") \
      || die 'missing restored originating session' 1
    actual_pane_id=$(map_lookup "$restore_pane_map" "$saved_pane_key") \
      || die 'missing restored pane mapping' 1
    start_window_index=$(printf '%s\n' "$start_pane" | jq -er '.window_index')
    start_pane_index=$(tmux_run display-message -p -t "$actual_pane_id" '#{pane_index}')
    tmux_run respawn-pane -k -t "$actual_origin:$start_window_index.$start_pane_index" \
      || die 'could not start a pane in its restored session' 1
    tmux_run set-option -p -t "$actual_pane_id" @dotfiles_line_pin_session "$actual_origin"
    start_title=$(printf '%s\n' "$start_pane" | jq -er '.title')
    tmux_run select-pane -t "$actual_pane_id" -T "$start_title"
  done
}

restore_focus_and_metadata() {
  jq -c '.windows[]' "$selected_manifest" |
  while IFS= read -r window_json; do
    saved_window_key=$(printf '%s\n' "$window_json" | jq -er '.key')
    active_pane_index=$(printf '%s\n' "$window_json" | jq -er '.active_pane_index')
    saved_active_pane=$(jq -er \
      --arg window "$saved_window_key" \
      --argjson index "$active_pane_index" \
      '.panes[] | select(.window_key == $window and .index == $index) | .key' \
      "$selected_manifest")
    actual_active_pane=$(map_lookup "$restore_pane_map" "$saved_active_pane") \
      || die 'missing active pane mapping' 1
    tmux_run select-pane -t "$actual_active_pane"
    if [ "$(printf '%s\n' "$window_json" | jq -r '.zoomed')" = true ]; then
      tmux_run resize-pane -Z -t "$actual_active_pane"
    fi
  done

  jq -c '.sessions[]' "$selected_manifest" |
  while IFS= read -r session_json; do
    saved_session_key=$(printf '%s\n' "$session_json" | jq -er '.key')
    actual_session_id=$(map_lookup "$restore_session_map" "$saved_session_key") \
      || die 'missing restored session mapping' 1
    last_window_index=$(printf '%s\n' "$session_json" | jq -er '.last_window_index')
    active_window_index=$(printf '%s\n' "$session_json" | jq -er '.active_window_index')
    tmux_run select-window -t "$actual_session_id:$last_window_index"
    tmux_run select-window -t "$actual_session_id:$active_window_index"
  done
}

publish_pane_map() {
  pane_map_staging=$workspace_runtime/.pane-map-$$
  jq -s --arg generation "$selected_generation" \
    '{generation:$generation,panes:map({key:.saved,pane_id:.actual})}' \
    "$restore_pane_map" >"$pane_map_staging"
  chmod 0600 "$pane_map_staging"
  mv "$pane_map_staging" "$workspace_runtime/pane-map.json"
}

record_restore() {
  restore_record_staging=$workspace_state/.last-restore-$$
  jq -n --arg generation "$selected_generation" --argjson restored_at "$(date '+%s')" \
    '{generation:$generation,restored_at:$restored_at}' >"$restore_record_staging"
  chmod 0600 "$restore_record_staging"
  mv "$restore_record_staging" "$workspace_state/last-restore.json"
}

resume_restored_processes() {
  resume_keys_file=$workspace_runtime/restore-$$-resume-keys
  jq -r '.panes[] | select(.process.kind == "codex" or .process.kind == "nvim") | .key' \
    "$selected_manifest" >"$resume_keys_file"
  chmod 0600 "$resume_keys_file"
  while IFS= read -r saved_pane_key; do
    [ -n "$saved_pane_key" ] || continue
    require_identifier "$saved_pane_key" '^%[0-9]+$' 'resumed pane identifier'
    actual_pane_id=$(map_lookup "$restore_pane_map" "$saved_pane_key") \
      || die 'missing process pane mapping' 1
    resumed_process_kind=$(jq -er --arg key "$saved_pane_key" \
      '.panes[] | select(.key == $key) | .process.kind' "$selected_manifest")
    case $resumed_process_kind in
      codex) resumed_executable=codex ;;
      nvim) resumed_executable=nvim ;;
      *) die 'invalid resumed process kind' 1 ;;
    esac
    if ! executable_available "$resumed_executable"; then
      notify_unavailable_process "$resumed_executable" "$actual_pane_id"
      continue
    fi
    # The restored shell, not this coordinator, expands its own HOME.
    # shellcheck disable=SC2016
    resume_command='"$HOME/.config/tmux/scripts/workspace" resume-pane '
    resume_command="${resume_command}${selected_generation} ${saved_pane_key}"
    tmux_run send-keys -t "$actual_pane_id" -l "$resume_command"
    tmux_run send-keys -t "$actual_pane_id" Enter
  done <"$resume_keys_file"
  rm -f "$resume_keys_file"
}

executable_available() {
  executable_name=$1
  if [ "${TMUX_WORKSPACE_TESTING:-0}" = 1 ] \
    && [ "${TMUX_WORKSPACE_TEST_MISSING_EXECUTABLE:-}" = "$executable_name" ]; then
    return 1
  fi
  command -v "$executable_name" >/dev/null 2>&1
}

notify_unavailable_process() {
  unavailable_executable=$1
  unavailable_pane=$2
  unavailable_message="$unavailable_executable is unavailable; the restored shell was left open"
  append_warning "$unavailable_message"
  case $unavailable_pane in
    %*)
      tmux_run display-message -d 5000 -t "$unavailable_pane" \
        "tmux-workspace: $unavailable_message" >/dev/null 2>&1 || :
      ;;
  esac
}

codex_hook() {
  prepare_roots
  case ${TMUX_PANE-} in
    %*) ;;
    *) return 0 ;;
  esac
  require_identifier "$TMUX_PANE" '^%[0-9]+$' 'TMUX_PANE'
  hook_temp=$workspace_runtime/.codex-hook-$$
  command cat >"$hook_temp"
  chmod 0600 "$hook_temp"
  hook_event=$(jq -er '.hook_event_name | select(type == "string")' \
    "$hook_temp") || die 'invalid Codex hook event' 1
  hook_session_id=$(jq -er '.session_id | select(type == "string")' \
    "$hook_temp") || die 'invalid Codex hook session identifier' 1
  session_id_is_valid "$hook_session_id" \
    || die 'invalid Codex hook session identifier' 1

  case $hook_event in
    SessionStart)
      tmux_run set-option -pt "$TMUX_PANE" \
        @dotfiles_codex_session_id "$hook_session_id" \
        \; set-option -pt "$TMUX_PANE" @dotfiles_codex_active 1
      ;;
    SessionEnd)
      current_session_id=$(tmux_run show-options -pqv -t "$TMUX_PANE" \
        @dotfiles_codex_session_id 2>/dev/null || :)
      if [ "$current_session_id" = "$hook_session_id" ]; then
        tmux_run set-option -pu -t "$TMUX_PANE" \
          @dotfiles_codex_session_id \
          \; set-option -pu -t "$TMUX_PANE" @dotfiles_codex_active
      fi
      ;;
  esac
  rm -f "$hook_temp"
  hook_temp=
}

resume_pane() {
  requested_generation=$1
  requested_pane=$2
  prepare_roots
  generation_is_valid "$requested_generation" \
    || die 'invalid resume generation' 2
  require_identifier "$requested_pane" '^%[0-9]+$' 'resume pane key'
  requested_manifest=$workspace_state/snapshots/$requested_generation/snapshot.json
  validate_snapshot "$requested_manifest" || die 'invalid resume snapshot' 1
  pane_record=$(jq -cer --arg key "$requested_pane" '
    [.panes[] | select(.key == $key)]
    | if length == 1 then .[0] else error("pane not found") end
  ' "$requested_manifest") || die 'resume pane is absent from snapshot' 1
  process_kind=$(printf '%s\n' "$pane_record" | jq -er '.process.kind')
  select_process_locale
  case $process_kind in
    codex)
      if ! executable_available codex; then
        notify_unavailable_process codex "${TMUX_PANE-}"
        exit 127
      fi
      codex_session_id=$(printf '%s\n' "$pane_record" | \
        jq -r '.process.codex_session_id // empty')
      if [ -n "$codex_session_id" ]; then
        session_id_is_valid "$codex_session_id" \
          || die 'invalid Codex session identifier in snapshot' 1
        LC_ALL="$workspace_process_locale" exec codex resume "$codex_session_id"
      fi
      LC_ALL="$workspace_process_locale" exec codex resume
      ;;
    nvim)
      if ! executable_available nvim; then
        notify_unavailable_process nvim "${TMUX_PANE-}"
        exit 127
      fi
      nvim_session=$(printf '%s\n' "$pane_record" | \
        jq -r '.process.nvim_session // empty')
      if [ -n "$nvim_session" ]; then
        printf '%s\n' "$nvim_session" | grep -Eq '^nvim/pane-[0-9]+\.vim$' \
          || die 'invalid Neovim session path in snapshot' 1
        nvim_session_file=$workspace_state/snapshots/$requested_generation/$nvim_session
        if [ -f "$nvim_session_file" ] \
          && [ ! -L "$nvim_session_file" ] \
          && [ -s "$nvim_session_file" ] \
          && [ "$(file_mode "$nvim_session_file" 2>/dev/null || :)" = 600 ]; then
          LC_ALL="$workspace_process_locale" exec nvim -S "$nvim_session_file"
        fi
      fi
      LC_ALL="$workspace_process_locale" exec nvim
      ;;
    *)
      die 'pane process is not restorable' 2
      ;;
  esac
}

restore_snapshot() {
  prepare_roots
  if ! select_snapshot; then
    die 'no valid snapshot' 1
  fi

  if tmux_run list-sessions >/dev/null 2>&1; then
    live_generation=$(tmux_run show-options -gqv @dotfiles_workspace_generation 2>/dev/null || :)
    if [ "$live_generation" = "$selected_generation" ]; then
      return 0
    fi
    tmux_run set-option -g @dotfiles_workspace_adopted 1
    append_warning 'a live tmux server was adopted without structural restore'
    return 0
  fi

  if [ "$(jq -r '.sessions | length' "$selected_manifest")" -eq 0 ]; then
    record_restore
    return 0
  fi

  prepare_restore_files
  restore_in_progress=1
  restore_committed=0
  build_restored_windows
  build_restored_sessions
  start_restored_panes
  restore_focus_and_metadata
  publish_pane_map

  tmux_run kill-session -t "$staging_session_id"
  resume_restored_processes
  tmux_run set-option -g renumber-windows "$restore_renumber_original"
  tmux_run set-option -guq @dotfiles_workspace_adopted
  tmux_run set-option -g @dotfiles_workspace_generation "$selected_generation"
  record_restore
  restore_committed=1
  restore_in_progress=0
  cleanup_restore_files
}

ready_is_valid() {
  ready_file=$workspace_runtime/ready
  [ -f "$ready_file" ] && [ ! -L "$ready_file" ] || return 1
  ready_generation=$(sed -n '1p' "$ready_file" 2>/dev/null || :)
  if [ -z "$ready_generation" ]; then
    return 0
  fi
  generation_is_valid "$ready_generation" || return 1
  select_snapshot || return 1
  [ "$selected_generation" = "$ready_generation" ] || return 1
  if ! tmux_run list-sessions >/dev/null 2>&1; then
    [ "$(jq -r '.sessions | length' "$selected_manifest")" -eq 0 ]
    return
  fi
  live_generation=$(tmux_run show-options -gqv @dotfiles_workspace_generation 2>/dev/null || :)
  [ "$live_generation" = "$ready_generation" ] && return 0
  [ "$(tmux_run show-options -gqv @dotfiles_workspace_adopted 2>/dev/null || :)" = 1 ]
}

publish_ready() {
  ready_generation=$1
  ready_staging=$workspace_runtime/.ready-$$
  printf '%s\n' "$ready_generation" >"$ready_staging"
  chmod 0600 "$ready_staging"
  mv "$ready_staging" "$workspace_runtime/ready"
}

ensure_ready() {
  prepare_roots
  if ready_is_valid; then
    return 0
  fi

  ensure_timeout=${TMUX_WORKSPACE_ENSURE_TIMEOUT:-30}
  case $ensure_timeout in
    ''|*[!0-9]*|0) die 'TMUX_WORKSPACE_ENSURE_TIMEOUT must be a positive integer' 2 ;;
  esac

  if acquire_lock restore; then
    if ready_is_valid; then
      release_lock
      return 0
    fi
    rm -f "$workspace_runtime/ready"
    if select_snapshot; then
      restore_snapshot
      publish_ready "$selected_generation"
    else
      publish_ready ''
    fi
    release_lock
    return 0
  fi

  ensure_waited=0
  while [ "$ensure_waited" -lt "$ensure_timeout" ]; do
    if ready_is_valid; then
      return 0
    fi
    sleep 1
    ensure_waited=$((ensure_waited + 1))
  done
  die 'workspace restoration did not become ready before timeout' 1
}

release_supervisor_lock() {
  [ "$supervisor_lock_held" -eq 1 ] || return 0
  case $supervisor_lock_path in
    "$workspace_runtime"/supervisor.lock) ;;
    *) return 1 ;;
  esac
  supervisor_owner=$(sed -n '1p' "$supervisor_lock_path/owner" 2>/dev/null || :)
  if [ "$supervisor_owner" = "$$" ]; then
    rm -f "$supervisor_lock_path/owner"
    rmdir "$supervisor_lock_path" 2>/dev/null || :
  fi
  supervisor_lock_held=0
  supervisor_lock_path=
}

acquire_supervisor_lock() {
  acquire_lock supervisor || return 1
  supervisor_lock_path=$lock_path
  supervisor_lock_held=1
  lock_path=
  lock_held=0
}

supervisor_signal() {
  supervisor_stop=1
  if [ -n "$sleeper" ]; then
    kill "$sleeper" >/dev/null 2>&1 || :
  fi
}

supervise_loop() {
  workspace_interval=${TMUX_WORKSPACE_INTERVAL:-300}
  case $workspace_interval in
    ''|*[!0-9]*|0) die 'TMUX_WORKSPACE_INTERVAL must be a positive integer' 2 ;;
  esac

  ensure_ready
  prepare_roots
  if ! acquire_supervisor_lock; then
    return 0
  fi
  supervisor_stop=0
  sleeper=
  trap supervisor_signal HUP INT TERM

  while [ "$supervisor_stop" -eq 0 ]; do
    sleep "$workspace_interval" &
    sleeper=$!
    wait "$sleeper" || :
    sleeper=
    if [ "$supervisor_stop" -eq 0 ]; then
      save_snapshot automatic >/dev/null
    fi
  done
  save_snapshot automatic >/dev/null
  release_supervisor_lock
}

cleanup_on_exit() {
  if [ -n "$staging_dir" ] && [ -d "$staging_dir" ] && [ ! -L "$staging_dir" ]; then
    case $staging_dir in
      "$workspace_state"/snapshots/.staging-*) rm -rf "$staging_dir" ;;
    esac
  fi
  if [ -n "$hook_temp" ]; then
    case $hook_temp in
      "$workspace_runtime"/.codex-hook-*) rm -f "$hook_temp" ;;
    esac
  fi
  if [ "$restore_in_progress" -eq 1 ] && [ "$restore_committed" -eq 0 ]; then
    rollback_restore || :
  fi
  release_supervisor_lock || :
  release_lock || :
}

trap cleanup_on_exit 0
trap 'exit 130' HUP INT TERM

require_test_socket

case ${1-} in
  --help|help)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    usage 1
    ;;
  save)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    save_snapshot explicit
    ;;
  restore)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    restore_snapshot
    ;;
  ensure)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    ensure_ready
    ;;
  supervise)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    supervise_loop
    ;;
  codex-hook)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    codex_hook
    ;;
  resume-pane)
    [ "$#" -eq 3 ] || { usage 0; exit 2; }
    initialize_workspace_source
    resume_pane "$2" "$3"
    ;;
  status)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    status_snapshot
    ;;
  doctor)
    [ "$#" -eq 1 ] || { usage 0; exit 2; }
    initialize_workspace_source
    doctor_workspace
    ;;
  '')
    usage 0
    exit 2
    ;;
  *)
    usage 0
    exit 2
    ;;
esac
