#!/usr/bin/env python3
"""Attach a project's shell or editor, optionally opening an editor window."""

import contextlib
import fcntl
import hashlib
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time


class LaunchError(Exception):
    pass


def editor_name(root):
    # Git worktrees share Git metadata, but never their physical working directory.
    label = re.sub(r"[^A-Za-z0-9_-]+", "_", Path(root).name)[:60] or "project"
    digest = hashlib.sha256(os.fsencode(root)).hexdigest()[:20]
    return f"nvim-{label}-{digest}"


def executable(name):
    value = shutil.which(name)
    if not value:
        raise LaunchError(f"{name} is not installed or not in PATH")
    return value


class ProjectSession:
    def __init__(self, target, root, view="shell"):
        if view not in ("shell", "nvim", "pair"):
            raise LaunchError("project view must be shell, nvim or pair")
        self.view = view
        self.root = str(Path(root).resolve(strict=True))
        self.tmux = [executable("tmux")]
        self.shell = self.query(target, "#{session_id}")
        if not re.fullmatch(r"\$[0-9]+", self.shell):
            raise LaunchError("could not resolve the shell session")
        self.socket = self.query(self.shell, "#{socket_path}")
        self.tmux += ["-S", self.socket]
        self.check_root(self.shell)
        self.name = editor_name(self.root)

    def run(self, *args, check=True):
        result = subprocess.run(
            [*self.tmux, *args], capture_output=True, text=True, timeout=5,
        )
        if check and result.returncode:
            raise LaunchError(result.stderr.strip() or "tmux command failed")
        return result

    def query(self, target, expression):
        return self.run("display-message", "-p", "-t", target + ":", expression).stdout.removesuffix("\n")

    def check_root(self, session):
        path = self.query(session, "#{session_path}")
        if str(Path(path).resolve()) != self.root:
            raise LaunchError("the selected session now belongs to another directory; run t again")

    @contextlib.contextmanager
    def lock(self):
        base = Path(os.environ.get("XDG_RUNTIME_DIR") or (
            Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "dotfiles"
        ))
        directory = base / "tmux-projects"
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        stat = directory.lstat()
        if directory.is_symlink() or stat.st_uid != os.getuid() or stat.st_mode & 0o077:
            raise LaunchError(f"project lock directory must be private: {directory}")
        key = hashlib.sha256(os.fsencode(self.socket + "\0" + self.root)).hexdigest()
        fd = os.open(directory / key, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(fd)

    def ensure_editor(self):
        target = "=" + self.name
        if self.run("has-session", "-t", target, check=False).returncode:
            nvim = executable("nvim")
            self.run(
                "new-session", "-d", "-s", self.name, "-n", "editor",
                "-c", self.root, "exec " + shlex.quote(nvim),
            )
        editor = self.query(target, "#{session_id}")
        self.check_root(editor)
        if editor == self.shell:
            raise LaunchError("the Neovim session cannot also be the shell session")
        # Reapply after workspace restoration, where session IDs may have changed.
        for session, role, peer_option, peer in (
            (self.shell, "shell", "@dotfiles_project_editor", editor),
            (editor, "nvim", "@dotfiles_project_shell", self.shell),
        ):
            self.run(
                "set-option", "-t", session, "@dotfiles_project_role", role,
                ";", "set-option", "-t", session, peer_option, peer,
            )
        return editor

    def ensure_window(self, editor):
        if int(self.query(editor, "#{session_attached}")):
            return
        ghostty = executable("ghostty")
        argv = [
            ghostty, "--title=Neovim · " + self.root,
            "--working-directory=" + self.root,
            "-e", *self.tmux, "attach-session", "-t", editor,
        ]
        # Do not propagate the invoking pane's identity into another terminal.
        env = {key: value for key, value in os.environ.items() if key not in ("TMUX", "TMUX_PANE")}
        process = subprocess.Popen(
            argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )
        attached = False
        try:
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                if int(self.query(editor, "#{session_attached}")):
                    attached = True
                    return
                if process.poll() is not None:
                    raise LaunchError(f"Ghostty exited before attaching to {self.name}")
                time.sleep(0.05)
            raise LaunchError(f"Ghostty did not attach to {self.name}; the Neovim session is still available")
        finally:
            if not attached:
                if process.poll() is None:
                    process.terminate()
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()

    def attach(self):
        target = self.shell
        with self.lock():
            self.check_root(self.shell)
            if self.view != "shell":
                editor = self.ensure_editor()
                if self.view == "nvim":
                    target = editor
                elif any(os.environ.get(key) for key in ("SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY")) or (
                    sys.platform.startswith("linux")
                    and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
                ):
                    print("t: Neovim is ready; run t --editor in this worktree from a second terminal.", file=sys.stderr)
                else:
                    self.ensure_window(editor)
        self.check_root(target)
        os.execv(self.tmux[0], [*self.tmux, "attach-session", "-c", self.root, "-t", target])


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "editor-name":
        print(editor_name(str(Path(sys.argv[2]).resolve(strict=True))))
    elif len(sys.argv) in (4, 5) and sys.argv[1] == "open":
        ProjectSession(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) == 5 else "shell").attach()
    else:
        raise LaunchError("usage: project-session editor-name DIRECTORY | open SESSION DIRECTORY [shell|nvim|pair]")


if __name__ == "__main__":
    try:
        main()
    except (LaunchError, OSError, subprocess.TimeoutExpired, ValueError) as error:
        print(f"t: {error}", file=sys.stderr)
        sys.exit(1)
